-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Mathlib.Data.Fintype.Perm
import Formalgo.Core.Algorithm
import Formalgo.Complexity.Sorting.LLMUnchecked.Factorial
import Formalgo.Complexity.Sorting.LLMUnchecked.Generic
import Formalgo.Complexity.Sorting.LLMUnchecked.Tapes

/-!
# Proof that sorting on the real RAM takes `Ω(n log n)` steps
-/

namespace Formalgo.Complexity.Sorting

open Nat

variable {operations : List RealRAM.Operation} {PC : Type} [Fintype PC]
  {program : (realRAM operations).Program PC}

/-- The start state on input `x`. -/
noncomputable def start (program : (realRAM operations).Program PC) (x : List ℝ) :
    Program.State PC ℕ ℝ :=
  ⟨program.init, listCoding.encode x⟩

theorem Indistinguishable.mono {R : ℝ → ℝ → Prop} {C C' : Set ℝ} (h : Indistinguishable R C')
    (hC : C ⊆ C') : Indistinguishable R C :=
  { h with const := fun c hc => h.const c (hC hc) }

section Counting

variable {K : Type*} [Field K] [Algebra K ℝ] {n : ℕ} {a : Fin n → ℝ}
  (hK : constants program ⊆ Set.range (algebraMap K ℝ)) (ha : AlgebraicIndependent K a)
include hK ha

/-- The runs on two permutations of `a` with the same comparison results stay related. -/
theorem run_sameFunction (π ρ : Equiv.Perm (Fin n)) {steps : ℕ}
    (h : trace program steps (start program (List.ofFn (a ∘ π))) =
      trace program steps (start program (List.ofFn (a ∘ ρ)))) :
    StatusRel (SameFunction (ha.comp π π.injective) (ha.comp ρ ρ.injective))
      (program.run (realRAM operations).semantics steps (start program (List.ofFn (a ∘ π))))
      (program.run (realRAM operations).semantics steps (start program (List.ofFn (a ∘ ρ)))) := by
  have hR := (indistinguishable (ha.comp π π.injective) (ha.comp ρ ρ.injective)).mono hK
  refine hR.run steps ⟨rfl, fun c => ?_⟩ h
  simp only [start, encode_read, List.length_ofFn]
  rcases c with _ | c
  · exact hR.nat n
  · simp only [List.getD_cons_succ]
    by_cases hc : c < n
    · rw [List.getD_eq_getElem _ _ (by simpa using hc),
        List.getD_eq_getElem _ _ (by simpa using hc), List.getElem_ofFn, List.getElem_ofFn]
      exact sameFunction_input _ _ ⟨c, hc⟩
    · rw [List.getD_eq_default _ _ (by simpa using hc),
        List.getD_eq_default _ _ (by simpa using hc)]
      simpa using hR.nat 0

/-- If `program` sorts each permutation of `a` within `T` steps, then `n! ≤ (T + n + 1) 2 ^ T`:
the comparison results and the position of the output determine the permutation. -/
theorem factorial_le (T : ℕ)
    (hT : ∀ π : Equiv.Perm (Fin n), ∃ f, program.run (realRAM operations).semantics T
        (start program (List.ofFn (a ∘ π))) = .halted f ∧
      (listCoding.decode f.tape).Perm (List.ofFn (a ∘ π)) ∧
      (listCoding.decode f.tape).Pairwise (· ≤ ·)) :
    n ! ≤ (T + n + 1) * 2 ^ T := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact Nat.mul_pos (Nat.succ_pos T) (Nat.two_pow_pos T)
  choose f hf hperm hsorted using hT
  choose W hWcard hW using fun π : Equiv.Perm (Fin n) =>
    run_write (program := program) T (start program (List.ofFn (a ∘ π)))
  set out := fun π => listCoding.decode (f π).tape
  set θ := fun π : Equiv.Perm (Fin n) => trace program T (start program (List.ofFn (a ∘ π)))
  set k := fun π => ⌊(f π).tape.read 0⌋₊
  have hperm' (π : Equiv.Perm (Fin n)) : (out π).Perm (List.ofFn a) :=
    (hperm π).trans (π.ofFn_comp_perm a)
  have hout_eq (π ρ : Equiv.Perm (Fin n)) : out π = out ρ :=
    ((hperm' π).trans (hperm' ρ).symm).eq_of_pairwise' (hsorted π) (hsorted ρ)
  have hlen (π : Equiv.Perm (Fin n)) : (out π).length = n := by
    simpa using (hperm' π).length_eq
  have hcell (π : Equiv.Perm (Fin n)) (i : ℕ) (hi : i < n) :
      (f π).tape.read (k π + 2 + i) = (out π).getD i 0 :=
    (decode_getD _ (by
      rw [show (listCoding.decode (f π).tape).length = n from hlen π]; exact hi)).symm
  have hmem (π : Equiv.Perm (Fin n)) (v : ℝ) : v ∈ out π ↔ ∃ j, a j = v := by
    rw [(hperm' π).mem_iff, List.mem_ofFn]
  have hrel (π ρ : Equiv.Perm (Fin n)) (h : θ π = θ ρ) :
      TapeRel (SameFunction (ha.comp π π.injective) (ha.comp ρ ρ.injective))
        (f π).tape (f ρ).tape := by
    have := run_sameFunction hK ha π ρ h
    rw [hf π, hf ρ] at this
    exact this.2
  have hR (π ρ : Equiv.Perm (Fin n)) :=
    indistinguishable (ha.comp π π.injective) (ha.comp ρ ρ.injective)
  -- The position of the output determines the permutation, among those with the same trace.
  have hinj (π ρ : Equiv.Perm (Fin n)) (hθ : θ π = θ ρ) (hk : k π = k ρ) : π = ρ := by
    refine Equiv.ext fun i => ha.injective ?_
    obtain ⟨j, hj, hji⟩ := List.getElem_of_mem ((hmem π (a (π i))).2 ⟨_, rfl⟩)
    rw [hlen] at hj
    have h := hrel π ρ hθ (k π + 2 + j)
    rw [hcell π j hj, hk, hcell ρ j hj, ← hout_eq π ρ, List.getD_eq_getElem _ _ (by rwa [hlen]),
      hji] at h
    exact ((hR π ρ).eq_iff h (sameFunction_input _ _ i)).1 rfl
  -- The output is written in a changed cell, or in the input.
  have hmaps (π₀ π : Equiv.Perm (Fin n)) (hθ : θ π₀ = θ π) :
      k π + 2 ∈ W π₀ ∪ Finset.range (n + 1) := by
    by_contra hc
    simp only [Finset.mem_union, Finset.mem_range, not_or, not_lt] at hc
    have h0 : (f π₀).tape.read (k π + 2) = 0 := by
      have := hW π₀ _ hc.1
      rw [hf π₀] at this
      refine this.trans ?_
      rw [start, encode_read, List.getD_eq_default _ _ (by simpa using hc.2)]
    have h := hrel π₀ π hθ (k π + 2 + 0)
    rw [Nat.add_zero, h0, ← Nat.add_zero (k π + 2), hcell π 0 hn,
      List.getD_eq_getElem _ _ (by rw [hlen]; exact hn)] at h
    obtain ⟨j, hj⟩ := (hmem π _).1 (List.getElem_mem _)
    have h00 := (hR π₀ π).nat 0
    rw [Nat.cast_zero] at h00
    exact ha.ne_zero j (hj.trans (((hR π₀ π).eq_iff h00 h).1 rfl).symm)
  have hcard := Finset.card_le_mul_card_image (f := θ) Finset.univ (T + n + 1) fun t ht => by
    obtain ⟨π₀, -, rfl⟩ := Finset.mem_image.1 ht
    calc _ ≤ (W π₀ ∪ Finset.range (n + 1)).card :=
          Finset.card_le_card_of_injOn (fun π => k π + 2)
            (fun π hπ => hmaps π₀ π (Finset.mem_filter.1 hπ).2.symm)
            fun π hπ ρ hρ hk => hinj π ρ ((Finset.mem_filter.1 hπ).2.trans
              (Finset.mem_filter.1 hρ).2.symm) (by simpa using hk)
      _ ≤ (W π₀).card + (n + 1) := (Finset.card_union_le _ _).trans (by simp)
      _ ≤ T + n + 1 := by have := hWcard π₀; omega
  have himage : (Finset.univ.image θ).card ≤ 2 ^ T :=
    (Finset.card_le_univ _).trans (by simp)
  calc n ! = (Finset.univ : Finset (Equiv.Perm (Fin n))).card := by
        rw [Finset.card_univ, Fintype.card_perm, Fintype.card_fin]
    _ ≤ (T + n + 1) * (Finset.univ.image θ).card := hcard
    _ ≤ (T + n + 1) * 2 ^ T := Nat.mul_le_mul_left _ himage

end Counting

/-- Real RAM algorithms on lists of reals. -/
abbrev ListAlgorithm (operations : List RealRAM.Operation) (PC : Type) [Fintype PC] :=
  Algorithm PC (Instr operations) Bool ℕ ℝ (List ℝ) (List ℝ)

/-- A real RAM program that sorts lists of reals takes `Ω(n log n)` steps on some input of each
length `n`. -/
theorem lowerBound (spec : IOSpec (List ℝ) (List ℝ))
    (hspec : ∀ x y, spec.valid x y → y.Perm x ∧ y.Pairwise (· ≤ ·))
    (program : (realRAM operations).Program PC)
    (h : Solves (⟨program, .standard⟩ : ListAlgorithm operations PC)
      (realRAM operations).semantics spec) (n : ℕ) :
    ∃ x : List ℝ, x.length = n ∧
      ∀ t, HaltsWithin (⟨program, .standard⟩ : ListAlgorithm operations PC)
        (realRAM operations).semantics x t → n * Nat.log 2 n ≤ 2048 * t + 2048 := by
  let K := Subfield.closure (constants program)
  have : Countable K := by
    rw [← Cardinal.mk_le_aleph0_iff]
    exact (Subfield.cardinalMk_closure_le_max _).trans
      (max_le (Cardinal.mk_le_aleph0_iff.2 (Set.countable_range _).to_subtype) le_rfl)
  obtain ⟨a, ha⟩ := exists_algebraicIndependent K n
  have hK : constants program ⊆ Set.range (algebraMap K ℝ) := fun c hc =>
    ⟨⟨c, Subfield.subset_closure hc⟩, rfl⟩
  by_contra hcon
  push Not at hcon
  choose t ht hlt using fun π : Equiv.Perm (Fin n) => hcon (List.ofFn (a ∘ π)) List.length_ofFn
  obtain ⟨π₀, -, hπ₀⟩ := Finset.exists_max_image Finset.univ t Finset.univ_nonempty
  refine absurd (mul_log_le (factorial_le hK ha (t π₀) fun π => ?_)) (not_le.2 (hlt π₀))
  obtain ⟨state, hstate⟩ := ht π
  have hstate' : program.run (realRAM operations).semantics (t π)
      (start program (List.ofFn (a ∘ π))) = .halted state := hstate
  obtain ⟨output, ⟨steps, final, hfinal, hout⟩, hvalid⟩ := h (List.ofFn (a ∘ π))
  have hfinal' : program.run (realRAM operations).semantics steps
      (start program (List.ofFn (a ∘ π))) = .halted final := hfinal
  have hout' : listCoding.decode final.tape = output := hout
  have h1 := run_halted hstate' (t π₀ - t π)
  rw [Nat.add_sub_cancel' (hπ₀ π (Finset.mem_univ _))] at h1
  rw [← halted_unique hfinal' hstate'] at h1
  exact ⟨final, h1, hout' ▸ hspec _ _ hvalid⟩

end Formalgo.Complexity.Sorting
