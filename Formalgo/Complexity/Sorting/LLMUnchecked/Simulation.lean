-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Core.RealRAM
import Formalgo.Core.Run

/-!
# Runs that the real RAM cannot tell apart
Two runs whose words are related by a relation compatible with the arithmetic, the constants and
the addresses take the same steps, as long as their comparisons `<` agree.
-/

namespace Formalgo.Complexity.Sorting

/-- Real RAM instructions with the operations `operations`. -/
abbrev Instr (operations : List RealRAM.Operation) :=
  RAM.Instruction ℕ ℝ (RAM.Arithmetic ℕ {operation // operation ∈ operations})

/-- A relation between words that the real RAM cannot tell apart by `=`, by `+`, `−`, `*`, `/`,
or by the constants `constants` and the naturals. -/
structure Indistinguishable (R : ℝ → ℝ → Prop) (constants : Set ℝ) : Prop where
  const : ∀ c ∈ constants, R c c
  nat : ∀ m : ℕ, R m m
  eq_iff : ∀ {v₁ w₁ v₂ w₂}, R v₁ w₁ → R v₂ w₂ → (v₁ = v₂ ↔ w₁ = w₂)
  add : ∀ {v₁ w₁ v₂ w₂}, R v₁ w₁ → R v₂ w₂ → R (v₁ + v₂) (w₁ + w₂)
  sub : ∀ {v₁ w₁ v₂ w₂}, R v₁ w₁ → R v₂ w₂ → R (v₁ - v₂) (w₁ - w₂)
  mul : ∀ {v₁ w₁ v₂ w₂}, R v₁ w₁ → R v₂ w₂ → R (v₁ * v₂) (w₁ * w₂)
  div : ∀ {v₁ w₁ v₂ w₂}, R v₁ w₁ → R v₂ w₂ → R (v₁ / v₂) (w₁ / w₂)

/-- The constant of a `const` instruction, and `0` for the others. -/
def constant {operations : List RealRAM.Operation} : Instr operations → ℝ
  | .const _ value => value
  | _ => 0

/-- The result of a comparison `<`, and `true` for the other instructions. -/
noncomputable def lessBit {operations : List RealRAM.Operation} :
    Instr operations → Tape ℕ ℝ → Bool
  | .extension (.apply ⟨.less, _⟩ _ left right), tape => decide (tape.read left < tape.read right)
  | _, _ => true

variable {operations : List RealRAM.Operation} {R : ℝ → ℝ → Prop} {C : Set ℝ}

theorem Indistinguishable.toAddress_eq (hR : Indistinguishable R C) {v w : ℝ}
    (h : R v w) : (realRAM operations).toAddress? v = (realRAM operations).toAddress? w := by
  have key (m : ℕ) : v = m ↔ w = m := hR.eq_iff h (hR.nat m)
  simp only [realRAM]
  by_cases hv : (⌊v⌋₊ : ℝ) = v
  · have hw : w = ⌊v⌋₊ := (key _).1 hv.symm
    rw [if_pos hv, hw, Nat.floor_natCast, if_pos rfl]
  · have hw : ¬ (⌊w⌋₊ : ℝ) = w := fun hw => hv (by
      rw [(key _).2 hw.symm, Nat.floor_natCast])
    rw [if_neg hv, if_neg hw]

/-- Related tapes: each cell holds related words. -/
def TapeRel (R : ℝ → ℝ → Prop) (t₁ t₂ : Tape ℕ ℝ) : Prop := ∀ c, R (t₁.read c) (t₂.read c)

theorem TapeRel.write {t₁ t₂ : Tape ℕ ℝ} (ht : TapeRel R t₁ t₂) (a : ℕ) {v w : ℝ} (h : R v w) :
    TapeRel R (t₁.write a v) (t₂.write a w) := fun c => by
  simp only [Tape.write]
  split_ifs
  exacts [h, ht c]

/-- One instruction on related tapes with the same comparison result. -/
theorem Indistinguishable.exec (hR : Indistinguishable R C) {i : Instr operations}
    (hi : constant i ∈ C) {t₁ t₂ : Tape ℕ ℝ} (ht : TapeRel R t₁ t₂)
    (hbit : lessBit i t₁ = lessBit i t₂) :
    ((realRAM operations).semantics.exec i t₁).1 = ((realRAM operations).semantics.exec i t₂).1 ∧
      TapeRel R ((realRAM operations).semantics.exec i t₁).2
        ((realRAM operations).semantics.exec i t₂).2 := by
  cases i with
  | const d v => exact ⟨rfl, ht.write d (hR.const v hi)⟩
  | copy d s => exact ⟨rfl, ht.write d (ht s)⟩
  | load d p =>
    simp only [RAM.semantics, hR.toAddress_eq (ht p)]
    split
    · exact ⟨rfl, ht.write d (ht _)⟩
    · exact ⟨rfl, ht⟩
  | store p s =>
    simp only [RAM.semantics, hR.toAddress_eq (ht p)]
    split
    · exact ⟨rfl, ht.write _ (ht s)⟩
    · exact ⟨rfl, ht⟩
  | halt => exact ⟨rfl, ht⟩
  | extension e =>
    cases e with
    | apply op d l r =>
      obtain ⟨op, hop⟩ := op
      refine ⟨rfl, ht.write d ?_⟩
      cases op with
      | add => exact hR.add (ht l) (ht r)
      | sub => exact hR.sub (ht l) (ht r)
      | mul => exact hR.mul (ht l) (ht r)
      | div => exact hR.div (ht l) (ht r)
      | less =>
        simp only [lessBit, decide_eq_decide] at hbit
        change R (if t₁.read l < t₁.read r then 1 else 0) (if t₂.read l < t₂.read r then 1 else 0)
        have h₁ := hR.nat 1
        have h₀ := hR.nat 0
        push_cast at h₁ h₀
        by_cases h : t₁.read l < t₁.read r
        · rw [if_pos h, if_pos (hbit.1 h)]; exact h₁
        · rw [if_neg h, if_neg (mt hbit.2 h)]; exact h₀
    | equal l r =>
      refine ⟨?_, ht⟩
      simp only [RAM.semantics, realRAM, RAM.arithmetic, hR.eq_iff (ht l) (ht r)]

/-! ### Runs -/

variable {PC : Type} [Fintype PC] (program : (realRAM operations).Program PC)

/-- The comparison results of the first `steps` steps of `program` from `state` (`true` after
halting). -/
noncomputable def trace : (steps : ℕ) → Program.State PC ℕ ℝ → Fin steps → Bool
  | 0, _ => Fin.elim0
  | steps + 1, state => Fin.cons (lessBit (program.instruction state.pc) state.tape)
    (match program.step (realRAM operations).semantics state with
      | .running next => trace steps next
      | .halted _ => fun _ => true)

/-- The state of a status. -/
def stateOf {State : Type*} : Status State → State
  | .running state | .halted state => state

/-- Related states: the same PC, and related tapes. -/
def StateRel (R : ℝ → ℝ → Prop) (s₁ s₂ : Program.State PC ℕ ℝ) : Prop :=
  s₁.pc = s₂.pc ∧ TapeRel R s₁.tape s₂.tape

/-- Related statuses: both running or both halted, in related states. -/
def StatusRel (R : ℝ → ℝ → Prop) : Status (Program.State PC ℕ ℝ) →
    Status (Program.State PC ℕ ℝ) → Prop
  | .running s₁, .running s₂ | .halted s₁, .halted s₂ => StateRel R s₁ s₂
  | _, _ => False

/-- The constants of `program`. -/
def constants : Set ℝ := Set.range fun pc => constant (program.instruction pc)

variable {program}

theorem Indistinguishable.step (hR : Indistinguishable R (constants program))
    {s₁ s₂ : Program.State PC ℕ ℝ} (h : StateRel R s₁ s₂)
    (hbit : lessBit (program.instruction s₁.pc) s₁.tape =
      lessBit (program.instruction s₂.pc) s₂.tape) :
    StatusRel R (program.step (realRAM operations).semantics s₁)
      (program.step (realRAM operations).semantics s₂) := by
  obtain ⟨hpc, ht⟩ := h
  rw [← hpc] at hbit
  obtain ⟨h1, h2⟩ := hR.exec ⟨s₁.pc, rfl⟩ ht hbit
  simp only [Program.step, ← hpc]
  revert h1 h2
  rcases (realRAM operations).semantics.exec (program.instruction s₁.pc) s₁.tape with ⟨_ | o, t⟩ <;>
    rcases (realRAM operations).semantics.exec (program.instruction s₁.pc) s₂.tape with
      ⟨_ | o', t'⟩ <;> simp only [reduceCtorEq, Option.some.injEq, IsEmpty.forall_iff]
  · exact fun _ h => show StateRel R _ _ from ⟨rfl, h⟩
  · rintro rfl h
    exact show StateRel R _ _ from ⟨rfl, h⟩

/-- Runs from related states with the same comparison results stay related. -/
theorem Indistinguishable.run (hR : Indistinguishable R (constants program)) :
    ∀ (steps : ℕ) {s₁ s₂ : Program.State PC ℕ ℝ}, StateRel R s₁ s₂ →
      trace program steps s₁ = trace program steps s₂ →
      StatusRel R (program.run (realRAM operations).semantics steps s₁)
        (program.run (realRAM operations).semantics steps s₂)
  | 0, _, _, h, _ => h
  | steps + 1, s₁, s₂, h, htrace => by
    simp only [trace, Fin.cons_inj] at htrace
    have hstep := hR.step h htrace.1
    have htail := htrace.2
    simp only [Program.run]
    revert hstep htail
    rcases program.step (realRAM operations).semantics s₁ with n₁ | f₁ <;>
      rcases program.step (realRAM operations).semantics s₂ with n₂ | f₂ <;>
      simp only [StatusRel, IsEmpty.forall_iff]
    · exact fun hn ht => hR.run steps hn ht
    · exact fun h _ => h

/-- A step changes at most one cell. -/
theorem exec_write (i : Instr operations) (t : Tape ℕ ℝ) :
    ∃ a, ∀ c ≠ a, ((realRAM operations).semantics.exec i t).2.read c = t.read c := by
  cases i with
  | const d v => exact ⟨d, fun c hc => if_neg hc⟩
  | copy d s => exact ⟨d, fun c hc => if_neg hc⟩
  | load d p =>
    refine ⟨d, fun c hc => ?_⟩
    simp only [RAM.semantics]
    split
    · exact if_neg hc
    · rfl
  | store p s =>
    refine ⟨((realRAM operations).toAddress? (t.read p)).getD 0, fun c hc => ?_⟩
    simp only [RAM.semantics]
    split
    · next a ha => rw [ha] at hc; exact if_neg hc
    · rfl
  | halt => exact ⟨0, fun _ _ => rfl⟩
  | extension e =>
    cases e with
    | apply op d l r => exact ⟨d, fun c hc => if_neg hc⟩
    | equal l r => exact ⟨0, fun _ _ => rfl⟩

theorem stateOf_step_tape (state : Program.State PC ℕ ℝ) :
    (stateOf (program.step (realRAM operations).semantics state)).tape =
      ((realRAM operations).semantics.exec (program.instruction state.pc) state.tape).2 := by
  simp only [Program.step]
  rcases (realRAM operations).semantics.exec (program.instruction state.pc) state.tape with
    ⟨_ | o, t⟩ <;> rfl

/-- A run of `steps` steps changes at most `steps` cells. -/
theorem run_write : ∀ (steps : ℕ) (state : Program.State PC ℕ ℝ), ∃ W : Finset ℕ,
    W.card ≤ steps ∧ ∀ c ∉ W,
      (stateOf (program.run (realRAM operations).semantics steps state)).tape.read c =
        state.tape.read c
  | 0, _ => ⟨∅, le_rfl, fun _ _ => rfl⟩
  | steps + 1, state => by
    obtain ⟨a, ha⟩ := exec_write (program.instruction state.pc) state.tape
    have htape := stateOf_step_tape (program := program) state
    simp only [Program.run]
    revert htape
    rcases program.step (realRAM operations).semantics state with next | final <;> intro htape
    · obtain ⟨W, hW, hc⟩ := run_write steps next
      refine ⟨insert a W, (Finset.card_insert_le _ _).trans (by omega), fun c hcW => ?_⟩
      rw [Finset.mem_insert, not_or] at hcW
      rw [hc c hcW.2, show next.tape = _ from htape, ha c hcW.1]
    · refine ⟨{a}, by simp, fun c hcW => ?_⟩
      exact (congrArg (·.read c) htape).trans (ha c (Finset.notMem_singleton.1 hcW))

/-- A halted run stays halted. -/
theorem run_halted : ∀ {steps : ℕ} {state final : Program.State PC ℕ ℝ},
    program.run (realRAM operations).semantics steps state = .halted final →
    ∀ k, program.run (realRAM operations).semantics (steps + k) state = .halted final
  | 0, _, _, h, _ => by simp [Program.run] at h
  | steps + 1, state, final, h, k => by
    rw [Nat.add_right_comm]
    simp only [Program.run] at h ⊢
    split at h
    · exact run_halted h k
    · exact h

/-- The final state of a halted run does not depend on the number of steps. -/
theorem halted_unique {steps steps' : ℕ} {state final final' : Program.State PC ℕ ℝ}
    (h : program.run (realRAM operations).semantics steps state = .halted final)
    (h' : program.run (realRAM operations).semantics steps' state = .halted final') :
    final = final' := by
  rcases le_total steps steps' with hle | hle
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hle
    rw [run_halted h k] at h'
    exact Status.halted.inj h'
  · obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hle
    rw [run_halted h' k] at h
    exact (Status.halted.inj h).symm

end Formalgo.Complexity.Sorting
