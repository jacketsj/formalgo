-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Mathlib.Data.List.GetD
import Formalgo.Core.RealRAM
import Formalgo.Core.Code.Real

/-!
# Lists of reals on real RAM tapes
The cells of the standard tape of a list of reals, and the list of reals read from a tape.
-/

namespace Formalgo.Complexity.Sorting

/-- The standard tape coding of lists of reals. -/
noncomputable abbrev listCoding : TapeCoding (List ℝ) (List ℝ) ℕ ℝ := .standard

theorem read_foldr_zipIdx (l : List ℝ) (k c : ℕ) :
    ((l.zipIdx k).foldr (fun (value, i) tape => tape.write i value)
      (⟨fun _ => 0⟩ : Tape ℕ ℝ)).read c = if k ≤ c then l.getD (c - k) 0 else 0 := by
  induction l generalizing k with
  | nil => simp
  | cons v l ih =>
    have hw (t : Tape ℕ ℝ) : (t.write k v).read c = if c = k then v else t.read c := rfl
    simp only [List.zipIdx_cons, List.foldr_cons]
    rw [hw, ih]
    by_cases hc : c = k
    · simp [hc]
    · rw [if_neg hc]
      by_cases hk : k + 1 ≤ c
      · obtain ⟨j, rfl⟩ := Nat.exists_eq_add_of_le hk
        rw [if_pos hk, if_pos (by omega), show k + 1 + j - k = j + 1 by omega,
          List.getD_cons_succ, show k + 1 + j - (k + 1) = j by omega]
      · rw [if_neg hk, if_neg (by omega)]

/-- The standard tape of a list of reals holds its length, then its elements, then zeros. -/
theorem encode_read (x : List ℝ) (c : ℕ) :
    (listCoding.encode x).read c = ((x.length : ℝ) :: x).getD c 0 := by
  have h : (Code.encode x : List ℝ) = (x.length : ℝ) :: x := by
    simp [Code.encode]
  simp only [listCoding, TapeCoding.standard, h]
  exact (read_foldr_zipIdx _ 0 c).trans (if_pos (Nat.zero_le c))

theorem decodeMany_value (m : ℕ) (stream : ℕ → ℝ) :
    Code.decodeMany (α := ℝ) m stream = (List.ofFn fun i : Fin m => stream i,
      fun i => stream (i + m)) := by
  induction m generalizing stream with
  | zero => rfl
  | succ m ih =>
    simp only [Code.decodeMany, Code.decode, ih, List.ofFn_succ]
    simp [Nat.add_assoc]

/-- The list of reals read from a tape: the input length `k` is read from cell `0`, the output
length from cell `k + 1`, and the output from the cells after it. -/
theorem decode_eq (tape : Tape ℕ ℝ) : listCoding.decode tape =
    List.ofFn fun i : Fin ⌊tape.read (⌊tape.read 0⌋₊ + 1)⌋₊ =>
      tape.read (⌊tape.read 0⌋₊ + 2 + i) := by
  simp only [listCoding, TapeCoding.standard, Code.decode, decodeMany_value]
  simp only [Nat.cast_id, zero_add]
  congr 1
  funext i
  congr 1
  simp only [Fin.val_cast]
  omega

theorem decode_getD (tape : Tape ℕ ℝ) {i : ℕ} (hi : i < (listCoding.decode tape).length) :
    (listCoding.decode tape).getD i 0 = tape.read (⌊tape.read 0⌋₊ + 2 + i) := by
  rw [List.getD_eq_getElem _ _ hi]
  simp only [decode_eq, List.getElem_ofFn]

end Formalgo.Complexity.Sorting
