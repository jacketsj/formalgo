namespace Formalgo.Complexity.Sorting

open Cardinal

/-- Over a countable field, there are `n` algebraically independent reals. -/
theorem exists_algebraicIndependent (K : Type) [Field K] [Algebra K ℝ] [Countable K] (n : ℕ) :
    ∃ a : Fin n → ℝ, AlgebraicIndependent K a := by
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis K ℝ
  have hinf : s.Infinite := by
    intro hfin
    have : Finite s := hfin.to_subtype
    have := hs.isAlgebraic
    have h1 :=
      Algebra.IsAlgebraic.cardinalMk_le_max (Algebra.adjoin K (Set.range ((↑) : s → ℝ))) ℝ
    have h2 : #(Algebra.adjoin K (Set.range ((↑) : s → ℝ))) ≤ ℵ₀ := by
      rw [← Cardinal.mk_congr hs.1.aevalEquiv.toEquiv]
      exact MvPolynomial.cardinalMk_le_max.trans (max_le (max_le mk_le_aleph0 mk_le_aleph0) le_rfl)
    rw [Cardinal.mk_real] at h1
    exact (not_le.2 aleph0_lt_continuum) (h1.trans (max_le h2 le_rfl))
  exact ⟨fun i => hinf.natEmbedding s i,
    hs.1.comp _ ((hinf.natEmbedding s).injective.comp Fin.val_injective)⟩

variable {K : Type*} [Field K] [Algebra K ℝ] {n : ℕ} {a b : Fin n → ℝ}

/-- Evaluation of rational functions in `n` variables at algebraically independent reals. -/
noncomputable def evalAt (ha : AlgebraicIndependent K a) :
    FractionRing (MvPolynomial (Fin n) K) →ₐ[K] ℝ :=
  IsFractionRing.liftAlgHom (algebraicIndependent_iff_injective_aeval.1 ha)

/-- `v` and `w` are the values of one rational function at `a` and at `b`. -/
def SameFunction (ha : AlgebraicIndependent K a) (hb : AlgebraicIndependent K b) (v w : ℝ) :
    Prop :=
  ∃ p, evalAt ha p = v ∧ evalAt hb p = w

theorem evalAt_X (ha : AlgebraicIndependent K a) (i : Fin n) :
    evalAt ha (algebraMap (MvPolynomial (Fin n) K) _ (MvPolynomial.X i)) = a i := by
  simp [evalAt, IsFractionRing.liftAlgHom_apply, IsFractionRing.lift_algebraMap]

theorem sameFunction_input (ha : AlgebraicIndependent K a) (hb : AlgebraicIndependent K b)
    (i : Fin n) : SameFunction ha hb (a i) (b i) :=
  ⟨_, evalAt_X ha i, evalAt_X hb i⟩

theorem indistinguishable (ha : AlgebraicIndependent K a) (hb : AlgebraicIndependent K b) :
    Indistinguishable (SameFunction ha hb) (Set.range (algebraMap K ℝ)) where
  const := by
    rintro _ ⟨k, rfl⟩
    exact ⟨algebraMap K _ k, (evalAt ha).commutes k, (evalAt hb).commutes k⟩
  nat m := ⟨m, map_natCast _ m, map_natCast _ m⟩
  eq_iff := by
    rintro _ _ _ _ ⟨p, rfl, rfl⟩ ⟨q, rfl, rfl⟩
    have hinj (c : Fin n → ℝ) (hc : AlgebraicIndependent K c) : Function.Injective (evalAt hc) :=
      (evalAt hc).toRingHom.injective
    rw [(hinj a ha).eq_iff, (hinj b hb).eq_iff]
  add := by
    rintro _ _ _ _ ⟨p, rfl, rfl⟩ ⟨q, rfl, rfl⟩
    exact ⟨p + q, map_add _ p q, map_add _ p q⟩
  sub := by
    rintro _ _ _ _ ⟨p, rfl, rfl⟩ ⟨q, rfl, rfl⟩
    exact ⟨p - q, map_sub _ p q, map_sub _ p q⟩
  mul := by
    rintro _ _ _ _ ⟨p, rfl, rfl⟩ ⟨q, rfl, rfl⟩
    exact ⟨p * q, map_mul _ p q, map_mul _ p q⟩
  div := by
    rintro _ _ _ _ ⟨p, rfl, rfl⟩ ⟨q, rfl, rfl⟩
    exact ⟨p / q, map_div₀ _ p q, map_div₀ _ p q⟩

