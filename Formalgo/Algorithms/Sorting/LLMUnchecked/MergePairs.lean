  m' 1 = m 1 ∧ m' 3 = m 3 ∧ m' 4 = m 4 ∧ m' 5 = m 5 ∧ m' 8 = m 8 ∧ m' 9 = m 9 ∧ m' 10 = m 10 ∧
    m' 16 = m 16

/-- The merged runs at a multiple of `2 w`. -/
