    ((L.drop (j * (2 * w))).take w).merge (((L.drop (j * (2 * w))).drop w).take w) nle =
      ((mergePass nle w L).drop (j * (2 * w))).take (2 * w) := by
  rw [drop_mergePass_mul hw, take_mergePass hw]

/-- The pair loop invariant: the runs before `i` merged. -/
