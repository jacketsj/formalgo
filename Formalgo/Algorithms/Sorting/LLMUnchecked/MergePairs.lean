/-- One step of the pair loop. -/
theorem pair_step {B src dst w i j s : ℕ} {L : List ℕ} {m m' : Mem} (hw : 0 < w)
    (hwn : w < L.length) (hlt : i < L.length) (hj : j * (2 * w) = i)
    (hdisj : dst + L.length ≤ src ∨ src + L.length ≤ dst) (h32 : 32 ≤ src ∧ 32 ≤ dst)
