-- Unchecked LLM code: generated by an LLM and not checked by a human.

import Formalgo.Algorithms.Sorting.LLMUnchecked.Theorem

/-!
# Commands on the integer RAM

Compiled commands run on an integer RAM tape holding the memory as integers.
-/

namespace Formalgo.LLMUnchecked

open Function Cmd

/-- The integer RAM operations used. -/
abbrev iops : List IntegerRAM.Operation := [.less, .add, .sub]

/-- An integer RAM operation used. -/
abbrev IOp := {operation // operation ∈ iops}

/-- Integer RAM instructions. -/
abbrev IInstr := RAM.Instruction ℕ ℤ (RAM.Arithmetic ℕ IOp)

/-- The integer RAM operation for an operation. -/
def opI (o : Op) : IOp :=
  match o.val with
  | .add => ⟨.add, by simp⟩
  | .sub => ⟨.sub, by simp⟩
  | _ => ⟨.less, by simp⟩

/-- The integer RAM arithmetic instruction for an arithmetic instruction. -/
def arithI : RAM.Arithmetic ℕ Op → RAM.Arithmetic ℕ IOp
  | .apply o d l r => .apply (opI o) d l r
  | .equal l r => .equal l r

/-- An instruction over natural numbers, on the integer RAM. -/
def NInstr.toInt (i : NInstr) : IInstr := i.map id (fun v : ℕ => (v : ℤ)) arithI

/-- The program running `lines` on the integer RAM. -/
def linesProgramI (lines : List Line) (h : 0 < lines.length) :
    Program (Fin lines.length) IInstr Bool where
  init := ⟨0, h⟩
  next pc outcome :=
    ⟨(if outcome then lines[pc].onTrue else lines[pc].onFalse) % lines.length, Nat.mod_lt _ h⟩
  instruction pc := lines[pc].instr.toInt

/-- The integer RAM semantics. -/
abbrev semI := IntegerRAM.withAddSub.semantics

/-- A memory of natural numbers agrees with an integer tape. -/
def ICorr (m : Mem) (T : Tape ℕ ℤ) : Prop := ∀ a, T.read a = (m a : ℤ)

theorem ICorr.write {m : Mem} {T : Tape ℕ ℤ} (hT : ICorr m T) (d v : ℕ) :
    ICorr (update m d v) (T.write d (v : ℤ)) := by
  intro a
  rw [Tape.read_write, update_apply]
  split_ifs <;> simp [hT a]

section Exec

variable {lines : List Line} {hlines : 0 < lines.length}

/-- One step on a line holding a non-halting instruction. -/
theorem run_lineI {T T' : Tape ℕ ℤ} {pc : Fin lines.length} {line : Line} {s : ℕ}
    (hpc : pc.val = s) (hline : lines[s]? = some line) {outcome : Bool}
    (hexec : semI.exec line.instr.toInt T = (some outcome, T')) {target : ℕ}
    (htarget : (if outcome then line.onTrue else line.onFalse) = target)
    (ht : target < lines.length) :
    (linesProgramI lines hlines).run semI 1 ⟨pc, T⟩ = .running ⟨⟨target, ht⟩, T'⟩ := by
  subst hpc
  have hl : lines[pc.val] = line := by
    rw [List.getElem?_eq_getElem pc.isLt] at hline; exact Option.some.inj hline
  simp only [Program.run, Program.step, linesProgramI, Fin.getElem_fin, hl, hexec]
  simp only [htarget, Nat.mod_eq_of_lt ht]

theorem run_primI {T T' : Tape ℕ ℤ} {pc : Fin lines.length} {s : ℕ} {i : NInstr}
    (hpc : pc.val = s) (hline : lines[s]? = some ⟨i, s + 1, s + 1⟩)
    (hexec : semI.exec i.toInt T = (some true, T')) (ht : s + 1 < lines.length) :
    (linesProgramI lines hlines).run semI 1 ⟨pc, T⟩ = .running ⟨⟨s + 1, ht⟩, T'⟩ :=
  run_lineI hpc hline hexec (by simp) ht

theorem exec_equalI {T : Tape ℕ ℤ} {m : Mem} (hT : ICorr m T) (l r : ℕ) :
    semI.exec (Line.instr ⟨.extension (.equal l r), 0, 0⟩).toInt T =
      (some (decide (m l = m r)), T) := by
  simp [NInstr.toInt, RAM.Instruction.map, arithI, RAM.semantics, IntegerRAM.withAddSub,
    integerRAM, RAM.arithmetic, hT l, hT r]

/-- A compiled command follows `Exec` on the integer RAM. -/
theorem Exec.runI {B : ℕ} {c : Cmd} {m : Mem} {k : ℕ} {m' : Mem} (hE : Exec B c m k m') :
    ∀ {s : ℕ} (_hat : At lines s (c.compile s)) (hlen : s + c.size < lines.length)
      {T : Tape ℕ ℤ} (_hT : ICorr m T) {pc : Fin lines.length} (_hpc : pc.val = s),
      ∃ T', (linesProgramI lines hlines).run semI k ⟨pc, T⟩ =
        .running ⟨⟨s + c.size, hlen⟩, T'⟩ ∧ ICorr m' T' := by
  induction hE with
  | @const m d v hd hv =>
    intro s hat hlen T hT pc hpc
    exact ⟨T.write d (v : ℤ), run_primI hpc (hat.cons).1
      (by simp [NInstr.toInt, RAM.Instruction.map, RAM.semantics]) hlen, hT.write d v⟩
  | @copy m d x hd hx =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write d (m x : ℤ), run_primI hpc (hat.cons).1
      (by simp [NInstr.toInt, RAM.Instruction.map, RAM.semantics, hT x]) hlen, hT.write d _⟩
  | @load m d p hd hp =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write d (m (m p) : ℤ), run_primI hpc (hat.cons).1
      (by simp [NInstr.toInt, RAM.Instruction.map, RAM.semantics, IntegerRAM.withAddSub,
        integerRAM, hT p, hT (m p)]) hlen, hT.write d _⟩
  | @store m p x hp hx =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write (m p) (m x : ℤ), run_primI hpc (hat.cons).1
      (by simp [NInstr.toInt, RAM.Instruction.map, RAM.semantics, IntegerRAM.withAddSub,
        integerRAM, hT p, hT x]) hlen, hT.write _ _⟩
  | @add m d l r hd hl hr hsum =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write d ((m l + m r : ℕ) : ℤ), run_primI hpc (hat.cons).1
      (by simp [NInstr.toInt, RAM.Instruction.map, arithI, opI, RAM.semantics,
        IntegerRAM.withAddSub, integerRAM, RAM.arithmetic, Cmd.addOp, hT l, hT r]) hlen,
      hT.write d _⟩
  | @sub m d l r hd hl hr hle =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write d ((m l - m r : ℕ) : ℤ), run_primI hpc (hat.cons).1
      (by simp [NInstr.toInt, RAM.Instruction.map, arithI, opI, RAM.semantics,
        IntegerRAM.withAddSub, integerRAM, RAM.arithmetic, Cmd.subOp, hT l, hT r,
        Nat.cast_sub hle]) hlen, hT.write d _⟩
  | @less m d l r hd hl hr =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write d ((if m l < m r then 1 else 0 : ℕ) : ℤ), run_primI hpc (hat.cons).1
      (by simp [NInstr.toInt, RAM.Instruction.map, arithI, opI, RAM.semantics,
        IntegerRAM.withAddSub, integerRAM, RAM.arithmetic, Cmd.lessOp, hT l, hT r]) hlen,
      hT.write d _⟩
  | @seq a b m k₁ m₁ k₂ m₂ _ _ iha ihb =>
    intro s hat hlen T hT pc hpc
    obtain ⟨hata, hatb⟩ := At.append hat
    rw [Cmd.length_compile] at hatb
    simp only [Cmd.size] at hlen
    obtain ⟨T₁, h₁, hT₁⟩ := iha hata (by omega) hT hpc
    obtain ⟨T₂, h₂, hT₂⟩ := ihb hatb (by omega) hT₁ (pc := ⟨s + a.size, by omega⟩) rfl
    refine ⟨T₂, ?_, hT₂⟩
    rw [run_add_of_running h₁, h₂]
    simp [Cmd.size, Nat.add_assoc]
  | @iteTrue l r t e m k m' hl hr heq _ iht =>
    intro s hat hlen T hT pc hpc
    obtain ⟨htest, hrest⟩ := At.cons hat
    obtain ⟨hatt, hrest⟩ := At.append hrest
    obtain ⟨hjump, _⟩ := At.cons hrest
    rw [Cmd.length_compile] at hjump
    simp only [Cmd.size] at hlen
    have h0 := run_lineI (hlines := hlines) hpc htest (exec_equalI hT l r) (target := s + 1)
      (by simp [heq]) (by omega)
    obtain ⟨T₁, h₁, hT₁⟩ := iht hatt (by omega) hT (pc := ⟨s + 1, by omega⟩) rfl
    have h₂ := run_lineI (hlines := hlines) (pc := ⟨s + 1 + t.size, by omega⟩) rfl hjump
      (exec_equalI hT₁ 0 0) (target := s + (t.size + e.size + 2)) (by simp [Cmd.jump]; omega)
      (by omega)
    refine ⟨T₁, ?_, hT₁⟩
    rw [show k + 2 = 1 + (k + 1) by omega, run_add_of_running h0, run_add_of_running h₁, h₂]
    rfl
  | @iteFalse l r t e m k m' hl hr hne _ ihe =>
    intro s hat hlen T hT pc hpc
    obtain ⟨htest, hrest⟩ := At.cons hat
    obtain ⟨_, hrest⟩ := At.append hrest
    obtain ⟨_, hate⟩ := At.cons hrest
    rw [Cmd.length_compile, show s + 1 + t.size + 1 = s + t.size + 2 by omega] at hate
    simp only [Cmd.size] at hlen
    have h0 := run_lineI (hlines := hlines) hpc htest (exec_equalI hT l r)
      (target := s + t.size + 2) (by simp [hne]) (by omega)
    obtain ⟨T₁, h₁, hT₁⟩ := ihe hate (by omega) hT (pc := ⟨s + t.size + 2, by omega⟩) rfl
    refine ⟨T₁, ?_, hT₁⟩
    rw [show k + 1 = 1 + k by omega, run_add_of_running h0, h₁]
    simp [Cmd.size]; omega
  | @loopTrue l r body m k₁ m₁ k₂ m₂ hl hr heq _ _ ihb ihl =>
    intro s hat hlen T hT pc hpc
    have hat' := hat
    obtain ⟨htest, hrest⟩ := At.cons hat
    obtain ⟨hatb, hrest⟩ := At.append hrest
    obtain ⟨hjump, _⟩ := At.cons hrest
    rw [Cmd.length_compile] at hjump
    simp only [Cmd.size] at hlen
    have h0 := run_lineI (hlines := hlines) hpc htest (exec_equalI hT l r) (target := s + 1)
      (by simp [heq]) (by omega)
    obtain ⟨T₁, h₁, hT₁⟩ := ihb hatb (by omega) hT (pc := ⟨s + 1, by omega⟩) rfl
    have h₂ := run_lineI (hlines := hlines) (pc := ⟨s + 1 + body.size, by omega⟩) rfl hjump
      (exec_equalI hT₁ 0 0) (target := s) (by simp [Cmd.jump]) (by omega)
    obtain ⟨T₂, h₃, hT₂⟩ := ihl hat' (by simpa [Cmd.size] using hlen) hT₁ (pc := ⟨s, by omega⟩) rfl
    refine ⟨T₂, ?_, hT₂⟩
    rw [show k₁ + k₂ + 2 = 1 + (k₁ + (1 + k₂)) by omega, run_add_of_running h0,
      run_add_of_running h₁, run_add_of_running h₂, h₃]
  | @loopFalse l r body m hl hr hne =>
    intro s hat hlen T hT pc hpc
    obtain ⟨htest, _⟩ := At.cons hat
    exact ⟨T, run_lineI (hlines := hlines) hpc htest (exec_equalI hT l r)
      (by simp [hne, Cmd.size]; omega) hlen, hT⟩

end Exec

/-! ### The integer RAM tape coding -/

/-- The memory holding `x` as the integer RAM's standard tape does: `n`, then `x`. -/
def imem (x : List ℕ) (a : ℕ) : ℕ := (x.length :: x).getD a 0

theorem encode_listI (x : List ℕ) :
    (Code.encode x : List ℤ) = (x.length :: x).map fun v => (v : ℤ) := by
  change [((x.length : ℕ) : ℤ)] ++ x.flatMap (fun v => [((v : ℕ) : ℤ)]) = _
  simp

theorem read_foldr_zipIdxI (L : List ℤ) (k a : ℕ) :
    ((L.zipIdx k).foldr (fun (p : ℤ × ℕ) tape => tape.write (p.2 : ℕ) p.1)
      (⟨fun _ => default⟩ : Tape ℕ ℤ)).read a =
      if k ≤ a then L.getD (a - k) default else default := by
  induction L generalizing k with
  | nil => simp
  | cons v L ih =>
    simp only [List.zipIdx_cons, List.foldr_cons]
    rw [Tape.read_write, ih (k + 1)]
    by_cases ha : a = k
    · subst ha; simp
    · simp only [ha, if_false]
      by_cases hle : k + 1 ≤ a
      · rw [if_pos hle, if_pos (by omega), show a - k = (a - (k + 1)) + 1 by omega]
        simp
      · rw [if_neg hle, if_neg (by omega)]

theorem getD_map_cast : ∀ (L : List ℕ) (a : ℕ),
    (L.map fun v => (v : ℤ)).getD a default = ((L.getD a 0 : ℕ) : ℤ)
  | [], _ => rfl
  | _ :: _, 0 => rfl
  | _ :: L, a + 1 => getD_map_cast L a

theorem imem_corr (x : List ℕ) :
    ICorr (imem x) ((TapeCoding.standard : TapeCoding (List ℕ) (List ℕ) ℕ ℤ).encode x) := by
  intro a
  have h := read_foldr_zipIdxI (Code.encode x : List ℤ) 0 a
  simp only [Nat.zero_le, if_true, Nat.sub_zero] at h
  have e : ((TapeCoding.standard : TapeCoding (List ℕ) (List ℕ) ℕ ℤ).encode x).read a =
      (Code.encode x : List ℤ).getD a default := by simpa [TapeCoding.standard] using h
  rw [e, encode_listI, imem]
  exact getD_map_cast _ a

theorem decodeMany_nat (k : ℕ) (s : ℕ → ℤ) :
    Code.decodeMany (α := ℕ) k s =
      ((List.range k).map fun i => (s i).toNat, fun i => s (i + k)) := by
  induction k generalizing s with
  | zero => simp [Code.decodeMany]
  | succ k ih =>
    simp only [Code.decodeMany]
    change (((s 0).toNat :: (Code.decodeMany k fun i => s (i + 1)).1),
      (Code.decodeMany k fun i => s (i + 1)).2) = _
    rw [ih, List.range_succ_eq_map]
    simp only [List.map_cons, List.map_map]
    refine Prod.ext rfl (funext fun i => ?_)
    simp only; congr 1

theorem decode_listI (s : ℕ → ℤ) :
    Code.decode (α := List ℕ) s = ((List.range (s 0).toNat).map fun i => (s (i + 1)).toNat,
      fun i => s (i + 1 + (s 0).toNat)) := by
  change Code.decodeMany (s 0).toNat (fun i => s (i + 1)) = _
  rw [decodeMany_nat]
  exact Prod.ext rfl (funext fun i => by simp only; congr 1; omega)

/-- The output on a final tape: the list after the input. -/
theorem decode_standardI {m : Mem} {T : Tape ℕ ℤ} (hT : ICorr m T) :
    (TapeCoding.standard : TapeCoding (List ℕ) (List ℕ) ℕ ℤ).decode T =
      (List.range (m (m 0 + 1))).map fun i => m (m 0 + 2 + i) := by
  change (Code.decode (α := List ℕ) (Code.decode (α := List ℕ) fun i : ℕ => T.read (i : ℕ)).2).1 = _
  rw [decode_listI, decode_listI]
  have hT' : ∀ a, T.read a = ((m a : ℕ) : ℤ) := hT
  simp only [hT', Int.toNat_natCast]
  rw [show 0 + 1 + m 0 = m 0 + 1 by omega]
  congr 1; funext i; congr 1; omega

/-! ### Integer RAM algorithms from commands -/

/-- The integer RAM algorithm running `c`, with the standard tape coding. -/
def iAlg (c : Cmd) : Algorithm (Fin c.lines.length) IInstr Bool ℕ ℤ (List ℕ) (List ℕ) :=
  ⟨linesProgramI c.lines (by simp [Cmd.length_lines]), .standard⟩

theorem run_haltI {lines : List Line} {hl : 0 < lines.length} {pc : Fin lines.length}
    (hpc : lines[pc.val]? = some ⟨.halt, 0, 0⟩) (T : Tape ℕ ℤ) :
    (linesProgramI lines hl).run semI 1 ⟨pc, T⟩ = .halted ⟨pc, T⟩ := by
  have : lines[pc.val] = ⟨.halt, 0, 0⟩ := by
    rw [List.getElem?_eq_getElem pc.isLt] at hpc; exact Option.some.inj hpc
  simp [Program.run, Program.step, linesProgramI, this, NInstr.toInt, RAM.Instruction.map,
    RAM.semantics]

/-- A command run from the input memory halts one step later, with the list after the input. -/
theorem outputs_of_execI (c : Cmd) (x : List ℕ) {B k : ℕ} {m' : Mem}
    (hE : Exec B c (imem x) k m') :
    Outputs (iAlg c) semI x ((List.range (m' (m' 0 + 1))).map fun i => m' (m' 0 + 2 + i)) ∧
      HaltsWithin (iAlg c) semI x (k + 1) := by
  have hlpos : 0 < c.lines.length := by simp [Cmd.length_lines]
  obtain ⟨T', hrun, hT'⟩ := Exec.runI (lines := c.lines) (hlines := hlpos) hE (s := 0)
    (fun i hi => by simp [Cmd.lines, List.getElem?_append_left (by rwa [Cmd.length_compile] at hi)])
    (by simp [Cmd.length_lines]) (imem_corr x) (pc := ⟨0, hlpos⟩) rfl
  have hhalt := run_haltI (hl := hlpos) (pc := ⟨0 + c.size, by simp [Cmd.length_lines]⟩)
    (by simp [Cmd.lines, Cmd.length_compile]) T'
  have hstatus : (Runnable.run (iAlg c) semI).status x (k + 1) =
      .halted ⟨⟨0 + c.size, by simp [Cmd.length_lines]⟩, T'⟩ := by
    change (linesProgramI c.lines hlpos).run semI (k + 1)
      ⟨⟨0, hlpos⟩, (TapeCoding.standard : TapeCoding (List ℕ) (List ℕ) ℕ ℤ).encode x⟩ = _
    rw [run_add_of_running hrun, hhalt]
  exact ⟨⟨k + 1, _, hstatus, decode_standardI hT'⟩, ⟨_, hstatus⟩⟩

theorem haltsWithin_monoI (c : Cmd) {x : List ℕ} {a b : ℕ}
    (h : HaltsWithin (iAlg c) semI x a) (hab : a ≤ b) : HaltsWithin (iAlg c) semI x b := by
  obtain ⟨st, hst⟩ := h
  exact ⟨st, status_halted_mono hst hab⟩

/-! ### Freeing the low cells

The input starts at cell `0`, so no cell is free. Doubling cell `0` keeps `n` (as `2 n`) and
points past the input, where cell `1` is saved; cell `1` then helps save cells `2, …, 31` to the
buffer at `S = 2 n + 64`.
-/

/-- Save cell `j` to `S + j`, with `S` in cell `0` and cell `1` as scratch. -/
def save1 (j : ℕ) : Cmd := seq (const 1 j) (seq (add 1 0 1) (store 1 j))

/-- Save the cells `js`, then copy `S` into cell `1`. -/
def saves : List ℕ → Cmd
  | [] => copy 1 0
  | j :: js => seq (save1 j) (saves js)

/-- Free the low cells: cell `0` and `1` hold `S = 2 n + 64`, and cells `2, …, 31` are saved. -/
def bootI : Cmd :=
  seq (add 0 0 0) (seq (store 0 1) (seq (const 1 64) (seq (add 0 0 1) (saves (List.range' 2 30)))))

theorem exec_saves {B S : ℕ} : ∀ (js : List ℕ) {m : Mem}, js.Nodup → m 0 = S →
    (∀ j ∈ js, 2 ≤ j ∧ j < 32) → 32 ≤ S → S < B → (∀ j ∈ js, S + j < B) →
    ∃ m', Exec B (saves js) m (3 * js.length + 1) m' ∧ m' 0 = S ∧ m' 1 = S ∧
      (∀ j ∈ js, m' (S + j) = m j) ∧
      ∀ a, a ≠ 1 → (∀ j ∈ js, a ≠ S + j) → m' a = m a
  | [], m, _, h0, _, hS, hSB, _ => ⟨_, .copy (by omega) (by omega), by simp [h0],
      by simp [h0], by simp, fun a ha _ => by simp [ha]⟩
  | j :: js, m, hnd, h0, hjs, hS, hSB, hB => by
    obtain ⟨hj2, hj32⟩ := hjs j (by simp)
    have hBj := hB j (by simp)
    have e₁ : Exec B (save1 j) m 3 (update (update (update m 1 j) 1 (S + j)) (S + j) (m j)) := by
      have := Exec.seq (.const (B := B) (m := m) (d := 1) (v := j) (by omega) (by omega))
        (.seq (.add (B := B) (d := 1) (l := 0) (r := 1) (by omega) (by omega) (by omega)
          (by simp [h0]; omega))
          (.store (B := B) (p := 1) (s := j) (by omega) (by omega)))
      simpa [save1, update_apply, h0, show j ≠ 1 by omega, show (1 : ℕ) ≠ 0 by omega] using this
    set m₁ := update (update (update m 1 j) 1 (S + j)) (S + j) (m j) with hm₁
    have h0₁ : m₁ 0 = S := by simp [hm₁, update_apply, h0]; omega
    obtain ⟨hjn, hnd'⟩ := List.nodup_cons.1 hnd
    obtain ⟨m₂, e₂, h₂0, h₂1, h₂buf, h₂rest⟩ := exec_saves js hnd' h0₁
      (fun j' hj' => hjs j' (by simp [hj'])) hS hSB (fun j' hj' => hB j' (by simp [hj']))
    refine ⟨m₂, ?_, h₂0, h₂1, fun j' hj' => ?_, fun a ha hne => ?_⟩
    · have := Exec.seq e₁ e₂
      simpa [saves, List.length_cons,
        show 3 + (3 * js.length + 1) = 3 * (js.length + 1) + 1 by omega]
        using this
    · rcases List.mem_cons.1 hj' with rfl | hj'
      · rw [h₂rest _ (by omega) (fun j'' hj'' h => hjn (by
          have : j' = j'' := by omega
          exact this ▸ hj''))]
        simp [hm₁]
      · have := hjs j' (by simp [hj'])
        rw [h₂buf j' hj', hm₁, update_of_ne (by omega), update_of_ne (by omega),
          update_of_ne (by omega)]
    · rw [h₂rest a ha (fun j' hj' => hne j' (by simp [hj'])), hm₁,
        update_of_ne (hne j (by simp)), update_of_ne ha, update_of_ne ha]

/-- The memory the body sees after `bootI`: `x₀` moved to cell `2 n`, and cells `0, 1` cleared. -/
def bootView (x : List ℕ) (a : ℕ) : ℕ :=
  if a < 2 then 0 else if a = 2 * x.length then imem x 1 else imem x a

theorem imem_high {x : List ℕ} {a : ℕ} (ha : x.length < a) : imem x a = 0 := by
  simp only [imem, List.getD_eq_getElem?_getD]
  rw [List.getElem?_eq_none (by simp; omega)]; rfl

theorem boot_runs {B : ℕ} (x : List ℕ) (hB : 2 * x.length + 96 < B) :
    Runs B bootI (imem x) fun m k => k = 95 ∧ m 0 = 2 * x.length + 64 ∧
      m 1 = 2 * x.length + 64 ∧ ∀ a, vm (2 * x.length + 64) m a = bootView x a := by
  have h00 : imem x 0 = x.length := by simp [imem]
  unfold bootI
  refine Runs.seq (Runs.addR (by omega) (by omega) (by omega) (by rw [h00]; omega)
    fun m₁ h₁ f₁ => ?_)
  rw [h00, ← two_mul] at h₁
  refine Runs.seq (Runs.storeR (by omega) (by omega) fun m₂ h₂ f₂ => ?_)
  rw [h₁, f₁ 1 (by omega)] at h₂
  rw [h₁] at f₂
  refine Runs.seq (Runs.constR (by omega) (by omega) fun m₃ h₃ f₃ => ?_)
  have h₃0 : m₃ 0 = 2 * x.length := by
    rw [f₃ 0 (by omega)]
    by_cases hn : x.length = 0
    · have h0n : 2 * x.length = 0 := by omega
      rw [h0n] at h₂ ⊢; rw [h₂, imem_high (by omega)]
    · rw [f₂ 0 (by omega), h₁]
  refine Runs.seq (Runs.addR (by omega) (by omega) (by omega) (by rw [h₃0, h₃]; omega)
    fun m₄ h₄ f₄ => ?_)
  rw [h₃0, h₃] at h₄
  obtain ⟨m₅, e₅, h₅0, h₅1, h₅buf, h₅rest⟩ := exec_saves (B := B) (S := 2 * x.length + 64)
    (List.range' 2 30) (m := m₄) List.nodup_range' h₄
    (fun j hj => by simp at hj; omega) (by omega) (by omega)
    (fun j hj => by simp at hj; omega)
  refine ⟨m₅, _, e₅, by simp, h₅0, h₅1, fun a => ?_⟩
  -- What the body sees.
  have hlow : ∀ a, a ≠ 0 → a ≠ 1 → m₄ a = if a = 2 * x.length then imem x 1 else imem x a :=
    fun a h0 h1 => by
      rw [f₄ a h0, f₃ a h1]
      split_ifs with h
      · subst h; rw [h₂]
      · rw [f₂ a h, f₁ a h0]
  have hhi : ∀ a, 32 ≤ a → a < 2 * x.length + 64 ∨ 2 * x.length + 96 ≤ a → m₅ a = m₄ a :=
    fun a h1 h2 => h₅rest a (by omega) (fun j hj => by simp at hj; omega)
  unfold vm bootView
  by_cases h32 : a < 32
  · rw [if_pos h32]
    by_cases ha2 : a < 2
    · rw [if_pos ha2, h₅rest _ (by omega) (fun j hj => by simp at hj; omega),
        hlow _ (by omega) (by omega), if_neg (by omega), imem_high (by omega)]
    · rw [if_neg ha2, h₅buf a (by simp; omega), hlow _ (by omega) (by omega)]
  · have hba : (if a < 2 then 0 else if a = 2 * x.length then imem x 1 else imem x a) =
        if a = 2 * x.length then imem x 1 else imem x a := if_neg (by omega)
    rw [if_neg h32, hba]
    by_cases hS : 2 * x.length + 64 ≤ a ∧ a < 2 * x.length + 64 + 32
    · rw [if_pos hS, if_neg (by omega), imem_high (by omega)]
    · rw [if_neg hS, hhi a (by omega) (by omega), hlow _ (by omega) (by omega)]

/-! ### The list in and out, one number per cell -/

/-- `A[i] := vm[va]`, `i += 1`, `va += 1`. -/
def loadBodyI : Cmd := seqs [vread 14 12, add 13 9 11, store 13 14, add 11 11 3, add 12 12 3,
  less 15 11 4]

/-- Load `x` from `vm[1, n]` into `A[0, n)`. -/
def loadLoopI : Cmd := seqs [const 11 0, const 12 1, less 15 11 4, loop 15 3 loadBodyI]

set_option maxHeartbeats 1000000 in
-- The loop proof unfolds many memory updates at once.
theorem exec_loadLoopI {B S n A : ℕ} {m : Mem} {x : List ℕ} (hn : x.length = n)
    (hR : ListRegs S n A m) (hKS : nK ≤ S) (hA : A = S + nK) (hB : A + n + nK < B)
    (hx : ∀ j < n, vm S m (j + 1) = x[j]!) (hxB : ∀ j < n, x[j]! < B) (hxS : n + 1 < S) :
    Runs B loadLoopI m fun m' k => ListRegs S n A m' ∧ (∀ j < n, vm S m' (A + j) = x[j]!) ∧
      (∀ a, (a < A ∨ A + n ≤ a) → vm S m' a = vm S m a) ∧ k ≤ 13 * n + 8 := by
  obtain ⟨⟨h1, h3, h5⟩, h4, h8, h9, h10, h16⟩ := id hR
  let P : Mem → ℕ → Prop := fun m' s => ∃ i ≤ n, ListRegs S n A m' ∧ m' 11 = i ∧
    m' 12 = i + 1 ∧ m' 15 = (if i < n then 1 else 0) ∧
    (∀ j < i, vm S m' (A + j) = x[j]!) ∧
    (∀ a, (a < A ∨ A + i ≤ a) → vm S m' a = vm S m a) ∧ s ≤ 13 * i + 3
  rstep; rstep; rstep; rstep; rstep; rstep; rstep
  rename_i m₁ g₁ f₁ v₁ m₂ g₂ f₂ v₂ m₃ g₃ f₃ v₃
  refine Runs.mono (Q := fun m' k => ListRegs S n A m' ∧ (∀ j < n, vm S m' (A + j) = x[j]!) ∧
      (∀ a, (a < A ∨ A + n ≤ a) → vm S m' a = vm S m a) ∧ k ≤ 13 * n + 4)
    (Runs.loop P (fun m' => n - m' 11) (by omega) (by omega) ?_ ?_ ?_) ?_
  · rintro m' s ⟨i, hi, ⟨⟨r1, r3, r5⟩, r4, r8, r9, r10, r16⟩, h11, h12, h15, hdone, hfr, hs⟩ heq
    have hlt : i < n := by by_contra h; simp [h15, r3, h] at heq
    rstep
    refine Runs.vread (S := S) (d := 14) (va := 12) ⟨r1, r3, r5⟩ (by omega) (by omega) (by omega)
      (by omega) hKS (by omega) (by rw [h12]; omega) ?_
    intro m₄ k₄ hk₄ hR₄ hv₄ hvm₄ hfr₄
    have hval : m₄ 14 = x[i]! := by
      rw [hv₄, h12, hfr _ (.inl (by omega)), hx i hlt]
    rstep; rstep; rstep
    refine Runs.storeR (p := 13) (s := 14) (by omega) (by omega) ?_
    intro m₆ hst hfst
    rename_i m₅ g₅ f₅ v₅
    have ha : m₅ 13 = A + i := by rsd
    rw [ha] at hst hfst
    rstep; rstep; rstep; rstep; rstep; rstep; rstep
    rename_i m₇ g₇ f₇ v₇ m₈ g₈ f₈ v₈ m₉ g₉ f₉ v₉ m₁₀ g₁₀ f₁₀ v₁₀
    have hvm₆ : vm S m₆ = update (vm S m₅) (A + i) (x[i]!) := by
      rw [vm_of_store (by omega) (.inr (by omega)) (by rw [hst, f₅ 14 (by decide), hval]) hfst]
    refine ⟨⟨i + 1, by omega, ⟨⟨by rsd, by rsd, by rsd⟩, by rsd, by rsd, by rsd, by rsd, by rsd⟩,
      by rsd, by rsd, by rsd, fun j hj => ?_, fun a ha' => ?_, by omega⟩, by rsd⟩
    · rw [v₁₀, v₉, v₈, v₇, hvm₆, v₅, hvm₄, update_apply]
      split_ifs with h
      · obtain rfl : j = i := by omega
        rfl
      · exact hdone j (by omega)
    · rw [v₁₀, v₉, v₈, v₇, hvm₆, v₅, hvm₄, update_apply, if_neg (by omega)]
      exact hfr a (by omega)
  · rintro m' s ⟨i, hi, hR', h11, h12, h15, hdone, hfr, hs⟩ hne
    have hin : i = n := by
      by_contra h
      exact hne (by rw [h15, hR'.1.2.1, if_pos (by omega)])
    subst hin
    exact ⟨hR', hdone, hfr, by omega⟩
  · refine ⟨0, by omega, ⟨⟨by rsd, by rsd, by rsd⟩, by rsd, by rsd, by rsd, by rsd, by rsd⟩, by rsd,
      by rsd, by rsd, fun j hj => by omega, fun a _ => by rw [v₃, v₂, v₁], by omega⟩
  · rintro m' k ⟨⟨⟨r1, r3, r5⟩, r4, r8, r9, r10, r16⟩, hd, hfr, hk⟩
    rstep
    rename_i m₄ g₄ f₄ v₄
    refine ⟨⟨⟨by rsd, by rsd, by rsd⟩, by rsd, by rsd, by rsd, by rsd, by rsd⟩,
      fun j hj => by rw [v₄]; exact hd j hj, fun a ha => by rw [v₄]; exact hfr a ha, by omega⟩

/-- `vm[va] := A[i]`, `va += 1`, `i += 1`. -/
def emitBodyI : Cmd := seqs [add 13 9 11, load 14 13, vwrite 12 14, add 12 12 3, add 11 11 3,
  less 15 11 4]

/-- Write `n` at `n + 1`, then `A[0, n)`. -/
def emitLoopI : Cmd := seqs [add 12 4 3, vwrite 12 4, add 12 12 3, const 11 0, less 15 11 4,
  loop 15 3 emitBodyI]

set_option maxHeartbeats 1000000 in
-- The loop proof unfolds many memory updates at once.
theorem exec_emitLoopI {B S n A : ℕ} {m : Mem} {ys : List ℕ} (hn : ys.length = n)
    (hR : ListRegs S n A m) (hKS : nK ≤ S) (hA : A = S + nK) (hB : A + n + nK < B)
    (hys : ∀ j < n, vm S m (A + j) = ys[j]!) (hyB : ∀ j < n, ys[j]! < B) (hNS : 2 * n + 2 ≤ S) :
    Runs B emitLoopI m fun m' k => ListRegs S n A m' ∧
      (∀ i ≤ n, vm S m' (n + 1 + i) = (n :: ys).getD i 0) ∧
      (∀ a, (a < n + 1 ∨ 2 * n + 2 ≤ a) → vm S m' a = vm S m a) ∧ k ≤ 20 * n + 20 := by
  obtain ⟨⟨h1, h3, h5⟩, h4, h8, h9, h10, h16⟩ := id hR
  let P : Mem → ℕ → Prop := fun m' s => ∃ i ≤ n, ListRegs S n A m' ∧
    m' 11 = i ∧ m' 12 = n + 2 + i ∧ m' 15 = (if i < n then 1 else 0) ∧
    (∀ j ≤ i, vm S m' (n + 1 + j) = (n :: ys).getD j 0) ∧
    (∀ a, (a < n + 1 ∨ n + 2 + i ≤ a) → vm S m' a = vm S m a) ∧ s ≤ 17 * i
  rstep; rstep
  rename_i m₁ g₁ f₁ v₁
  have hm₁12 : m₁ 12 = n + 1 := by rsd
  have hS32 : S + nK < B := by omega
  rstep
  refine Runs.vwrite (S := S) (va := 12) (src := 4) (m := m₁) ⟨by rsd, by rsd, by rsd⟩ (by omega)
    (by omega) (by omega) (by omega) hKS hS32 (.inl (by rw [hm₁12]; omega)) ?_
  intro m₂ k₂ hk₂ hR₂ hvm₂ hfr₂
  rstep; rstep; rstep; rstep; rstep; rstep; rstep
  rename_i m₃ g₃ f₃ v₃ m₄ g₄ f₄ v₄ m₅ g₅ f₅ v₅
  refine Runs.mono (Q := fun m' k => ListRegs S n A m' ∧
      (∀ i ≤ n, vm S m' (n + 1 + i) = (n :: ys).getD i 0) ∧
      (∀ a, (a < n + 1 ∨ 2 * n + 2 ≤ a) → vm S m' a = vm S m a) ∧ k ≤ 17 * n + 1)
    (Runs.loop P (fun m' => n - m' 11) (by omega) (by omega) ?_ ?_ ?_) ?_
  · rintro m' s ⟨i, hi, ⟨⟨r1, r3, r5⟩, r4, r8, r9, r10, r16⟩, h11, h12, h15, hdone, hfr, hs⟩
      heq
    have hlt : i < n := by by_contra h; simp [h15, r3, h] at heq
    have hval : m' (A + i) = ys[i]! := by
      rw [← hys i hlt, ← hfr _ (.inr (by omega)), vm_high hKS (by omega)]
    rstep; rstep; rstep; rstep
    rename_i m₆ g₆ f₆ v₆ m₇ g₇ f₇ v₇
    have hv7 : m₇ 14 = ys[i]! := by
      rw [g₇, g₆, r9, h11, f₆ _ (by omega), hval]
    have a7 : m₇ 12 = n + 2 + i := by rsd
    rstep
    refine Runs.vwrite (S := S) (va := 12) (src := 14) (m := m₇) ⟨by rsd, by rsd, by rsd⟩
      (by omega) (by omega) (by omega) (by omega) hKS (by omega) (.inl (by rw [a7]; omega)) ?_
    intro m₈ k₈ hk₈ hR₈ hvm₈ hfr₈
    rstep; rstep; rstep; rstep; rstep; rstep; rstep
    rename_i m₉ g₉ f₉ v₉ m₁₀ g₁₀ f₁₀ v₁₀ m₁₁ g₁₁ f₁₁ v₁₁ m₁₂ g₁₂ f₁₂ v₁₂
    have hv : ∀ a, vm S m₁₂ a = update (vm S m') (n + 2 + i) (ys[i]!) a := by
      intro a; rw [v₁₂, v₁₁, v₁₀, v₉, hvm₈, a7, hv7, v₇, v₆]
    refine ⟨⟨i + 1, by omega, ⟨⟨by rsd, by rsd, by rsd⟩, by rsd, by rsd, by rsd, by rsd, by rsd⟩,
      by rsd, by rsd, by rsd, fun j hj => ?_, fun a ha => ?_, by omega⟩, by rsd⟩
    · rw [hv, update_apply]
      split_ifs with e
      · obtain rfl : j = i + 1 := by omega
        simp [List.getD_eq_getElem?_getD, hn, hlt]
      · exact hdone j (by omega)
    · rw [hv, update_apply, if_neg (by omega)]
      exact hfr a (by omega)
  · rintro m' s ⟨i, hi, hR', h11, h12, h15, hdone, hfr, hs⟩ hne
    have hin : i = n := by
      by_contra h
      exact hne (by rw [h15, hR'.1.2.1, if_pos (by omega)])
    subst hin
    exact ⟨hR', hdone, fun a ha => hfr a (by omega), by omega⟩
  · refine ⟨0, by omega, ⟨⟨by rsd, by rsd, by rsd⟩, by rsd, by rsd, by rsd, by rsd, by rsd⟩, by rsd,
      by rsd, by rsd, fun j hj => ?_, fun a ha => ?_, by omega⟩
    · obtain rfl : j = 0 := by omega
      rw [v₅, v₄, v₃, hvm₂, hm₁12, update_apply, if_pos (by omega)]
      simp [show m₁ 4 = n by rsd]
    · rw [v₅, v₄, v₃, hvm₂, hm₁12, update_apply, if_neg (by omega), v₁]
  · rintro m' k ⟨⟨⟨r1, r3, r5⟩, r4, r8, r9, r10, r16⟩, hd, hfr, hk⟩
    rstep
    rename_i m₉ g₉ f₉ v₉
    refine ⟨⟨⟨by rsd, by rsd, by rsd⟩, by rsd, by rsd, by rsd, by rsd, by rsd⟩,
      fun i hi => by rw [v₉]; exact hd i hi, fun a ha => by rw [v₉]; exact hfr a ha, by omega⟩

/-! ### The integer RAM program -/

/-- One step of recovering `n` from `2 n`: `n' += 1`, `2 n' += 2`. -/
def halfBody : Cmd := seqs [add 4 4 3, add 13 13 3, add 13 13 3, less 14 13 12]

/-- Set the fixed registers and recover `n` into `4` and `2 n` into `12`. -/
def halfI : Cmd := seqs [const 3 1, const 5 32, const 8 0, const 16 3, const 11 64, sub 12 1 11,
  const 4 0, const 13 0, less 14 13 12, loop 14 3 halfBody]

/-- Recover `n`, move `x₀` to cell `1`, sort, write the output, and keep `n` at `2 S + 4`. -/
def bodyI (core : Cmd) : Cmd := seq halfI (seqs [vread 14 12, vwrite 3 14, add 9 1 5, add 10 9 4,
  loadLoopI, core, emitLoopI, add 11 1 1, add 11 11 16, add 11 11 3, store 11 4])

/-- The registers after recovering `n`. -/
theorem half_runs {B S n : ℕ} {m : Mem} (h1 : m 1 = S) (hS : S = 2 * n + 64) (hB : S + 64 < B)
    (hKS : nK ≤ S) :
    Runs B halfI m fun m' k =>
      Regs S m' ∧ m' 4 = n ∧ m' 8 = 0 ∧ m' 12 = 2 * n ∧ m' 16 = 3 ∧ vm S m' = vm S m ∧
        k ≤ 7 * n + 20 := by
  unfold halfI
  rstep; rstep; rstep; rstep; rstep; rstep; rstep; rstep; rstep; rstep; rstep; rstep; rstep
  rstep; rstep; rstep; rstep; rstep; rstep
  rename_i m₁ g₁ f₁ v₁ m₂ g₂ f₂ v₂ m₃ g₃ f₃ v₃ m₄ g₄ f₄ v₄ m₅ g₅ f₅ v₅ m₆ g₆ f₆ v₆ m₇ g₇ f₇ v₇
    m₈ g₈ f₈ v₈ m₉ g₉ f₉ v₉
  have hvm₉ : vm S m₉ = vm S m := by rw [v₉, v₈, v₇, v₆, v₅, v₄, v₃, v₂, v₁]
  let P : Mem → ℕ → Prop := fun m' s => ∃ i ≤ n, Regs S m' ∧ m' 4 = i ∧ m' 8 = 0 ∧
    m' 12 = 2 * n ∧ m' 13 = 2 * i ∧ m' 16 = 3 ∧ m' 14 = (if 2 * i < 2 * n then 1 else 0) ∧
    vm S m' = vm S m ∧ s ≤ 7 * i
  refine Runs.mono (Q := fun m' k => Regs S m' ∧ m' 4 = n ∧ m' 8 = 0 ∧ m' 12 = 2 * n ∧
      m' 16 = 3 ∧ vm S m' = vm S m ∧ k ≤ 7 * n + 1)
    (Runs.loop P (fun m' => n - m' 4) (by omega) (by omega) ?_ ?_ ?_) ?_
  · rintro m' s ⟨i, hi, ⟨r1, r3, r5⟩, r4, r8, r12, r13, r16, r14, hv, hs⟩ heq
    have hlt : i < n := by by_contra h; simp [r14, r3, show ¬2 * i < 2 * n by omega] at heq
    rstep; rstep; rstep; rstep; rstep; rstep; rstep; rstep; rstep
    rename_i m₁ g₁ f₁ v₁ m₂ g₂ f₂ v₂ m₃ g₃ f₃ v₃ m₄ g₄ f₄ v₄ m₅ g₅ f₅ v₅
    refine ⟨⟨i + 1, by omega, ⟨by rsd, by rsd, by rsd⟩, by rsd, by rsd, by rsd, by rsd, by rsd,
      by rsd, by rw [v₅, v₄, v₃, v₂, v₁, hv], by omega⟩, by rsd⟩
  · rintro m' s ⟨i, hi, hR, r4, r8, r12, r13, r16, r14, hv, hs⟩ hne
    have hin : i = n := by
      by_contra h
      exact hne (by rw [r14, hR.2.1, if_pos (by omega)])
    subst hin
    exact ⟨hR, r4, r8, r12, r16, hv, by omega⟩
  · exact ⟨0, by omega, ⟨by rsd, by rsd, by rsd⟩, by rsd, by rsd, by rsd, by rsd, by rsd, by rsd,
      hvm₉, by omega⟩
  · rintro m' k ⟨⟨r1, r3, r5⟩, r4, r8, r12, r16, hv, hk⟩
    rstep
    rename_i m₁₀ g₁₀ f₁₀ v₁₀
    exact ⟨⟨by rsd, by rsd, by rsd⟩, by rsd, by rsd, by rsd, by rsd, by rw [v₁₀, hv], by omega⟩

theorem imem_succ (x : List ℕ) (j : ℕ) : imem x (j + 1) = x[j]! := by
  unfold imem; rw [List.getD_cons_succ]
  cases h : x[j]? <;> simp [List.getD_eq_getElem?_getD, getElem!_def, h]

theorem bodyI_runs {core : Cmd} {f : List ℕ → List ℕ} {t : ℕ → ℕ} (hcore : CoreSpec core f t)
    (hf : ∀ x, (f x).Perm x) {B : ℕ} (x : List ℕ) {m : Mem}
    (h1 : m 1 = 2 * x.length + 64) (hv : vm (2 * x.length + 64) m = bootView x)
    (hB : 4 * x.length + 200 < B) (hxB : ∀ v ∈ x, v < B) :
    Runs B (bodyI core) m fun m' k => m' 1 = 2 * x.length + 64 ∧
      m' (2 * (2 * x.length + 64) + 4) = x.length ∧
      (∀ i ≤ x.length, vm (2 * x.length + 64) m' (x.length + 1 + i) =
        (x.length :: f x).getD i 0) ∧ k ≤ t x.length + 40 * x.length + 70 := by
  set n := x.length with hn
  set S := 2 * n + 64 with hS
  have hKS : nK ≤ S := by omega
  unfold bodyI
  refine Runs.seq (Runs.mono (half_runs (n := n) h1 hS (by omega) hKS) ?_)
  rintro m₁ k₁ ⟨hR₁, h₁4, h₁8, h₁12, h₁16, hv₁, hk₁⟩
  obtain ⟨p1, p3, p5⟩ := id hR₁
  rstep
  refine Runs.vread (S := S) (d := 14) (va := 12) hR₁ (by omega) (by omega) (by omega)
    (by omega) hKS (by omega) (.inl (by rw [h₁12]; omega)) ?_
  intro m₂ k₂ hk₂ hR₂ hd₂ hvm₂ hfr₂
  rstep
  refine Runs.vwrite (S := S) (va := 3) (src := 14) hR₂ (by omega) (by omega) (by omega)
    (by omega) hKS (by omega) (.inl (by rw [hR₂.2.1]; omega)) ?_
  intro m₃ k₃ hk₃ hR₃ hvm₃ hfr₃
  obtain ⟨r1, r3, r5⟩ := hR₃
  have a4 : m₃ 4 = n := by rw [hfr₃ 4 (by omega) (by omega) (by omega), hfr₂ 4 (by omega)
    (by omega) (by omega), h₁4]
  have a8 : m₃ 8 = 0 := by rw [hfr₃ 8 (by omega) (by omega) (by omega), hfr₂ 8 (by omega)
    (by omega) (by omega), h₁8]
  have a16 : m₃ 16 = 3 := by rw [hfr₃ 16 (by omega) (by omega) (by omega), hfr₂ 16 (by omega)
    (by omega) (by omega), h₁16]
  have q1 : m₃ 1 = S := r1
  have q5 : m₃ 5 = 32 := r5
  rstep; rstep; rstep; rstep
  rename_i m₄ g₄ f₄ v₄ m₅ g₅ f₅ v₅
  have e₅ : ∀ a, a ≠ 9 → a ≠ 10 → m₅ a = m₃ a := fun a h9 h10 => by rw [f₅ a h10, f₄ a h9]
  have hLR : ListRegs S n (S + nK) m₅ :=
    ⟨⟨by rw [e₅ 1 (by omega) (by omega), r1], by rw [e₅ 3 (by omega) (by omega), r3],
      by rw [e₅ 5 (by omega) (by omega), r5]⟩, by rw [e₅ 4 (by omega) (by omega), a4],
      by rw [e₅ 8 (by omega) (by omega), a8], by rw [f₅ 9 (by omega), g₄, r1, r5],
      by rw [g₅, f₄ 4 (by omega), g₄, r1, r5, a4], by rw [e₅ 16 (by omega) (by omega), a16]⟩
  have hvm₅ : vm S m₅ = update (bootView x) 1 (bootView x (2 * n)) := by
    rw [v₅, v₄, hvm₃, hR₂.2.1, hd₂, hvm₂, hv₁, hv, h₁12]
  have hx : ∀ j < n, vm S m₅ (j + 1) = x[j]! := by
    intro j hj
    rw [hvm₅, update_apply]
    split_ifs with h
    · obtain rfl : j = 0 := by omega
      rw [bootView, if_neg (show ¬2 * n < 2 by omega), if_pos (show 2 * n = 2 * x.length by omega)]
      exact imem_succ x 0
    · rw [bootView, if_neg (show ¬j + 1 < 2 by omega),
        if_neg (show ¬j + 1 = 2 * x.length by omega)]
      exact imem_succ x j
  have hxB' : ∀ j < n, x[j]! < B := fun j hj => by
    rw [getElem!_eq_getElem (by omega)]; exact hxB _ (List.getElem_mem _)
  rstep
  refine Runs.mono (exec_loadLoopI (x := x) rfl hLR hKS rfl (by omega) hx hxB' (by omega)) ?_
  rintro m₆ k₆ ⟨hLR₆, hA₆, -, hk₆⟩
  rstep
  refine Runs.mono (hcore B S (S + nK) m₆ x hLR₆ hKS rfl (by omega) hxB hA₆) ?_
  rintro m₇ k₇ ⟨hLR₇, hA₇, -, hk₇⟩
  rw [← hn] at hk₇
  have hfl : (f x).length = n := (hf x).length_eq
  have hyB : ∀ j < n, (f x)[j]! < B := fun j hj => by
    rw [getElem!_eq_getElem (by omega)]
    exact hxB _ ((hf x).mem_iff.1 (List.getElem_mem _))
  rstep
  refine Runs.mono (exec_emitLoopI (ys := f x) hfl hLR₇ hKS rfl (by omega) hA₇ hyB (by omega)) ?_
  rintro m₈ k₈ ⟨⟨⟨r1, r3, r5⟩, r4, r8, r9, r10, r16⟩, hout₈, -, hk₈⟩
  rstep; rstep; rstep; rstep; rstep; rstep
  rename_i m₉ g₉ f₉ v₉ m₁₀ g₁₀ f₁₀ v₁₀ m₁₁ g₁₁ f₁₁ v₁₁
  have a11 : m₁₁ 11 = 2 * S + 4 := by rsd
  rstep
  refine Runs.storeR (p := 11) (s := 4) (by omega) (by omega) ?_
  intro m₁₂ hst hfst
  rw [a11] at hst hfst
  have hvm₁₂ : vm S m₁₂ = update (vm S m₈) (2 * S + 4) n := by
    have h4 : m₁₂ (2 * S + 4) = n := by
      rw [hst, f₁₁ 4 (by omega), f₁₀ 4 (by omega), f₉ 4 (by omega), r4]
    rw [vm_of_store (by omega) (.inr (by omega)) h4 hfst, v₁₁, v₁₀, v₉]
  rstep
  rename_i m₁₃ g₁₃ f₁₃ v₁₃
  have b1 : m₁₃ 1 = S := by
    rw [f₁₃ 1 (by omega), hfst 1 (by omega), f₁₁ 1 (by omega), f₁₀ 1 (by omega),
      f₉ 1 (by omega), r1]
  have b2 : m₁₃ (2 * S + 4) = n := by
    rw [f₁₃ (2 * S + 4) (by omega), hst, f₁₁ 4 (by omega), f₁₀ 4 (by omega), f₉ 4 (by omega), r4]
  refine ⟨b1, b2, fun i hi => ?_, by omega⟩
  rw [v₁₃, hvm₁₂, update_apply, if_neg (by omega)]
  exact hout₈ i hi

/-! ### Restoring the low cells -/

/-- Restore the cells `js` from `S + j`, with `S` in cell `0` and cell `2` as scratch; then
`M[2] := 2`. -/
def restores : List ℕ → Cmd
  | [] => const 2 2
  | j :: js => seq (seq (const 2 j) (seq (add 2 0 2) (load j 2))) (restores js)

theorem exec_restores {B S : ℕ} : ∀ (js : List ℕ) {m : Mem}, js.Nodup → m 0 = S →
    (∀ j ∈ js, j ≠ 0 ∧ j ≠ 2 ∧ j < 32) → 32 ≤ S → S + 32 < B →
    ∃ m', Exec B (restores js) m (3 * js.length + 1) m' ∧ m' 0 = S ∧ m' 2 = 2 ∧
      (∀ j ∈ js, m' j = m (S + j)) ∧ ∀ a, a ≠ 2 → a ∉ js → m' a = m a
  | [], m, _, h0, _, hS, hB => ⟨_, .const (by omega) (by omega), by simp [h0],
      by simp, by simp, fun a ha _ => by simp [ha]⟩
  | j :: js, m, hnd, h0, hjs, hS, hB => by
    obtain ⟨hj0, hj2, hj32⟩ := hjs j (by simp)
    have e₁ : Exec B (seq (const 2 j) (seq (add 2 0 2) (load j 2))) m 3
        (update (update (update m 2 j) 2 (S + j)) j (m (S + j))) := by
      have := Exec.seq (.const (B := B) (m := m) (d := 2) (v := j) (by omega) (by omega))
        (.seq (.add (B := B) (d := 2) (l := 0) (r := 2) (by omega) (by omega) (by omega)
          (by simp [h0, show (0 : ℕ) ≠ 2 by omega]; omega))
          (.load (B := B) (d := j) (p := 2) (by omega) (by omega)))
      simpa [update_apply, h0, show (0 : ℕ) ≠ 2 by omega, show S + j ≠ 2 by omega] using this
    set m₁ := update (update (update m 2 j) 2 (S + j)) j (m (S + j)) with hm₁
    have h₁0 : m₁ 0 = S := by simp [hm₁, update_apply, h0]; omega
    obtain ⟨hjn, hnd'⟩ := List.nodup_cons.1 hnd
    obtain ⟨m₂, e₂, h₂0, h₂2, h₂js, h₂rest⟩ := exec_restores js hnd' h₁0
      (fun j' hj' => hjs j' (by simp [hj'])) hS hB
    refine ⟨m₂, ?_, h₂0, h₂2, fun j' hj' => ?_, fun a ha hne => ?_⟩
    · have := Exec.seq e₁ e₂
      simpa [restores, show 3 + (3 * js.length + 1) = 3 * (js.length + 1) + 1 by omega]
        using this
    · rcases List.mem_cons.1 hj' with rfl | hj'
      · rw [h₂rest _ (by omega) hjn]; simp [hm₁]
      · have := hjs j' (by simp [hj'])
        rw [h₂js j' hj', hm₁, update_of_ne (by omega), update_of_ne (by omega),
          update_of_ne (by omega)]
    · rw [h₂rest a ha (fun h => hne (by simp [h])), hm₁, update_of_ne (fun h => hne (by simp [h])),
        update_of_ne ha, update_of_ne ha]

/-- Restore the low cells, then put `n` (kept at `2 S + 4`) back in cell `0`. -/
def finaleI : Cmd := seq (copy 0 1) (seq (restores (1 :: List.range' 3 29))
  (seq (add 0 0 2) (seq (load 2 0) (seq (add 0 0 0) (load 0 0)))))

theorem finale_runs {B S n : ℕ} {m : Mem} (h1 : m 1 = S) (hn : m (2 * S + 4) = n) (hS : 32 ≤ S)
    (hB : 2 * S + 8 < B) :
    Runs B finaleI m fun m' k => k = 96 ∧ m' 0 = n ∧
      (∀ a, 1 ≤ a → a < 32 → m' a = m (S + a)) ∧ ∀ a, 32 ≤ a → m' a = m a := by
  unfold finaleI
  refine Runs.seq (Runs.copyR (by omega) (by omega) fun m₁ g₁ f₁ => ?_)
  rw [h1] at g₁
  refine Runs.seq ?_
  obtain ⟨m₂, e₂, h₂0, h₂2, h₂js, h₂rest⟩ := exec_restores (B := B) (S := S)
    (1 :: List.range' 3 29) (m := m₁) (by decide) g₁ (fun j hj => by simp at hj; omega)
    hS (by omega)
  refine ⟨m₂, _, e₂, ?_⟩
  have hlo : ∀ a, 32 ≤ a → m₂ a = m a := fun a ha => by
    rw [h₂rest a (by omega) (by simp; omega), f₁ a (by omega)]
  refine Runs.seq (Runs.addR (by omega) (by omega) (by omega) (by rw [h₂0, h₂2]; omega)
    fun m₃ g₃ f₃ => ?_)
  rw [h₂0, h₂2] at g₃
  refine Runs.seq (Runs.loadR (by omega) (by omega) fun m₄ g₄ f₄ => ?_)
  rw [g₃, f₃ _ (by omega), hlo _ (by omega)] at g₄
  have h₄0 : m₄ 0 = S + 2 := by rw [f₄ 0 (by omega), g₃]
  refine Runs.seq (Runs.addR (by omega) (by omega) (by omega) (by rw [h₄0]; omega)
    fun m₅ g₅ f₅ => ?_)
  rw [h₄0] at g₅
  refine Runs.loadR (by omega) (by omega) fun m₆ g₆ f₆ => ?_
  refine ⟨by simp [List.length_range'], ?_, fun a ha1 ha32 => ?_, fun a ha => ?_⟩
  · rw [g₆, g₅, f₅ _ (by omega), f₄ _ (by omega), f₃ _ (by omega), hlo _ (by omega),
      show S + 2 + (S + 2) = 2 * S + 4 by omega, hn]
  · rw [f₆ a (by omega), f₅ a (by omega)]
    by_cases ha2 : a = 2
    · subst ha2; exact g₄
    · rw [f₄ a (Ne.symm (Ne.symm ha2)), f₃ a (by omega), h₂js a (by simp; omega),
        f₁ _ (by omega)]
  · rw [f₆ a (by omega), f₅ a (by omega), f₄ a (by omega), f₃ a (by omega), hlo a ha]

/-! ### The whole program -/

/-- Free the low cells, run the body, and restore them. -/
def progI (core : Cmd) : Cmd := seq bootI (seq (bodyI core) finaleI)

theorem getD_eq_getElem! (x : List ℕ) (i : ℕ) : x.getD i 0 = x[i]! := by
  cases h : x[i]? <;> simp [List.getD_eq_getElem?_getD, getElem!_def, h]

theorem le_sum_of_memN {x : List ℕ} {v : ℕ} (h : v ∈ x) : v ≤ x.sum := by
  induction x with
  | nil => simp at h
  | cons a l ih =>
    rw [List.sum_cons]
    rcases List.mem_cons.1 h with rfl | h
    · omega
    · have := ih h; omega

theorem progI_exec {core : Cmd} {f : List ℕ → List ℕ} {t : ℕ → ℕ} (hcore : CoreSpec core f t)
    (hf : ∀ x, (f x).Perm x) (x : List ℕ) :
    ∃ B m' k, Exec B (progI core) (imem x) k m' ∧ m' 0 = x.length ∧
      m' (x.length + 1) = x.length ∧ (∀ i < x.length, m' (x.length + 2 + i) = (f x)[i]!) ∧
      k ≤ t x.length + 40 * x.length + 261 := by
  set n := x.length with hn
  set S := 2 * n + 64 with hS
  set B := 4 * n + 300 + x.sum with hB
  have hxB : ∀ v ∈ x, v < B := fun v hv => by
    have := le_sum_of_memN hv; omega
  obtain ⟨m₁, k₁, e₁, hk₁, -, h₁1, h₁v⟩ := boot_runs (B := B) x (by omega)
  obtain ⟨m₂, k₂, e₂, h₂1, h₂n, h₂out, hk₂⟩ :=
    bodyI_runs hcore hf (B := B) x h₁1 (funext h₁v) (by omega) hxB
  obtain ⟨m₃, k₃, e₃, hk₃, h₃0, h₃lo, h₃hi⟩ :=
    finale_runs (B := B) (S := S) h₂1 h₂n (by omega) (by omega)
  rw [← hn] at hk₂
  have hview : ∀ a, 1 ≤ a → a < S → m₃ a = vm S m₂ a := by
    intro a ha1 haS
    unfold vm
    by_cases h32 : a < 32
    · rw [if_pos h32, h₃lo a ha1 h32]
    · rw [if_neg h32, if_neg (by omega), h₃hi a (by omega)]
  refine ⟨B, m₃, _, .seq e₁ (.seq e₂ e₃), h₃0, ?_, fun i hi => ?_, by omega⟩
  · rw [hview _ (by omega) (by omega), show n + 1 = n + 1 + 0 by rfl, h₂out 0 (by omega)]; rfl
  · rw [hview _ (by omega) (by omega), show n + 2 + i = n + 1 + (i + 1) by omega,
      h₂out (i + 1) (by omega), List.getD_cons_succ, getD_eq_getElem!]

end Formalgo.LLMUnchecked

namespace Formalgo.Algorithms.Sorting.MergeSort

open LLMUnchecked Cmd

/-- Merge sort on the integer RAM with `<`, `+` and `−`, in `O(n log n)` steps. -/
theorem integerRAM (spec : IOSpec (List ℕ) (List ℕ))
    (hspec : ∀ x y, y.Perm x → y.Pairwise (· ≤ ·) → spec.valid x y) :
    ∃ (c : ℕ) (PC : Type) (_ : Fintype PC) (program : Program PC IInstr Bool),
      let A : Algorithm PC IInstr Bool ℕ ℤ (List ℕ) (List ℕ) := ⟨program, .standard⟩
      Solves A IntegerRAM.withAddSub.semantics spec ∧
        ∀ l, HaltsWithin A IntegerRAM.withAddSub.semantics l
          (c * l.length * Nat.log 2 l.length + c) := by
  refine ⟨500, _, inferInstance, (iAlg (progI core)).program, ?_⟩
  intro A
  have key : ∀ x : List ℕ, Outputs (iAlg (progI core)) semI x (sortList x) ∧
      HaltsWithin (iAlg (progI core)) semI x (500 * x.length * Nat.log 2 x.length + 500) := by
    intro x
    obtain ⟨B, m', k, e, h0, hn1, hout, hk⟩ := progI_exec core_spec (fun x => passes_perm _ x) x
    obtain ⟨ho, hh⟩ := outputs_of_execI (progI core) x e
    have hfl : (sortList x).length = x.length := (passes_perm _ x).length_eq
    have hdec : ((List.range (m' (m' 0 + 1))).map fun i => m' (m' 0 + 2 + i)) = sortList x := by
      rw [h0, hn1]
      apply List.ext_getElem (by simp [hfl])
      intro i h1 h2
      simp only [List.length_map, List.length_range] at h1
      simp [hout i h1, getElem!_eq_getElem (x := sortList x) (j := i) (by omega)]
    rw [hdec] at ho
    exact ⟨ho, haltsWithin_monoI _ hh (by have := time_bound x.length; omega)⟩
  exact ⟨fun x => ⟨sortList x, (key x).1, hspec _ _ (sortList_valid x).1 (sortList_valid x).2⟩,
    fun x => (key x).2⟩

end Formalgo.Algorithms.Sorting.MergeSort
