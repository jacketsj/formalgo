-- Unchecked LLM code: generated by an LLM and not checked by a human.

import Formalgo.Core.RealRAM
import Formalgo.Algorithms.Sorting.LLMUnchecked.IntegerRAM

/-!
# Commands on the real RAM

Compiled commands run on a real RAM tape holding the memory as reals.
-/

namespace Formalgo.LLMUnchecked

open Function Cmd

/-- The real RAM operations used. -/
abbrev rops : List RealRAM.Operation := [.less, .add, .sub]

/-- An real RAM operation used. -/
abbrev ROp := {operation // operation ∈ rops}

/-- Real RAM instructions. -/
abbrev RInstr := RAM.Instruction ℕ ℝ (RAM.Arithmetic ℕ ROp)

/-- The real RAM operation for an operation. -/
def opR (o : Op) : ROp :=
  match o.val with
  | .add => ⟨.add, by simp⟩
  | .sub => ⟨.sub, by simp⟩
  | _ => ⟨.less, by simp⟩

/-- The real RAM arithmetic instruction for an arithmetic instruction. -/
def arithR : RAM.Arithmetic ℕ Op → RAM.Arithmetic ℕ ROp
  | .apply o d l r => .apply (opR o) d l r
  | .equal l r => .equal l r

/-- An instruction over natural numbers, on the real RAM. -/
def NInstr.toReal (i : NInstr) : RInstr := i.map id (fun v : ℕ => (v : ℝ)) arithR

/-- The program running `lines` on the real RAM. -/
def linesProgramR (lines : List Line) (h : 0 < lines.length) :
    Program (Fin lines.length) RInstr Bool where
  init := ⟨0, h⟩
  next pc outcome :=
    ⟨(if outcome then lines[pc].onTrue else lines[pc].onFalse) % lines.length, Nat.mod_lt _ h⟩
  instruction pc := lines[pc].instr.toReal

/-- The real RAM semantics. -/
noncomputable abbrev semR := RealRAM.withAddSub.semantics

/-- A memory of natural numbers agrees with an integer tape. -/
def RCorr (m : Mem) (T : Tape ℕ ℝ) : Prop := ∀ a, T.read a = (m a : ℝ)

theorem RCorr.write {m : Mem} {T : Tape ℕ ℝ} (hT : RCorr m T) (d v : ℕ) :
    RCorr (update m d v) (T.write d (v : ℝ)) := by
  intro a
  rw [Tape.read_write, update_apply]
  split_ifs <;> simp [hT a]

section Exec

variable {lines : List Line} {hlines : 0 < lines.length}

/-- One step on a line holding a non-halting instruction. -/
theorem run_lineR {T T' : Tape ℕ ℝ} {pc : Fin lines.length} {line : Line} {s : ℕ}
    (hpc : pc.val = s) (hline : lines[s]? = some line) {outcome : Bool}
    (hexec : semR.exec line.instr.toReal T = (some outcome, T')) {target : ℕ}
    (htarget : (if outcome then line.onTrue else line.onFalse) = target)
    (ht : target < lines.length) :
    (linesProgramR lines hlines).run semR 1 ⟨pc, T⟩ = .running ⟨⟨target, ht⟩, T'⟩ := by
  subst hpc
  have hl : lines[pc.val] = line := by
    rw [List.getElem?_eq_getElem pc.isLt] at hline; exact Option.some.inj hline
  simp only [Program.run, Program.step, linesProgramR, Fin.getElem_fin, hl, hexec]
  simp only [htarget, Nat.mod_eq_of_lt ht]

theorem run_primR {T T' : Tape ℕ ℝ} {pc : Fin lines.length} {s : ℕ} {i : NInstr}
    (hpc : pc.val = s) (hline : lines[s]? = some ⟨i, s + 1, s + 1⟩)
    (hexec : semR.exec i.toReal T = (some true, T')) (ht : s + 1 < lines.length) :
    (linesProgramR lines hlines).run semR 1 ⟨pc, T⟩ = .running ⟨⟨s + 1, ht⟩, T'⟩ :=
  run_lineR hpc hline hexec (by simp) ht

theorem exec_equalR {T : Tape ℕ ℝ} {m : Mem} (hT : RCorr m T) (l r : ℕ) :
    semR.exec (Line.instr ⟨.extension (.equal l r), 0, 0⟩).toReal T =
      (some (decide (m l = m r)), T) := by
  simp [NInstr.toReal, RAM.Instruction.map, arithR, RAM.semantics, RealRAM.withAddSub,
    realRAM, RAM.arithmetic, hT l, hT r]

/-- A compiled command follows `Exec` on the real RAM. -/
theorem Exec.runR {B : ℕ} {c : Cmd} {m : Mem} {k : ℕ} {m' : Mem} (hE : Exec B c m k m') :
    ∀ {s : ℕ} (_hat : At lines s (c.compile s)) (hlen : s + c.size < lines.length)
      {T : Tape ℕ ℝ} (_hT : RCorr m T) {pc : Fin lines.length} (_hpc : pc.val = s),
      ∃ T', (linesProgramR lines hlines).run semR k ⟨pc, T⟩ =
        .running ⟨⟨s + c.size, hlen⟩, T'⟩ ∧ RCorr m' T' := by
  induction hE with
  | @const m d v hd hv =>
    intro s hat hlen T hT pc hpc
    exact ⟨T.write d (v : ℝ), run_primR hpc (hat.cons).1
      (by simp [NInstr.toReal, RAM.Instruction.map, RAM.semantics]) hlen, hT.write d v⟩
  | @copy m d x hd hx =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write d (m x : ℝ), run_primR hpc (hat.cons).1
      (by simp [NInstr.toReal, RAM.Instruction.map, RAM.semantics, hT x]) hlen, hT.write d _⟩
  | @load m d p hd hp =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write d (m (m p) : ℝ), run_primR hpc (hat.cons).1
      (by simp [NInstr.toReal, RAM.Instruction.map, RAM.semantics, RealRAM.withAddSub,
        realRAM, hT p, hT (m p)]) hlen, hT.write d _⟩
  | @store m p x hp hx =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write (m p) (m x : ℝ), run_primR hpc (hat.cons).1
      (by simp [NInstr.toReal, RAM.Instruction.map, RAM.semantics, RealRAM.withAddSub,
        realRAM, hT p, hT x]) hlen, hT.write _ _⟩
  | @add m d l r hd hl hr hsum =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write d ((m l + m r : ℕ) : ℝ), run_primR hpc (hat.cons).1
      (by simp [NInstr.toReal, RAM.Instruction.map, arithR, opR, RAM.semantics,
        RealRAM.withAddSub, realRAM, RAM.arithmetic, Cmd.addOp, hT l, hT r]) hlen,
      hT.write d _⟩
  | @sub m d l r hd hl hr hle =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write d ((m l - m r : ℕ) : ℝ), run_primR hpc (hat.cons).1
      (by simp [NInstr.toReal, RAM.Instruction.map, arithR, opR, RAM.semantics,
        RealRAM.withAddSub, realRAM, RAM.arithmetic, Cmd.subOp, hT l, hT r,
        Nat.cast_sub hle]) hlen, hT.write d _⟩
  | @less m d l r hd hl hr =>
    intro s hat hlen T hT pc hpc
    refine ⟨T.write d ((if m l < m r then 1 else 0 : ℕ) : ℝ), run_primR hpc (hat.cons).1
      (by simp [NInstr.toReal, RAM.Instruction.map, arithR, opR, RAM.semantics,
        RealRAM.withAddSub, realRAM, RAM.arithmetic, Cmd.lessOp, hT l, hT r]) hlen,
      hT.write d _⟩
  | @seq a b m k₁ m₁ k₂ m₂ _ _ iha ihb =>
    intro s hat hlen T hT pc hpc
    obtain ⟨hata, hatb⟩ := At.append hat
    rw [Cmd.length_compile] at hatb
    simp only [Cmd.size] at hlen
    obtain ⟨T₁, h₁, hT₁⟩ := iha hata (by omega) hT hpc
    obtain ⟨T₂, h₂, hT₂⟩ := ihb hatb (by omega) hT₁ (pc := ⟨s + a.size, by omega⟩) rfl
    refine ⟨T₂, ?_, hT₂⟩
    rw [run_add_of_running h₁, h₂]
    simp [Cmd.size, Nat.add_assoc]
  | @iteTrue l r t e m k m' hl hr heq _ iht =>
    intro s hat hlen T hT pc hpc
    obtain ⟨htest, hrest⟩ := At.cons hat
    obtain ⟨hatt, hrest⟩ := At.append hrest
    obtain ⟨hjump, _⟩ := At.cons hrest
    rw [Cmd.length_compile] at hjump
    simp only [Cmd.size] at hlen
    have h0 := run_lineR (hlines := hlines) hpc htest (exec_equalR hT l r) (target := s + 1)
      (by simp [heq]) (by omega)
    obtain ⟨T₁, h₁, hT₁⟩ := iht hatt (by omega) hT (pc := ⟨s + 1, by omega⟩) rfl
    have h₂ := run_lineR (hlines := hlines) (pc := ⟨s + 1 + t.size, by omega⟩) rfl hjump
      (exec_equalR hT₁ 0 0) (target := s + (t.size + e.size + 2)) (by simp [Cmd.jump]; omega)
      (by omega)
    refine ⟨T₁, ?_, hT₁⟩
    rw [show k + 2 = 1 + (k + 1) by omega, run_add_of_running h0, run_add_of_running h₁, h₂]
    rfl
  | @iteFalse l r t e m k m' hl hr hne _ ihe =>
    intro s hat hlen T hT pc hpc
    obtain ⟨htest, hrest⟩ := At.cons hat
    obtain ⟨_, hrest⟩ := At.append hrest
    obtain ⟨_, hate⟩ := At.cons hrest
    rw [Cmd.length_compile, show s + 1 + t.size + 1 = s + t.size + 2 by omega] at hate
    simp only [Cmd.size] at hlen
    have h0 := run_lineR (hlines := hlines) hpc htest (exec_equalR hT l r)
      (target := s + t.size + 2) (by simp [hne]) (by omega)
    obtain ⟨T₁, h₁, hT₁⟩ := ihe hate (by omega) hT (pc := ⟨s + t.size + 2, by omega⟩) rfl
    refine ⟨T₁, ?_, hT₁⟩
    rw [show k + 1 = 1 + k by omega, run_add_of_running h0, h₁]
    simp [Cmd.size]; omega
  | @loopTrue l r body m k₁ m₁ k₂ m₂ hl hr heq _ _ ihb ihl =>
    intro s hat hlen T hT pc hpc
    have hat' := hat
    obtain ⟨htest, hrest⟩ := At.cons hat
    obtain ⟨hatb, hrest⟩ := At.append hrest
    obtain ⟨hjump, _⟩ := At.cons hrest
    rw [Cmd.length_compile] at hjump
    simp only [Cmd.size] at hlen
    have h0 := run_lineR (hlines := hlines) hpc htest (exec_equalR hT l r) (target := s + 1)
      (by simp [heq]) (by omega)
    obtain ⟨T₁, h₁, hT₁⟩ := ihb hatb (by omega) hT (pc := ⟨s + 1, by omega⟩) rfl
    have h₂ := run_lineR (hlines := hlines) (pc := ⟨s + 1 + body.size, by omega⟩) rfl hjump
      (exec_equalR hT₁ 0 0) (target := s) (by simp [Cmd.jump]) (by omega)
    obtain ⟨T₂, h₃, hT₂⟩ := ihl hat' (by simpa [Cmd.size] using hlen) hT₁ (pc := ⟨s, by omega⟩) rfl
    refine ⟨T₂, ?_, hT₂⟩
    rw [show k₁ + k₂ + 2 = 1 + (k₁ + (1 + k₂)) by omega, run_add_of_running h0,
      run_add_of_running h₁, run_add_of_running h₂, h₃]
  | @loopFalse l r body m hl hr hne =>
    intro s hat hlen T hT pc hpc
    obtain ⟨htest, _⟩ := At.cons hat
    exact ⟨T, run_lineR (hlines := hlines) hpc htest (exec_equalR hT l r)
      (by simp [hne, Cmd.size]; omega) hlen, hT⟩

end Exec

/-! ### The real RAM tape coding -/

theorem encode_listR (x : List ℕ) :
    (Code.encode x : List ℝ) = (x.length :: x).map fun v => (v : ℝ) := by
  change [((x.length : ℕ) : ℝ)] ++ x.flatMap (fun v => [((v : ℕ) : ℝ)]) = _
  simp

theorem read_foldr_zipIdxR (L : List ℝ) (k a : ℕ) :
    ((L.zipIdx k).foldr (fun (p : ℝ × ℕ) tape => tape.write (p.2 : ℕ) p.1)
      (⟨fun _ => default⟩ : Tape ℕ ℝ)).read a =
      if k ≤ a then L.getD (a - k) default else default := by
  induction L generalizing k with
  | nil => simp
  | cons v L ih =>
    simp only [List.zipIdx_cons, List.foldr_cons]
    rw [Tape.read_write, ih (k + 1)]
    by_cases ha : a = k
    · subst ha; simp
    · simp only [ha, if_false]
      by_cases hle : k + 1 ≤ a
      · rw [if_pos hle, if_pos (by omega), show a - k = (a - (k + 1)) + 1 by omega]
        simp
      · rw [if_neg hle, if_neg (by omega)]

theorem getD_map_castR : ∀ (L : List ℕ) (a : ℕ),
    (L.map fun v => (v : ℝ)).getD a default = ((L.getD a 0 : ℕ) : ℝ)
  | [], _ => by simp; rfl
  | _ :: _, 0 => rfl
  | _ :: L, a + 1 => getD_map_castR L a

theorem imem_corrR (x : List ℕ) :
    RCorr (imem x) ((TapeCoding.standard : TapeCoding (List ℕ) (List ℕ) ℕ ℝ).encode x) := by
  intro a
  have h := read_foldr_zipIdxR (Code.encode x : List ℝ) 0 a
  simp only [Nat.zero_le, if_true, Nat.sub_zero] at h
  have e : ((TapeCoding.standard : TapeCoding (List ℕ) (List ℕ) ℕ ℝ).encode x).read a =
      (Code.encode x : List ℝ).getD a default := by simpa [TapeCoding.standard] using h
  rw [e, encode_listR, imem]
  exact getD_map_castR _ a

theorem decodeMany_natR (k : ℕ) (s : ℕ → ℝ) :
    Code.decodeMany (α := ℕ) k s =
      ((List.range k).map fun i => ⌊s i⌋₊, fun i => s (i + k)) := by
  induction k generalizing s with
  | zero => simp [Code.decodeMany]
  | succ k ih =>
    simp only [Code.decodeMany]
    change ((⌊s 0⌋₊ :: (Code.decodeMany k fun i => s (i + 1)).1),
      (Code.decodeMany k fun i => s (i + 1)).2) = _
    rw [ih, List.range_succ_eq_map]
    simp only [List.map_cons, List.map_map]
    refine Prod.ext rfl (funext fun i => ?_)
    simp only; congr 1

theorem decode_listR (s : ℕ → ℝ) :
    Code.decode (α := List ℕ) s = ((List.range ⌊s 0⌋₊).map fun i => ⌊s (i + 1)⌋₊,
      fun i => s (i + 1 + ⌊s 0⌋₊)) := by
  change Code.decodeMany ⌊s 0⌋₊ (fun i => s (i + 1)) = _
  rw [decodeMany_natR]
  exact Prod.ext rfl (funext fun i => by simp only; congr 1; omega)

/-- The output on a final tape: the list after the input. -/
theorem decode_standardR {m : Mem} {T : Tape ℕ ℝ} (hT : RCorr m T) :
    (TapeCoding.standard : TapeCoding (List ℕ) (List ℕ) ℕ ℝ).decode T =
      (List.range (m (m 0 + 1))).map fun i => m (m 0 + 2 + i) := by
  change (Code.decode (α := List ℕ) (Code.decode (α := List ℕ) fun i : ℕ => T.read (i : ℕ)).2).1 = _
  rw [decode_listR, decode_listR]
  have hT' : ∀ a, T.read a = ((m a : ℕ) : ℝ) := hT
  simp only [hT', Nat.floor_natCast]
  rw [show 0 + 1 + m 0 = m 0 + 1 by omega]
  congr 1; funext i; congr 1; omega

/-! ### Real RAM algorithms from commands -/

/-- The real RAM algorithm running `c`, with the standard tape coding. -/
noncomputable def rAlg (c : Cmd) :
    Algorithm (Fin c.lines.length) RInstr Bool ℕ ℝ (List ℕ) (List ℕ) :=
  ⟨linesProgramR c.lines (by simp [Cmd.length_lines]), .standard⟩

theorem run_haltR {lines : List Line} {hl : 0 < lines.length} {pc : Fin lines.length}
    (hpc : lines[pc.val]? = some ⟨.halt, 0, 0⟩) (T : Tape ℕ ℝ) :
    (linesProgramR lines hl).run semR 1 ⟨pc, T⟩ = .halted ⟨pc, T⟩ := by
  have : lines[pc.val] = ⟨.halt, 0, 0⟩ := by
    rw [List.getElem?_eq_getElem pc.isLt] at hpc; exact Option.some.inj hpc
  simp [Program.run, Program.step, linesProgramR, this, NInstr.toReal, RAM.Instruction.map,
    RAM.semantics]

/-- A command run from the input memory halts one step later, with the list after the input. -/
theorem outputs_of_execR (c : Cmd) (x : List ℕ) {B k : ℕ} {m' : Mem}
    (hE : Exec B c (imem x) k m') :
    Outputs (rAlg c) semR x ((List.range (m' (m' 0 + 1))).map fun i => m' (m' 0 + 2 + i)) ∧
      HaltsWithin (rAlg c) semR x (k + 1) := by
  have hlpos : 0 < c.lines.length := by simp [Cmd.length_lines]
  obtain ⟨T', hrun, hT'⟩ := Exec.runR (lines := c.lines) (hlines := hlpos) hE (s := 0)
    (fun i hi => by simp [Cmd.lines, List.getElem?_append_left (by rwa [Cmd.length_compile] at hi)])
    (by simp [Cmd.length_lines]) (imem_corrR x) (pc := ⟨0, hlpos⟩) rfl
  have hhalt := run_haltR (hl := hlpos) (pc := ⟨0 + c.size, by simp [Cmd.length_lines]⟩)
    (by simp [Cmd.lines, Cmd.length_compile]) T'
  have hstatus : (Runnable.run (rAlg c) semR).status x (k + 1) =
      .halted ⟨⟨0 + c.size, by simp [Cmd.length_lines]⟩, T'⟩ := by
    change (linesProgramR c.lines hlpos).run semR (k + 1)
      ⟨⟨0, hlpos⟩, (TapeCoding.standard : TapeCoding (List ℕ) (List ℕ) ℕ ℝ).encode x⟩ = _
    rw [run_add_of_running hrun, hhalt]
  exact ⟨⟨k + 1, _, hstatus, decode_standardR hT'⟩, ⟨_, hstatus⟩⟩

theorem haltsWithin_monoR (c : Cmd) {x : List ℕ} {a b : ℕ}
    (h : HaltsWithin (rAlg c) semR x a) (hab : a ≤ b) : HaltsWithin (rAlg c) semR x b := by
  obtain ⟨st, hst⟩ := h
  exact ⟨st, status_halted_mono hst hab⟩

end Formalgo.LLMUnchecked

namespace Formalgo.Algorithms.Sorting.MergeSort

open LLMUnchecked Cmd

/-- Merge sort on the real RAM with `<`, `+` and `−`, in `O(n log n)` steps. -/
theorem realRAM (spec : IOSpec (List ℕ) (List ℕ))
    (hspec : ∀ x y, y.Perm x → y.Pairwise (· ≤ ·) → spec.valid x y) :
    ∃ (c : ℕ) (PC : Type) (_ : Fintype PC) (program : Program PC RInstr Bool),
      let A : Algorithm PC RInstr Bool ℕ ℝ (List ℕ) (List ℕ) := ⟨program, .standard⟩
      Solves A RealRAM.withAddSub.semantics spec ∧
        ∀ l, HaltsWithin A RealRAM.withAddSub.semantics l
          (c * l.length * Nat.log 2 l.length + c) := by
  refine ⟨500, _, inferInstance, (rAlg (progI core)).program, ?_⟩
  intro A
  have key : ∀ x : List ℕ, Outputs (rAlg (progI core)) semR x (sortList x) ∧
      HaltsWithin (rAlg (progI core)) semR x (500 * x.length * Nat.log 2 x.length + 500) := by
    intro x
    obtain ⟨B, m', k, e, h0, hn1, hout, hk⟩ := progI_exec core_spec (fun x => passes_perm _ x) x
    obtain ⟨ho, hh⟩ := outputs_of_execR (progI core) x e
    have hfl : (sortList x).length = x.length := (passes_perm _ x).length_eq
    have hdec : ((List.range (m' (m' 0 + 1))).map fun i => m' (m' 0 + 2 + i)) = sortList x := by
      rw [h0, hn1]
      apply List.ext_getElem (by simp [hfl])
      intro i h1 h2
      simp only [List.length_map, List.length_range] at h1
      simp [hout i h1, getElem!_eq_getElem (x := sortList x) (j := i) (by omega)]
    rw [hdec] at ho
    exact ⟨ho, haltsWithin_monoR _ hh (by have := time_bound x.length; omega)⟩
  exact ⟨fun x => ⟨sortList x, (key x).1, hspec _ _ (sortList_valid x).1 (sortList_valid x).2⟩,
    fun x => (key x).2⟩

end Formalgo.Algorithms.Sorting.MergeSort
