/-- `r := min(r, n)`, through a comparison already in index cell `12`. -/
def minN (r : ℕ) : DCmd := .ite 12 3 .skip (Cmd.copy r 4)

/-- Merge the runs at `i`, then move to the next pair. -/
def pairBody : DCmd := .seqs [Cmd.add 22 21 20, Cmd.less 12 22 4, minN 22,
  Cmd.add 23 22 20, Cmd.less 12 23 4, minN 23,
  Cmd.add 24 18 21, Cmd.add 25 18 22, Cmd.copy 26 25, Cmd.add 27 18 23, Cmd.add 28 19 21,
  Cmd.add 29 19 23, Cmd.less 12 28 29, .loop 12 3 mergeBody, Cmd.copy 21 23, Cmd.less 11 21 4]

theorem minN_spec {s : DState} {r : ℕ} {Q : DState → ℕ → Prop} (h3 : s.m 3 = 1)
    (h12 : s.m 12 = if s.m r < s.m 4 then 1 else 0)
    (h : ∀ m' k, m' r = min (s.m r) (s.m 4) → (∀ a, a ≠ r → m' a = s.m a) → k ≤ 2 →
      Q ⟨m', s.d⟩ k) : DRuns (minN r) s Q := by
  refine DRuns.ite (fun hc => ?_) (fun hc => ?_)
  · have hlt := lt_of_cond h12 hc h3
    exact DRuns.skip (h s.m 2 (by omega) (fun _ _ => rfl) le_rfl)
  · have hlt := not_lt_of_cond h12 hc h3
    refine DRuns.icopy fun m' hd hf => h m' (1 + 1) ?_ hf (by omega)
    rw [hd]; omega

/-- The facts a pass needs about its start. -/
structure PairStart (L : List ℝ) (src dst w : ℕ) (s₀ : DState) : Prop where
  hw : 0 < w
  hdisj : dst + L.length ≤ src ∨ src + L.length ≤ dst
  h3 : s₀.m 3 = 1
  h4 : s₀.m 4 = L.length
  h18 : s₀.m 18 = src
  h19 : s₀.m 19 = dst
  h20 : s₀.m 20 = w
  hsrc : DArr s₀.d src L

/-- The index cells a pass may change: `11`–`15` and `21`–`29`. -/
def PairKeep (a : ℕ) : Prop := a < 11 ∨ 29 < a ∨ (16 ≤ a ∧ a ≤ 20)

/-- The pair loop invariant: the runs before `i` merged. -/
def PairInv (L : List ℝ) (dst w : ℕ) (s₀ s : DState) (c : ℕ) : Prop :=
  ∃ i ≤ L.length, (i = L.length ∨ ∃ j, i = j * (2 * w)) ∧ s.m 21 = i ∧
    s.m 11 = (if i < L.length then 1 else 0) ∧ (∀ a, PairKeep a → s.m a = s₀.m a) ∧
    (∀ j < i, s.d (dst + j) = (mergePass rle w L).getD j 0) ∧
    (∀ a, (a < dst ∨ dst + L.length ≤ a) → s.d a = s₀.d a) ∧ c ≤ 40 * i

/-- The merged runs at a multiple of `2 w`. -/
theorem merge_runs_eq' {w j : ℕ} (hw : 0 < w) (L : List ℝ) :
    ((L.drop (j * (2 * w))).take w).merge (((L.drop (j * (2 * w))).drop w).take w) rle =
      ((mergePass rle w L).drop (j * (2 * w))).take (2 * w) := by
  rw [drop_mergePass_mul hw, take_mergePass hw]

