/-- The pair loop: one pass with width `w`. -/
theorem pair_loop {L : List ℝ} {src dst w : ℕ} {s₀ : DState} (hS : PairStart L src dst w s₀)
    (h21 : s₀.m 21 = 0) (h11 : s₀.m 11 = if 0 < L.length then 1 else 0) :
    DRuns (.loop 11 3 pairBody) s₀ fun s k => DArr s.d dst (mergePass rle w L) ∧
      (∀ a, PairKeep a → s.m a = s₀.m a) ∧
      (∀ a, (a < dst ∨ dst + L.length ≤ a) → s.d a = s₀.d a) ∧ k ≤ 40 * L.length + 1 := by
  refine DRuns.loop (PairInv L dst w s₀) (fun s => L.length - s.m 21)
    (fun s c hinv heq => pair_step hS hinv heq) ?_ ?_
  · rintro s c ⟨i, hi, hij, h21', h11', hfr, hdst, hdfr, hc⟩ hne
    have h3 : s.m 3 = 1 := by rw [hfr 3 (by unfold PairKeep; omega), hS.h3]
    have hin : i = L.length := by
      by_contra h; exact hne (by rw [h11', h3, if_pos (by omega)])
    subst hin
    refine ⟨fun j hj => ?_, hfr, hdfr, by omega⟩
    rw [length_mergePass] at hj
    rw [hdst j hj, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem]; rfl
  · exact ⟨0, by omega, .inr ⟨0, by simp⟩, h21, h11, fun a _ => rfl, fun j hj => by omega,
      fun a _ => rfl, by omega⟩

