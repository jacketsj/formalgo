    (h7 : M 7 = ((n + 1 : ℕ) : ℝ)) (hsrc : ∀ t, 8 ≤ t → t ≤ n → M t = T t) :
    RRuns bootCopy M fun M' k => M' 0 = ((16 * n + 16 : ℕ) : ℝ) ∧ M' 7 = ((n + 1 : ℕ) : ℝ) ∧
      (∀ t, 8 ≤ t → t ≤ n → M' (16 * n + 16 + t) = T t) ∧
      (∀ a, 8 ≤ a → (a < 16 * n + 24 ∨ 17 * n + 17 ≤ a) → M' a = M a) ∧ k ≤ 7 * n + 4 := by
  unfold bootCopy
  rr; rr; rename_i M₁ g₁ f₁
  rr; rr; rename_i M₂ g₂ f₂
  rr; rr; rename_i M₃ g₃ f₃
  rr
  refine RRuns.mono (RRuns.loop (M := M₃) (Q := fun M' k =>
      (∀ t, 8 ≤ t → t ≤ n → M' (16 * n + 16 + t) = T t) ∧
      (∀ a, a ≠ 1 → a ≠ 3 → a ≠ 5 → a ≠ 6 → (a < 16 * n + 24 ∨ 17 * n + 17 ≤ a) →
        M' a = M₃ a) ∧ k ≤ 7 * n + 1)
    (fun M' k => ∃ i, 8 ≤ i ∧ (i ≤ n + 1 ∨ i = 8) ∧ M' 3 = (i : ℝ) ∧
      M' 1 = ((16 * n + 16 + i : ℕ) : ℝ) ∧ M' 6 = (if i < n + 1 then 1 else 0) ∧
      (∀ t, 8 ≤ t → t < i → M' (16 * n + 16 + t) = T t) ∧
      (∀ a, a ≠ 1 → a ≠ 3 → a ≠ 5 → a ≠ 6 → (a < 16 * n + 24 ∨ 16 * n + 16 + i ≤ a) →
        M' a = M₃ a) ∧ k ≤ 7 * (i - 8)) (fun M' => n + 1 - ⌊M' 3⌋₊) ?_ ?_
    ⟨8, le_rfl, by omega, ?_, ?_, ?_, fun t h1 h2 => by omega, fun _ _ _ _ _ _ => rfl, by omega⟩)
    ?_
  · rintro M' k ⟨i, hi8, hin, h3, h1, h6, hcp, hfr, hk⟩ heq
    have e4 : M' 4 = 1 := by
      rw [hfr 4 (by omega) (by omega) (by omega) (by omega) (by omega), f₃ 4 (by omega),
        f₂ 4 (by omega), f₁ 4 (by omega), h4]
    have e7 : M' 7 = ((n + 1 : ℕ) : ℝ) := by
      rw [hfr 7 (by omega) (by omega) (by omega) (by omega) (by omega), f₃ 7 (by omega),
        f₂ 7 (by omega), f₁ 7 (by omega), h7]
