theorem bootMain_runs {M T : RMem} {n : ℕ} (hn : 1 ≤ n) (h0 : M 0 = ((16 * n : ℕ) : ℝ))
    (h16 : M (16 * n) = T 1) (hfr : ∀ a, 2 ≤ a → a ≠ 16 * n → M a = T a)
    (hz : ∀ a, n < a → T a = 0) :
    RRuns bootMain M fun M' k => M' 0 = ((n + 1 : ℕ) : ℝ) ∧ M' 1 = ((16 * n + 16 : ℕ) : ℝ) ∧
      M' (16 * n + 16) = n ∧ (∀ j, 1 ≤ j → j ≤ n → M' (16 * n + 16 + j) = T j) ∧
      (∀ a, 17 * n + 17 ≤ a → M' a = 0) ∧ k ≤ 11 * n + 40 := by
  unfold bootMain
  rr
  refine RRuns.mono (bootSave_runs hn h0 h16 hfr) fun M₁ k₁ ⟨p0, psav, pfr, pk⟩ => ?_
  rr
  refine RRuns.mono (bootCount_runs p0) fun M₂ k₂ ⟨q0, q4, q7, qS, qfr, qk⟩ => ?_
  rr
  refine RRuns.mono (bootCopy_runs (T := T) q0 q4 q7 fun t h8 ht => by
    rw [qfr t h8 (by omega), pfr t h8 (by omega) (by omega)])
    fun M₃ k₃ ⟨r0, r7, rcp, rfr, rk⟩ => ?_
  rr; rr; rename_i M₄ g₄ f₄
  rr; rr; rename_i M₅ g₅ f₅
  rr
  have fr : ∀ a, 2 ≤ a → M₅ a = M₃ a := fun a ha => by rw [f₅ a (by omega), f₄ a (by omega)]
  refine ⟨by rw [g₅, f₄ 7 (by omega), r7], by rw [f₅ 1 (by omega), g₄, r0], ?_,
    fun j hj1 hjn => ?_, fun a ha => ?_, by omega⟩
  · rw [fr _ (by omega), rfr _ (by omega) (by omega), qS]
  · rw [fr _ (by omega)]
    by_cases hj8 : 8 ≤ j
    · exact rcp j hj8 hjn
    · rw [rfr _ (by omega) (by omega), qfr _ (by omega) (by omega), psav j hj1 (by omega)]
  · rw [fr _ (by omega), rfr _ (by omega) (by omega), qfr _ (by omega) (by omega)]
    by_cases haS : a < 16 * n + 24
    · rw [show a = 16 * n + 16 + (a - (16 * n + 16)) by omega, psav _ (by omega) (by omega),
        hz _ (by omega)]
    · rw [pfr a (by omega) (by omega) (by omega), hz a (by omega)]

/-- The boot runs on the code `[n, x₀, …, x_{n-1}]` of a list of reals. -/
theorem bootList_runs (x : List ℝ) :
    RRuns bootList (fun i => ((x.length : ℝ) :: x).getD i 0) fun M k => ∃ D : ℕ,
      M 0 = ((x.length + 1 : ℕ) : ℝ) ∧ M 1 = D ∧ x.length + 10 ≤ D ∧ D ≤ 16 * x.length + 16 ∧
      (∀ i, i < x.length + 1 → M (D + i) = ((x.length : ℝ) :: x).getD i 0) ∧
      (∀ a, D + (x.length + 1) ≤ a → M a = 0) ∧ k ≤ 11 * x.length + 50 := by
  generalize hT : (fun i => ((x.length : ℝ) :: x).getD i 0) = T
  have hT0 : T 0 = x.length := by rw [← hT]; simp
  have hz : ∀ a, x.length < a → T a = 0 := fun a ha => by
    rw [← hT]; simp only [List.getD_eq_getElem?_getD]
    rw [List.getElem?_eq_none (by simp; omega)]; rfl
  have hTL : ∀ i, T i = ((x.length : ℝ) :: x).getD i 0 := fun i => by rw [← hT]
  clear hT
  generalize x.length = n at hT0 hz hTL ⊢
  unfold bootList
  rr; rr; rename_i M₁ g₁ f₁
  rr; rr; rename_i M₂ g₂ f₂
  rr; rr; rename_i M₃ g₃ f₃
  rr; rr; rename_i M₄ g₄ f₄
  have e₄0 : M₄ 0 = ((16 * n : ℕ) : ℝ) := by
    rw [g₄, g₃, g₂, g₁, hT0]; push_cast; ring
  rr; refine RRuns.storeR (16 * n) e₄0 ?_
  intro M₅ g₅ f₅
  rr; rr; rename_i M₆ g₆ f₆
  have fr₄ : ∀ a, a ≠ 0 → M₄ a = T a := fun a ha => by
    rw [f₄ a ha, f₃ a ha, f₂ a ha, f₁ a ha]
  have e₅0 : M₅ 0 = ((16 * n : ℕ) : ℝ) := by
    by_cases hn : n = 0
    · subst hn
      rw [show (0 : ℕ) = 16 * 0 from rfl, g₅, fr₄ 1 (by omega), hz 1 (by omega)]; simp
    · rw [f₅ 0 (by omega), e₄0]
  rr
  refine RRuns.ite (fun hc => ?_) (fun hc => ?_)
  · have hn : n = 0 := by
      rw [f₆ 0 (by omega), e₅0, g₆] at hc
      have : 16 * n = 0 := by exact_mod_cast hc
      omega
    subst hn
    unfold bootEmpty
    rr; rr; rename_i M₇ g₇ f₇
    rr; rr; rename_i M₈ g₈ f₈
    rr; rr
    have fr : ∀ a, 2 ≤ a → M₈ a = T a := fun a ha => by
      rw [f₈ a (by omega), f₇ a (by omega), f₆ a (by omega), f₅ a (by omega), fr₄ a (by omega)]
    refine ⟨16, by rw [f₈ 0 (by omega), g₇]; norm_num, by rw [g₈]; norm_num, by omega, by omega,
      fun i hi => ?_, fun a ha => by rw [fr a (by omega), hz a (by omega)], by omega⟩
    rw [fr _ (by omega), hz _ (by omega), show i = 0 by omega]; simp
  · have hn : 1 ≤ n := by
      by_contra h
      apply hc
      rw [f₆ 0 (by omega), e₅0, g₆, show n = 0 by omega]; simp
    have h0 : M₆ 0 = ((16 * n : ℕ) : ℝ) := by rw [f₆ 0 (by omega), e₅0]
    have h16 : M₆ (16 * n) = T 1 := by
      rw [f₆ _ (by omega), g₅, fr₄ 1 (by omega)]
    have hfr : ∀ a, 2 ≤ a → a ≠ 16 * n → M₆ a = T a := fun a ha ha' => by
      rw [f₆ a (by omega), f₅ a ha', fr₄ a (by omega)]
    refine RRuns.mono (bootMain_runs hn h0 h16 hfr hz) fun M' k ⟨h0', h1', hS, hj, hzz, hk⟩ => ?_
    rr
    refine ⟨16 * n + 16, h0', h1', by omega, by omega, fun i hi => ?_, fun a ha => hzz a
      (by omega), by omega⟩
    rcases i with _ | j
    · rw [Nat.add_zero, hS]; simp
    · rw [hj _ (by omega) (by omega), hTL]

