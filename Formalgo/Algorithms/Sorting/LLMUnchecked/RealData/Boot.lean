    rr; refine RRuns.storeR (16 * n + 16 + i) (by rw [f₄ 1 (by omega), h1]) ?_
    intro M₅ g₅ f₅
    rr; rr; rename_i M₆ g₆ f₆
    rr; rr; rename_i M₇ g₇ f₇
    rr; rr; rename_i M₈ g₈ f₈
    rr
    have v3 : M₈ 3 = ((i + 1 : ℕ) : ℝ) := by
      rw [f₈ 3 (by omega), f₇ 3 (by omega), g₆, f₅ 3 (by omega), f₄ 3 (by omega), h3,
        f₅ 4 (by omega), f₄ 4 (by omega), e4]; push_cast; ring
    have v7 : M₇ 7 = ((n + 1 : ℕ) : ℝ) := by
      rw [f₇ 7 (by omega), f₆ 7 (by omega), f₅ 7 (by omega), f₄ 7 (by omega), e7]
    refine ⟨⟨i + 1, by omega, by omega, v3, ?_, ?_, fun t h8 ht => ?_,
      fun a h1' h3' h5' h6' ha => ?_, by omega⟩, ?_⟩
    · rw [f₈ 1 (by omega), g₇, f₆ 1 (by omega), f₅ 1 (by omega), f₄ 1 (by omega), h1,
        f₆ 4 (by omega), f₅ 4 (by omega), f₄ 4 (by omega), e4]; push_cast; ring
    · simp only [g₈, v7, show M₇ 3 = ((i + 1 : ℕ) : ℝ) by rw [← v3, f₈ 3 (by omega)], Nat.cast_lt]
    · rw [f₈ _ (by omega), f₇ _ (by omega), f₆ _ (by omega)]
