-- Unchecked LLM code: generated by an LLM and not checked by a human.

import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.Raw

/-!
# Booting on a list of reals

LLM-generated; not checked by a human.

The input code `[n, x₀, …, x_{n-1}]` of a list of reals fills the tape from cell `0`, so no cell
is free. The boot, on the raw real RAM:
1. doubles cell `0` four times (`16 n`) and saves cell `1` at `16 n`, freeing cell `1` (for
   `n = 0` the whole tape is zero, and the boot just writes `ℓ = 1` and `D = 16`);
2. with `S = 16 n + 16` in cell `0`, saves cells `2, …, 7` at `S + j` and moves cell `1`'s value
   from `16 n` to `S + 1`, freeing cells `1, …, 7`;
3. recovers `n` by counting (`16 k` up to `16 n`), and writes `n` at `S`;
4. copies cells `[8, n]` to `[S + 8, S + n]`.
Then the input code sits at `[S, S + ℓ)` (`ℓ = n + 1`) with zeros after it, and the boot ends
with `ℓ` in cell `0` and `D = S` in cell `1`.
-/

namespace Formalgo.Algorithms.Sorting.MergeSort.RealData

open Formalgo.Algorithms.ShortestPaths.LLMUnchecked Function

/-- `M[S + j] := M[j]`, with `S` in cell `0`. -/
noncomputable def save (j : ℕ) : RCmd := .seqs [.const 1 j, .add 1 0 1, .store 1 j]

/-- Save the cells `js`. -/
noncomputable def saves : List ℕ → RCmd
  | [] => .skip
  | j :: js => .seq (save j) (saves js)

/-- Free cells `1, …, 7`. -/
noncomputable def bootSave : RCmd := .seqs [.const 1 16, .add 0 0 1, saves [2, 3, 4, 5, 6, 7],
  .const 1 16, .sub 2 0 1, .load 3 2, .const 1 1, .add 1 0 1, .store 1 3]

/-- Recover `n` in cell `2`, and write it at `S`. -/
noncomputable def bootCount : RCmd := .seqs [.const 2 0, .const 3 0, .const 4 1, .const 5 16,
  .sub 6 0 5, .loopNe 3 6 (.seq (.add 2 2 4) (.add 3 3 5)), .add 7 2 4, .store 0 2]

/-- Copy cells `[8, n]` to `[S + 8, S + n]`. -/
noncomputable def bootCopy : RCmd := .seqs [.const 3 8, .add 1 0 3, .less 6 3 7,
  .loop 6 4 (.seqs [.load 5 3, .store 1 5, .add 3 3 4, .add 1 1 4, .less 6 3 7])]

/-- The boot for a nonempty list. -/
noncomputable def bootMain : RCmd := .seqs [bootSave, bootCount, bootCopy, .copy 1 0, .copy 0 7]

/-- The boot for the empty list. -/
noncomputable def bootEmpty : RCmd := .seqs [.const 0 1, .const 1 16]

/-- The boot for a list of reals. -/
noncomputable def bootList : RCmd := .seqs [.add 0 0 0, .add 0 0 0, .add 0 0 0, .add 0 0 0,
  .store 0 1, .const 1 0, .ite 0 1 bootEmpty bootMain]

theorem saves_runs : ∀ (js : List ℕ) {M : RMem} {S : ℕ}, js.Nodup → M 0 = S →
    (∀ j ∈ js, 2 ≤ j ∧ j < 8) → 16 ≤ S →
    RRuns (saves js) M fun M' k => M' 0 = S ∧ (∀ j ∈ js, M' (S + j) = M j) ∧
      (∀ a, a ≠ 1 → (∀ j ∈ js, a ≠ S + j) → M' a = M a) ∧ k = 3 * js.length
  | [], M, S, _, h0, _, _ => RRuns.skip ⟨h0, by simp, fun _ _ _ => rfl, rfl⟩
  | j :: js, M, S, hnd, h0, hjs, hS => by
    obtain ⟨hj2, hj8⟩ := hjs j (by simp)
    obtain ⟨hjn, hnd'⟩ := List.nodup_cons.1 hnd
    refine RRuns.seq ?_
    unfold save
    rr; rr; rename_i M₁ g₁ f₁
    rr; rr; rename_i M₂ g₂ f₂
    rr; refine RRuns.storeR (S + j) (by rw [g₂, f₁ 0 (by omega), h0, g₁]; push_cast; ring) ?_
    intro M₃ g₃ f₃
    rr
    have e0 : M₃ 0 = S := by rw [f₃ 0 (by omega), f₂ 0 (by omega), f₁ 0 (by omega), h0]
    refine RRuns.mono (saves_runs js hnd' e0 (fun j' h => hjs j' (by simp [h])) hS) ?_
    rintro M' k ⟨h0', hsv, hfr, hk⟩
    refine ⟨h0', fun j' hj' => ?_, fun a ha hne => ?_, ?_⟩
    · rcases List.mem_cons.1 hj' with rfl | hj'
      · rw [hfr _ (by omega) (fun j'' hj'' h => hjn (by
          have : j'' = j' := by omega
          exact this ▸ hj'')), g₃, f₂ _ (by omega), f₁ _ (by omega)]
      · rw [hsv j' hj', f₃ _ (by have := hjs j' (by simp [hj']); omega), f₂ _ (by
          have := hjs j' (by simp [hj']); omega), f₁ _ (by have := hjs j' (by simp [hj']); omega)]
    · rw [hfr a ha (fun j' hj' => hne j' (by simp [hj'])), f₃ a (hne j (by simp)), f₂ a ha,
        f₁ a ha]
    · simp only [List.length_cons]; omega

theorem bootSave_runs {M T : RMem} {n : ℕ} (hn : 1 ≤ n) (h0 : M 0 = ((16 * n : ℕ) : ℝ))
    (h16 : M (16 * n) = T 1) (hfr : ∀ a, 2 ≤ a → a ≠ 16 * n → M a = T a) :
    RRuns bootSave M fun M' k => M' 0 = ((16 * n + 16 : ℕ) : ℝ) ∧
      (∀ j, 1 ≤ j → j < 8 → M' (16 * n + 16 + j) = T j) ∧
      (∀ a, 8 ≤ a → a ≠ 16 * n → (a < 16 * n + 16 ∨ 16 * n + 24 ≤ a) → M' a = T a) ∧
      k = 26 := by
  unfold bootSave
  rr; rr; rename_i M₁ g₁ f₁
  rr; rr; rename_i M₂ g₂ f₂
  have e₂0 : M₂ 0 = ((16 * n + 16 : ℕ) : ℝ) := by rw [g₂, f₁ 0 (by omega), h0, g₁]; push_cast; ring
  rr
  refine RRuns.mono (saves_runs [2, 3, 4, 5, 6, 7] (by decide) e₂0
    (fun j hj => by simp at hj; omega) (by omega)) fun M₃ k₃ ⟨e₃0, hsv, hfr₃, hk₃⟩ => ?_
  rr; rr; rename_i M₄ g₄ f₄
  rr; rr; rename_i M₅ g₅ f₅
  rr; refine RRuns.loadR (16 * n) (by rw [g₅, f₄ 0 (by omega), e₃0, g₄]; push_cast; ring) ?_
  intro M₆ g₆ f₆
  rr; rr; rename_i M₇ g₇ f₇
  rr; rr; rename_i M₈ g₈ f₈
  rr; refine RRuns.storeR (16 * n + 16 + 1) (by
    rw [g₈, f₇ 0 (by omega), f₆ 0 (by omega), f₅ 0 (by omega), f₄ 0 (by omega), e₃0, g₇]
    push_cast; ring) ?_
  intro M₉ g₉ f₉
  rr
  have low : ∀ a, a ≠ 1 → M₉ (16 * n + 16 + a) = M₃ (16 * n + 16 + a) :=
    fun a h1 => by
      rw [f₉ _ (by omega), f₈ _ (by omega), f₇ _ (by omega), f₆ _ (by omega), f₅ _ (by omega),
        f₄ _ (by omega)]
  refine ⟨?_, fun j hj1 hj8 => ?_, fun a ha8 ha16 haS => ?_, by simp at hk₃; omega⟩
  · rw [f₉ 0 (by omega), f₈ 0 (by omega), f₇ 0 (by omega), f₆ 0 (by omega), f₅ 0 (by omega),
      f₄ 0 (by omega), e₃0]
  · by_cases hj : j = 1
    · subst hj
      rw [g₉, f₈ 3 (by omega), f₇ 3 (by omega), g₆, f₅ _ (by omega), f₄ _ (by omega),
        hfr₃ _ (by omega) (fun j hj => by simp at hj; omega), f₂ _ (by omega), f₁ _ (by omega),
        h16]
    · rw [low j hj, hsv j (by simp; omega), f₂ _ (by omega),
        f₁ _ (by omega), hfr _ (by omega) (by omega)]
  · rw [f₉ _ (by omega), f₈ _ (by omega), f₇ _ (by omega), f₆ _ (by omega), f₅ _ (by omega),
      f₄ _ (by omega), hfr₃ _ (by omega) (fun j hj => by simp at hj; omega), f₂ _ (by omega),
      f₁ _ (by omega), hfr _ (by omega) ha16]

theorem bootCount_runs {M : RMem} {n : ℕ} (h0 : M 0 = ((16 * n + 16 : ℕ) : ℝ)) :
    RRuns bootCount M fun M' k => M' 0 = ((16 * n + 16 : ℕ) : ℝ) ∧ M' 4 = 1 ∧
      M' 7 = ((n + 1 : ℕ) : ℝ) ∧ M' (16 * n + 16) = n ∧
      (∀ a, 8 ≤ a → a ≠ 16 * n + 16 → M' a = M a) ∧ k ≤ 4 * n + 8 := by
  unfold bootCount
  rr; rr; rename_i M₁ g₁ f₁
  rr; rr; rename_i M₂ g₂ f₂
  rr; rr; rename_i M₃ g₃ f₃
  rr; rr; rename_i M₄ g₄ f₄
  rr; rr; rename_i M₅ g₅ f₅
  have e6 : M₅ 6 = ((16 * n : ℕ) : ℝ) := by
    rw [g₅, f₄ 0 (by omega), f₃ 0 (by omega), f₂ 0 (by omega), f₁ 0 (by omega), h0, g₄]
    push_cast; ring
  have e4 : M₅ 4 = 1 := by rw [f₅ 4 (by omega), f₄ 4 (by omega), g₃]
  have e5 : M₅ 5 = 16 := by rw [f₅ 5 (by omega), g₄]
  have e2 : M₅ 2 = ((0 : ℕ) : ℝ) := by
    rw [f₅ 2 (by omega), f₄ 2 (by omega), f₃ 2 (by omega), f₂ 2 (by omega), g₁]; simp
  have e3 : M₅ 3 = ((16 * 0 : ℕ) : ℝ) := by
    rw [f₅ 3 (by omega), f₄ 3 (by omega), f₃ 3 (by omega), g₂]; simp
  rr
  refine RRuns.mono (RRuns.loopNe (M := M₅) (Q := fun M' k => M' 2 = n ∧
      (∀ a, a ≠ 2 → a ≠ 3 → M' a = M₅ a) ∧ k ≤ 4 * n + 1)
    (fun M' k => ∃ c ≤ n, M' 2 = c ∧ M' 3 = ((16 * c : ℕ) : ℝ) ∧
      (∀ a, a ≠ 2 → a ≠ 3 → M' a = M₅ a) ∧ k ≤ 4 * c) (fun M' => n - ⌊M' 2⌋₊) ?_ ?_
    ⟨0, by omega, e2, e3, fun _ _ _ => rfl, le_rfl⟩) ?_
  · rintro M' k ⟨c, hc, h2, h3, hfr, hk⟩ hne
    have hcn : c < n := by
      by_contra h
      exact hne (by rw [h3, hfr 6 (by omega) (by omega), e6, show c = n by omega])
    rr; rr; rename_i M₆ g₆ f₆
    rr; rename_i M₇ g₇ f₇
    refine ⟨⟨c + 1, by omega, ?_, ?_, fun a h2 h3 => ?_, by omega⟩, ?_⟩
    · rw [f₇ 2 (by omega), g₆, h2, hfr 4 (by omega) (by omega), e4]; push_cast; ring
    · rw [g₇, f₆ 3 (by omega), f₆ 5 (by omega), h3, hfr 5 (by omega) (by omega), e5]
      push_cast; ring
    · rw [f₇ a h3, f₆ a h2, hfr a h2 h3]
    · have : M₇ 2 = ((c + 1 : ℕ) : ℝ) := by
        rw [f₇ 2 (by omega), g₆, h2, hfr 4 (by omega) (by omega), e4]; push_cast; ring
      rw [this, h2, Nat.floor_natCast, Nat.floor_natCast]; omega
  · rintro M' k ⟨c, hc, h2, h3, hfr, hk⟩ heq
    have hcn : c = n := by
      rw [h3, hfr 6 (by omega) (by omega), e6] at heq
      have : 16 * c = 16 * n := by exact_mod_cast heq
      omega
    subst hcn
    exact ⟨h2, hfr, by omega⟩
  · rintro M' k ⟨h2, hfr, hk⟩
    rr; rr; rename_i M₈ g₈ f₈
    have e₈0 : M₈ 0 = ((16 * n + 16 : ℕ) : ℝ) := by
      rw [f₈ 0 (by omega), hfr 0 (by omega) (by omega), f₅ 0 (by omega), f₄ 0 (by omega),
        f₃ 0 (by omega), f₂ 0 (by omega), f₁ 0 (by omega), h0]
    rr; refine RRuns.storeR (16 * n + 16) e₈0 ?_
    intro M₉ g₉ f₉
    rr
    have fr5 : ∀ a, 8 ≤ a → M₅ a = M a := fun a ha => by
      rw [f₅ a (by omega), f₄ a (by omega), f₃ a (by omega), f₂ a (by omega), f₁ a (by omega)]
    refine ⟨by rw [f₉ 0 (by omega), e₈0], by rw [f₉ 4 (by omega), f₈ 4 (by omega),
      hfr 4 (by omega) (by omega), e4], ?_, by rw [g₉, f₈ 2 (by omega), h2], fun a ha ha' => ?_,
      by omega⟩
    · rw [f₉ 7 (by omega), g₈, h2, hfr 4 (by omega) (by omega), e4]
      push_cast; ring
    · rw [f₉ a ha', f₈ a (by omega), hfr a (by omega) (by omega), fr5 a ha]

