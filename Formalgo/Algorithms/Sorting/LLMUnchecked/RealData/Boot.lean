      rw [f₃ a (by omega), f₂ a (by omega), f₁ a (by omega)]
    refine ⟨?_, ?_, hcp, fun a ha ha' => by rw [hfr a (by omega) (by omega) (by omega) (by omega)
      ha', fr a ha], by omega⟩
    · rw [hfr 0 (by omega) (by omega) (by omega) (by omega) (by omega), f₃ 0 (by omega),
        f₂ 0 (by omega), f₁ 0 (by omega), h0]
    · rw [hfr 7 (by omega) (by omega) (by omega) (by omega) (by omega), f₃ 7 (by omega),
