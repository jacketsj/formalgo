import Formalgo.Algorithms.Sorting.LLMUnchecked.RealData.Passes

/-!
# The merge sort core on reals

LLM-generated; not checked by a human.

The core for the real RAM harness: from the input code `[n, x₀, …, x_{n-1}]` in data cells
`[0, ℓ)` (`ℓ = n + 1`), copy the list to the array at `X = ℓ + 1`, sort it with the merge passes
(the scratch array is at `Y = 2 ℓ + 1`), and write `n` just before the sorted array, so that the
output code `[n, y₀, …, y_{n-1}]` starts at `m 1`.
-/

namespace Formalgo.Algorithms.Sorting.MergeSort.RealData

open Formalgo.Algorithms.ShortestPaths.LLMUnchecked Function

/-- Copy one element: `d[X + i] := d[i + 1]`. -/
def copyIn : DCmd := .seqs [Cmd.add 16 21 3, Cmd.add 17 18 21, .dcopy 17 16, Cmd.add 21 21 3,
  Cmd.less 11 21 4]

/-- Merge sort of the list in the input code. -/
def core : DCmd := .seqs [.toIdx 4 5, Cmd.const 3 1, Cmd.add 18 0 3, Cmd.add 19 18 0,
  Cmd.const 21 0, Cmd.less 11 21 4, .loop 11 3 copyIn,
  Cmd.const 20 1, Cmd.less 11 20 4, .loop 11 3 passBody,
  Cmd.sub 1 18 3, .ofIdx 1 4, Cmd.copy 2 0]

/-- The copy loop invariant: `x[0, i)` copied to `X`. -/
def CopyInv (x : List ℝ) (X : ℕ) (s₀ s : DState) (c : ℕ) : Prop :=
  ∃ i ≤ x.length, s.m 21 = i ∧ s.m 11 = (if i < x.length then 1 else 0) ∧
    (∀ a, a ≠ 11 → a ≠ 16 → a ≠ 17 → a ≠ 21 → s.m a = s₀.m a) ∧
    (∀ t < i, s.d (X + t) = x.getD t 0) ∧ (∀ a < X, s.d a = s₀.d a) ∧ c ≤ 7 * i

/-- The copy loop. -/
theorem copy_loop {x : List ℝ} {X : ℕ} {s₀ : DState} (h3 : s₀.m 3 = 1)
    (h4 : s₀.m 4 = x.length) (h18 : s₀.m 18 = X) (hX : x.length + 1 ≤ X)
    (hsrc : ∀ t < x.length, s₀.d (t + 1) = x.getD t 0) (h21 : s₀.m 21 = 0)
    (h11 : s₀.m 11 = if 0 < x.length then 1 else 0) :
    DRuns (.loop 11 3 copyIn) s₀ fun s k => DArr s.d X x ∧
      (∀ a, a ≠ 11 → a ≠ 16 → a ≠ 17 → a ≠ 21 → s.m a = s₀.m a) ∧
      (∀ a < X, s.d a = s₀.d a) ∧ k ≤ 7 * x.length + 1 := by
  refine DRuns.loop (CopyInv x X s₀) (fun s => x.length - s.m 21) ?_ ?_
    ⟨0, by omega, h21, h11, fun _ _ _ _ _ => rfl, fun t ht => by omega, fun _ _ => rfl, le_rfl⟩
  · rintro ⟨m, d⟩ c ⟨i, hi, e21, e11, hfr, hdst, hdfr, hc⟩ heq
    dsimp only at *
    have e3 : m 3 = 1 := by rw [hfr 3 (by omega) (by omega) (by omega) (by omega), h3]
    have e4 : m 4 = x.length := by rw [hfr 4 (by omega) (by omega) (by omega) (by omega), h4]
    have e18 : m 18 = X := by rw [hfr 18 (by omega) (by omega) (by omega) (by omega), h18]
    have hlt : i < x.length := lt_of_cond e11 heq e3
    unfold copyIn
    dstep; dstep; rename_i m₁ g₁ f₁
    dstep; dstep; rename_i m₂ g₂ f₂
    try dsimp only at *
    dstep; dstep; rename_i d₃ g₃ f₃
    try dsimp only at *
    dstep; dstep; rename_i m₄ g₄ f₄
    dstep; dstep; rename_i m₅ g₅ f₅
    try dsimp only at *
    dstep
    have a17 : m₂ 17 = X + i := by ds
    have a16 : m₂ 16 = i + 1 := by ds
    rw [a17, a16] at g₃
    rw [a17] at f₃
    refine ⟨⟨i + 1, by omega, by ds, by ds, fun a h1 h2 h3 h4 => by ds, fun t ht => ?_,
      fun a ha => ?_, by omega⟩, ?_⟩
    · change d₃ (X + t) = _
      by_cases hti : t = i
      · subst hti; rw [g₃, hdfr _ (by omega), hsrc t hlt]
      · rw [f₃ _ (by omega), hdst t (by omega)]
    · change d₃ a = _
      rw [f₃ _ (by omega), hdfr a ha]
    · change _ - m₅ 21 < _
      have : m₅ 21 = i + 1 := by ds
      omega
  · rintro ⟨m, d⟩ c ⟨i, hi, e21, e11, hfr, hdst, hdfr, hc⟩ hne
    dsimp only at *
    have e3 : m 3 = 1 := by rw [hfr 3 (by omega) (by omega) (by omega) (by omega), h3]
    have hin : i = x.length := by
      by_contra h; exact hne (by rw [e11, e3, if_pos (by omega)])
    subst hin
    refine ⟨fun t ht => ?_, hfr, hdfr, by omega⟩
    rw [hdst t ht, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem ht]; rfl

/-- The code of a list of reals: its length, then its entries. -/
theorem encode_list_real (x : List ℝ) : Code.encode (Value := ℝ) x = (x.length : ℝ) :: x := by
  change [(x.length : ℝ)] ++ x.flatMap (fun a => [a]) = _
  simp

/-- The list merge sort of reals. -/
noncomputable def sortReal (x : List ℝ) : List ℝ := passes rle (Nat.clog 2 x.length) x

theorem sortReal_valid (x : List ℝ) :
    (sortReal x).Perm x ∧ (sortReal x).Pairwise (· ≤ ·) := by
  refine ⟨passes_perm _ x, ?_⟩
  have h := (runsSorted_passes (le := rle) (fun a b c h₁ h₂ => by
      simp only [rle, decide_eq_true_eq] at *; exact h₁.trans h₂)
    (fun a b => by simp only [rle, Bool.or_eq_true, decide_eq_true_eq]; exact le_total a b)
    (Nat.clog 2 x.length) x).pairwise
    (by rw [length_passes']; exact Nat.le_pow_clog (by decide) _)
  exact h.imp fun h => by simpa [rle] using h

/-- The steps the core takes on a list of length `n`. -/
def coreTime (n : ℕ) : ℕ := Nat.clog 2 n * (40 * n + 10) + 8 * n + 20

set_option maxHeartbeats 1000000 in
-- many symbolic steps with their frame facts in one proof
/-- The core sorts, for any specification accepting sorted permutations. -/
theorem core_spec (spec : IOSpec (List ℝ) (List ℝ))
    (hspec : ∀ x y, y.Perm x → y.Pairwise (· ≤ ·) → spec.valid x y) :
    CoreSpec core spec fun x => coreTime x.length := by
  intro x
  rw [encode_list_real]
  have hL0 : (DState.input ((x.length : ℝ) :: x)).d 0 = (x.length : ℝ) := by
    simp [DState.input]
  have hLs : ∀ t < x.length, (DState.input ((x.length : ℝ) :: x)).d (t + 1) = x.getD t 0 := by
    intro t ht; simp [DState.input]
  have hm : ∀ a, (DState.input ((x.length : ℝ) :: x)).m a =
      if a = 0 then x.length + 1 else 0 := by
    intro a; simp [DState.input]
  have hdL : ∀ a, (DState.input ((x.length : ℝ) :: x)).d a =
      ((x.length : ℝ) :: x).getD a 0 := fun a => rfl
  generalize DState.input ((x.length : ℝ) :: x) = s at hL0 hLs hm hdL
  obtain ⟨m, d⟩ := s
  dsimp only at *
  unfold core
  dstep
  refine DRuns.toIdxR x.length (by change d (m 5) = _; rw [hm 5]; simpa using hL0)
    fun m₁ g₁ f₁ => ?_
  dsimp only at *
  dstep; dstep; rename_i m₂ g₂ f₂
  dstep; dstep; rename_i m₃ g₃ f₃
  dstep; dstep; rename_i m₄ g₄ f₄
  dstep; dstep; rename_i m₅ g₅ f₅
  dstep; dstep; rename_i m₆ g₆ f₆
  try dsimp only at *
  have c3 : m₆ 3 = 1 := by ds
  have c4 : m₆ 4 = x.length := by ds
  have c0 : m₆ 0 = x.length + 1 := by ds
  have c18 : m₆ 18 = x.length + 2 := by ds
  have c19 : m₆ 19 = 2 * x.length + 3 := by ds
  have c21 : m₆ 21 = 0 := by ds
  have c11 : m₆ 11 = if 0 < x.length then 1 else 0 := by ds
  clear f₁ f₂ f₃ f₄ f₅ f₆ g₁ g₂ g₃ g₄ g₅ g₆
  dstep
  refine DRuns.mono (copy_loop (s₀ := ⟨m₆, d⟩) (X := x.length + 2) c3 c4 c18 (by omega)
    hLs c21 c11) fun s₇ k₇ ⟨harr₇, hfr₇, hdfr₇, hk₇⟩ => ?_
  obtain ⟨m₇, d₇⟩ := s₇
  dsimp only at *
  dstep; dstep; rename_i m₈ g₈ f₈
  dstep; dstep; rename_i m₉ g₉ f₉
  try dsimp only at *
  dstep
  have b3 : m₉ 3 = 1 := by rw [f₉ 3 (by omega), f₈ 3 (by omega), hfr₇ 3 (by omega) (by omega)
    (by omega) (by omega), c3]
  have b4 : m₉ 4 = x.length := by rw [f₉ 4 (by omega), f₈ 4 (by omega), hfr₇ 4 (by omega)
    (by omega) (by omega) (by omega), c4]
  have b18 : m₉ 18 = x.length + 2 := by rw [f₉ 18 (by omega), f₈ 18 (by omega),
    hfr₇ 18 (by omega) (by omega) (by omega) (by omega), c18]
  have b19 : m₉ 19 = 2 * x.length + 3 := by rw [f₉ 19 (by omega), f₈ 19 (by omega),
    hfr₇ 19 (by omega) (by omega) (by omega) (by omega), c19]
  have b0 : m₉ 0 = x.length + 1 := by rw [f₉ 0 (by omega), f₈ 0 (by omega),
    hfr₇ 0 (by omega) (by omega) (by omega) (by omega), c0]
  have b20 : m₉ 20 = 1 := by rw [f₉ 20 (by omega), g₈]
  have b11 : m₉ 11 = if 1 < x.length then 1 else 0 := by
    simp only [g₉, f₈ 4 (by omega), g₈, hfr₇ 4 (by omega) (by omega) (by omega) (by omega), c4]
  have h0 : PassInv x (x.length + 2) (2 * x.length + 3) ⟨m₉, d₇⟩ ⟨m₉, d₇⟩ 0 :=
    ⟨0, x.length + 2, 2 * x.length + 3, .inl rfl, .inl ⟨rfl, rfl⟩, b18, b19, b20,
      by change m₉ 11 = _; rw [b11]; rfl, by simpa [passes] using harr₇, fun _ _ => rfl,
      fun _ _ => rfl,
      by simp⟩
  refine DRuns.mono (pass_loop (s₀ := ⟨m₉, d₇⟩) b3 b4 (by omega) h0)
    fun s₁₀ k₁₀ ⟨src, hsrc, h18, harr, hfr, hdfr, hk₁₀⟩ => ?_
  obtain ⟨m₁₀, d₁₀⟩ := s₁₀
  dsimp only at *
  have e3 : m₁₀ 3 = 1 := by rw [hfr 3 (by unfold PassKeep; omega), b3]
  have e4 : m₁₀ 4 = x.length := by rw [hfr 4 (by unfold PassKeep; omega), b4]
  have e0 : m₁₀ 0 = x.length + 1 := by rw [hfr 0 (by unfold PassKeep; omega), b0]
  dstep
  refine DRuns.isub (by dsimp only; omega) fun m₁₁ g₁₁ f₁₁ => ?_
  dsimp only at *
  dstep; dstep; rename_i d₁₂ g₁₂ f₁₂
  dstep; dstep; rename_i m₁₃ g₁₃ f₁₃
  dstep
  try dsimp only at *
  have q1 : m₁₃ 1 = src - 1 := by rw [f₁₃ 1 (by omega), g₁₁, h18, e3]
  rw [show m₁₁ 1 = src - 1 by rw [g₁₁, h18, e3], show m₁₁ 4 = x.length by
    rw [f₁₁ 4 (by omega), e4]] at g₁₂
  rw [show m₁₁ 1 = src - 1 by rw [g₁₁, h18, e3]] at f₁₂
  have hlen : (sortReal x).length = x.length := length_passes' _ x
  refine ⟨sortReal x, hspec _ _ (sortReal_valid x).1 (sortReal_valid x).2,
    ⟨by change m₁₃ 0 = _; simp only [List.length_cons]; ds, ?_, ?_, fun i hi => ?_,
      fun j hj => ?_⟩, ?_, ?_⟩
  · simp only [List.length_cons]; omega
  · simp only [encode_list_real, List.length_cons, hlen]; ds
  · simp only [List.length_cons] at hi
    change d₁₂ i = _
    rw [f₁₂ i (by omega), hdfr i (by omega), hdfr₇ i (by omega), hdL i,
      List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by simpa using hi)]
    rfl
  · simp only [encode_list_real, List.length_cons, hlen] at hj
    simp only [encode_list_real, q1]
    rcases j with _ | t
    ·       rw [Nat.add_zero, g₁₂]; simp [hlen]
    · rw [f₁₂ _ (by omega), show src - 1 + (t + 1) = src + t by omega, harr t (by
        rw [length_passes']; omega)]
      rfl
  · unfold coreTime; omega
  · rw [encode_list_real]; simp only [List.length_cons, hlen]; unfold coreTime; omega

