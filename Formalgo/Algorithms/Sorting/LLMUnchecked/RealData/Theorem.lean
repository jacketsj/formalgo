    4090 * (coreTime n + (n + 1) + 1) ≤ 409000 * n * Nat.log 2 n + 409000 := by
  unfold coreTime
  rw [Nat.mul_assoc]
  suffices Nat.clog 2 n * (40 * n + 10) + 8 * n + 20 + (n + 1) + 1 ≤
      100 * (n * Nat.log 2 n) + 100 by omega
  by_cases hn : n ≤ 1
  · have : Nat.clog 2 n = 0 := Nat.le_zero.1 (Nat.clog_le_of_le_pow (by simpa using hn))
    rw [this]; omega
