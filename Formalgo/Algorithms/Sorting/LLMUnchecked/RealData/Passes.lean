open Formalgo.Algorithms.ShortestPaths.LLMUnchecked Function

/-- One pass: merge all pairs of runs, swap the arrays, and double the width. -/
def passBody : DCmd := .seqs [Cmd.const 21 0, Cmd.less 11 21 4, .loop 11 3 pairBody,
  Cmd.copy 13 18, Cmd.copy 18 19, Cmd.copy 19 13, Cmd.add 20 20 20, Cmd.less 11 20 4]

/-- The index cells the pass loop keeps. -/
def PassKeep (a : ℕ) : Prop := a < 11 ∨ 29 < a

theorem length_passes' (j : ℕ) (x : List ℝ) : (passes rle j x).length = x.length :=
  (passes_perm j x).length_eq

/-- The pass loop invariant: `jp` passes done, the result at `src`. -/
def PassInv (x : List ℝ) (X Y : ℕ) (s₀ s : DState) (c : ℕ) : Prop :=
  ∃ jp src dst, (jp = 0 ∨ 2 ^ (jp - 1) < x.length) ∧
    ((src = X ∧ dst = Y) ∨ (src = Y ∧ dst = X)) ∧
    s.m 18 = src ∧ s.m 19 = dst ∧ s.m 20 = 2 ^ jp ∧
    s.m 11 = (if 2 ^ jp < x.length then 1 else 0) ∧ DArr s.d src (passes rle jp x) ∧
    (∀ a, PassKeep a → s.m a = s₀.m a) ∧ (∀ a < X, s.d a = s₀.d a) ∧
    c ≤ jp * (40 * x.length + 10)

set_option maxHeartbeats 1000000 in
