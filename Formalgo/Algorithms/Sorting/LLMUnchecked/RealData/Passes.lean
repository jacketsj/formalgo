/-- After the passes, `jp` is the number of passes needed. -/
theorem jp_eq_clog' {jp n : ℕ} (h0 : jp = 0 ∨ 2 ^ (jp - 1) < n) (h1 : ¬ 2 ^ jp < n) :
    jp = Nat.clog 2 n := by
  apply le_antisymm
  · rcases h0 with rfl | h0
    · exact Nat.zero_le _
    · by_contra h
      have h2 : n ≤ 2 ^ Nat.clog 2 n := Nat.le_pow_clog (by decide) n
      have h3 : 2 ^ Nat.clog 2 n ≤ 2 ^ (jp - 1) := Nat.pow_le_pow_right (by decide) (by omega)
      omega
  · exact Nat.clog_le_of_le_pow (by omega)

/-- The pass loop. -/
theorem pass_loop {x : List ℝ} {X Y : ℕ} {s₀ s : DState} (h3 : s₀.m 3 = 1)
    (h4 : s₀.m 4 = x.length) (hXY : X + x.length ≤ Y) (h0 : PassInv x X Y s₀ s 0) :
    DRuns (.loop 11 3 passBody) s fun s' k => ∃ src, (src = X ∨ src = Y) ∧ s'.m 18 = src ∧
      DArr s'.d src (passes rle (Nat.clog 2 x.length) x) ∧
      (∀ a, PassKeep a → s'.m a = s₀.m a) ∧ (∀ a < X, s'.d a = s₀.d a) ∧
      k ≤ Nat.clog 2 x.length * (40 * x.length + 10) + 1 := by
  refine DRuns.loop (PassInv x X Y s₀) (fun s => x.length - s.m 20)
    (fun s c hinv heq => pass_step h3 h4 hXY hinv heq) ?_ h0
  rintro s c ⟨jp, src, dst, hjp, hsd, h18, h19, h20, h11, harr, hfr, hdfr, hc⟩ hne
  have s3 : s.m 3 = 1 := by rw [hfr 3 (by unfold PassKeep; omega), h3]
  have hge : ¬ 2 ^ jp < x.length := fun h => hne (by rw [h11, s3, if_pos h])
  obtain rfl := jp_eq_clog' hjp hge
  exact ⟨src, by omega, h18, harr, hfr, hdfr, by omega⟩

