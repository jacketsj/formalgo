  have hPS : PairStart (passes rle jp x) src dst (2 ^ jp) ⟨m₂, d⟩ := by
    refine ⟨hpos, by rw [length_passes']; omega, by ds, ?_, by ds, by ds, by ds, harr⟩
    change m₂ 4 = _
    rw [length_passes']; ds
