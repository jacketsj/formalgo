      x.length - s'.m 20 < x.length - s.m 20 := by
  obtain ⟨jp, src, dst, hjp, hsd, h18, h19, h20, h11, harr, hfr, hdfr, hc⟩ := hinv
  have s3 : s.m 3 = 1 := by rw [hfr 3 (by unfold PassKeep; omega), h3]
  have s4 : s.m 4 = x.length := by rw [hfr 4 (by unfold PassKeep; omega), h4]
