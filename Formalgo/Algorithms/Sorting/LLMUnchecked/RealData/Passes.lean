      ek a ha, hfr a ha]
  · change d₃ a = _
    rw [hdfr₃ a (by omega), hdfr a ha]
  · rw [length_passes'] at hc₃
    rw [Nat.succ_mul]; omega
  · change _ - m₈ 20 < _
