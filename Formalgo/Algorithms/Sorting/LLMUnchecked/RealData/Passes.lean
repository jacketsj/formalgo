    fun s₃ k₃ ⟨harr₃, hk₃, hdfr₃, hc₃⟩ => ?_
  obtain ⟨m₃, d₃⟩ := s₃
  dsimp only at *
  have e18 : m₃ 18 = src := by rw [hk₃ 18 (by unfold PairKeep; omega)]; ds
  have e19 : m₃ 19 = dst := by rw [hk₃ 19 (by unfold PairKeep; omega)]; ds
  have e20 : m₃ 20 = 2 ^ jp := by rw [hk₃ 20 (by unfold PairKeep; omega)]; ds
  have e4 : m₃ 4 = x.length := by rw [hk₃ 4 (by unfold PairKeep; omega)]; ds
  have ek : ∀ a, PassKeep a → m₃ a = m a := fun a ha => by
    unfold PassKeep at ha; rw [hk₃ a (by unfold PairKeep; omega)]; ds
  clear hk₃ f₁ f₂ g₁ g₂
  dstep; dstep; rename_i m₄ g₄ f₄
  dstep; dstep; rename_i m₅ g₅ f₅
  dstep; dstep; rename_i m₆ g₆ f₆
  dstep; dstep; rename_i m₇ g₇ f₇
  dstep; dstep; rename_i m₈ g₈ f₈
  try dsimp only at *
  dstep
  have e₈20 : m₈ 20 = 2 ^ (jp + 1) := by rw [Nat.pow_succ]; ds
  refine ⟨⟨jp + 1, dst, src, .inr (by simpa using hlt), by omega, by ds, by ds, e₈20, ?_,
    fun t ht => ?_, fun a ha => ?_, fun a ha => ?_, ?_⟩, ?_⟩
  · change m₈ 11 = _
    rw [← e₈20]; ds
  · change d₃ (dst + t) = _
