/-!
# The model on an input with weights in any type

LLM-generated; not checked by a human.

For weights in a linear order `R` with nonnegative addition (`ℕ`, or the nonnegative reals): the
statement's input as a `WGraphW R`, its adjacency lists (built as `Context.lean` builds them for
natural weights: the half-edges of the edges in lexicographic order, latest first), and the
model's output. For a connected graph and a source vertex, the output is the least weight of a
walk from the source to each vertex (`distOut_valid`), with the model's steps in `O(E + V log V)`
(`finishW_time`).
-/

namespace Formalgo.Algorithms.ShortestPaths

open Function St LLMUnchecked

variable {R : Type*}

/-- The statement's input, with weights in `R`: `n`, a graph on `Fin n`, a weight on each edge,
and a source. -/
abbrev InputW (R : Type*) := Σ n, Σ G : SimpleGraph (Fin n), (G.edgeSet → R) × ℕ

open Classical in
/-- The graph of an input, with weight `0` off its edges. -/
noncomputable def InputW.wg [Zero R] (x : InputW R) : WGraphW R :=
  ⟨x.1, x.2.1, fun e => if h : e ∈ x.2.1.edgeSet then x.2.2.1 ⟨e, h⟩ else 0⟩

theorem InputW.wg_weight [Zero R] (x : InputW R) {e : Sym2 (Fin x.1)} (h : e ∈ x.2.1.edgeSet) :
    x.wg.weight e = x.2.2.1 ⟨e, h⟩ := dif_pos h

/-- The weight of a walk in the graph of an input is its weight in the statement. -/
theorem wlen_wg [AddCommMonoid R] (x : InputW R) {u v : Fin x.1} (p : x.2.1.Walk u v) :
    wlen x.wg p = (p.darts.map fun d => x.2.2.1 ⟨d.edge, d.edge_mem⟩).sum := by
  unfold wlen SimpleGraph.Walk.edges
  rw [List.map_map]
  congr 1
  exact List.map_congr_left fun d _ => x.wg_weight d.edge_mem

/-! ### Adjacency lists -/

section Adjacency

variable (G : WGraphW R)

/-- The half-edges `(source id, target id, weight)`, in the order they are added. -/
noncomputable def halvesW : List (ℕ × ℕ × R) :=
  (lexEdges G.graph).flatMap fun e =>
    [((e.1 : ℕ) + 1, (e.2 : ℕ) + 1, G.weight s(e.1, e.2)),
      ((e.2 : ℕ) + 1, (e.1 : ℕ) + 1, G.weight s(e.1, e.2))]

/-- The adjacency list of vertex id `a`: its half-edges, latest first. -/
noncomputable def adjW (a : ℕ) : List (ℕ × R) :=
  ((halvesW G).reverse.filter fun h => h.1 = a).map fun h => (h.2.1, h.2.2)

/-- The model's data for a graph. -/
noncomputable def ctxW : CtxW R :=
  ⟨G.n, Dn G.n, G.n + Dn G.n + 2 * (lexEdges G.graph).length + 2, adjW G⟩

variable {G}

theorem length_halvesW : (halvesW G).length = 2 * (lexEdges G.graph).length := by
  simp only [halvesW, List.length_flatMap, List.length_cons, List.length_nil]
  induction (lexEdges G.graph) <;> simp_all; omega

theorem mem_halvesW {h : ℕ × ℕ × R} : h ∈ halvesW G ↔ ∃ a b : Fin G.n,
    (a, b) ∈ lexEdges G.graph ∧ (h = ((a : ℕ) + 1, (b : ℕ) + 1, G.weight s(a, b)) ∨
      h = ((b : ℕ) + 1, (a : ℕ) + 1, G.weight s(a, b))) := by
  simp only [halvesW, List.mem_flatMap, List.mem_cons, List.mem_nil_iff, or_false, Prod.exists]

theorem mem_adjW {a : ℕ} {p : ℕ × R} :
    p ∈ adjW G a ↔ ∃ h ∈ halvesW G, h.1 = a ∧ p = (h.2.1, h.2.2) := by
  simp only [adjW, List.mem_map, List.mem_filter, List.mem_reverse, decide_eq_true_eq]
  constructor
  · rintro ⟨h, ⟨hm, ha⟩, rfl⟩; exact ⟨h, hm, ha, rfl⟩
  · rintro ⟨h, hm, ha, rfl⟩; exact ⟨h, ⟨hm, ha⟩, rfl⟩

theorem ctxW_ok [LinearOrder R] : CtxOK (ctxW G) := ⟨rfl, by simp [ctxW]; omega⟩

/-- The adjacency lists hold `2E` half-edges in all. -/
theorem sum_adjW :
    ∑ a ∈ Finset.range (G.n + 1), (adjW G a).length = 2 * (lexEdges G.graph).length := by
  rw [← length_halvesW, ← List.length_reverse]
  have := sum_filter_length (Finset.range (G.n + 1)) (halvesW G).reverse (fun h hh => by
    rw [List.mem_reverse] at hh
    obtain ⟨a, b, _, rfl | rfl⟩ := mem_halvesW.1 hh <;> simp)
  rw [← this]
  simp only [adjW, List.length_map]

/-- The adjacency lists list the edges, with weights at most `W`. -/
theorem adjW_ok [AddCommMonoid R] [LinearOrder R] {W : R}
    (hW : ∀ a b : Fin G.n, (a, b) ∈ lexEdges G.graph → G.weight s(a, b) ≤ W) :
    AdjOK (ctxW G) G W := by
  refine ⟨rfl, fun u p hp => ?_, fun u v huv => ?_, fun a p hp => ?_, fun a => ?_⟩
  · obtain ⟨h, hm, ha, rfl⟩ := mem_adjW.1 hp
    obtain ⟨a, b, hab, rfl | rfl⟩ := mem_halvesW.1 hm
    · have : a = u := Fin.ext (by simp at ha; omega)
      subst this
      exact ⟨b, (mem_edges.1 hab).2, rfl⟩
    · have : b = u := Fin.ext (by simp at ha; omega)
      subst this
      exact ⟨a, (mem_edges.1 hab).2.symm, by simp [Sym2.eq_swap]⟩
  · refine mem_adjW.2 ?_
    rcases lt_or_gt_of_ne (fun h : u = v => huv.ne h) with hlt | hlt
    · exact ⟨_, mem_halvesW.2 ⟨u, v, mem_edges.2 ⟨hlt, huv⟩, .inl rfl⟩, rfl, rfl⟩
    · exact ⟨_, mem_halvesW.2 ⟨v, u, mem_edges.2 ⟨hlt, huv.symm⟩, .inr rfl⟩, rfl,
        by simp [Sym2.eq_swap]⟩
  · obtain ⟨h, hm, _, rfl⟩ := mem_adjW.1 hp
    obtain ⟨a, b, hab, rfl | rfl⟩ := mem_halvesW.1 hm <;> exact hW a b hab
  · change (adjW G a).length ≤ G.n + Dn G.n + 2 * (lexEdges G.graph).length + 2
    have : (adjW G a).length ≤ (halvesW G).length := by
      simp only [adjW, List.length_map]
      exact (List.length_filter_le _ _).trans (by simp)
    rw [length_halvesW] at this; omega

/-- The total weight of the edges, a bound on each weight. -/
noncomputable def wsum [AddCommMonoid R] (G : WGraphW R) : R :=
  ((lexEdges G.graph).map fun e => G.weight s(e.1, e.2)).sum

theorem adjW_ok_wsum [AddCommMonoid R] [LinearOrder R] [CanonicallyOrderedAdd R] :
    AdjOK (ctxW G) G (wsum G) :=
  adjW_ok fun a b hab =>
    List.le_sum_of_mem (List.mem_map.2 ⟨(a, b), hab, rfl⟩)

end Adjacency

/-! ### The model's output -/

variable [AddCommMonoid R] [LinearOrder R] [CanonicallyOrderedAdd R]

/-- The model's steps for a graph with `E` edges are `O(E + V log V)`. -/
theorem finishW_time (G : WGraphW R) (src : ℕ) :
    (finish (ctxW G) src).time ≤
      65 + G.n * perVertex (ctxW G) + 650 * (lexEdges G.graph).length := by
  by_cases hs : src < G.n
  · have h := (finish_spec_least ctxW_ok adjW_ok_wsum hs).2.2.2.2
    have : ∑ v ∈ Finset.range (G.n + 1), ((ctxW G).adj v).length =
        2 * (lexEdges G.graph).length := sum_adjW
    rw [this] at h
    omega
  · rw [finish_invalid (show (ctxW G).n ≤ src by change G.n ≤ src; omega)]
    simp [blank]

/-- The model's steps are at most `1100 (E + V log V) + 1100`. -/
theorem finishW_time_log (G : WGraphW R) (src : ℕ) :
    (finish (ctxW G) src).time ≤
      1100 * ((lexEdges G.graph).length + G.n * Nat.log 2 G.n) + 1100 := by
  have h := finishW_time G src
  have hs : Nat.size G.n ≤ Nat.log 2 G.n + 1 :=
    Nat.size_le.2 (Nat.lt_pow_succ_log_self (by decide) G.n)
  have hp : perVertex (ctxW G) ≤ 400 * Nat.log 2 G.n + 620 := by
    change 200 * (2 * Nat.size G.n + 1) + 20 ≤ _; omega
  have h1 := Nat.mul_le_mul_left G.n hp
  have h2 : G.n ≤ G.n * Nat.log 2 G.n + 1 := by
    rcases Nat.lt_or_ge G.n 2 with hn | hn
    · omega
    · have : 1 ≤ Nat.log 2 G.n := Nat.le_log_of_pow_le (by decide) (by simpa using hn)
      have := Nat.mul_le_mul_left G.n this
      omega
  have e : G.n * (400 * Nat.log 2 G.n + 620) = 400 * (G.n * Nat.log 2 G.n) + 620 * G.n := by ring
  omega

/-- The model's output for an input: `n`, and the value at each vertex. -/
noncomputable def distOut (x : InputW R) : Σ n, Fin n → R :=
  ⟨x.1, fun v => outVal (finish (ctxW x.wg) x.2.2.2) ((v : ℕ) + 1)⟩

variable (R) in
/-- `spec` accepts, for a connected graph and a source vertex, the weight of a lightest walk from
the source to each vertex (stated with Mathlib's walks only, so the proof does not import the
statement). -/
def AcceptsDistW (spec : IOSpec (InputW R) (Σ n, Fin n → R)) : Prop :=
  ∀ n (G : SimpleGraph (Fin n)) (w : G.edgeSet → R) (s : ℕ) (out : Σ n, Fin n → R),
    (G.Connected → ∀ h : s < n, ∃ f : Fin n → R, out = ⟨n, f⟩ ∧ ∀ v,
      IsLeast {(p.darts.map fun d => w ⟨d.edge, d.edge_mem⟩).sum | p : G.Walk ⟨s, h⟩ v} (f v)) →
    spec.valid ⟨n, G, w, s⟩ out

/-- For a connected graph and a source vertex, the model outputs the weight of a lightest walk
from the source to each vertex. -/
theorem distOut_valid {spec : IOSpec (InputW R) (Σ n, Fin n → R)} (hspec : AcceptsDistW R spec)
    (x : InputW R) : spec.valid x (distOut x) := by
  obtain ⟨n, G, w, s⟩ := x
  refine hspec n G w s _ fun hG h => ⟨(distOut ⟨n, G, w, s⟩).2, rfl, fun v => ?_⟩
  have hs : s < (InputW.wg ⟨n, G, w, s⟩).n := h
  have hv := (finish_spec_least (ctxW_ok (G := InputW.wg ⟨n, G, w, s⟩)) adjW_ok_wsum hs).2.2.1 v
    (hG.preconnected _ _)
  have e : (Set.range fun p : G.Walk ⟨s, h⟩ v => wlen (InputW.wg ⟨n, G, w, s⟩) p) =
      {(p.darts.map fun d => w ⟨d.edge, d.edge_mem⟩).sum | p : G.Walk ⟨s, h⟩ v} := by
    ext; simp only [Set.mem_range, Set.mem_setOf_eq]
    exact exists_congr fun p => by rw [wlen_wg]
  rw [← e]
  exact hv

end Formalgo.Algorithms.ShortestPaths
