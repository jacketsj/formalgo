-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs.FloydWarshall
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs.Codes
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs.RunFW

/-!
# The program's matrices and the model's

LLM-generated; not checked by a human.

The programs start from the model's initial matrix, with a value `M` above twice the total weight
for `⊤` (`M = 2 Σ w + 1`), and their rounds are the model's.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs

open Function

/-- A matrix on `Fin n`, extended by `0`. -/
def ext {α : Type*} [Zero α] {n : ℕ} (D : Fin n → Fin n → α) (a b : ℕ) : α :=
  if h : a < n ∧ b < n then D ⟨a, h.1⟩ ⟨b, h.2⟩ else 0

theorem ext_fin {α : Type*} [Zero α] {n : ℕ} (D : Fin n → Fin n → α) (a b : Fin n) :
    ext D a b = D a b := by
  simp [ext]

theorem roundsN_ext {α : Type*} [Zero α] [Add α] [LinearOrder α] {n : ℕ}
    (D : Fin n → Fin n → α) {k : ℕ} (hk : k ≤ n) (a b : Fin n) :
    roundsN (ext D) k a b = FW.rounds D k a b := by
  induction k generalizing a b with
  | zero => exact ext_fin D a b
  | succ k ih =>
    rw [FW.rounds_succ _ (by omega)]
    change min _ (_ + _) = min _ (_ + _)
    rw [ih (by omega) a b]
    congr 2
    · exact ih (by omega) a ⟨k, by omega⟩
    · exact ih (by omega) ⟨k, by omega⟩ b

/-! ### Neighbours -/

theorem mem_nbrs {n : ℕ} {G : SimpleGraph (Fin n)} {u : Fin n} {v : ℕ} :
    v ∈ nbrs G u ↔ ∃ h : v < n, G.Adj u ⟨v, h⟩ := by
  unfold nbrs
  simp only [List.mem_map, List.mem_filter, List.mem_finRange, true_and, decide_eq_true_eq,
    SimpleGraph.mem_neighborSet]
  constructor
  · rintro ⟨v', h, rfl⟩; exact ⟨v'.isLt, h⟩
  · rintro ⟨hv, h⟩; exact ⟨⟨v, hv⟩, h, rfl⟩

theorem getD_nbrLists {n : ℕ} (G : SimpleGraph (Fin n)) {u : ℕ} (hu : u < n) :
    (nbrLists G).getD u [] = nbrs G ⟨u, hu⟩ := by
  simp [nbrLists, List.getD_eq_getElem?_getD, hu]

theorem nbrLists_ok {n : ℕ} (G : SimpleGraph (Fin n)) :
    ∀ u < n, ∀ v ∈ (nbrLists G).getD u [], v < n ∧ v ≠ u := by
  intro u hu v hv
  rw [getD_nbrLists _ hu, mem_nbrs] at hv
  obtain ⟨hv, h⟩ := hv
  refine ⟨hv, fun e => ?_⟩
  subst e; exact G.irrefl h

theorem length_lexEdges_le {n : ℕ} (G : SimpleGraph (Fin n)) : (lexEdges G).length ≤ n * n := by
  classical
  unfold lexEdges
  rw [List.length_flatMap]
  have h := List.sum_le_card_nsmul ((List.finRange n).map fun u =>
    (((List.finRange n).filter fun v => u < v ∧ G.Adj u v).map (u, ·)).length) n
    (fun k hk => by
      obtain ⟨u, -, rfl⟩ := List.mem_map.1 hk
      rw [List.length_map]
      exact (List.length_filter_le _ _).trans (List.length_finRange ..).le)
  simpa using h

/-! ### The initial matrix, over any weights -/

section Generic

variable {W : Type*} [AddCommMonoid W] [LinearOrder W] [IsOrderedAddMonoid W]
  [CanonicallyOrderedAdd W]

/-- An all-pairs input with weights in `W`. -/
abbrev GInput (W : Type*) := Σ n, Σ G : SimpleGraph (Fin n), G.edgeSet → W

/-- The weights, in increasing order of the edges. -/
noncomputable def gW (x : GInput W) : List W := (edgeList x.2.1).map x.2.2

/-- The initial matrix, with `M` for `⊤`. -/
noncomputable def D0G (M : W) (x : GInput W) : Fin x.1 → Fin x.1 → W :=
  fun a b => FW.enc M (FW.init x.2.2 a b)

omit [LinearOrder W] [IsOrderedAddMonoid W] [CanonicallyOrderedAdd W] in
theorem init_symm {n : ℕ} {G : SimpleGraph (Fin n)} (w : G.edgeSet → W) (a b : Fin n) :
    FW.init w a b = FW.init w b a := by
  unfold FW.init
  by_cases hab : a = b
  · subst hab; rfl
  · rw [if_neg hab, if_neg (Ne.symm hab)]
    by_cases h : G.Adj a b
    · rw [dif_pos h, dif_pos h.symm]
      have e : (⟨s(a, b), h⟩ : G.edgeSet) = ⟨s(b, a), h.symm⟩ := Subtype.ext Sym2.eq_swap
      rw [e]
    · rw [dif_neg h, dif_neg fun h' => h h'.symm]

omit [IsOrderedAddMonoid W] in
theorem init_le_sum {n : ℕ} {G : SimpleGraph (Fin n)} (w : G.edgeSet → W) (a b : Fin n) (d : W)
    (h : FW.init w a b = d) : d ≤ ((edgeList G).map w).sum := by
  unfold FW.init at h
  split_ifs at h with h1 h2
  · cases h; exact zero_le
  · cases h; exact List.le_sum_of_mem (List.mem_map_of_mem (mem_edgeList _))
  · exact absurd h (by simp)

variable {M : W} {x : GInput W}

omit [IsOrderedAddMonoid W] in
theorem D0G_le (hM : (gW x).sum + (gW x).sum < M) (a b : Fin x.1) : D0G M x a b ≤ M :=
  FW.enc_le (fun d h => init_le_sum x.2.2 a b d h) hM

omit [IsOrderedAddMonoid W] in
theorem extG_le (hM : (gW x).sum + (gW x).sum < M) :
    ∀ a < x.1, ∀ b < x.1, ext (D0G M x) a b ≤ M :=
  fun a ha b hb => by rw [ext, dif_pos ⟨ha, hb⟩]; exact D0G_le hM _ _

omit [LinearOrder W] [IsOrderedAddMonoid W] [CanonicallyOrderedAdd W] in
theorem extG_symm (a b : ℕ) : ext (D0G M x) a b = ext (D0G M x) b a := by
  unfold ext D0G
  by_cases h : a < x.1 ∧ b < x.1
  · rw [dif_pos h, dif_pos ⟨h.2, h.1⟩, init_symm]
  · rw [dif_neg h, dif_neg fun h' => h ⟨h'.2, h'.1⟩]

omit [LinearOrder W] [IsOrderedAddMonoid W] [CanonicallyOrderedAdd W] in
theorem fillG_ok : ∀ a < x.1, ∀ b < x.1, b ∉ (nbrLists x.2.1).getD a [] →
    ext (D0G M x) a b = if a = b then 0 else M := by
  intro a ha b hb hn
  rw [getD_nbrLists _ ha, mem_nbrs] at hn
  have hadj : ¬ x.2.1.Adj ⟨a, ha⟩ ⟨b, hb⟩ := fun h => hn ⟨hb, h⟩
  rw [ext, dif_pos ⟨ha, hb⟩]
  unfold D0G FW.init
  by_cases hab : a = b
  · subst hab; simp [FW.enc]
  · rw [if_neg (fun h => hab (congrArg Fin.val h)), dif_neg hadj, if_neg hab]; rfl

omit [LinearOrder W] [IsOrderedAddMonoid W] [CanonicallyOrderedAdd W] in
theorem gW_lex : gW x = (lexEdges x.2.1).map fun e => ext (D0G M x) e.1 e.2 := by
  obtain ⟨n, G, w⟩ := x
  change (edgeList G).map w = _
  unfold edgeList
  rw [List.map_filterMap, ← List.filterMap_eq_map]
  refine List.filterMap_congr fun e he => ?_
  have hm : s(e.1, e.2) ∈ G.edgeSet := (mem_edges.1 he).2
  have hne : e.1 ≠ e.2 := (mem_edges.1 he).1.ne
  simp only [Function.comp_apply, hm, ↓reduceDIte, Option.map_some, ext, e.1.isLt, e.2.isLt,
    and_self, D0G, FW.init, if_neg hne, dif_pos (show G.Adj e.1 e.2 from hm)]
  rfl

omit [LinearOrder W] [IsOrderedAddMonoid W] [CanonicallyOrderedAdd W] in
theorem gW_eq : gW x = wFrom (ext (D0G M x)) (nbrLists x.2.1) 0 := by
  obtain ⟨n, G, w⟩ := x
  classical
  rw [gW_lex (M := M), wFrom, show (nbrLists G).length - 0 = n by simp [nbrLists],
    ← List.range_eq_range', ← List.map_coe_finRange_eq_range, List.flatMap_map, lexEdges,
    List.map_flatMap]
  refine List.flatMap_congr fun u _ => ?_
  rw [getD_nbrLists _ u.isLt, wl, List.map_map, nbrs, List.filter_map, List.map_map,
    List.filter_filter]
  congr 1
  refine List.filter_congr fun v _ => ?_
  simp only [Function.comp_apply, SimpleGraph.mem_neighborSet, Fin.lt_def, Bool.decide_and]

theorem outG_eq (hM : (gW x).sum + (gW x).sum < M) (a b : Fin x.1) :
    roundsN (ext (D0G M x)) x.1 a b = FW.enc M (FW.rounds (FW.init x.2.2) x.1 a b) := by
  have h := FW.enc_rounds x.2.2 (L := edgeList x.2.1) (M := M) mem_edgeList hM x.1
  rw [roundsN_ext _ le_rfl]
  exact (congrFun (congrFun h a) b).symm

/-- For a connected graph, after all rounds each entry is the least weight of a walk. -/
theorem outG_isLeast (hM : (gW x).sum + (gW x).sum < M) (hG : x.2.1.Connected) (u v : Fin x.1) :
    IsLeast {(p.darts.map fun d => x.2.2 ⟨d.edge, d.edge_mem⟩).sum | p : x.2.1.Walk u v}
      (roundsN (ext (D0G M x)) x.1 u v) := by
  obtain ⟨d, hd, hl⟩ := FW.isLeast_rounds x.2.2 hG u v
  rw [outG_eq hM u v, hd]
  exact hl

end Generic

/-! ### Natural weights -/

/-- The value for `⊤`: above twice the total weight. -/
noncomputable def big (x : APInput) : ℕ := (apW x).sum + (apW x).sum + 1

/-- The initial matrix on `ℕ`. -/
noncomputable def D0 (x : APInput) : Fin x.1 → Fin x.1 → ℕ := D0G (big x) x

/-- The output: the matrix after all rounds. -/
noncomputable def apOut (x : APInput) : APOutput := ⟨x.1, fun a b => roundsN (ext (D0 x)) x.1 a b⟩

theorem big_gt (x : APInput) : (gW x).sum + (gW x).sum < big x := by
  change (apW x).sum + (apW x).sum < _; unfold big; omega

theorem ext_le (x : APInput) : ∀ a < x.1, ∀ b < x.1, ext (D0 x) a b ≤ big x :=
  extG_le (big_gt x)

theorem ext_symm (x : APInput) (a b : ℕ) : ext (D0 x) a b = ext (D0 x) b a := extG_symm a b

theorem nbrs_ok (x : APInput) : ∀ u < x.1, ∀ v ∈ (nbrLists x.2.1).getD u [], v < x.1 ∧ v ≠ u :=
  nbrLists_ok x.2.1

theorem fill_ok (x : APInput) : ∀ a < x.1, ∀ b < x.1, b ∉ (nbrLists x.2.1).getD a [] →
    ext (D0 x) a b = if a = b then 0 else big x := fillG_ok

theorem apW_lex (x : APInput) : apW x = (lexEdges x.2.1).map fun e => ext (D0 x) e.1 e.2 :=
  gW_lex

theorem apW_eq (x : APInput) : apW x = wFrom (ext (D0 x)) (nbrLists x.2.1) 0 := gW_eq

theorem out_le (x : APInput) : ∀ a < x.1, ∀ b < x.1, roundsN (ext (D0 x)) x.1 a b ≤ big x :=
  roundsN_le (ext_le x) x.1

/-- `spec` accepts, for a connected graph, the weight of a lightest walk between each pair. -/
def AcceptsAllPairs (spec : IOSpec APInput APOutput) : Prop :=
  ∀ n (G : SimpleGraph (Fin n)) (w : G.edgeSet → ℕ) (out : APOutput),
    (G.Connected → ∃ d : Fin n → Fin n → ℕ, out = ⟨n, d⟩ ∧ ∀ u v,
      IsLeast {(p.darts.map fun d => w ⟨d.edge, d.edge_mem⟩).sum | p : G.Walk u v} (d u v)) →
    spec.valid ⟨n, G, w⟩ out

theorem apOut_valid {spec : IOSpec APInput APOutput} (hspec : AcceptsAllPairs spec)
    (x : APInput) : spec.valid x (apOut x) := by
  obtain ⟨n, G, w⟩ := x
  exact hspec n G w _ fun hG => ⟨_, rfl, fun u v =>
    outG_isLeast (x := ⟨n, G, w⟩) (big_gt ⟨n, G, w⟩) hG u v⟩

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs
