theorem getElem?_flatMap_eq {α β : Type*} (l : List β) (f : β → List α) (K : ℕ)
    (hK : ∀ b ∈ l, (f b).length = K) {a r : ℕ} (ha : a < l.length) (hr : r < K) :
    (l.flatMap f)[a * K + r]? = (f l[a])[r]? := by
  induction l generalizing a with
  | nil => simp at ha
  | cons b l ih =>
    rw [List.flatMap_cons]
    have hb := hK b (by simp)
    rcases a with _ | a
    · rw [Nat.zero_mul, Nat.zero_add, List.getElem?_append_left (by omega)]; rfl
    · rw [List.getElem?_append_right (by rw [hb, Nat.succ_mul]; omega), hb,
        show (a + 1) * K + r - K = a * K + r by rw [Nat.succ_mul]; omega]
      exact ih (fun b hb => hK b (by simp [hb])) (by simpa using ha)

theorem length_flatMap_rows {β : Type*} (l : List β) (f : β → List ℕ) (K : ℕ)
    (hK : ∀ b ∈ l, (f b).length = K) : (l.flatMap f).length = l.length * K := by
  induction l with
  | nil => simp
  | cons b l ih =>
    rw [List.flatMap_cons, List.length_append, hK b (by simp),
      ih fun b hb => hK b (by simp [hb]), List.length_cons, Nat.succ_mul]
    omega

theorem ncode_apOut (x : APInput) : ncode (apOut x) = x.1 :: x.1 ::
    (List.finRange x.1).flatMap fun u : Fin x.1 => x.1 ::
      (List.finRange x.1).map fun v : Fin x.1 => roundsN (ext (D0 x)) x.1 (u : ℕ) (v : ℕ) :=
  ncode_apo (apOut x)

theorem len_apo (x : APInput) : (ncode (apOut x)).length = 2 + x.1 * (x.1 + 1) := by
  rw [ncode_apOut, List.length_cons, List.length_cons,
    length_flatMap_rows _ _ (x.1 + 1) fun b _ => by simp, List.length_finRange]
  omega

/-- The output code, entry by entry. -/
theorem apo_get (x : APInput) {a r : ℕ} (ha : a < x.1) (hr : r < x.1 + 1) :
    (ncode (apOut x))[2 + (a * (x.1 + 1) + r)]? =
      some (if r = 0 then x.1 else roundsN (ext (D0 x)) x.1 a (r - 1)) := by
  rw [ncode_apOut, show 2 + (a * (x.1 + 1) + r) = (a * (x.1 + 1) + r) + 1 + 1 by omega,
    List.getElem?_cons_succ, List.getElem?_cons_succ,
    getElem?_flatMap_eq _ _ (x.1 + 1) (fun b _ => by simp) (by simpa using ha) hr]
  rcases r with _ | b
  · simp
  · rw [List.getElem?_cons_succ, List.getElem?_map,
      List.getElem?_eq_getElem (show b < (List.finRange x.1).length by simp; omega)]
    simp

theorem getElem!_of_getElem? {l : List ℕ} {j v : ℕ} (h : l[j]? = some v) : l[j]! = v := by
  rw [getElem!_def, h]

/-! ### The core -/

/-- The memory used from `A`. -/
noncomputable def apNeed (x : APInput) : ℕ :=
  (ncode x).length + x.1 + x.1 * (x.1 + 1) + 4 * (apW x).sum + 40

/-- The steps of the core. -/
noncomputable def apTime (x : APInput) : ℕ := 40 * (x.1 + 1) ^ 3 + 40 * (ncode x).length + 100

theorem MemAt.cast {m : Mem} {Q Q' : ℕ} {W : List ℕ} (h : MemAt m Q W) (hQ : Q = Q') :
    MemAt m Q' W := hQ ▸ h

theorem cost_bound (n ℓ fm E : ℕ) (hfm : n ≤ fm) (hℓ : ℓ = 3 + fm + E) :
    8 + ((8 * n + 8) + ((8 * E + 20) + ((n * (9 * n + 20) + 6) + ((20 * fm + 10) +
      ((n * (n * (14 * n + 12) + 12) + 4) + 1))))) ≤ 40 * (n + 1) ^ 3 + 40 * ℓ + 100 := by
  subst hℓ
  have h1 : n * (9 * n + 20) + n * (n * (14 * n + 12) + 12) ≤ 40 * (n + 1) ^ 3 := by
    nlinarith [Nat.zero_le n, sq_nonneg n]
  omega

