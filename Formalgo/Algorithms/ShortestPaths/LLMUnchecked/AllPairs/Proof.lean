theorem allPairs_wordRAM (spec : IOSpec APInput APOutput) (hspec : AcceptsAllPairs spec) :
    ∃ c, (tdWordRAM [.less, .add, .sub]).SolvableWithin spec fun ⟨V, _, _⟩ => c * V ^ 3 + c :=
  ⟨2000, solvableWithin_code (W := 16) (scale := 4) core_spec (lenScan_spec apOut) setS_spec
    layout_ap skips_ap layout_apo readsBack_apo ncode_ap_ne (by omega) (by omega) small_core
    hS_ap hneed_ap (fun x w hw hM => hbig_ap x w hw hM) hfy_ap spec (apOut_valid hspec) _
    time_ap⟩

