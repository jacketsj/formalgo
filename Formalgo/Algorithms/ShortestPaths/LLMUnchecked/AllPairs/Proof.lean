/-! ### Bounds -/

theorem small_core : Small 16 (codeProgram setS lenScan core).lines := by decide +kernel

theorem hS_ap (x : APInput) : 3 * ((ncode x).length + 1) + 3 * (ncode (apOut x)).length + nK ≤
    6 * (ncode x).length + 3 * (x.1 * x.1) + 70 := by
  rw [len_apo, Nat.mul_add_one x.1 x.1]
  have := n_le_length x
  omega

theorem hneed_ap (x : APInput) : (ncode x).length + nK ≤ apNeed x := by
  unfold apNeed; omega

theorem sum_le_codeMax (x : APInput) : (apW x).sum ≤ codeMax (ncode x) * codeMax (ncode x) := by
  have hT := ncode_ap_tape x
  have hw : ∀ v ∈ apW x, v ≤ codeMax (ncode x) := fun v hv =>
    le_codeMax (by rw [hT]; simp [hv])
  have hE : (apW x).length ≤ codeMax (ncode x) := le_codeMax (by rw [hT]; simp)
  have := List.sum_le_card_nsmul (apW x) _ hw
  rw [smul_eq_mul] at this
  exact this.trans (Nat.mul_le_mul_right _ hE)

theorem poly_lt' {M w : ℕ} (hw : 16 ≤ w) (hM : (M + 1) ^ 4 ≤ 2 ^ w) :
    8 * (M * M) + 9 * M + 142 < 2 ^ w := by
  have h16 : 2 ^ 16 ≤ 2 ^ w := Nat.pow_le_pow_right (by decide) hw
  by_cases hs : M ≤ 9
  · have : M * M ≤ 81 := Nat.mul_le_mul hs hs
    omega
  · have h1 : (M + 1) ^ 4 = (M + 1) ^ 2 * (M + 1) ^ 2 := by ring
    have h2 : 121 * (M + 1) ^ 2 ≤ (M + 1) ^ 2 * (M + 1) ^ 2 :=
      Nat.mul_le_mul_right _ (by nlinarith)
    have h3 : (M + 1) ^ 2 = M * M + 2 * M + 1 := by ring
    omega

theorem hbig_ap (x : APInput) (w : ℕ) (hw : 16 ≤ w) (hM : (codeMax (ncode x) + 1) ^ 4 ≤ 2 ^ w) :
    6 * (ncode x).length + 3 * (x.1 * x.1) + 70 + nK + apNeed x < 2 ^ w := by
  have hl := length_le_codeMax (ncode x)
  have hn : x.1 ≤ codeMax (ncode x) := le_codeMax (by rw [ncode_ap_tape]; simp)
  have hs := sum_le_codeMax x
  have hnn : x.1 * x.1 ≤ codeMax (ncode x) * codeMax (ncode x) := Nat.mul_le_mul hn hn
  have := poly_lt' hw hM
  unfold apNeed
  rw [Nat.mul_add_one x.1 x.1]
  omega

theorem hfy_ap (x : APInput) : ∀ v ∈ ncode (apOut x), v < (codeMax (ncode x) + 1) ^ 4 := by
  intro v hv
  have hl := length_le_codeMax (ncode x)
  have h3 := n_le_length x
  have hn : x.1 ≤ codeMax (ncode x) := le_codeMax (by rw [ncode_ap_tape]; simp)
  have hs := sum_le_codeMax x
  generalize codeMax (ncode x) = M at hl hn hs
  have h4 : 2 * (M * M) + 1 < (M + 1) ^ 4 := by nlinarith
  have h5 : M < (M + 1) ^ 4 := by nlinarith
  rw [ncode_apOut] at hv
  simp only [List.mem_cons, List.mem_flatMap, List.mem_finRange, true_and, List.mem_map] at hv
  rcases hv with rfl | rfl | ⟨u, rfl | ⟨w, -, rfl⟩⟩
  · omega
  · omega
  · omega
  · have := out_le x u u.isLt w w.isLt
    unfold big at this
    omega

theorem time_ap (x : APInput) :
    apTime x + 33 * (ncode x).length + 25 * (ncode (apOut x)).length + 340 ≤
      (fun x : APInput => 2000 * x.1 ^ 3 + 2000) x := by
  have hT := ncode_ap_tape x
  have hblk := length_blocks x.2.1
  have hE : (apW x).length = (lexEdges x.2.1).length := by rw [apW_lex, List.length_map]
  have hlex := length_lexEdges_le x.2.1
  have hℓ : (ncode x).length = 3 + x.1 + 3 * (lexEdges x.2.1).length := by
    rw [hT]; simp only [List.length_cons, List.length_append]; omega
  rw [len_apo]
  unfold apTime
  simp only
  rw [hℓ]
  generalize (lexEdges x.2.1).length = E at hlex
  generalize x.1 = n at hlex ⊢
  rcases n with _ | n
  · obtain rfl : E = 0 := by omega
    norm_num
  · nlinarith [hlex, Nat.zero_le n, sq_nonneg n]

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs

