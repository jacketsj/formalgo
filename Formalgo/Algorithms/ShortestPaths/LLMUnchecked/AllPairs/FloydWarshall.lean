-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected
import Mathlib.Combinatorics.SimpleGraph.Walk.Decomp
import Mathlib.Algebra.Order.Monoid.WithTop
import Mathlib.Algebra.Order.BigOperators.Group.List

/-!
# Floyd–Warshall, as a plain Lean model

LLM-generated; not checked by a human.

`rounds D k` relaxes the matrix `D` through the vertices below `k`. From the edge weights (`init`,
with `⊤` for non-edges), after the rounds through all vertices each entry is the least weight of
a walk. Over a canonically ordered monoid `W`, the same rounds on `W` itself, with a large value
`M` in place of `⊤` (`enc`), give the same entries.
-/

namespace Formalgo.Algorithms.ShortestPaths.FW

open SimpleGraph

/-! ### The rounds -/

section Rounds

variable {α : Type*} [Add α] [LinearOrder α] {n : ℕ}

/-- Relax every entry through `k`. -/
def relax (D : Fin n → Fin n → α) (k : Fin n) : Fin n → Fin n → α :=
  fun i j => min (D i j) (D i k + D k j)

/-- Relax through the vertices below `k`, in increasing order. -/
def rounds (D : Fin n → Fin n → α) : ℕ → Fin n → Fin n → α
  | 0 => D
  | k + 1 => if h : k < n then relax (rounds D k) ⟨k, h⟩ else rounds D k

theorem rounds_succ (D : Fin n → Fin n → α) {k : ℕ} (h : k < n) :
    rounds D (k + 1) = relax (rounds D k) ⟨k, h⟩ := by
  simp [rounds, h]

theorem rounds_succ_of_le (D : Fin n → Fin n → α) {k : ℕ} (h : n ≤ k) :
    rounds D (k + 1) = rounds D k := by
  simp [rounds, show ¬ k < n by omega]

end Rounds

/-! ### Walks -/

variable {W : Type*} [AddCommMonoid W] [LinearOrder W] [IsOrderedAddMonoid W]
  [CanonicallyOrderedAdd W] {n : ℕ} {G : SimpleGraph (Fin n)} (w : G.edgeSet → W)

/-- The weight of a walk. -/
def wt {u v : Fin n} (p : G.Walk u v) : W := (p.darts.map fun d => w ⟨d.edge, d.edge_mem⟩).sum

omit [LinearOrder W] [IsOrderedAddMonoid W] [CanonicallyOrderedAdd W] in
theorem wt_append {u v x : Fin n} (p : G.Walk u v) (q : G.Walk v x) :
    wt w (p.append q) = wt w p + wt w q := by
  simp [wt, Walk.darts_append]

theorem wt_le_of_subset {u v x y : Fin n} {p : G.Walk u v} {q : G.Walk x y}
    (hp : p.darts.Nodup) (h : p.darts ⊆ q.darts) : wt w p ≤ wt w q := by
  obtain ⟨l, hl, hs⟩ := List.subperm_of_subset hp h
  unfold wt
  rw [← (hl.map _).sum_eq]
  exact (hs.map _).sum_le_sum fun _ _ => zero_le

theorem wt_bypass_le {u v : Fin n} (p : G.Walk u v) :
    wt w p.bypass ≤ wt w p :=
  wt_le_of_subset w (Walk.darts_nodup_of_support_nodup p.bypass_isPath.support_nodup)
    p.darts_bypass_subset_darts

/-- A path weighs at most the sum of the weights over a list of the edges without repeats. -/
theorem wt_le_sum {u v : Fin n} {p : G.Walk u v} (hp : p.IsPath) {L : List G.edgeSet}
    (hL : ∀ e, e ∈ L) : wt w p ≤ (L.map w).sum := by
  have hnd : (p.darts.map fun d => (⟨d.edge, d.edge_mem⟩ : G.edgeSet)).Nodup := by
    have h := hp.isTrail.edges_nodup
    have e : (p.darts.map fun d => (⟨d.edge, d.edge_mem⟩ : G.edgeSet)).map Subtype.val =
        p.edges := by simp [Walk.edges]
    rw [← e] at h
    exact h.of_map _
  obtain ⟨l, hl, hs⟩ := List.subperm_of_subset hnd fun e _ => hL e
  unfold wt
  rw [show (p.darts.map fun d => w ⟨d.edge, d.edge_mem⟩) =
      (p.darts.map fun d => (⟨d.edge, d.edge_mem⟩ : G.edgeSet)).map w by simp,
    ← (hl.map _).sum_eq]
  exact (hs.map _).sum_le_sum fun _ _ => zero_le

/-- The vertices of `p` other than its ends are below `k`. -/
def Low (k : ℕ) {u v : Fin n} (p : G.Walk u v) : Prop :=
  ∀ x ∈ p.support, x = u ∨ x = v ∨ (x : ℕ) < k

theorem Low.mono {k k' : ℕ} {u v : Fin n} {p : G.Walk u v} (h : Low k p) (hk : k ≤ k') :
    Low k' p := fun x hx => by
  rcases h x hx with h | h | h
  · exact .inl h
  · exact .inr (.inl h)
  · exact .inr (.inr (by omega))

theorem low_all {u v : Fin n} (p : G.Walk u v) : Low n p := fun x _ => .inr (.inr x.isLt)

/-! ### The initial matrix -/

open Classical in
/-- `0` on the diagonal, the weight of each edge, and `⊤` elsewhere. -/
noncomputable def init : Fin n → Fin n → WithTop W := fun u v =>
  if u = v then 0 else if h : G.Adj u v then ((w ⟨s(u, v), h⟩ : W) : WithTop W) else ⊤

/-! ### Each entry is the weight of a walk -/

omit [IsOrderedAddMonoid W] [CanonicallyOrderedAdd W] in
theorem rounds_sound (k : ℕ) (i j : Fin n) :
    rounds (init w) k i j = ⊤ ∨ ∃ p : G.Walk i j, Low k p ∧ rounds (init w) k i j = wt w p := by
  induction k generalizing i j with
  | zero =>
    simp only [rounds, init]
    split_ifs with h1 h2
    · subst h1
      exact .inr ⟨Walk.nil, fun x hx => .inl (by simpa using hx), by simp [wt]⟩
    · refine .inr ⟨Walk.cons h2 Walk.nil, fun x hx => ?_, by simp [wt]⟩
      simp only [Walk.support_cons, Walk.support_nil, List.mem_cons, List.not_mem_nil,
        or_false] at hx
      rcases hx with rfl | rfl
      · exact .inl rfl
      · exact .inr (.inl rfl)
    · exact .inl rfl
  | succ k ih =>
    by_cases hk : k < n
    · rw [rounds_succ _ hk]
      simp only [relax]
      rcases min_choice (rounds (init w) k i j)
        (rounds (init w) k i ⟨k, hk⟩ + rounds (init w) k ⟨k, hk⟩ j) with h | h <;> rw [h]
      · rcases ih i j with h' | ⟨p, hp, h'⟩
        · exact .inl h'
        · exact .inr ⟨p, hp.mono (by omega), h'⟩
      · rcases ih i ⟨k, hk⟩ with h₁ | ⟨p, hp, h₁⟩
        · left; rw [h₁, WithTop.top_add]
        rcases ih ⟨k, hk⟩ j with h₂ | ⟨q, hq, h₂⟩
        · left; rw [h₂, WithTop.add_top]
        refine .inr ⟨p.append q, fun x hx => ?_, by rw [h₁, h₂, wt_append, WithTop.coe_add]⟩
        rw [Walk.mem_support_append_iff] at hx
        rcases hx with hx | hx
        · rcases hp x hx with h | h | h
          · exact .inl h
          · exact .inr (.inr (by rw [h]; exact Nat.lt_succ_self k))
          · exact .inr (.inr (by omega))
        · rcases hq x hx with h | h | h
          · exact .inr (.inr (by rw [h]; exact Nat.lt_succ_self k))
          · exact .inr (.inl h)
          · exact .inr (.inr (by omega))
    · rw [rounds_succ_of_le _ (by omega)]
      rcases ih i j with h | ⟨p, hp, h⟩
      · exact .inl h
      · exact .inr ⟨p, hp.mono (by omega), h⟩

/-! ### Each entry is at most the weight of each low path -/

omit [IsOrderedAddMonoid W] in
theorem init_le {i j : Fin n} {p : G.Walk i j} (hp : p.IsPath) (hl : Low 0 p) :
    init w i j ≤ wt w p := by
  cases p with
  | nil => simp [init]
  | @cons _ v _ h q =>
    have hv : v = j := by
      rcases hl v (by simp) with h' | h' | h'
      · exact absurd h' (G.ne_of_adj h).symm
      · exact h'
      · omega
    subst hv
    obtain rfl : q = Walk.nil := (Walk.isPath_iff_nil.1 hp.of_cons).eq_nil
    simp [init, G.ne_of_adj h, h, wt]

theorem rounds_complete (k : ℕ) {i j : Fin n} (p : G.Walk i j)
    (hp : p.IsPath) (hl : Low k p) : rounds (init w) k i j ≤ wt w p := by
  induction k generalizing i j with
  | zero => exact init_le w hp hl
  | succ k ih =>
    by_cases hk : k < n
    · rw [rounds_succ _ hk]
      simp only [relax]
      set kk : Fin n := ⟨k, hk⟩
      by_cases hlow : Low k p
      · exact (min_le_left _ _).trans (ih p hp hlow)
      have hmem : kk ∈ p.support := by
        by_contra hm
        refine hlow fun x hx => ?_
        rcases hl x hx with h | h | h
        · exact .inl h
        · exact .inr (.inl h)
        · refine .inr (.inr (lt_of_le_of_ne (Nat.lt_succ_iff.1 h) fun e => hm ?_))
          rw [show kk = x from Fin.ext e.symm]; exact hx
      have hki : kk ≠ i := fun e => hlow fun x hx => by
        rcases hl x hx with h | h | h
        · exact .inl h
        · exact .inr (.inl h)
        · rcases Nat.lt_succ_iff_lt_or_eq.1 h with h | h
          · exact .inr (.inr h)
          · exact .inl (by rw [← e]; exact Fin.ext h)
      have hkj : kk ≠ j := fun e => hlow fun x hx => by
        rcases hl x hx with h | h | h
        · exact .inl h
        · exact .inr (.inl h)
        · rcases Nat.lt_succ_iff_lt_or_eq.1 h with h | h
          · exact .inr (.inr h)
          · exact .inr (.inl (by rw [← e]; exact Fin.ext h))
      set q := p.takeUntil kk hmem
      set r := p.dropUntil kk hmem
      have hspec : q.append r = p := p.take_spec hmem
      have hnd : (q.support ++ r.support.tail).Nodup := by
        rw [← Walk.support_append, hspec]; exact hp.support_nodup
      have hdis := List.disjoint_of_nodup_append hnd
      have hlq : Low k q := fun x hx => by
        rcases hl x (p.support_takeUntil_subset_support hmem hx) with h | h | h
        · exact .inl h
        · exact absurd (h ▸ hx) fun hj => hdis hj (r.end_mem_tail_support_of_ne hkj)
        · rcases Nat.lt_succ_iff_lt_or_eq.1 h with h | h
          · exact .inr (.inr h)
          · exact .inr (.inl (Fin.ext h))
      have hlr : Low k r := fun x hx => by
        rcases hl x (p.support_dropUntil_subset_support hmem hx) with h | h | h
        · refine absurd (h ▸ hx) fun hi => ?_
          rw [← List.cons_head_tail (Walk.support_ne_nil r), Walk.head_support] at hi
          rcases List.mem_cons.1 hi with hi | hi
          · exact hki hi.symm
          · exact hdis q.start_mem_support hi
        · exact .inr (.inl h)
        · rcases Nat.lt_succ_iff_lt_or_eq.1 h with h | h
          · exact .inr (.inr h)
          · exact .inl (Fin.ext h)
      have h1 := ih q (hp.takeUntil hmem) hlq
      have h2 := ih r (hp.dropUntil hmem) hlr
      refine (min_le_right _ _).trans ?_
      rw [← hspec, wt_append, WithTop.coe_add]
      exact add_le_add h1 h2
    · rw [rounds_succ_of_le _ (by omega)]
      exact ih p hp fun x hx => by
        rcases hl x hx with h | h | h
        · exact .inl h
        · exact .inr (.inl h)
        · exact .inr (.inr (by have := x.isLt; omega))

/-! ### After all rounds -/

theorem rounds_le_wt {i j : Fin n} (p : G.Walk i j) :
    rounds (init w) n i j ≤ wt w p :=
  (rounds_complete w n p.bypass p.bypass_isPath (low_all _)).trans
    (WithTop.coe_le_coe.2 (wt_bypass_le w p))

/-- For a connected graph, after all rounds each entry is the least weight of a walk. -/
theorem isLeast_rounds (hG : G.Connected) (i j : Fin n) :
    ∃ d : W, rounds (init w) n i j = d ∧ IsLeast {x | ∃ p : G.Walk i j, wt w p = x} d := by
  classical
  obtain ⟨p⟩ := hG.preconnected i j
  rcases rounds_sound w n i j with h | ⟨q, -, hq⟩
  · exact absurd (h ▸ rounds_le_wt w p) (by simp)
  · exact ⟨wt w q, hq, ⟨q, rfl⟩, fun _ ⟨p, hp⟩ => hp ▸ WithTop.coe_le_coe.1 (hq ▸ rounds_le_wt w p)⟩

/-- Each finite entry is at most the total weight. -/
theorem rounds_le_sum (k : ℕ) {i j : Fin n} {d : W} (h : rounds (init w) k i j = d)
    {L : List G.edgeSet} (hL : ∀ e, e ∈ L) : d ≤ (L.map w).sum := by
  classical
  rcases rounds_sound w k i j with h' | ⟨p, hp, h'⟩
  · rw [h] at h'; exact absurd h' (by simp)
  have hb : Low k p.bypass := fun x hx => hp x (p.support_bypass_subset_support hx)
  have h1 := rounds_complete w k p.bypass p.bypass_isPath hb
  rw [h] at h1
  exact (WithTop.coe_le_coe.1 h1).trans (wt_le_sum w p.bypass_isPath hL)

/-! ### A large value in place of `⊤` -/

/-- `x`, with `M` for `⊤`. -/
def enc (M : W) (x : WithTop W) : W := x.untopD M

omit [IsOrderedAddMonoid W] in
theorem enc_le {M Bd : W} {x : WithTop W} (hx : ∀ d : W, x = d → d ≤ Bd) (hM : Bd + Bd < M) :
    enc M x ≤ M := by
  cases x with
  | top => exact le_rfl
  | coe d => exact ((hx d rfl).trans le_self_add).trans hM.le

theorem enc_relax {M Bd : W} (D : Fin n → Fin n → WithTop W)
    (hD : ∀ i j (d : W), D i j = d → d ≤ Bd) (hM : Bd + Bd < M) (k i j : Fin n) :
    enc M (relax D k i j) = relax (fun a b => enc M (D a b)) k i j := by
  simp only [relax]
  have hij := enc_le (hD i j) hM
  by_cases hik : D i k = ⊤
  · rw [hik, WithTop.top_add, min_top_right]
    exact (min_eq_left (hij.trans le_self_add)).symm
  obtain ⟨a, ha⟩ := WithTop.ne_top_iff_exists.1 hik
  by_cases hkj : D k j = ⊤
  · rw [hkj, WithTop.add_top, min_top_right]
    exact (min_eq_left (hij.trans le_add_self)).symm
  obtain ⟨b, hb⟩ := WithTop.ne_top_iff_exists.1 hkj
  have hab : a + b < M := (add_le_add (hD i k a ha.symm) (hD k j b hb.symm)).trans_lt hM
  rw [← ha, ← hb]
  by_cases hij' : D i j = ⊤
  · simp only [hij', enc, min_top_left, ← WithTop.coe_add, WithTop.untopD_coe,
      WithTop.untopD_top]
    exact (min_eq_right hab.le).symm
  · obtain ⟨c, hc⟩ := WithTop.ne_top_iff_exists.1 hij'
    simp only [← hc, enc, ← WithTop.coe_add, ← WithTop.coe_min, WithTop.untopD_coe]

/-- The rounds on `W`, from the initial matrix with `M` for `⊤`, follow the rounds on `WithTop W`
if `M` is above twice the total weight. -/
theorem enc_rounds {M : W} {L : List G.edgeSet} (hL : ∀ e, e ∈ L) (hM : (L.map w).sum +
    (L.map w).sum < M) (k : ℕ) :
    (fun i j => enc M (rounds (init w) k i j)) = rounds (fun i j => enc M (init w i j)) k := by
  induction k with
  | zero => rfl
  | succ k ih =>
    by_cases hk : k < n
    · rw [rounds_succ _ hk, rounds_succ _ hk, ← ih]
      funext i j
      exact enc_relax _ (fun a b d h => rounds_le_sum w k h hL) hM _ _ _
    · rw [rounds_succ_of_le _ (by omega), rounds_succ_of_le _ (by omega), ih]

end Formalgo.Algorithms.ShortestPaths.FW
