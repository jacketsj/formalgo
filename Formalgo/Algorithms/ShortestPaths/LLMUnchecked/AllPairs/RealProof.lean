/-- `spec` accepts, for a connected graph, the weight of a lightest walk between each pair, with
weights in `W`. -/
def AcceptsAllPairsW (W : Type*) [AddMonoid W] [LE W]
    (spec : IOSpec (Σ n, Σ G : SimpleGraph (Fin n), G.edgeSet → W)
      (Σ n, Fin n → Fin n → W)) : Prop :=
  ∀ n (G : SimpleGraph (Fin n)) (w : G.edgeSet → W) (out : Σ n, Fin n → Fin n → W),
    (G.Connected → ∃ d : Fin n → Fin n → W, out = ⟨n, d⟩ ∧ ∀ u v,
      IsLeast {(p.darts.map fun d => w ⟨d.edge, d.edge_mem⟩).sum | p : G.Walk u v} (d u v)) →
    spec.valid ⟨n, G, w⟩ out

/-- `AcceptsAllPairsW` for nonnegative real weights. -/
abbrev AcceptsAllPairsR (spec : IOSpec RInput ROutput) : Prop := AcceptsAllPairsW ℝ≥0 spec

theorem rOut_valid {spec : IOSpec RInput ROutput} (hspec : AcceptsAllPairsR spec) (x : RInput) :
    spec.valid x (rOut x) := by
  obtain ⟨n, G, w⟩ := x
  exact hspec n G w _ fun hG => ⟨_, rfl, fun u v =>
    outG_isLeast (x := ⟨n, G, w⟩) (bigR_gt ⟨n, G, w⟩) hG u v⟩

