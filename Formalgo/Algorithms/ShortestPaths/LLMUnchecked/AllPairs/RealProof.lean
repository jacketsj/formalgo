theorem cube_bound (n E : ℕ) (hE : E ≤ n * n) :
    3850 * (40 * (n + 1) ^ 3 + (n + 3 * E + 3) * 41 + 100) + 3850 ≤
      3850 * 600 * n ^ 3 + 3850 * 600 := by
  rcases n with _ | n
  · obtain rfl : E = 0 := by omega
    norm_num
  · nlinarith [hE, Nat.zero_le n, sq_nonneg n]

/-- A real RAM with `<`, `+` and `−` solves, in `O(V³)` steps, any spec that accepts the
all-pairs shortest-path distances with nonnegative real weights. -/
theorem allPairs_realRAM
    (spec : IOSpec (Σ n, Σ G : SimpleGraph (Fin n), G.edgeSet → ℝ≥0) (Σ n, Fin n → Fin n → ℝ≥0))
    (hspec : AcceptsAllPairsR spec) :
    ∃ c, RealRAM.withAddSub.semantics.SolvableWithin spec fun ⟨V, _, _⟩ => c * V ^ 3 + c := by
  obtain ⟨PC, hPC, prog, hs, hh⟩ := solvableWithin_apsp (coreR_spec hspec)
  refine ⟨3850 * 600, PC, hPC, prog, hs, fun x => ?_⟩
  obtain ⟨st, hst⟩ := hh x
  refine ⟨st, status_halted_mono hst ?_⟩
  obtain ⟨n, G, w⟩ := x
  change 3850 * (tR ⟨n, G, w⟩ + _) + 3850 ≤ 3850 * 600 * n ^ 3 + 3850 * 600
  have hE : G.edgeSet.ncard ≤ n * n := by rw [← length_edges]; exact length_lexEdges_le G
  have := cube_bound n G.edgeSet.ncard hE
  unfold tR
  rw [length_encode_apsp_input]
  dsimp only
  omega

end Formalgo.Algorithms.ShortestPaths
