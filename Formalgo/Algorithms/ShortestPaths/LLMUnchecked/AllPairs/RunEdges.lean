    RowsAt m Z n g f (u + 1) [] := fun a ha b' hb' => by
  rw [h a ha b' hb']
  by_cases h1 : a < u
  · simp [h1, show a < u + 1 by omega]
  · by_cases h2 : a = u
    · subst h2
      by_cases h3 : b' ∈ b
      · simp [h3]
      · simp [h3, hfill b' hb' h3]
    · simp [h1, h2, show ¬ a < u + 1 by omega]

theorem RowsAt.frame {m m' : Mem} {Z n u : ℕ} {g f : ℕ → ℕ → ℕ} {b : List ℕ}
    (h : RowsAt m Z n g f u b) (hf : ∀ a, Z + 3 ≤ a → m' a = m a) : RowsAt m' Z n g f u b :=
  fun a ha b' hb' => by rw [hf _ (by have := hdr_ge Z n a; omega)]; exact h a ha b' hb'

