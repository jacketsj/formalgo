/-- The registers that the loop over a row may change. -/
def CellReg (r : ℕ) : Prop := r = 0 ∨ r = 2 ∨ r = 19 ∨ r = 21 ∨ r = 22 ∨ r = 23 ∨ r = 31

/-- The registers that the loop over the rows may change. -/
def RowReg (r : ℕ) : Prop := CellReg r ∨ r = 25 ∨ r = 26 ∨ r = 27 ∨ r = 29 ∨ r = 30

/-- The registers that the rounds may change. -/
def FwReg (r : ℕ) : Prop := RowReg r ∨ r = 15 ∨ r = 18 ∨ r = 28

