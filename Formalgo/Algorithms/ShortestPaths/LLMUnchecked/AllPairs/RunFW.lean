    have hjn : j < n := lt_of_flag e31 (heq.trans e3)
    refine Runs.mono (fwCell_run (B := B) (Z := Z) (n := n) (k := k) (i := i) (j := j) (D := D)
      (by rw [hr 28 (by decide) (by unfold CellReg; omega), h28])
      (by rw [hr 29 (by decide) (by unfold CellReg; omega), h29])
      (by rw [hr 30 (by decide) (by unfold CellReg; omega), h30]) e19
      (by rw [hr 11 (by decide) (by unfold CellReg; omega), h11]) e3
      (by rw [hM₁ k hk j hjn, mix_kj D]) (by rw [hM₁ i hi j hjn, mix_ij]) hk hi hjn hZ hB
      (by have := hD i hi k hk; have := hD k hk j hjn; omega)) ?_
