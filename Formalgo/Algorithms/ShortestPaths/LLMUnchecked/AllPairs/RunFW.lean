  refine Runs.loop (fun m' s => ∃ j ≤ n, m' 19 = j ∧ m' 31 = (if j < n then 1 else 0) ∧
      Mat m' Z n (mix D k i j) ∧ (∀ a, ¬ CellReg a → ¬ IsCell Z n a → m' a = m a) ∧ s ≤ 14 * j)
    (fun m' => n - m' 19) (by omega) (by omega) ?_ ?_
    ⟨0, by omega, h19, h31, hM, fun _ _ _ => rfl, by omega⟩
  · rintro m₁ s ⟨j, hj, e19, e31, hM₁, hf, hs⟩ heq
    have hr : ∀ r, r < 32 → ¬ CellReg r → m₁ r = m r := fun r hr h => hf r h (hnc _ (by omega))
