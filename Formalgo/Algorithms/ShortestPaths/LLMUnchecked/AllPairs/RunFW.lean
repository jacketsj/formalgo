  rename_i m₁ g₁ f₁ m₂ g₂ f₂ m₃ g₃ f₃ m₄ g₄ f₄ m₅ g₅ f₅ m₆ g₆ f₆
  have e0 : m₆ 0 = hdr Z n i + 1 + j := by rd
