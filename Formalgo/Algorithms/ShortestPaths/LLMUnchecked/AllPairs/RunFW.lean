/-- The matrix `D` is in memory. -/
def Mat (m : Mem) (Z n : ℕ) (D : ℕ → ℕ → ℕ) : Prop :=
  ∀ a < n, ∀ b < n, m (hdr Z n a + 1 + b) = D a b

theorem Mat.frame {m m' : Mem} {Z n : ℕ} {D : ℕ → ℕ → ℕ} (h : Mat m Z n D)
    (hf : ∀ a, Z + 3 ≤ a → m' a = m a) : Mat m' Z n D :=
  fun a ha b hb => by rw [hf _ (by have := hdr_ge Z n a; omega)]; exact h a ha b hb

theorem Mat.congr {m : Mem} {Z n : ℕ} {D D' : ℕ → ℕ → ℕ} (h : Mat m Z n D)
    (hD : ∀ a < n, ∀ b < n, D a b = D' a b) : Mat m Z n D' :=
  fun a ha b hb => by rw [h a ha b hb, hD a ha b hb]

