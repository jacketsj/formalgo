-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Mathlib.Algebra.Order.Group.Nat
import Mathlib.Order.Basic

/-!
# The programs' matrices

LLM-generated; not checked by a human.

Matrices indexed by numbers, with entries in a linear order with addition (`ℕ` on the word RAM,
`ℝ≥0` on the real RAM), the in-place rounds of Floyd–Warshall on them, and the order in which the
programs read the edge weights.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs

section Rounds

variable {α : Type*} [Add α] [LinearOrder α]

/-- Relax every entry through `k`. -/
def relaxN (D : ℕ → ℕ → α) (k : ℕ) : ℕ → ℕ → α := fun i j => min (D i j) (D i k + D k j)

/-- Relax through the vertices below `k`. -/
def roundsN (D : ℕ → ℕ → α) : ℕ → ℕ → ℕ → α
  | 0 => D
  | k + 1 => relaxN (roundsN D k) k

/-- The entries before `(i, j)` relaxed through `k`, the others not. -/
def mix (D : ℕ → ℕ → α) (k i j : ℕ) : ℕ → ℕ → α :=
  fun a b => if a < i ∨ (a = i ∧ b < j) then relaxN D k a b else D a b

theorem relaxN_le (D : ℕ → ℕ → α) (k i j : ℕ) : relaxN D k i j ≤ D i j := min_le_left _ _

theorem roundsN_le {D : ℕ → ℕ → α} {n : ℕ} {Mx : α} (h : ∀ a < n, ∀ b < n, D a b ≤ Mx)
    (k : ℕ) : ∀ a < n, ∀ b < n, roundsN D k a b ≤ Mx := by
  induction k with
  | zero => exact h
  | succ k ih => exact fun a ha b hb => (relaxN_le _ _ _ _).trans (ih a ha b hb)

theorem mix_le {D : ℕ → ℕ → α} {n k i j : ℕ} {Mx : α} (h : ∀ a < n, ∀ b < n, D a b ≤ Mx) :
    ∀ a < n, ∀ b < n, mix D k i j a b ≤ Mx := fun a ha b hb => by
  unfold mix; split_ifs
  · exact (relaxN_le _ _ _ _).trans (h a ha b hb)
  · exact h a ha b hb

theorem mix_ij (D : ℕ → ℕ → α) (k i j : ℕ) : mix D k i j i j = D i j := by
  simp [mix]

theorem mix_ik (D : ℕ → ℕ → α) (k i : ℕ) : mix D k i 0 i k = D i k := by
  simp [mix]

omit [Add α] in
theorem if_lt_eq_min (s c : α) : (if s < c then s else c) = min c s := by
  split_ifs with h
  · exact (min_eq_right h.le).symm
  · exact (min_eq_left (not_lt.1 h)).symm

theorem mix_succ_ne {D : ℕ → ℕ → α} {k i j a b : ℕ} (h : a ≠ i ∨ b ≠ j) :
    mix D k i (j + 1) a b = mix D k i j a b := by
  unfold mix
  by_cases h1 : a < i ∨ (a = i ∧ b < j)
  · rw [if_pos h1, if_pos (by omega)]
  · rw [if_neg h1, if_neg (by omega)]

theorem mix_succ_eq (D : ℕ → ℕ → α) (k i j : ℕ) : mix D k i (j + 1) i j = relaxN D k i j := by
  simp [mix]

theorem mix_end {D : ℕ → ℕ → α} {k i n a b : ℕ} (hb : b < n) :
    mix D k i n a b = mix D k (i + 1) 0 a b := by
  unfold mix
  by_cases h1 : a < i ∨ (a = i ∧ b < n)
  · rw [if_pos h1, if_pos (by omega)]
  · rw [if_neg h1, if_neg (by omega)]

theorem mix_zero (D : ℕ → ℕ → α) (k a b : ℕ) : mix D k 0 0 a b = D a b := by simp [mix]

theorem mix_all {D : ℕ → ℕ → α} {k n a b : ℕ} (ha : a < n) :
    mix D k n 0 a b = relaxN D k a b := by simp [mix, ha]

variable [CanonicallyOrderedAdd α]

theorem relaxN_row (D : ℕ → ℕ → α) (k j : ℕ) : relaxN D k k j = D k j :=
  min_eq_left le_add_self

theorem relaxN_col (D : ℕ → ℕ → α) (k i : ℕ) : relaxN D k i k = D i k :=
  min_eq_left le_self_add

theorem mix_kj (D : ℕ → ℕ → α) (k i j : ℕ) : mix D k i j k j = D k j := by
  unfold mix; split_ifs
  · exact relaxN_row D k j
  · rfl

end Rounds

/-! ### The weights in the order the programs read them -/

section Weights

variable {α : Type*}

/-- The weights of the edges from `u` to the vertices of `l` above it. -/
def wl (g : ℕ → ℕ → α) (u : ℕ) (l : List ℕ) : List α := (l.filter (u < ·)).map (g u)

/-- The weights of the edges from the vertices `u, …, n - 1` to vertices above them. -/
def wFrom (g : ℕ → ℕ → α) (bs : List (List ℕ)) (u : ℕ) : List α :=
  (List.range' u (bs.length - u)).flatMap fun a => wl g a (bs.getD a [])

theorem wFrom_succ (g : ℕ → ℕ → α) (bs : List (List ℕ)) {u : ℕ} (h : u < bs.length) :
    wFrom g bs u = wl g u (bs.getD u []) ++ wFrom g bs (u + 1) := by
  unfold wFrom
  rw [show bs.length - u = (bs.length - (u + 1)) + 1 by omega, List.range'_succ,
    List.flatMap_cons]

theorem wl_drop {g : ℕ → ℕ → α} {u : ℕ} {l : List ℕ} {c : ℕ} (h : c < l.length) :
    wl g u (l.drop c) = (if u < l[c] then [g u l[c]] else []) ++ wl g u (l.drop (c + 1)) := by
  rw [List.drop_eq_getElem_cons h]
  by_cases hu : u < l[c] <;> simp [wl, hu, -List.getElem_cons_drop]

theorem mem_take_succ {l : List ℕ} {c b : ℕ} (h : c < l.length) :
    b ∈ l.take (c + 1) ↔ b ∈ l.take c ∨ b = l[c] := by
  rw [List.take_add_one, List.getElem?_eq_getElem h, Option.toList_some, List.mem_append,
    List.mem_singleton]

theorem wl_take_succ {g : ℕ → ℕ → α} {u : ℕ} {l : List ℕ} {c : ℕ} (h : c < l.length) :
    wl g u (l.take (c + 1)) = wl g u (l.take c) ++ (if u < l[c] then [g u l[c]] else []) := by
  rw [List.take_add_one, List.getElem?_eq_getElem h, Option.toList_some]
  unfold wl
  rw [List.filter_append, List.map_append]
  by_cases hu : u < l[c] <;> simp [hu]

theorem wl_split (g : ℕ → ℕ → α) (u : ℕ) (l : List ℕ) (c : ℕ) :
    wl g u l = wl g u (l.take c) ++ wl g u (l.drop c) := by
  conv_lhs => rw [← List.take_append_drop c l]
  unfold wl
  rw [List.filter_append, List.map_append]

end Weights

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs
