def CellRegR (r : ℕ) : Prop := r = 19 ∨ r = 21 ∨ r = 22 ∨ r = 31

/-- The registers that the loop over the rows may change. -/
def RowRegR (r : ℕ) : Prop := CellRegR r ∨ r = 25 ∨ r = 26 ∨ r = 27 ∨ r = 29

/-- The registers that the rounds may change. -/
def FwRegR (r : ℕ) : Prop := RowRegR r ∨ r = 15 ∨ r = 18 ∨ r = 28

