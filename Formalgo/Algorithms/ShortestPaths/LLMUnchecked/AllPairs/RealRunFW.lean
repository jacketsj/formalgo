/-- The matrix `D` is in the data memory. -/
def MatR (d : ℕ → ℝ) (Z n : ℕ) (D : ℕ → ℕ → ℝ≥0) : Prop :=
  ∀ a < n, ∀ b < n, d (hdr Z n a + 1 + b) = (D a b : ℝ)

theorem MatR.congr {d : ℕ → ℝ} {Z n : ℕ} {D D' : ℕ → ℕ → ℝ≥0} (h : MatR d Z n D)
    (hD : ∀ a < n, ∀ b < n, D a b = D' a b) : MatR d Z n D' :=
  fun a ha b hb => by rw [h a ha b hb, hD a ha b hb]

theorem DRuns.iteCopy {l r p q : ℕ} {s : DState} :
    DRuns (.ite l r (.dcopy p q) .skip) s fun s' k => s'.m = s.m ∧
      s'.d (s.m p) = (if s.m l = s.m r then s.d (s.m q) else s.d (s.m p)) ∧
      (∀ a, a ≠ s.m p → s'.d a = s.d a) ∧ k ≤ 3 := by
  refine DRuns.ite (fun h => DRuns.dcopyR fun d' h₁ h₂ => ?_) (fun h => DRuns.skip ?_)
  · exact ⟨rfl, by change d' _ = _; rw [h₁, if_pos h], h₂, le_rfl⟩
  · exact ⟨rfl, by rw [if_neg h], fun _ _ => rfl, by omega⟩

theorem relax_real (x y z : ℝ≥0) :
    (if ((y : ℝ) + z) < x then ((y : ℝ) + z) else (x : ℝ)) = ((min x (y + z) : ℝ≥0) : ℝ) := by
  rw [NNReal.coe_min, NNReal.coe_add, if_lt_eq_min]

