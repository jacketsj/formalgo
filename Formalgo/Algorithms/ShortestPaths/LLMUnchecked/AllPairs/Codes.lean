-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.InputCode

/-!
# The all-pairs codes on the tape

LLM-generated; not checked by a human.

The input `⟨n, G, weight⟩` is written as `n`, then `n` and, for each vertex, its degree and its
neighbours in increasing order, then the number of edges and the weights in lexicographic order of
the edges. The output `⟨n, d⟩` is written as `n, n`, then for each `u` the row `n, d u 0, …`.
-/

namespace Formalgo.Algorithms.ShortestPaths

/-- The all-pairs input type (the proof does not import the statement). -/
abbrev LLMUnchecked.APInput := Σ n, Σ G : SimpleGraph (Fin n), G.edgeSet → ℕ

/-- The all-pairs output type. -/
abbrev LLMUnchecked.APOutput := Σ n, Fin n → Fin n → ℕ

open LLMUnchecked

/-- The weights, in increasing order of the edges. -/
noncomputable def apW (x : APInput) : List ℕ := (edgeList x.2.1).map x.2.2

/-- The parts of the code of an input. -/
noncomputable def apT (x : APInput) : ℕ × List (List ℕ) × List ℕ :=
  (x.1, nbrLists x.2.1, apW x)

section Encode

variable {V : Type*} [Code ℕ V]

theorem encode_ap (x : APInput) : (Code.encode x : List V) = Code.encode (apT x) := by
  obtain ⟨n, G, w⟩ := x
  change (Code.encode n : List V) ++ ((Code.encode G : List V) ++ (Code.encode w : List V)) =
    (Code.encode n : List V) ++ ((Code.encode (nbrLists G) : List V) ++
      (Code.encode (apW ⟨n, G, w⟩) : List V))
  rw [encode_graph_fin, encode_weights]; rfl

theorem encode_fin_fun {n : ℕ} {β : Type*} [Inhabited β] [Code β V] (f : Fin n → β) :
    (Code.encode f : List V) = Code.encode ((List.finRange n).map f) := by
  change (Code.encode (((Set.finite_univ.toFinset : Finset (Fin n)).sort).map f) : List V) = _
  rw [sort_univ_fin]

end Encode

theorem ncode_ap (x : APInput) : ncode x = ncode (apT x) := encode_ap x

theorem wcode_ap (w : ℕ) (x : APInput) : wcode w x = wcode w (apT x) := encode_ap x

theorem ncode_ap_tape (x : APInput) : ncode x = x.1 :: x.1 ::
    ((nbrLists x.2.1).flatMap blk ++ (apW x).length :: apW x) := by
  rw [ncode_ap]
  simp only [apT, ncode_prod, ncode_nat, ncode_list, flatMap_ncode_nats, flatMap_ncode_blk]
  simp [nbrLists]

/-! ### Reading the input -/

section Decode

variable {V : Type*} [Code ℕ V]

theorem decode_apRest_snd {n : ℕ} (s : ℕ → V) :
    (Code.decode s : (Σ G : SimpleGraph (Fin n), G.edgeSet → ℕ) × _).2 =
      (Code.decode s : (List (List ℕ) × List ℕ) × _).2 := by
  rw [decode_sigma (V := V) (α := SimpleGraph (Fin n)) (β := fun G => G.edgeSet → ℕ) s,
    decode_prod (α := List (List ℕ)) (β := List ℕ) s]
  change (Code.decode (Code.decode s : SimpleGraph (Fin n) × (ℕ → V)).2 :
      List ℕ × (ℕ → V)).2 = _
  rw [decode_graph_snd]

end Decode

theorem fits_ap {w : ℕ} {x : APInput} : Fits w x ↔ Fits w (apT x) := by
  unfold Fits; rw [ncode_ap]

theorem layout_ap (x : APInput) : Layout x := fun w hw hf => by
  rw [wcode_ap, ncode_ap]
  exact ((layout_nat _).prod ((layout_list fun _ _ => layout_list fun _ _ => layout_nat _).prod
    (layout_list fun _ _ => layout_nat _))) w hw (fits_ap.1 hf)

theorem skips_ap (x : APInput) : Skips x := fun w hw hf s hs => by
  rw [fits_ap] at hf
  rw [wcode_ap] at hs ⊢
  have h := ((readsBack_nat _).prod ((readsBack_list fun _ _ => readsBack_list fun _ _ =>
    readsBack_nat _).prod (readsBack_list fun _ _ => readsBack_nat _))).skips w hw hf s hs
  rw [decode_prod] at h
  rw [decode_sigma (V := BitVec w) (α := ℕ)
    (β := fun n => Σ G : SimpleGraph (Fin n), G.edgeSet → ℕ) s]
  change (Code.decode (Code.decode s : ℕ × _).2 :
    (Σ G : SimpleGraph (Fin (Code.decode s : ℕ × _).1), G.edgeSet → ℕ) × _).2 = _
  rw [decode_apRest_snd]
  exact h

theorem ncode_ap_ne (x : APInput) : ncode x ≠ [] := by
  rw [ncode_ap_tape]; simp

/-! ### The output -/

section Fun

variable {β : Type*} [Inhabited β] [Code β ℕ] [∀ w, Code β (BitVec w)] {n : ℕ}

omit [∀ w, Code β (BitVec w)] in
theorem ncode_fin_fun (f : Fin n → β) : ncode f = ncode ((List.finRange n).map f) :=
  encode_fin_fun f

omit [∀ w, Code β (BitVec w)] in
theorem fits_fin_fun {w : ℕ} {f : Fin n → β} : Fits w f ↔ Fits w ((List.finRange n).map f) := by
  unfold Fits; rw [ncode_fin_fun]

theorem layout_fin_fun {f : Fin n → β} (h : ∀ a, Layout (f a)) : Layout f := fun w hw hf => by
  rw [show wcode w f = wcode w ((List.finRange n).map f) from encode_fin_fun f, ncode_fin_fun]
  exact layout_list (fun b hb => by
    obtain ⟨a, -, rfl⟩ := List.mem_map.1 hb; exact h a) w hw (fits_fin_fun.1 hf)

theorem readsBack_fin_fun {f : Fin n → β} (h : ∀ a, ReadsBack (f a)) : ReadsBack f :=
  fun w hw hf s hs => by
  have e : wcode w f = wcode w ((List.finRange n).map f) := encode_fin_fun f
  rw [fits_fin_fun] at hf
  rw [e] at hs ⊢
  have h₁ := readsBack_list (l := (List.finRange n).map f) (fun b hb => by
    obtain ⟨a, -, rfl⟩ := List.mem_map.1 hb; exact h a) w hw hf s hs
  change ((fun a => ((Code.decode s : List β × (ℕ → BitVec w)).1).getD (Code.position a)
    default), (Code.decode s : List β × (ℕ → BitVec w)).2) = _
  rw [h₁]
  refine Prod.ext ?_ rfl
  funext a
  simp [position_fin]

end Fun

theorem ncode_apo (y : APOutput) : ncode y = y.1 :: y.1 ::
    (List.finRange y.1).flatMap fun u => y.1 :: (List.finRange y.1).map (y.2 u) := by
  obtain ⟨n, d⟩ := y
  change ncode n ++ ncode d = _
  rw [ncode_nat, ncode_fin_fun, ncode_list, List.flatMap_map]
  simp only [List.length_map, List.length_finRange, List.singleton_append, List.cons.injEq,
    true_and]
  refine List.flatMap_congr fun u _ => ?_
  rw [ncode_fin_fun, ncode_list, flatMap_ncode_nats, List.length_map, List.length_finRange]

theorem layout_apo (y : APOutput) : Layout y := fun w hw hf => by
  obtain ⟨n, d⟩ := y
  have h := ((layout_nat n).prod (layout_fin_fun (f := d) fun u =>
    layout_fin_fun fun _ => layout_nat _)) w hw hf
  exact h

theorem readsBack_apo (y : APOutput) : ReadsBack y := fun w hw hf s hs => by
  obtain ⟨n, d⟩ := y
  have hf' : Fits w (n, d) := hf
  rw [fits_prod] at hf'
  change StartsWith s (wcode w (n, d)) at hs
  rw [wcode_prod] at hs
  have h₁ := readsBack_nat n w hw hf'.1 s hs.append_left
  have h₂ := readsBack_fin_fun (f := d) (fun _ => readsBack_fin_fun fun _ => readsBack_nat _) w hw
    hf'.2 _ hs.append_right
  rw [decode_sigma (V := BitVec w) (α := ℕ) (β := fun n => Fin n → Fin n → ℕ) s, h₁]
  simp only
  rw [h₂]
  refine Prod.ext rfl ?_
  funext i
  change s (i + (wcode w d).length + (wcode w n).length) =
    s (i + (wcode w n ++ wcode w d).length)
  rw [List.length_append]
  congr 1
  omega

end Formalgo.Algorithms.ShortestPaths
