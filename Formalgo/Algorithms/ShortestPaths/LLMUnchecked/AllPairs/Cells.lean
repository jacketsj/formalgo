import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs.Program
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.Run.RunConv

/-!
# The matrix in memory

LLM-generated; not checked by a human.

Row `a` of the output, from `Z`, has its header at `hdr Z n a = Z + 2 + a (n + 1)` and its entries
after it.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs

open Cmd Function

/-- The address of the header of row `a`. -/
def hdr (Z n a : ℕ) : ℕ := Z + 2 + a * (n + 1)

theorem hdr_zero (Z n : ℕ) : hdr Z n 0 = Z + 2 := by simp [hdr]

theorem hdr_succ (Z n a : ℕ) : hdr Z n (a + 1) = hdr Z n a + (n + 1) := by
  simp only [hdr, Nat.succ_mul]; omega

theorem hdr_ge (Z n a : ℕ) : Z + 2 ≤ hdr Z n a := by simp [hdr]

theorem hdr_mono {Z n a a' : ℕ} (h : a < a') : hdr Z n a + (n + 1) ≤ hdr Z n a' := by
  rw [← hdr_succ]; unfold hdr
  have := Nat.mul_le_mul_right (n + 1) (show a + 1 ≤ a' from h)
  omega

theorem hdr_le_of_le {Z n a a' : ℕ} (h : a ≤ a') : hdr Z n a ≤ hdr Z n a' := by
  rcases Nat.lt_or_eq_of_le h with h | rfl
  · have := hdr_mono (Z := Z) (n := n) h; omega
  · exact le_rfl

/-- Entries of different cells are at different addresses. -/
theorem cell_ne {Z n a b a' b' : ℕ} (hb : b < n) (hb' : b' < n) (h : a ≠ a' ∨ b ≠ b') :
    hdr Z n a + 1 + b ≠ hdr Z n a' + 1 + b' := by
  rcases lt_trichotomy a a' with h' | rfl | h'
  · have := hdr_mono (Z := Z) (n := n) h'; omega
  · omega
  · have := hdr_mono (Z := Z) (n := n) h'; omega

/-- Headers are not entries. -/
theorem hdr_ne_cell {Z n a a' b' : ℕ} (hb' : b' < n) : hdr Z n a ≠ hdr Z n a' + 1 + b' := by
  rcases lt_trichotomy a a' with h' | rfl | h'
  · have := hdr_mono (Z := Z) (n := n) h'; omega
  · omega
  · have := hdr_mono (Z := Z) (n := n) h'; omega

/-- An entry of the matrix. -/
def IsCell (Z n a : ℕ) : Prop := ∃ u < n, ∃ v < n, a = hdr Z n u + 1 + v

theorem not_isCell_lt {Z n a : ℕ} (h : a < Z + 3) : ¬ IsCell Z n a := by
  rintro ⟨u, -, v, -, rfl⟩; have := hdr_ge Z n u; omega

theorem not_isCell_hdr {Z n a : ℕ} : ¬ IsCell Z n (hdr Z n a) := by
  rintro ⟨u, -, v, hv, h⟩; exact hdr_ne_cell hv h

theorem not_isCell_ge {Z n a : ℕ} (h : hdr Z n n ≤ a) : ¬ IsCell Z n a := by
  rintro ⟨u, hu, v, hv, rfl⟩; have := hdr_mono (Z := Z) (n := n) hu; omega

/-! ### Loop flags -/

theorem lt_of_flag {x u n : ℕ} (h : x = if u < n then 1 else 0) (h1 : x = 1) : u < n := by
  by_contra h'; rw [if_neg h'] at h; omega

theorem not_lt_of_flag {x u n : ℕ} (h : x = if u < n then 1 else 0) (h1 : x ≠ 1) : ¬ u < n := by
  intro h'; rw [if_pos h'] at h; exact h1 h

/-! ### Conditional stores -/

theorem Runs.iteStore {B l r p s s' : ℕ} {m : Mem} (hl : l < B) (hr : r < B) (hp : p < B)
    (hs : s < B) (hs' : s' < B) :
    Runs B (.ite l r (.store p s) (.store p s')) m fun m' k =>
      m' (m p) = (if m l = m r then m s else m s') ∧ (∀ a, a ≠ m p → m' a = m a) ∧ k ≤ 3 := by
  refine Runs.ite hl hr (fun h => Runs.storeR hp hs fun m' h₁ h₂ => ?_)
    (fun h => Runs.storeR hp hs' fun m' h₁ h₂ => ?_)
  · exact ⟨by rw [h₁, if_pos h], h₂, le_rfl⟩
  · exact ⟨by rw [h₁, if_neg h], h₂, by omega⟩

theorem Runs.iteStoreSkip {B l r p s : ℕ} {m : Mem} (h2 : m p ≠ 2) (hl : l < B) (hr : r < B)
    (hp : p < B) (hs : s < B) (hB : 2 < B) :
    Runs B (.ite l r (.store p s) (seqs [])) m fun m' k =>
      m' (m p) = (if m l = m r then m s else m (m p)) ∧ (∀ a, a ≠ m p → a ≠ 2 → m' a = m a) ∧
        k ≤ 3 := by
  refine Runs.ite hl hr (fun h => Runs.storeR hp hs fun m' h₁ h₂ => ?_)
    (fun h => Runs.seqs_nilR hB fun m' h₁ h₂ => ?_)
  · exact ⟨by rw [h₁, if_pos h], fun a ha _ => h₂ a ha, le_rfl⟩
  · exact ⟨by rw [h₂ _ h2, if_neg h], fun a _ ha => h₂ a ha, by omega⟩

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs
