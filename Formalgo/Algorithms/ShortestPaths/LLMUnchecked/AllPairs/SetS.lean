-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs.Codes
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs.Program

/-!
# Room for the output

LLM-generated; not checked by a human.

The output has `n² + n + 2` numbers, so the register buffer goes at `S = 6 ℓ + 3 n² + 70`: count
the code values (markers `1` at `3 j + 3`), then `n²` by adding `n` (cell `4`) `n` times, in the
cells `5` and `8`, which hold `0` on the tape and are cleared afterwards.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs

open Cmd Function

/-- `M[0] := 6 ℓ + 3 n² + 70`. -/
def setS : Cmd := seqs [const 0 3, load 2 0,
  loop 2 3 (seq (const 2 3) (seq (add 0 0 2) (load 2 0))),
  less 2 8 4, loop 2 3 (seq (add 5 5 4) (seq (add 8 8 3) (less 2 8 4))),
  add 0 0 0, add 0 0 5, add 0 0 5, add 0 0 5, const 2 64, add 0 0 2, const 5 0, const 8 0]

theorem n_le_length (x : APInput) : x.1 + 3 ≤ (ncode x).length := by
  rw [ncode_ap_tape]
  have := length_blocks x.2.1
  simp only [List.length_cons, List.length_append]
  omega

set_option maxHeartbeats 800000 in
-- Two loops and a straight-line tail.
theorem setS_spec : SetSSpec (I := APInput) setS
    fun x => 6 * (ncode x).length + 3 * (x.1 * x.1) + 70 := by
  intro B w x hne hB
  beta_reduce at hB ⊢
  have hflag : ∀ j, j ≤ (ncode x).length →
      initMem w x (3 * j + 3) = if j < (ncode x).length then 1 else 0 := by
    intro j _
    rw [initMem_code, show 3 * j + 3 = 3 * (j + 1) by omega, tripleNat_getD_mul]
    simp
  have hl : 0 < (ncode x).length := List.length_pos_of_ne_nil hne
  have h4 : initMem w x 4 = x.1 := by
    rw [show 4 = 3 * 0 + 4 from rfl, initMem_code_elem hl, ncode_ap_tape]; rfl
  have h5 : initMem w x 5 = 0 := by
    rw [initMem_code]; exact tripleNat_getD_mul_two _ 1
  have h8 : initMem w x 8 = 0 := by
    rw [initMem_code]; exact tripleNat_getD_mul_two _ 2
  have hnl := n_le_length x
  generalize x.1 = n at hB hnl h4 ⊢
  generalize initMem w x = m₀ at hflag h4 h5 h8 ⊢
  generalize (ncode x).length = ℓ at hflag hl hB hnl ⊢
  have h3 : m₀ 3 = 1 := by have := hflag 0 (by omega); rwa [if_pos hl] at this
  suffices h : Runs B setS m₀ fun m' k => m' 0 = 6 * ℓ + 3 * (n * n) + 70 ∧
      (∀ a, a ≠ 0 → a ≠ 2 → m' a = m₀ a) ∧ k ≤ 10 * ℓ + 20 by
    obtain ⟨m', k, e, h1, h2, h3⟩ := h
    exact ⟨m', k, e, h1, h2, h3⟩
  have hnn : n * n + n ≤ 3 * (n * n) + n + 1 := by omega
  xs; xs; xs; xs
  rename_i m₁ g₁ f₁ m₂ g₂ f₂
  -- Count the code values.
  refine Runs.seqs_cons (Runs.mono (Q := fun m s => m 0 = 3 * ℓ + 3 ∧ m 2 = 0 ∧
      (∀ a, a ≠ 0 → a ≠ 2 → m a = m₀ a) ∧ s ≤ 5 * ℓ + 1)
    (Runs.loop (fun m s => ∃ j ≤ ℓ, m 0 = 3 * j + 3 ∧ m 2 = (if j < ℓ then 1 else 0) ∧
      (∀ a, a ≠ 0 → a ≠ 2 → m a = m₀ a) ∧ s ≤ 5 * j)
    (fun m => 3 * ℓ + 3 - m 0) (by omega) (by omega) ?_ ?_
    ⟨0, by omega, by rd, by rw [g₂, g₁, f₁ 3 (by decide), h3, if_pos hl],
      fun a h0 h2 => by rw [f₂ a h2, f₁ a h0], le_rfl⟩) ?_)
  · rintro m s ⟨j, hj, e0, e2, hfr, hs⟩ heq
    have hjl : j < ℓ := by
      by_contra h
      rw [e2, if_neg h, hfr 3 (by decide) (by decide), h3] at heq
      exact absurd heq (by decide)
    have hf1 : m₀ (3 * (j + 1) + 3) = if j + 1 < ℓ then 1 else 0 := hflag (j + 1) (by omega)
    xs; xs; xs; xs; xs
    rename_i m₃ g₃ f₃ m₄ g₄ f₄ m₅ g₅ f₅
    have e4 : m₄ 0 = 3 * (j + 1) + 3 := by rw [g₄, f₃ 0 (by decide), g₃, e0]; omega
    refine ⟨⟨j + 1, by omega, by rw [f₅ 0 (by decide), e4], ?_, fun a h0 h2 => ?_, by omega⟩,
      by rw [f₅ 0 (by decide), e4, e0]; omega⟩
    · rw [g₅, e4, f₄ _ (by omega), f₃ _ (by omega), hfr _ (by omega) (by omega), hf1]
    · rw [f₅ a h2, f₄ a h0, f₃ a h2, hfr a h0 h2]
  · rintro m s ⟨j, hj, e0, e2, hfr, hs⟩ hne
    have hjl : j = ℓ := by
      by_contra h
      exact hne (by rw [e2, if_pos (by omega), hfr 3 (by decide) (by decide), h3])
    subst hjl
    exact ⟨e0, by rw [e2, if_neg (by omega)], hfr, by omega⟩
  rintro m₃ k₃ ⟨e0, e2, hfr, hk₃⟩
  -- `n²`.
  have e8 : m₃ 8 = 0 := by rw [hfr 8 (by decide) (by decide), h8]
  have e5 : m₃ 5 = 0 := by rw [hfr 5 (by decide) (by decide), h5]
  have e4 : m₃ 4 = n := by rw [hfr 4 (by decide) (by decide), h4]
  have e3 : m₃ 3 = 1 := by rw [hfr 3 (by decide) (by decide), h3]
  xs; xs
  rename_i m₄ g₄ f₄
  refine Runs.seqs_cons (Runs.mono (Q := fun m s => m 0 = 3 * ℓ + 3 ∧ m 5 = n * n ∧
      (∀ a, a ≠ 0 → a ≠ 2 → a ≠ 5 → a ≠ 8 → m a = m₀ a) ∧ s ≤ 5 * n + 1)
    (Runs.loop (fun m s => ∃ c ≤ n, m 0 = 3 * ℓ + 3 ∧ m 8 = c ∧ m 5 = c * n ∧
      m 2 = (if c < n then 1 else 0) ∧ (∀ a, a ≠ 0 → a ≠ 2 → a ≠ 5 → a ≠ 8 → m a = m₀ a) ∧
      s ≤ 5 * c)
    (fun m => n - m 8) (by omega) (by omega) ?_ ?_
    ⟨0, by omega, by rd, by rd, by rw [f₄ 5 (by decide), e5]; simp, by rd,
      fun a h0 h2 h5 h8 => by rw [f₄ a h2, hfr a h0 h2], le_rfl⟩) ?_)
  · rintro m s ⟨c, hc, e0', e8', e5', e2', hfr', hs⟩ heq
    have e3' : m 3 = 1 := by rw [hfr' 3 (by decide) (by decide) (by decide) (by decide), h3]
    have e4' : m 4 = n := by rw [hfr' 4 (by decide) (by decide) (by decide) (by decide), h4]
    have hcn : c < n := by
      by_contra h; rw [e2', if_neg h, e3'] at heq; exact absurd heq (by decide)
    have hcn' : c * n + n ≤ n * n := by
      have := Nat.mul_le_mul_right n (show c + 1 ≤ n by omega)
      rw [Nat.succ_mul] at this; omega
    refine Runs.seq (Runs.addR (by omega) (by omega) (by omega) (by rw [e5', e4']; omega)
      fun m₅ g₅ f₅ => ?_)
    refine Runs.seq (Runs.addR (by omega) (by omega) (by omega)
      (by rw [f₅ 8 (by decide), f₅ 3 (by decide), e8', e3']; omega) fun m₆ g₆ f₆ => ?_)
    refine Runs.lessR (by omega) (by omega) (by omega) fun m₇ g₇ f₇ => ?_
    have e8'' : m₆ 8 = c + 1 := by rw [g₆, f₅ 8 (by decide), f₅ 3 (by decide), e8', e3']
    refine ⟨⟨c + 1, hcn, by rw [f₇ 0 (by decide), f₆ 0 (by decide), f₅ 0 (by decide), e0'],
      by rw [f₇ 8 (by decide), e8''], ?_, ?_, fun a h0 h2 h5 h8 => ?_, by omega⟩, ?_⟩
    · rw [f₇ 5 (by decide), f₆ 5 (by decide), g₅, e5', e4', Nat.succ_mul]
    · rw [g₇, e8'', f₆ 4 (by decide), f₅ 4 (by decide), e4']
    · rw [f₇ a h2, f₆ a h8, f₅ a h5, hfr' a h0 h2 h5 h8]
    · rw [f₇ 8 (by decide), e8'', e8']; omega
  · rintro m s ⟨c, hc, e0', e8', e5', e2', hfr', hs⟩ hne
    have e3' : m 3 = 1 := by rw [hfr' 3 (by decide) (by decide) (by decide) (by decide), h3]
    have hcn : c = n := by
      by_contra h; exact hne (by rw [e2', if_pos (by omega), e3'])
    subst hcn
    exact ⟨e0', e5', hfr', by omega⟩
  rintro m₅ k₅ ⟨e0', e5', hfr', hk₅⟩
  -- The tail.
  xs; xs; xs; xs; xs; xs; xs; xs; xs; xs; xs; xs; xs; xs; xs; xs; xs
  refine ⟨by rd, fun a h0 h2 => ?_, by omega⟩
  by_cases h5 : a = 5
  · subst h5; rw [h5]; rd
  by_cases h8 : a = 8
  · subst h8; rw [h8]; rd
  rw [← hfr' a h0 h2 h5 h8]; rd

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked.AllPairs
