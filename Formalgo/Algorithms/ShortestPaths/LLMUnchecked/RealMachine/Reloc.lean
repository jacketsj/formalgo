-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.Compile
import Mathlib.Data.List.GetD

/-!
# Moving a list into the data memory

LLM-generated; not checked by a human.

`reloc` moves a list `P` of length `S` from real RAM cells `[D, D + S)` (with `S` in cell `0`, `D`
in cell `1`, and cells from `D + S` blank) to data cells `[0, S)`, zeroes every other index and
data cell, and puts `S` in index cell `0`: the memory then holds `DState.input P`.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked

open Function

/-- Copy `P` to the data cells: `dcell i := M[D + i]` for `i < S`. -/
noncomputable def relocCopy : RCmd :=
  .loopNe 2 0 (.seqs [.add 5 1 2, .load 6 5, .add 5 2 2, .const 4 9, .add 5 5 4, .store 5 6,
    .add 2 2 7])

/-- Zero `M[2 i + off]` for `i` from `M[2]` up to `M[3]`. -/
noncomputable def relocZero (off : ℕ) : RCmd :=
  .loopNe 2 3 (.seqs [.add 5 2 2, .const 4 (off : ℝ), .add 5 5 4, .const 6 0, .store 5 6,
    .add 2 2 7])

/-- The relocation. -/
noncomputable def reloc : RCmd :=
  .seqs [.const 7 1, .const 2 0, relocCopy, .add 3 1 0, .const 2 0, relocZero 8, .copy 2 0,
    relocZero 9, .copy 8 0]

theorem cast_add_cast (a b : ℕ) : (a : ℝ) + (b : ℝ) = ((a + b : ℕ) : ℝ) := by push_cast; ring

section

variable {M : RMem} {S D : ℕ} {P : List ℝ}

theorem relocCopy_runs (hP : P.length = S) (hD : S + 9 ≤ D) (h0 : M 0 = S) (h1 : M 1 = D)
    (h2 : M 2 = 0) (h7 : M 7 = 1) (hsrc : ∀ i (h : i < S), M (D + i) = P[i]) :
    RRuns relocCopy M fun M' k => M' 0 = S ∧ M' 1 = D ∧ M' 7 = 1 ∧
      (∀ a, 8 ≤ a → M' a = if 9 ≤ a ∧ a % 2 = 1 ∧ (a - 9) / 2 < S then P.getD ((a - 9) / 2) 0
        else M a) ∧ k ≤ 9 * S + 1 := by
  refine RRuns.loopNe (fun M' n => ∃ i ≤ S, M' 0 = S ∧ M' 1 = D ∧ M' 7 = 1 ∧ M' 2 = i ∧
      (∀ a, 8 ≤ a → M' a = if 9 ≤ a ∧ a % 2 = 1 ∧ (a - 9) / 2 < i then P.getD ((a - 9) / 2) 0
        else M a) ∧ n ≤ 9 * i)
    (fun M' => S - ⌊M' 2⌋₊) ?_ ?_ ⟨0, by omega, h0, h1, h7, by simp [h2], fun a _ => by
      simp, by omega⟩
  · rintro M' n ⟨i, hi, e0, e1, e7, e2, hm, hn⟩ hne
    have hiS : i < S := by
      rcases Nat.lt_or_ge i S with h | h
      · exact h
      · exact absurd (by rw [e2, e0, show i = S by omega]) hne
    have hsrc' : M' (D + i) = P[i] := by
      rw [hm _ (by omega), if_neg (by omega)]; exact hsrc i hiS
    rr; rr; rename_i M₁ g₁ f₁
    rr; refine RRuns.loadR (D + i) (by rw [g₁, e1, e2]; push_cast; ring) ?_; intro M₂ g₂ f₂
    rr; rr; rename_i M₃ g₃ f₃
    rr; rr; rename_i M₄ g₄ f₄
    rr; rr; rename_i M₅ g₅ f₅
    rr; refine RRuns.storeR (2 * i + 9) (by rv) ?_; intro M₆ g₆ f₆
    rr; rr; rename_i M₇ g₇ f₇
    rr
    have v2 : M₇ 2 = ((i + 1 : ℕ) : ℝ) := by rv
    refine ⟨⟨i + 1, by omega, by rv, by rv, by rv, v2, fun a ha => ?_, by omega⟩, ?_⟩
    · rw [f₇ a (by omega)]
      by_cases hai : a = 2 * i + 9
      · subst hai
        rw [g₆, if_pos (by omega), show (2 * i + 9 - 9) / 2 = i by omega,
          List.getD_eq_getElem _ _ (by omega), f₅ 6 (by omega), f₄ 6 (by omega),
          f₃ 6 (by omega), g₂, f₁ _ (by omega), hsrc']
      · rw [f₆ a hai, f₅ a (by omega), f₄ a (by omega), f₃ a (by omega), f₂ a (by omega),
          f₁ a (by omega), hm a ha]
        congr 1; apply propext; omega
    · rw [v2, e2, Nat.floor_natCast, Nat.floor_natCast]; omega
  · rintro M' n ⟨i, hi, e0, e1, e7, e2, hm, hn⟩ heq
    have hiS : i = S := by rw [e2, e0] at heq; exact_mod_cast heq
    subst hiS
    exact ⟨e0, e1, e7, hm, by omega⟩

end

theorem relocZero_runs {M : RMem} (off i₀ N : ℕ) (hoff : 8 ≤ off) (hi₀ : i₀ ≤ N)
    (h2 : M 2 = i₀) (h3 : M 3 = N) (h7 : M 7 = 1) :
    RRuns (relocZero off) M fun M' k => M' 0 = M 0 ∧ M' 1 = M 1 ∧ M' 3 = N ∧ M' 7 = 1 ∧
      (∀ a, 8 ≤ a → M' a = if off ≤ a ∧ (a - off) % 2 = 0 ∧ i₀ ≤ (a - off) / 2 ∧
        (a - off) / 2 < N then 0 else M a) ∧ k ≤ 8 * (N - i₀) + 1 := by
  refine RRuns.loopNe (fun M' n => ∃ i, i₀ ≤ i ∧ i ≤ N ∧ M' 0 = M 0 ∧ M' 1 = M 1 ∧ M' 3 = N ∧
      M' 7 = 1 ∧ M' 2 = i ∧ (∀ a, 8 ≤ a → M' a = if off ≤ a ∧ (a - off) % 2 = 0 ∧
        i₀ ≤ (a - off) / 2 ∧ (a - off) / 2 < i then 0 else M a) ∧ n ≤ 8 * (i - i₀))
    (fun M' => N - ⌊M' 2⌋₊) ?_ ?_ ⟨i₀, le_rfl, hi₀, rfl, rfl, h3, h7, h2, fun a _ => by
      rw [if_neg (by omega)], by omega⟩
  · rintro M' n ⟨i, hi₀', hi, e0, e1, e3, e7, e2, hm, hn⟩ hne
    have hiN : i < N := by
      rcases Nat.lt_or_ge i N with h | h
      · exact h
      · exact absurd (by rw [e2, e3, show i = N by omega]) hne
    rr; rr; rename_i M₁ g₁ f₁
    rr; rr; rename_i M₂ g₂ f₂
    rr; rr; rename_i M₃ g₃ f₃
    rr; rr; rename_i M₄ g₄ f₄
    rr; refine RRuns.storeR (2 * i + off) (by rv) ?_; intro M₅ g₅ f₅
    rr; rr; rename_i M₆ g₆ f₆
    rr
    have v2 : M₆ 2 = ((i + 1 : ℕ) : ℝ) := by rv
    refine ⟨⟨i + 1, by omega, by omega, by rv, by rv, by rv, by rv, v2, fun a ha => ?_,
      by omega⟩, ?_⟩
    · rw [f₆ a (by omega)]
      by_cases hai : a = 2 * i + off
      · subst hai
        rw [g₅, g₄, if_pos (by omega)]
      · rw [f₅ a hai, f₄ a (by omega), f₃ a (by omega), f₂ a (by omega), f₁ a (by omega),
          hm a ha]
        congr 1; apply propext; omega
    · rw [v2, e2, Nat.floor_natCast, Nat.floor_natCast]; omega
  · rintro M' n ⟨i, hi₀', hi, e0, e1, e3, e7, e2, hm, hn⟩ heq
    have hiN : i = N := by rw [e2, e3] at heq; exact_mod_cast heq
    subst hiN
    exact ⟨e0, e1, e3, e7, hm, by omega⟩

/-- The relocation leaves `DState.input P` in the memory. -/
theorem reloc_runs {M : RMem} {S D : ℕ} {P : List ℝ} (hP : P.length = S) (hD : S + 9 ≤ D)
    (h0 : M 0 = S) (h1 : M 1 = D) (hsrc : ∀ i (h : i < S), M (D + i) = P[i])
    (hblank : ∀ a, D + S ≤ a → M a = 0) :
    RRuns reloc M fun M' k => Agree (DState.input P) M' ∧ k ≤ 40 * D + 40 := by
  rr; rr; rename_i M₁ g₁ f₁
  rr; rr; rename_i M₂ g₂ f₂
  rr
  refine RRuns.mono (relocCopy_runs hP hD (by rv) (by rv) (by rv) (by rv)
    (fun i hi => by rw [f₂ _ (by omega), f₁ _ (by omega)]; exact hsrc i hi)) ?_
  rintro M₃ k₃ ⟨e0, e1, e7, hm₃, hk₃⟩
  rr; rr; rename_i M₄ g₄ f₄
  rr; rr; rename_i M₅ g₅ f₅
  rr
  refine RRuns.mono (relocZero_runs (M := M₅) 8 0 (D + S) le_rfl (by omega) (by rv)
    (by rw [f₅ 3 (by omega), g₄, e1, e0]; push_cast; ring) (by rv)) ?_
  rintro M₆ k₆ ⟨e0₆, e1₆, e3₆, e7₆, hm₆, hk₆⟩
  rr; rr; rename_i M₇ g₇ f₇
  rr
  refine RRuns.mono (relocZero_runs (M := M₇) 9 S (D + S) (by omega) (by omega)
    (by rw [g₇, e0₆, f₅ 0 (by omega), f₄ 0 (by omega), e0]) (by rv) (by rv)) ?_
  rintro M₈ k₈ ⟨e0₈, e1₈, e3₈, e7₈, hm₈, hk₈⟩
  rr; rr; rename_i M₉ g₉ f₉
  rr
  have hS₉ : M₉ 8 = S := by
    rw [g₉, e0₈, f₇ 0 (by omega), e0₆, f₅ 0 (by omega), f₄ 0 (by omega), e0]
  -- The memory before the zeroing loops, from cell `8`.
  have hmid : ∀ a, 8 ≤ a → M₅ a = if 9 ≤ a ∧ a % 2 = 1 ∧ (a - 9) / 2 < S then
      P.getD ((a - 9) / 2) 0 else M a := fun a ha => by
    rw [f₅ a (by omega), f₄ a (by omega), hm₃ a ha, f₂ a (by omega), f₁ a (by omega)]
  refine ⟨⟨fun a => ?_, fun a => ?_⟩, by omega⟩
  · -- Index cells.
    simp only [DState.input, icell]
    by_cases ha : a = 0
    · subst ha; simp [hS₉, hP]
    · rw [if_neg ha, f₉ _ (by omega), hm₈ _ (by omega), if_neg (by omega), f₇ _ (by omega),
        hm₆ _ (by omega)]
      by_cases hlt : a < D + S
      · rw [if_pos (by omega)]; simp
      · rw [if_neg (by omega), hmid _ (by omega), if_neg (by omega), hblank _ (by omega)]
        simp
  · -- Data cells.
    simp only [DState.input, dcell]
    rw [f₉ _ (by omega), hm₈ _ (by omega)]
    by_cases hS : a < S
    · rw [if_neg (by omega), f₇ _ (by omega), hm₆ _ (by omega), if_neg (by omega),
        hmid _ (by omega), if_pos (by omega), show (2 * a + 9 - 9) / 2 = a by omega]
    · rw [List.getD_eq_default _ _ (by omega)]
      by_cases hlt : a < D + S
      · rw [if_pos (by omega)]
      · rw [if_neg (by omega), f₇ _ (by omega), hm₆ _ (by omega), if_neg (by omega),
          hmid _ (by omega), if_neg (by omega), hblank _ (by omega)]

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked
