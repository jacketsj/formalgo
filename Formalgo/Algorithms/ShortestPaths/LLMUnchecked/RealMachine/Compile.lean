-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.Raw

/-!
# Compiling commands with real data to the real RAM

LLM-generated; not checked by a human.

Real RAM cells `0, …, 7` are scratch, index cell `a` is cell `icell a = 2 a + 8` and data cell `a`
is cell `dcell a = 2 a + 9`, so the two memories are disjoint. `DCmd.toRaw` translates a command;
`DExec.toRaw` shows the translation follows `DExec`, with each unit of cost at most `13` real RAM
steps.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked

open Function

/-- The real RAM cell of index cell `a`. -/
def icell (a : ℕ) : ℕ := 2 * a + 8

/-- The real RAM cell of data cell `a`. -/
def dcell (a : ℕ) : ℕ := 2 * a + 9

/-- A real RAM memory holds a state: index cell `a` at `icell a`, data cell `a` at `dcell a`. -/
def Agree (s : DState) (M : RMem) : Prop :=
  (∀ a, M (icell a) = (s.m a : ℝ)) ∧ ∀ a, M (dcell a) = s.d a

theorem icell_ne_dcell (a b : ℕ) : icell a ≠ dcell b := by unfold icell dcell; omega

namespace Agree

variable {s : DState} {M : RMem}

theorem temp (h : Agree s M) {t : ℕ} (ht : t < 8) (v : ℝ) : Agree s (update M t v) := by
  refine ⟨fun a => ?_, fun a => ?_⟩
  · rw [update_of_ne (by unfold icell; omega)]; exact h.1 a
  · rw [update_of_ne (by unfold dcell; omega)]; exact h.2 a

theorem frame (h : Agree s M) {M' : RMem} (hf : ∀ a, 8 ≤ a → M' a = M a) : Agree s M' :=
  ⟨fun a => by rw [hf _ (by unfold icell; omega)]; exact h.1 a,
    fun a => by rw [hf _ (by unfold dcell; omega)]; exact h.2 a⟩

theorem idx (h : Agree s M) (d v : ℕ) :
    Agree ⟨update s.m d v, s.d⟩ (update M (icell d) (v : ℝ)) := by
  refine ⟨fun a => ?_, fun a => ?_⟩
  · by_cases ha : a = d
    · subst ha; simp
    · rw [update_of_ne (by unfold icell; omega)]; simp [ha, h.1 a]
  · rw [update_of_ne (icell_ne_dcell d a).symm]; exact h.2 a

theorem dat (h : Agree s M) (b : ℕ) (v : ℝ) :
    Agree ⟨s.m, update s.d b v⟩ (update M (dcell b) v) := by
  refine ⟨fun a => ?_, fun a => ?_⟩
  · rw [update_of_ne (icell_ne_dcell a b)]; exact h.1 a
  · by_cases ha : a = b
    · subst ha; simp
    · rw [update_of_ne (by unfold dcell; omega)]; simp [ha, h.2 a]

end Agree

/-- `M[t] := 2 M[icell p] + off`, using scratch cell `1`. -/
noncomputable def addrOf (t p off : ℕ) : RCmd :=
  .seqs [.add t (icell p) (icell p), .const 1 (off : ℝ), .add t t 1]

theorem addrOf_runs {s : DState} {M : RMem} (h : Agree s M) (p off : ℕ) {Q : RMem → ℕ → Prop}
    (hQ : ∀ M', Agree s M' → M' 0 = ((2 * s.m p + off : ℕ) : ℝ) → (∀ a, 2 ≤ a → M' a = M a) →
      Q M' 3) :
    RRuns (addrOf 0 p off) M Q := by
  refine RRuns.seqs_cons (RRuns.add (RRuns.seqs_cons (RRuns.const (RRuns.seqs_cons
    (RRuns.add (RRuns.seqs_nil ?_))))))
  refine hQ _ (((h.temp (by omega) _).temp (by omega) _).temp (by omega) _) ?_ (fun a ha => ?_)
  · simp [h.1 p]; ring
  · simp [show a ≠ 0 by omega, show a ≠ 1 by omega]

/-! ### Index commands -/

/-- The real RAM command for an index command. -/
noncomputable def Cmd.toRaw : Cmd → RCmd
  | .const d v => .const (icell d) (v : ℝ)
  | .copy d s => .copy (icell d) (icell s)
  | .load d p => .seq (addrOf 0 p 8) (.load (icell d) 0)
  | .store p s => .seq (addrOf 0 p 8) (.store 0 (icell s))
  | .add d l r => .add (icell d) (icell l) (icell r)
  | .sub d l r => .sub (icell d) (icell l) (icell r)
  | .less d l r => .less (icell d) (icell l) (icell r)
  | .seq a b => .seq a.toRaw b.toRaw
  | .ite l r t e => .ite (icell l) (icell r) t.toRaw e.toRaw
  | .loop l r body => .loop (icell l) (icell r) body.toRaw

theorem two_mul_add_eight (a : ℕ) : 2 * a + 8 = icell a := rfl

/-- A translated index command follows `Exec`, within `4` real RAM steps per unit of cost. -/
theorem Exec.toRaw {B : ℕ} {c : Cmd} {m m' : Mem} {k : ℕ} (hE : Exec B c m k m') :
    ∀ (d : ℕ → ℝ) (M : RMem), Agree ⟨m, d⟩ M →
      ∃ M' k', RExec c.toRaw M k' M' ∧ Agree ⟨m', d⟩ M' ∧ k' ≤ 4 * k := by
  induction hE with
  | @const m dd v _ _ =>
    intro d M hA
    exact ⟨_, 1, .const, hA.idx dd v, by omega⟩
  | @copy m dd x _ _ =>
    intro d M hA
    refine ⟨_, 1, .copy, ?_, by omega⟩
    rw [hA.1 x]; exact hA.idx dd (m x)
  | @load m dd p _ _ =>
    intro d M hA
    refine addrOf_runs hA p 8 (Q := fun M₁ k₁ => ∃ M' k', RExec (.load (icell dd) 0) M₁ k' M' ∧
      Agree ⟨update m dd (m (m p)), d⟩ M' ∧ k₁ + k' ≤ 4 * 1) (fun M₁ hA₁ h₁0 _ => ?_)
      |> fun ⟨M₁, k₁, e₁, M', k', e', hA', hk⟩ => ⟨M', k₁ + k', .seq e₁ e', hA', hk⟩
    refine ⟨_, 1, .load _ h₁0, ?_, by omega⟩
    rw [two_mul_add_eight, hA₁.1 (m p)]; exact hA₁.idx dd _
  | @store m p x _ _ =>
    intro d M hA
    refine addrOf_runs hA p 8 (Q := fun M₁ k₁ => ∃ M' k', RExec (.store 0 (icell x)) M₁ k' M' ∧
      Agree ⟨update m (m p) (m x), d⟩ M' ∧ k₁ + k' ≤ 4 * 1) (fun M₁ hA₁ h₁0 _ => ?_)
      |> fun ⟨M₁, k₁, e₁, M', k', e', hA', hk⟩ => ⟨M', k₁ + k', .seq e₁ e', hA', hk⟩
    refine ⟨_, 1, .store _ h₁0, ?_, by omega⟩
    rw [two_mul_add_eight, hA₁.1 x]; exact hA₁.idx (m p) _
  | @add m dd l r _ _ _ _ =>
    intro d M hA
    refine ⟨_, 1, .add, ?_, by omega⟩
    rw [hA.1 l, hA.1 r, ← Nat.cast_add]; exact hA.idx dd _
  | @sub m dd l r _ _ _ hle =>
    intro d M hA
    refine ⟨_, 1, .sub, ?_, by omega⟩
    rw [hA.1 l, hA.1 r, ← Nat.cast_sub hle]; exact hA.idx dd _
  | @less m dd l r _ _ _ =>
    intro d M hA
    refine ⟨_, 1, .less, ?_, by omega⟩
    rw [hA.1 l, hA.1 r, show (if (m l : ℝ) < (m r : ℝ) then (1 : ℝ) else 0) =
      ((if m l < m r then 1 else 0 : ℕ) : ℝ) by split_ifs <;> simp_all]
    exact hA.idx dd _
  | @seq a b m k₁ m₁ k₂ m₂ _ _ iha ihb =>
    intro d M hA
    obtain ⟨M₁, k₁', e₁, hA₁, hk₁⟩ := iha d M hA
    obtain ⟨M₂, k₂', e₂, hA₂, hk₂⟩ := ihb d M₁ hA₁
    exact ⟨M₂, k₁' + k₂', .seq e₁ e₂, hA₂, by omega⟩
  | @iteTrue l r t e m k m' _ _ heq _ iht =>
    intro d M hA
    obtain ⟨M', k', e', hA', hk⟩ := iht d M hA
    exact ⟨M', k' + 2, .iteTrue (by rw [hA.1 l, hA.1 r]; exact congrArg Nat.cast heq) e', hA',
      by omega⟩
  | @iteFalse l r t e m k m' _ _ hne _ ihe =>
    intro d M hA
    obtain ⟨M', k', e', hA', hk⟩ := ihe d M hA
    exact ⟨M', k' + 1, .iteFalse (by rw [hA.1 l, hA.1 r]; exact_mod_cast hne) e', hA', by omega⟩
  | @loopTrue l r body m k₁ m₁ k₂ m₂ _ _ heq _ _ ihb ihl =>
    intro d M hA
    obtain ⟨M₁, k₁', e₁, hA₁, hk₁⟩ := ihb d M hA
    obtain ⟨M₂, k₂', e₂, hA₂, hk₂⟩ := ihl d M₁ hA₁
    exact ⟨M₂, k₁' + k₂' + 2,
      .loopTrue (by rw [hA.1 l, hA.1 r]; exact congrArg Nat.cast heq) e₁ e₂, hA₂, by omega⟩
  | @loopFalse l r body m _ _ hne =>
    intro d M hA
    exact ⟨M, 1, .loopFalse (by rw [hA.1 l, hA.1 r]; exact_mod_cast hne), hA, by omega⟩

/-! ### Commands with real data -/

/-- The real RAM command for a command with real data. -/
noncomputable def DCmd.toRaw : DCmd → RCmd
  | .idx c => c.toRaw
  | .skip => .skip
  | .dconst p v => .seqs [addrOf 0 p 9, .const 1 v, .store 0 1]
  | .dcopy p q => .seqs [addrOf 0 q 9, .load 2 0, addrOf 0 p 9, .store 0 2]
  | .dadd p q r =>
    .seqs [addrOf 0 q 9, .load 2 0, addrOf 0 r 9, .load 3 0, .add 2 2 3, addrOf 0 p 9, .store 0 2]
  | .dsub p q r =>
    .seqs [addrOf 0 q 9, .load 2 0, addrOf 0 r 9, .load 3 0, .sub 2 2 3, addrOf 0 p 9, .store 0 2]
  | .dless x q r => .seqs [addrOf 0 q 9, .load 2 0, addrOf 0 r 9, .load 3 0, .less (icell x) 2 3]
  | .toIdx x p => .seqs [addrOf 0 p 9, .load (icell x) 0]
  | .ofIdx p x => .seqs [addrOf 0 p 9, .store 0 (icell x)]
  | .seq a b => .seq a.toRaw b.toRaw
  | .ite l r t e => .ite (icell l) (icell r) t.toRaw e.toRaw
  | .loop l r body => .loop (icell l) (icell r) body.toRaw

theorem two_mul_add_nine (a : ℕ) : 2 * a + 9 = dcell a := rfl

/-- Two values of data cells into scratch cells `2` and `3`. -/
theorem load2_runs {s : DState} {M : RMem} (h : Agree s M) (q r : ℕ) {cs : List RCmd}
    {Q : RMem → ℕ → Prop}
    (hQ : ∀ M', Agree s M' → M' 2 = s.d (s.m q) → M' 3 = s.d (s.m r) →
      RRuns (.seqs cs) M' fun M'' k => Q M'' (8 + k)) :
    RRuns (.seqs (addrOf 0 q 9 :: .load 2 0 :: addrOf 0 r 9 :: .load 3 0 :: cs)) M Q := by
  refine RRuns.seqs_cons (addrOf_runs h q 9 fun M₁ hA₁ h₁0 h₁f => ?_)
  refine RRuns.seqs_cons (RRuns.load _ h₁0 ?_)
  have hA₂ := hA₁.temp (show 2 < 8 by omega) (M₁ (2 * s.m q + 9))
  refine RRuns.seqs_cons (addrOf_runs hA₂ r 9 fun M₃ hA₃ h₃0 h₃f => ?_)
  refine RRuns.seqs_cons (RRuns.load _ h₃0 ?_)
  refine RRuns.mono (hQ _ (hA₃.temp (show 3 < 8 by omega) _) ?_ ?_) fun M'' k hq => ?_
  · rw [update_of_ne (by omega), h₃f 2 le_rfl, update_self, two_mul_add_nine,
      h₁f _ (by unfold dcell; omega), h.2]
  · rw [update_self, two_mul_add_nine, h₃f _ (by unfold dcell; omega), update_of_ne
      (by unfold dcell; omega), h₁f _ (by unfold dcell; omega), h.2]
  · rw [show 3 + (1 + (3 + (1 + k))) = 8 + k by omega]; exact hq

/-- A translated command follows `DExec`, within `13` real RAM steps per unit of cost. -/
theorem DExec.toRaw {c : DCmd} {s s' : DState} {k : ℕ} (hE : DExec c s k s') :
    ∀ M, Agree s M → ∃ M' k', RExec c.toRaw M k' M' ∧ Agree s' M' ∧ k' ≤ 13 * k := by
  induction hE with
  | @idx B c m k m' d e =>
    intro M hA
    obtain ⟨M', k', e', hA', hk⟩ := Exec.toRaw e d M hA
    exact ⟨M', k', e', hA', by omega⟩
  | @skip s => intro M hA; exact ⟨M, 0, .skip, hA, by omega⟩
  | @dconst p v s =>
    intro M hA
    change RRuns _ M fun M' k' => Agree _ M' ∧ k' ≤ 13 * 1
    refine RRuns.seqs_cons (addrOf_runs hA p 9 fun M₁ hA₁ h₁0 _ => ?_)
    refine RRuns.seqs_cons (RRuns.const (RRuns.seqs_cons (RRuns.store _ (by
      rw [update_of_ne (by omega)]; exact h₁0) (RRuns.seqs_nil ⟨?_, by omega⟩))))
    rw [update_self, two_mul_add_nine]
    exact (hA₁.temp (show 1 < 8 by omega) v).dat _ _
  | @dcopy p q s =>
    intro M hA
    change RRuns _ M fun M' k' => Agree _ M' ∧ k' ≤ 13 * 1
    refine RRuns.seqs_cons (addrOf_runs hA q 9 fun M₁ hA₁ h₁0 h₁f => ?_)
    refine RRuns.seqs_cons (RRuns.load _ h₁0 ?_)
    refine RRuns.seqs_cons (addrOf_runs (hA₁.temp (show 2 < 8 by omega) _) p 9
      fun M₃ hA₃ h₃0 h₃f => ?_)
    refine RRuns.seqs_cons (RRuns.store _ h₃0 (RRuns.seqs_nil ⟨?_, by omega⟩))
    rw [two_mul_add_nine, h₃f 2 le_rfl, update_self, two_mul_add_nine, h₁f _ (by
      unfold dcell; omega), hA.2]
    exact hA₃.dat _ _
  | @dadd p q r s =>
    intro M hA
    change RRuns _ M fun M' k' => Agree _ M' ∧ k' ≤ 13 * 1
    refine load2_runs hA q r fun M₁ hA₁ h₂ h₃ => ?_
    refine RRuns.seqs_cons (RRuns.add (RRuns.seqs_cons (addrOf_runs
      (hA₁.temp (show 2 < 8 by omega) _) p 9 fun M₅ hA₅ h₅0 h₅f => ?_)))
    refine RRuns.seqs_cons (RRuns.store _ h₅0 (RRuns.seqs_nil ⟨?_, by omega⟩))
    rw [two_mul_add_nine, h₅f 2 le_rfl, update_self, h₂, h₃]
    exact hA₅.dat _ _
  | @dsub p q r s =>
    intro M hA
    change RRuns _ M fun M' k' => Agree _ M' ∧ k' ≤ 13 * 1
    refine load2_runs hA q r fun M₁ hA₁ h₂ h₃ => ?_
    refine RRuns.seqs_cons (RRuns.sub (RRuns.seqs_cons (addrOf_runs
      (hA₁.temp (show 2 < 8 by omega) _) p 9 fun M₅ hA₅ h₅0 h₅f => ?_)))
    refine RRuns.seqs_cons (RRuns.store _ h₅0 (RRuns.seqs_nil ⟨?_, by omega⟩))
    rw [two_mul_add_nine, h₅f 2 le_rfl, update_self, h₂, h₃]
    exact hA₅.dat _ _
  | @dless x q r s =>
    intro M hA
    change RRuns _ M fun M' k' => Agree _ M' ∧ k' ≤ 13 * 1
    refine load2_runs hA q r fun M₁ hA₁ h₂ h₃ => ?_
    refine RRuns.seqs_cons (RRuns.less (RRuns.seqs_nil ⟨?_, by omega⟩))
    rw [h₂, h₃, show (if s.d (s.m q) < s.d (s.m r) then (1 : ℝ) else 0) =
      ((if s.d (s.m q) < s.d (s.m r) then 1 else 0 : ℕ) : ℝ) by split_ifs <;> simp]
    exact hA₁.idx x _
  | @toIdx x p s v hv =>
    intro M hA
    change RRuns _ M fun M' k' => Agree _ M' ∧ k' ≤ 13 * 1
    refine RRuns.seqs_cons (addrOf_runs hA p 9 fun M₁ hA₁ h₁0 _ => ?_)
    refine RRuns.seqs_cons (RRuns.load _ h₁0 (RRuns.seqs_nil ⟨?_, by omega⟩))
    rw [two_mul_add_nine, hA₁.2, hv]
    exact hA₁.idx x v
  | @ofIdx p x s =>
    intro M hA
    change RRuns _ M fun M' k' => Agree _ M' ∧ k' ≤ 13 * 1
    refine RRuns.seqs_cons (addrOf_runs hA p 9 fun M₁ hA₁ h₁0 _ => ?_)
    refine RRuns.seqs_cons (RRuns.store _ h₁0 (RRuns.seqs_nil ⟨?_, by omega⟩))
    rw [two_mul_add_nine, hA₁.1 x]
    exact hA₁.dat _ _
  | @seq a b s k₁ s₁ k₂ s₂ _ _ iha ihb =>
    intro M hA
    obtain ⟨M₁, k₁', e₁, hA₁, hk₁⟩ := iha M hA
    obtain ⟨M₂, k₂', e₂, hA₂, hk₂⟩ := ihb M₁ hA₁
    exact ⟨M₂, k₁' + k₂', .seq e₁ e₂, hA₂, by rw [Nat.mul_add]; omega⟩
  | @iteTrue l r t e s k s' heq _ iht =>
    intro M hA
    obtain ⟨M', k', e', hA', hk⟩ := iht M hA
    exact ⟨M', k' + 2, .iteTrue (by rw [hA.1 l, hA.1 r, heq]) e', hA', by omega⟩
  | @iteFalse l r t e s k s' hne _ ihe =>
    intro M hA
    obtain ⟨M', k', e', hA', hk⟩ := ihe M hA
    exact ⟨M', k' + 1, .iteFalse (by rw [hA.1 l, hA.1 r]; exact_mod_cast hne) e', hA', by omega⟩
  | @loopTrue l r body s k₁ s₁ k₂ s₂ heq _ _ ihb ihl =>
    intro M hA
    obtain ⟨M₁, k₁', e₁, hA₁, hk₁⟩ := ihb M hA
    obtain ⟨M₂, k₂', e₂, hA₂, hk₂⟩ := ihl M₁ hA₁
    exact ⟨M₂, k₁' + k₂' + 2, .loopTrue (by rw [hA.1 l, hA.1 r, heq]) e₁ e₂, hA₂, by
      rw [Nat.mul_add, Nat.mul_add]; omega⟩
  | @loopFalse l r body s hne =>
    intro M hA
    exact ⟨M, 1, .loopFalse (by rw [hA.1 l, hA.1 r]; exact_mod_cast hne), hA, by omega⟩

/-- `DRuns` transfers to the real RAM. -/
theorem DRuns.toRaw {c : DCmd} {s : DState} {Q : DState → ℕ → Prop} (h : DRuns c s Q)
    {M : RMem} (hA : Agree s M) :
    RRuns c.toRaw M fun M' k' => ∃ s' k, Agree s' M' ∧ Q s' k ∧ k' ≤ 13 * k := by
  obtain ⟨s', k, e, hQ⟩ := h
  obtain ⟨M', k', e', hA', hk⟩ := e.toRaw M hA
  exact ⟨M', k', e', s', k, hA', hQ, hk⟩

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked
