-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.CodeDefs

/-!
# The repo's codes read back

LLM-generated; not checked by a human.

`Faithful` instances for the codes of `Formalgo.Core.Code`, `Formalgo.Core.Code.Graph` and
`Formalgo.Core.RealRAM`: values, naturals and nonnegative reals as one real, pairs, dependent
pairs, lists, functions on finite linear orders, sets, functions on sets of unordered pairs,
injective encodings and simple graphs.
-/

namespace Formalgo.Code

variable {α β V : Type*}

/-! ### Prepending -/

@[simp] theorem prepend_nil (s : ℕ → V) : prepend [] s = s := by
  funext i; simp [prepend]

@[simp] theorem prepend_cons_zero (a : V) (L : List V) (s : ℕ → V) :
    prepend (a :: L) s 0 = a := by
  simp [prepend]

theorem prepend_cons_succ (a : V) (L : List V) (s : ℕ → V) :
    (fun i => prepend (a :: L) s (i + 1)) = prepend L s := by
  funext i
  unfold prepend
  by_cases h : i < L.length
  · rw [dif_pos (by simp; omega), dif_pos h]; simp
  · rw [dif_neg (by simp; omega), dif_neg h]; congr 1; simp

theorem prepend_append (L₁ L₂ : List V) (s : ℕ → V) :
    prepend (L₁ ++ L₂) s = prepend L₁ (prepend L₂ s) := by
  funext i
  unfold prepend
  by_cases h₁ : i < L₁.length
  · rw [dif_pos (by simp; omega), dif_pos h₁, List.getElem_append_left h₁]
  · rw [dif_neg h₁]
    by_cases h₂ : i - L₁.length < L₂.length
    · rw [dif_pos (by simp; omega), dif_pos h₂, List.getElem_append_right (by omega)]
    · rw [dif_neg (by simp; omega), dif_neg h₂]; congr 1; simp; omega

/-! ### One value -/

/-- A value, written as itself, reads back. -/
instance Faithful.value : Faithful V V where
  decode_prepend a s := by
    change (prepend [a] s 0, fun i => prepend [a] s (i + 1)) = (a, s)
    rw [prepend_cons_zero, prepend_cons_succ, prepend_nil]

/-- A natural number, written as one real, reads back. -/
instance Faithful.realNat : Faithful ℕ ℝ where
  decode_prepend n s := by
    change (⌊prepend [(n : ℝ)] s 0⌋₊, fun i => prepend [(n : ℝ)] s (i + 1)) = (n, s)
    rw [prepend_cons_zero, prepend_cons_succ, prepend_nil, Nat.floor_natCast]

/-- A nonnegative real, written as itself, reads back. -/
instance Faithful.nnreal : Faithful NNReal ℝ where
  decode_prepend r s := by
    change ((prepend [(r : ℝ)] s 0).toNNReal, fun i => prepend [(r : ℝ)] s (i + 1)) = (r, s)
    rw [prepend_cons_zero, prepend_cons_succ, prepend_nil, Real.toNNReal_coe]

/-! ### Pairs and lists -/

/-- A pair reads back if its components do. -/
instance Faithful.prod [Code α V] [Code β V] [Faithful α V] [Faithful β V] :
    Faithful (α × β) V where
  decode_prepend x s := by
    obtain ⟨a, b⟩ := x
    change decode (prepend (encode a ++ encode b) s) = _
    rw [prepend_append]
    dsimp only [decode]
    rw [Faithful.decode_prepend]
    dsimp only
    rw [Faithful.decode_prepend]

/-- A dependent pair reads back if its first component and every second component do. -/
instance Faithful.sigma {β : α → Type*} [Code α V] [∀ a, Code (β a) V] [Faithful α V]
    [∀ a, Faithful (β a) V] : Faithful (Σ a, β a) V where
  decode_prepend x s := by
    obtain ⟨a, b⟩ := x
    change decode (prepend (encode a ++ encode b) s) = _
    rw [prepend_append]
    dsimp only [decode]
    rw [Faithful.decode_prepend]
    dsimp only
    rw [Faithful.decode_prepend]

/-- Reading `l.length` elements from the codes of the elements of `l` gives `l`. -/
theorem decodeMany_prepend [Code α V] [Faithful α V] (l : List α) (s : ℕ → V) :
    decodeMany l.length (prepend (l.flatMap encode) s) = (l, s) := by
  induction l with
  | nil => simp [decodeMany]
  | cons a l ih =>
    rw [List.flatMap_cons, prepend_append]
    simp only [decodeMany, List.length_cons, Faithful.decode_prepend, ih]

/-- A list reads back if natural numbers and its elements do. -/
instance Faithful.list [Code ℕ V] [Faithful ℕ V] [Code α V] [Faithful α V] :
    Faithful (List α) V where
  decode_prepend l s := by
    change decode (prepend (encode l.length ++ l.flatMap encode) s) = _
    rw [prepend_append]
    dsimp only [decode]
    rw [Faithful.decode_prepend]
    exact decodeMany_prepend l s

/-! ### Functions on finite linear orders, and sets -/

theorem mem_sort_univ [Finite α] [LinearOrder α] (a : α) :
    a ∈ (Set.finite_univ.toFinset : Finset α).sort := by
  simp

/-- The value at the position of `a`, in the values in increasing order, is the value at `a`. -/
theorem getD_map_sort_position [Finite α] [LinearOrder α] [Inhabited β] (f : α → β) (a : α) :
    (((Set.finite_univ.toFinset : Finset α).sort).map f).getD (position a) default = f a := by
  unfold position
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_idxOf (mem_sort_univ a)]
  rfl

theorem position_inj [Finite α] [LinearOrder α] {a b : α} : position a = position b ↔ a = b :=
  List.idxOf_inj (mem_sort_univ a)

/-- A function on a finite linear order reads back if the list of its values does. -/
instance Faithful.labels [Finite α] [LinearOrder α] [Inhabited β] [Code (List β) V]
    [Faithful (List β) V] : Faithful (α → β) V where
  decode_prepend f s := by
    change (fun a => (decode (prepend (encode
        (((Set.finite_univ.toFinset : Finset α).sort).map f)) s) : List β × _).1.getD
        (position a) default, (decode (prepend (encode
        (((Set.finite_univ.toFinset : Finset α).sort).map f)) s) : List β × _).2) = (f, s)
    rw [Faithful.decode_prepend]
    simp only [getD_map_sort_position]

theorem decode_set_eq [Finite α] [LinearOrder α] [Code ℕ V] (st : ℕ → V) :
    (decode st : Set α × _) =
      ({a | position a ∈ (decode st : List ℕ × _).1}, (decode st : List ℕ × _).2) := rfl

theorem encode_set_eq [Finite α] [LinearOrder α] [Code ℕ V] (t : Set α) :
    (encode t : List V) = encode (t.toFinite.toFinset.sort.map position) := rfl

/-- A set in a finite linear order reads back if lists of natural numbers do. -/
instance Faithful.set [Finite α] [LinearOrder α] [Code ℕ V] [Faithful (List ℕ) V] :
    Faithful (Set α) V where
  decode_prepend t s := by
    rw [decode_set_eq, encode_set_eq, Faithful.decode_prepend]
    refine Prod.ext (Set.ext fun a => ?_) rfl
    simp only [Set.mem_setOf_eq, List.mem_map, Finset.mem_sort, Set.Finite.mem_toFinset,
      position_inj]
    exact ⟨fun ⟨b, hb, h⟩ => h ▸ hb, fun h => ⟨a, h, rfl⟩⟩

/-- A function on a set of unordered pairs reads back if the list of its values does. -/
instance Faithful.sym2SetLabels [Finite α] [LinearOrder α] {s : Set (Sym2 α)} [Inhabited β]
    [Code (List β) V] [Faithful (List β) V] : Faithful (s → β) V :=
  letI := sym2LinearOrder α
  Faithful.labels

/-! ### Injective encodings and graphs -/

/-- Writing data determining each element reads back if the data does. -/
theorem Faithful.ofInj [Nonempty α] [Code β V] [Faithful β V] (data : α → β)
    (hinj : Function.Injective data) : @Faithful α V (ofInj (Value := V) data hinj) := by
  letI := Code.ofInj (Value := V) data hinj
  refine ⟨fun a s => ?_⟩
  change (Classical.epsilon fun a' => data a' = (decode (prepend (encode (data a)) s)).1,
    (decode (prepend (encode (data a)) s)).2) = (a, s)
  rw [Faithful.decode_prepend]
  exact Prod.ext (hinj (Classical.epsilon_spec (p := fun a' => data a' = data a) ⟨a, rfl⟩)) rfl

/-- A simple graph on a finite linear order reads back if lists of natural numbers do. -/
instance Faithful.simpleGraph [Finite α] [LinearOrder α] [Code ℕ V] [Faithful ℕ V] :
    Faithful (SimpleGraph α) V :=
  Faithful.ofInj (β := α → Set α) SimpleGraph.Adj SimpleGraph.adj_injective

/-! ### The shortest-path types over `ℝ` -/

example : Faithful (Σ n, Σ G : SimpleGraph (Fin n), (G.edgeSet → NNReal) × ℕ) ℝ := inferInstance
example : Faithful (Σ n, Σ G : SimpleGraph (Fin n), G.edgeSet → NNReal) ℝ := inferInstance
example : Faithful (Σ n, Fin n → NNReal) ℝ := inferInstance
example : Faithful (Σ n, Fin n → Fin n → NNReal) ℝ := inferInstance

end Formalgo.Code
