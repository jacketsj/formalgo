-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.Reloc
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.Rules
import Mathlib.Tactic.IntervalCases

/-!
# Writing out the result

LLM-generated; not checked by a human.

`moveOut` moves the output code of a core to just after the input in the data memory, so data
cells `[0, N)` hold `L ++ Z`, with `N` in index cell `0`. `finish` then writes data cells `[0, N)`
to real RAM cells `[0, N)`: it stashes the first eight values far away, compacts the rest in
increasing order (each value moves down), and finally loads the stashed values into cells
`7, …, 0`, doubling the pointer in cell `0` between loads.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked

open Function

/-- Move the output from data `[m 1, m 1 + m 2)` to data `[m 0, m 0 + m 2)`, then
`m 0 := m 0 + m 2`. -/
def moveOut : DCmd :=
  .seqs [Cmd.const 5 1, Cmd.copy 3 0, Cmd.const 4 0, Cmd.less 6 4 2, Cmd.const 7 1,
    .loop 6 7 (.seqs [.dcopy 3 1, Cmd.add 3 3 5, Cmd.add 1 1 5, Cmd.add 4 4 5, Cmd.less 6 4 2]),
    Cmd.add 0 0 2]

theorem moveOut_runs {s : DState} {L Z : List ℝ} (h : s.Out L Z) :
    DRuns moveOut s fun s' k => s'.m 0 = L.length + Z.length ∧
      (∀ i < L.length + Z.length, s'.d i = (L ++ Z).getD i 0) ∧ k ≤ 7 * Z.length + 10 := by
  obtain ⟨h0, hl1, h2, hL, hZ⟩ := h
  set ℓ := L.length
  set z := Z.length
  set m1 := s.m 1
  dstep; dstep; rename_i m₁ g₁ f₁
  dstep; dstep; rename_i m₂ g₂ f₂
  dstep; dstep; rename_i m₃ g₃ f₃
  dstep; dstep; rename_i m₄ g₄ f₄
  dstep; dstep; rename_i m₅ g₅ f₅
  dstep
  refine DRuns.mono (Q := fun s' k => s'.m 0 = ℓ ∧ s'.m 2 = z ∧
      (∀ i < ℓ + z, s'.d i = (L ++ Z).getD i 0) ∧ k ≤ 7 * z + 1)
    (DRuns.loop (fun s' n => ∃ j ≤ z, s'.m 0 = ℓ ∧ s'.m 1 = m1 + j ∧ s'.m 2 = z ∧
      s'.m 3 = ℓ + j ∧ s'.m 4 = j ∧ s'.m 5 = 1 ∧ s'.m 7 = 1 ∧
      s'.m 6 = (if j < z then 1 else 0) ∧ (∀ i (hi : i < ℓ), s'.d i = L[i]) ∧
      (∀ i (hi : i < j), s'.d (ℓ + i) = Z.getD i 0) ∧
      (∀ i (hi : i < z), j ≤ i → s'.d (m1 + i) = Z[i]) ∧ n ≤ 7 * j)
      (fun s' => z - s'.m 4) ?_ ?_ ⟨0, by omega, by rs, by rs, by rs, by rs, by rs, by rs, by rs,
        by rs, hL, fun i (hi : i < 0) => absurd hi (Nat.not_lt_zero _), fun i hi _ => hZ i hi,
        by omega⟩) ?_
  · rintro s' n ⟨j, hj, e0, e1, e2, e3, e4, e5, e7, e6, hL', hdone, hrest, hn⟩ heq
    have hjz : j < z := by
      by_contra hc; rw [e6, if_neg hc, e7] at heq; exact absurd heq (by decide)
    dstep; dstep; rename_i d₁ g₁' f₁'
    dstep; dstep; rename_i n₂ g₂' f₂'
    dstep; dstep; rename_i n₃ g₃' f₃'
    dstep; dstep; rename_i n₄ g₄' f₄'
    dstep; dstep; rename_i n₅ g₅' f₅'
    dstep
    simp only at g₁' f₁' g₂' f₂' g₃' f₃' g₄' f₄' g₅' f₅' ⊢
    have v4 : n₅ 4 = j + 1 := by rs
    refine ⟨⟨j + 1, by omega, by rs, by rs, by rs, by rs, v4, by rs, by rs, by rs,
      fun i hi => ?_, fun i hi => ?_, fun i hi hji => ?_, by omega⟩, by rw [v4, e4]; omega⟩
    · rw [f₁' _ (by rw [e3]; omega)]; exact hL' i hi
    · by_cases hij : i = j
      · subst hij; rw [← e3, g₁', e1, hrest i (by omega) le_rfl,
          List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega), Option.getD_some]
      · rw [f₁' _ (by rw [e3]; omega)]; exact hdone i (by omega)
    · rw [f₁' _ (by rw [e3]; omega)]; exact hrest i hi (by omega)
  · rintro s' n ⟨j, hj, e0, e1, e2, e3, e4, e5, e7, e6, hL', hdone, hrest, hn⟩ hne
    have hjz : j = z := by
      by_contra hc; exact hne (by rw [e6, if_pos (by omega), e7])
    subst hjz
    refine ⟨e0, e2, fun i hi => ?_, by omega⟩
    by_cases hil : i < ℓ
    · rw [hL' i hil, List.getD_eq_getElem?_getD, List.getElem?_append_left hil,
        List.getElem?_eq_getElem hil, Option.getD_some]
    · have := hdone (i - ℓ) (by omega)
      rw [show ℓ + (i - ℓ) = i by omega] at this
      rw [this, List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD,
        List.getElem?_append_right (by omega)]
  · rintro s' k ⟨e0, e2, hd, hk⟩
    dstep; dstep; rename_i n₆ g₆ f₆
    dstep
    simp only at g₆ f₆ ⊢
    exact ⟨by rw [g₆, e0, e2], hd, by omega⟩

/-- Stash data cells `7, …, 0` at `q, 2 q, …, 128 q`, with `q = M[4] = 2 N + 24`. -/
noncomputable def finishStash : RCmd :=
  .seqs [.store 4 23, .add 4 4 4, .store 4 21, .add 4 4 4, .store 4 19, .add 4 4 4, .store 4 17,
    .add 4 4 4, .store 4 15, .add 4 4 4, .store 4 13, .add 4 4 4, .store 4 11, .add 4 4 4,
    .store 4 9]

/-- Compact: `M[p] := M[2 p + 9]` for `p` from `8` while `p < M[3]`. -/
noncomputable def finishCompact : RCmd :=
  .seqs [.const 2 8, .const 6 1, .const 7 9, .less 4 2 3, .const 5 1,
    .loop 4 5 (.seqs [.add 4 2 2, .add 4 4 7, .load 5 4, .store 2 5, .add 2 2 6, .less 4 2 3,
      .const 5 1])]

/-- Load cells `7, …, 0` from `q, 2 q, …, 128 q`, with `q = M[1]`. -/
noncomputable def finishLoad : RCmd :=
  .seqs [.copy 0 1, .load 7 0, .add 0 0 0, .load 6 0, .add 0 0 0, .load 5 0, .add 0 0 0,
    .load 4 0, .add 0 0 0, .load 3 0, .add 0 0 0, .load 2 0, .add 0 0 0, .load 1 0, .add 0 0 0,
    .load 0 0]

/-- Write data cells `[0, N)` to real RAM cells `[0, N)`, with `N` in index cell `0`. -/
noncomputable def finishRaw : RCmd :=
  .seqs [.add 4 8 8, .const 3 24, .add 4 4 3, .copy 1 4, finishStash, .copy 3 8, finishCompact,
    finishLoad]

theorem finishStash_runs {M : RMem} {q : ℕ} (hq : 24 ≤ q) (h4 : M 4 = q) :
    RRuns finishStash M fun M' k => (∀ a, 8 ≤ a → a < q → M' a = M a) ∧
      (M' q = M 23 ∧ M' (2 * q) = M 21 ∧ M' (4 * q) = M 19 ∧ M' (8 * q) = M 17 ∧
        M' (16 * q) = M 15 ∧ M' (32 * q) = M 13 ∧ M' (64 * q) = M 11 ∧ M' (128 * q) = M 9) ∧
      (∀ a, a < 4 → M' a = M a) ∧ k = 15 := by
  rr; refine RRuns.storeR q (by rv) ?_; intro M₁ g₁ f₁
  rr; rr; rename_i M₂ g₂ f₂
  rr; refine RRuns.storeR (2 * q) (by rv) ?_; intro M₃ g₃ f₃
  rr; rr; rename_i M₄ g₄ f₄
  rr; refine RRuns.storeR (4 * q) (by rv) ?_; intro M₅ g₅ f₅
  rr; rr; rename_i M₆ g₆ f₆
  rr; refine RRuns.storeR (8 * q) (by rv) ?_; intro M₇ g₇ f₇
  rr; rr; rename_i M₈ g₈ f₈
  rr; refine RRuns.storeR (16 * q) (by rv) ?_; intro M₉ g₉ f₉
  rr; rr; rename_i M₁₀ g₁₀ f₁₀
  rr; refine RRuns.storeR (32 * q) (by rv) ?_; intro M₁₁ g₁₁ f₁₁
  rr; rr; rename_i M₁₂ g₁₂ f₁₂
  rr; refine RRuns.storeR (64 * q) (by rv) ?_; intro M₁₃ g₁₃ f₁₃
  rr; rr; rename_i M₁₄ g₁₄ f₁₄
  rr; refine RRuns.storeR (128 * q) (by rv) ?_; intro M₁₅ g₁₅ f₁₅
  rr
  exact ⟨fun a ha haq => by rv, ⟨by rv, by rv, by rv, by rv, by rv, by rv, by rv, by rv⟩,
    fun a ha => by rv, rfl⟩

theorem finishCompact_runs {M : RMem} {N : ℕ} (h3 : M 3 = N) :
    RRuns finishCompact M fun M' k => M' 1 = M 1 ∧
      (∀ a, 8 ≤ a → M' a = if a < N then M (2 * a + 9) else M a) ∧ k ≤ 9 * N + 10 := by
  rr; rr; rename_i M₁ g₁ f₁
  rr; rr; rename_i M₂ g₂ f₂
  rr; rr; rename_i M₃ g₃ f₃
  rr; rr; rename_i M₄ g₄ f₄
  rr; rr; rename_i M₅ g₅ f₅
  rr
  refine RRuns.mono (RRuns.loop (M := M₅) (Q := fun M' k => M' 1 = M 1 ∧
      (∀ a, 8 ≤ a → M' a = if a < N then M (2 * a + 9) else M a) ∧ k ≤ 9 * N + 1)
      (fun M' n => ∃ p, 8 ≤ p ∧ (p ≤ N ∨ p = 8) ∧ M' 2 = p ∧
      M' 3 = N ∧ M' 6 = 1 ∧ M' 7 = 9 ∧ M' 5 = 1 ∧ M' 4 = (if p < N then 1 else 0) ∧
      M' 1 = M 1 ∧ (∀ a, 8 ≤ a → M' a = if a < p then M (2 * a + 9) else M a) ∧
      n ≤ 9 * (p - 8)) (fun M' => N - ⌊M' 2⌋₊) ?_ ?_
    ⟨8, le_rfl, .inr rfl, by rv, by rv, by rv, by rv, by rv, ?_, by rv,
      fun a ha => by rw [if_neg (by omega)]; rv, by omega⟩) ?_
  · rintro M' n ⟨p, hp8, hpN, e2, e3, e6, e7, e5, e4, e1, hm, hn⟩ heq
    have hlt : p < N := by
      by_contra hc; rw [e4, if_neg hc, e5] at heq; exact absurd heq (by norm_num)
    rr; rr; rename_i N₁ a₁ b₁
    rr; rr; rename_i N₂ a₂ b₂
    rr; refine RRuns.loadR (2 * p + 9) (by rv) ?_; intro N₃ a₃ b₃
    rr; refine RRuns.storeR p (by rv) ?_; intro N₄ a₄ b₄
    rr; rr; rename_i N₅ a₅ b₅
    rr; rr; rename_i N₆ a₆ b₆
    rr; rr; rename_i N₇ a₇ b₇
    rr
    have v2 : N₇ 2 = ((p + 1 : ℕ) : ℝ) := by rv
    refine ⟨⟨p + 1, by omega, .inl (by omega), v2, by rv, by rv, by rv, by rv, ?_, by rv,
      fun a ha => ?_, by omega⟩, ?_⟩
    · have v2' : N₅ 2 = ((p + 1 : ℕ) : ℝ) := by rv
      have v3 : N₅ 3 = N := by rv
      rw [b₇ 4 (by omega), a₆, v2', v3]
      by_cases h : p + 1 < N
      · rw [if_pos (by exact_mod_cast h), if_pos h]
      · rw [if_neg (by exact_mod_cast h), if_neg h]
    · rw [b₇ a (by omega), b₆ a (by omega), b₅ a (by omega)]
      by_cases hap : a = p
      · subst hap
        rw [a₄, a₃, b₂ _ (by omega), b₁ _ (by omega), hm _ (by omega), if_neg (by omega),
          if_pos (by omega)]
      · rw [b₄ a hap, b₃ a (by omega), b₂ a (by omega), b₁ a (by omega), hm a ha]
        by_cases hap' : a < p
        · rw [if_pos hap', if_pos (by omega)]
        · rw [if_neg hap', if_neg (by omega)]
    · rw [v2, e2, Nat.floor_natCast, Nat.floor_natCast]; omega
  · rintro M' n ⟨p, hp8, hpN, e2, e3, e6, e7, e5, e4, e1, hm, hn⟩ hne
    have hpN' : ¬ p < N := by
      intro hc; exact hne (by rw [e4, if_pos hc, e5])
    refine ⟨e1, fun a ha => ?_, by omega⟩
    rw [hm a ha]
    by_cases haN : a < N
    · rw [if_pos haN, if_pos (by omega)]
    · rw [if_neg haN]
      by_cases hap : a < p
      · omega
      · rw [if_neg hap]
  · rw [f₅ 4 (by omega), g₄]
    have : M₃ 2 = 8 := by rv
    have h3' : M₃ 3 = N := by rv
    rw [this, h3']
    by_cases h : 8 < N
    · rw [if_pos (by exact_mod_cast h), if_pos h]
    · rw [if_neg (by exact_mod_cast h), if_neg h]
  · rintro M' k ⟨e1, hm, hk⟩
    rr
    exact ⟨e1, hm, by omega⟩

theorem finishLoad_runs {M : RMem} {q : ℕ} (hq : 24 ≤ q) (h1 : M 1 = q) :
    RRuns finishLoad M fun M' k => M' 7 = M q ∧ M' 6 = M (2 * q) ∧ M' 5 = M (4 * q) ∧
      M' 4 = M (8 * q) ∧ M' 3 = M (16 * q) ∧ M' 2 = M (32 * q) ∧ M' 1 = M (64 * q) ∧
      M' 0 = M (128 * q) ∧ (∀ a, 8 ≤ a → M' a = M a) ∧ k = 16 := by
  rr; rr; rename_i M₀ g₀ f₀
  rr; refine RRuns.loadR q (by rv) ?_; intro M₁ g₁ f₁
  rr; rr; rename_i M₂ g₂ f₂
  rr; refine RRuns.loadR (2 * q) (by rv) ?_; intro M₃ g₃ f₃
  rr; rr; rename_i M₄ g₄ f₄
  rr; refine RRuns.loadR (4 * q) (by rv) ?_; intro M₅ g₅ f₅
  rr; rr; rename_i M₆ g₆ f₆
  rr; refine RRuns.loadR (8 * q) (by rv) ?_; intro M₇ g₇ f₇
  rr; rr; rename_i M₈ g₈ f₈
  rr; refine RRuns.loadR (16 * q) (by rv) ?_; intro M₉ g₉ f₉
  rr; rr; rename_i M₁₀ g₁₀ f₁₀
  rr; refine RRuns.loadR (32 * q) (by rv) ?_; intro M₁₁ g₁₁ f₁₁
  rr; rr; rename_i M₁₂ g₁₂ f₁₂
  rr; refine RRuns.loadR (64 * q) (by rv) ?_; intro M₁₃ g₁₃ f₁₃
  rr; rr; rename_i M₁₄ g₁₄ f₁₄
  rr; refine RRuns.loadR (128 * q) (by rv) ?_; intro M₁₅ g₁₅ f₁₅
  rr
  exact ⟨by rv, by rv, by rv, by rv, by rv, by rv, by rv, by rv, fun a ha => by rv, rfl⟩

/-- `finishRaw` writes data cells `[0, N)` to real RAM cells `[0, N)`. -/
theorem finishRaw_runs {M : RMem} {s : DState} {W : List ℝ} {N : ℕ} (hA : Agree s M)
    (h0 : s.m 0 = N) (hW : ∀ i < N, s.d i = W.getD i 0) :
    RRuns finishRaw M fun M' k => (∀ i < N, M' i = W.getD i 0) ∧ k ≤ 9 * N + 50 := by
  have hN : M 8 = N := by rw [show (8 : ℕ) = icell 0 from rfl, hA.1, h0]
  have hd : ∀ i, M (2 * i + 9) = s.d i := fun i => hA.2 i
  set q := 2 * N + 24 with hq
  have hqR : (q : ℝ) = 2 * (N : ℝ) + 24 := by rw [hq]; push_cast; ring
  rr; rr; rename_i M₁ g₁ f₁
  rr; rr; rename_i M₂ g₂ f₂
  rr; rr; rename_i M₃ g₃ f₃
  rr; rr; rename_i M₄ g₄ f₄
  have h4 : M₄ 4 = q := by rw [hqR]; rv
  rr
  refine RRuns.mono (finishStash_runs (q := q) (by omega) h4) ?_
  rintro M₅ k₅ ⟨fr₅, ⟨s7, s6, s5, s4, s3, s2, s1, s0⟩, lo₅, hk₅⟩
  rr; rr; rename_i M₆ g₆ f₆
  rr
  have h63 : M₆ 3 = N := by rw [g₆, fr₅ 8 le_rfl (by omega), f₄ 8 (by omega), f₃ 8 (by omega),
    f₂ 8 (by omega), f₁ 8 (by omega), hN]
  refine RRuns.mono (finishCompact_runs h63) ?_
  rintro M₇ k₇ ⟨e71, hm₇, hk₇⟩
  rr
  have h71 : M₇ 1 = q := by rw [e71, f₆ 1 (by omega), lo₅ 1 (by omega), hqR]; rv
  refine RRuns.mono (finishLoad_runs (by omega) h71) ?_
  rintro M₈ k₈ ⟨l7, l6, l5, l4, l3, l2, l1, l0, hm₈, hk₈⟩
  rr
  -- Values far up, after the compaction.
  have up : ∀ a, q ≤ a → M₇ a = M₅ a := fun a ha => by
    rw [hm₇ a (by omega), if_neg (by omega), f₆ a (by omega)]
  -- Data cells below the stash, after it.
  have low : ∀ i < N, M₅ (2 * i + 9) = W.getD i 0 := fun i hi => by
    rw [fr₅ _ (by omega) (by omega), f₄ _ (by omega), f₃ _ (by omega), f₂ _ (by omega),
      f₁ _ (by omega), hd, hW i hi]
  refine ⟨fun i hi => ?_, by omega⟩
  by_cases h8 : 8 ≤ i
  · rw [hm₈ i h8, hm₇ i h8, if_pos hi, f₆ _ (by omega), low i hi]
  · have hW' : ∀ j < N, M (2 * j + 9) = W.getD j 0 := fun j hj => by rw [hd, hW j hj]
    interval_cases i
    · rw [l0, up _ (by omega), s0, f₄ _ (by omega), f₃ _ (by omega), f₂ _ (by omega),
        f₁ _ (by omega), hW' 0 hi]
    · rw [l1, up _ (by omega), s1, f₄ _ (by omega), f₃ _ (by omega), f₂ _ (by omega),
        f₁ _ (by omega), hW' 1 hi]
    · rw [l2, up _ (by omega), s2, f₄ _ (by omega), f₃ _ (by omega), f₂ _ (by omega),
        f₁ _ (by omega), hW' 2 hi]
    · rw [l3, up _ (by omega), s3, f₄ _ (by omega), f₃ _ (by omega), f₂ _ (by omega),
        f₁ _ (by omega), hW' 3 hi]
    · rw [l4, up _ (by omega), s4, f₄ _ (by omega), f₃ _ (by omega), f₂ _ (by omega),
        f₁ _ (by omega), hW' 4 hi]
    · rw [l5, up _ (by omega), s5, f₄ _ (by omega), f₃ _ (by omega), f₂ _ (by omega),
        f₁ _ (by omega), hW' 5 hi]
    · rw [l6, up _ (by omega), s6, f₄ _ (by omega), f₃ _ (by omega), f₂ _ (by omega),
        f₁ _ (by omega), hW' 6 hi]
    · rw [l7, up _ (by omega), s7, f₄ _ (by omega), f₃ _ (by omega), f₂ _ (by omega),
        f₁ _ (by omega), hW' 7 hi]

