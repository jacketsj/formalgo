-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.Finish
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.Codes

/-!
# The harness for the real RAM

LLM-generated; not checked by a human.

The whole program: a boot (input-specific, on the raw tape) finds the length `ℓ` of the input code
and copies a list `pre x` of length `ℓ` to cells `[D, D + ℓ)`; `reloc` moves it into the data
memory and clears the rest; a fix-up `fix` (input-specific) turns it into the input code; the
core runs; `moveOut` puts the output right after the input; `finishRaw` writes `L ++ Z` to cells
`[0, ℓ + |Z|)`; and the program halts. With faithful codes, the output read back is the core's.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked

open Function

/-- The whole program. -/
noncomputable def realProgram (boot : RCmd) (fix core : DCmd) : RCmd :=
  .seqs [boot, reloc, (DCmd.seqs [fix, core, moveOut]).toRaw, finishRaw]

/-- The memory of the standard tape holding `L` from cell `0`. -/
theorem read_foldr_zipIdx (L : List ℝ) (k a : ℕ) :
    ((L.zipIdx k).foldr (fun (p : ℝ × ℕ) tape => tape.write (p.2 : ℕ) p.1)
      (⟨fun _ => default⟩ : Tape ℕ ℝ)).read a =
      if k ≤ a then L.getD (a - k) 0 else 0 := by
  induction L generalizing k with
  | nil => simp; rfl
  | cons v L ih =>
    simp only [List.zipIdx_cons, List.foldr_cons]
    rw [show ∀ (t : Tape ℕ ℝ) (x : ℕ) (v : ℝ) (a : ℕ),
      (t.write x v).read a = if a = x then v else t.read a from fun _ _ _ _ => rfl, ih (k + 1)]
    by_cases ha : a = k
    · subst ha; simp
    · simp only [ha, if_false]
      by_cases hle : k + 1 ≤ a
      · rw [if_pos hle, if_pos (by omega), show a - k = (a - (k + 1)) + 1 by omega]
        simp
      · rw [if_neg hle, if_neg (by omega)]

theorem standard_encode {I O : Type*} [Code I ℝ] [Code O ℝ] (x : I) :
    (TapeCoding.standard : TapeCoding I O ℕ ℝ).encode x =
      ⟨fun i => (Code.encode (Value := ℝ) x).getD i 0⟩ := by
  change Tape.mk _ = _
  congr 1; funext a
  have := read_foldr_zipIdx (Code.encode (Value := ℝ) x) 0 a
  simp only [Nat.zero_le, if_true, Nat.sub_zero] at this
  rw [← this]; rfl

theorem prepend_self {T : ℕ → ℝ} {W : List ℝ} (h : ∀ i < W.length, T i = W.getD i 0) :
    T = Code.prepend W fun i => T (i + W.length) := by
  funext i
  unfold Code.prepend
  split_ifs with hi
  · rw [h i hi, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi, Option.getD_some]
  · congr 1; omega

/-- The decoded output of a tape that starts with `L ++ Z`. -/
theorem decode_output {I O : Type*} [Code I ℝ] [Code O ℝ] [Code.Faithful I ℝ]
    [Code.Faithful O ℝ] {x : I} {y : O} {T : Tape ℕ ℝ}
    (h : ∀ i < (Code.encode (Value := ℝ) x ++ Code.encode (Value := ℝ) y).length,
      T.read i = (Code.encode (Value := ℝ) x ++ Code.encode (Value := ℝ) y).getD i 0) :
    (TapeCoding.standard : TapeCoding I O ℕ ℝ).decode T = y := by
  change (Code.decode (Code.decode (α := I) fun i => T.read i).2).1 = y
  rw [show (fun i => T.read i) = T.read from rfl, prepend_self h, Code.prepend_append,
    Code.Faithful.decode_prepend, Code.Faithful.decode_prepend]

/-- The harness, for an input-specific boot and fix-up: from a core, a real RAM program within
`(60 cb + 250) (t x + ℓ x + 1)` steps. -/
theorem solvableWithin_of_boot {I O : Type*} [Code I ℝ] [Code O ℝ] [Code.Faithful I ℝ]
    [Code.Faithful O ℝ] {boot : RCmd} {fix core : DCmd} {pre : I → List ℝ} {cb : ℕ}
    (hlen : ∀ x, (pre x).length = (Code.encode (Value := ℝ) x).length)
    (hboot : ∀ x : I, RRuns boot (fun i => (Code.encode (Value := ℝ) x).getD i 0) fun M k =>
      ∃ D : ℕ, M 0 = (pre x).length ∧ M 1 = D ∧ (pre x).length + 9 ≤ D ∧
        D ≤ cb * (pre x).length + cb ∧ (∀ i (h : i < (pre x).length), M (D + i) = (pre x)[i]) ∧
        (∀ a, D + (pre x).length ≤ a → M a = 0) ∧ k ≤ cb * (pre x).length + cb)
    (hfix : ∀ x : I, DRuns fix (.input (pre x)) fun s k =>
      s = .input (Code.encode x) ∧ k ≤ cb * (pre x).length + cb)
    {spec : IOSpec I O} {t : I → ℕ} (hcore : CoreSpec core spec t) :
    RealRAM.withAddSub.semantics.SolvableWithin spec
      fun x => (60 * cb + 250) * (t x + (Code.encode (Value := ℝ) x).length + 1) := by
  let c := realProgram boot fix core
  -- The run on one input.
  have key : ∀ x : I, ∃ (y : O) (k : ℕ), spec.valid x y ∧
      k ≤ (60 * cb + 250) * (t x + (Code.encode (Value := ℝ) x).length + 1) ∧
      ∃ pc T, c.program.run semR k ⟨c.program.init,
        (TapeCoding.standard : TapeCoding I O ℕ ℝ).encode x⟩ = .halted ⟨pc, T⟩ ∧
        (TapeCoding.standard : TapeCoding I O ℕ ℝ).decode T = y := by
    intro x
    have hl := hlen x
    obtain ⟨M₁, k₁, e₁, D, h10, h11, hD, hDb, hsrc, hblank, hk₁⟩ := hboot x
    obtain ⟨M₂, k₂, e₂, hA₂, hk₂⟩ := reloc_runs (P := pre x) rfl hD h10 h11 hsrc hblank
    -- The commands on the data memory.
    have hd : DRuns (DCmd.seqs [fix, core, moveOut]) (.input (pre x)) fun s k =>
        ∃ y : O, spec.valid x y ∧
          s.m 0 = (Code.encode (Value := ℝ) x).length + (Code.encode (Value := ℝ) y).length ∧
          (∀ i < (Code.encode (Value := ℝ) x).length + (Code.encode (Value := ℝ) y).length,
            s.d i = ((Code.encode (Value := ℝ) x) ++ Code.encode (Value := ℝ) y).getD i 0) ∧
          (Code.encode (Value := ℝ) y).length ≤ t x ∧
          k ≤ cb * (Code.encode (Value := ℝ) x).length + cb + 8 * t x + 10 := by
      refine DRuns.seqs_cons (DRuns.mono (hfix x) fun s₁ k₁ ⟨hs₁, hk₁'⟩ => ?_)
      subst hs₁
      refine DRuns.seqs_cons (DRuns.mono (hcore x) fun s₂ k₂ ⟨y, hy, hout, hk₂', hz⟩ => ?_)
      refine DRuns.seqs_cons (DRuns.mono (moveOut_runs hout) fun s₃ k₃ ⟨h30, h3d, hk₃⟩ => ?_)
      refine DRuns.seqs_nil ⟨y, hy, h30, h3d, hz, by rw [hl] at hk₁'; omega⟩
    obtain ⟨M₃, k₃, e₃, s₃, k₃', hA₃, ⟨y, hy, h30, h3d, hz, hk₃'⟩, hk₃⟩ := hd.toRaw hA₂
    obtain ⟨M₄, k₄, e₄, hout₄, hk₄⟩ := finishRaw_runs hA₃ h30 h3d
    have eall : RExec c (fun i => (Code.encode (Value := ℝ) x).getD i 0)
        (k₁ + (k₂ + (k₃ + (k₄ + 0)))) M₄ :=
      .seq e₁ (.seq e₂ (.seq e₃ (.seq e₄ .skip)))
    obtain ⟨pc, hrun⟩ := eall.run_halts
    refine ⟨y, _, hy, ?_, pc, ⟨M₄⟩, by rw [standard_encode]; exact hrun,
      decode_output fun i hi => hout₄ i (by simpa using hi)⟩
    rw [hl] at hk₁ hDb
    have e : (60 * cb + 250) * (t x + (Code.encode (Value := ℝ) x).length + 1) =
        60 * (cb * t x) + 60 * (cb * (Code.encode (Value := ℝ) x).length) + 60 * cb +
          250 * t x + 250 * (Code.encode (Value := ℝ) x).length + 250 := by
      ring
    rw [e]; omega
  refine ⟨_, inferInstance, c.program, fun x => ?_, fun x => ?_⟩
  · obtain ⟨y, k, hy, -, pc, T, hrun, hdec⟩ := key x
    exact ⟨y, ⟨k, ⟨pc, T⟩, hrun, hdec⟩, hy⟩
  · obtain ⟨y, k, -, hk, pc, T, hrun, -⟩ := key x
    exact ⟨⟨pc, T⟩, run_halted_of_le hrun hk⟩

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked
