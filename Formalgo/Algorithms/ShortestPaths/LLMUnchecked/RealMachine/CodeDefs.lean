-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Core.RealRAM
import Formalgo.Core.Code.Graph

/-!
# Codes that read back

LLM-generated; not checked by a human.

`Code.Faithful α V`: decoding the code of `a` followed by any stream gives `a` and that stream.
The standard tape coding reads the output from just after the input, so the harness needs this for
the input and output types. `GraphShape c L`: `L` is laid out like the code of a graph input (the
number of vertices twice, a block per vertex, the number of edges, then `E + c` more values).
-/

namespace Formalgo.Code

/-- The list `L`, followed by the stream `s`. -/
def prepend {V : Type*} (L : List V) (s : ℕ → V) : ℕ → V :=
  fun i => if h : i < L.length then L[i] else s (i - L.length)

/-- Decoding the code of `a`, followed by any stream, gives `a` and that stream. -/
class Faithful (α V : Type*) [Code α V] : Prop where
  decode_prepend : ∀ (a : α) (s : ℕ → V), decode (prepend (encode a) s) = (a, s)

end Formalgo.Code

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked

/-- The code of a block: its length, then its entries. -/
noncomputable def blockCode (b : List ℕ) : List ℝ := (b.length : ℝ) :: b.map fun a : ℕ => (a : ℝ)

/-- `L` is laid out like the code of a graph input with `c` values after the edge labels: `n`
twice, then `n` blocks of naturals below `n` (each its length, then its entries), then `E`, then
`E + c` values. -/
def GraphShape (c : ℕ) (L : List ℝ) : Prop :=
  ∃ (n : ℕ) (blocks : List (List ℕ)) (E : ℕ) (rest : List ℝ), blocks.length = n ∧
    (∀ b ∈ blocks, ∀ a ∈ b, a < n) ∧ rest.length = E + c ∧
    L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++ (E : ℝ) :: rest)

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked
