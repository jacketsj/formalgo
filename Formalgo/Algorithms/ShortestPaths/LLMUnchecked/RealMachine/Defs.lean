-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.Machine.Prog
import Formalgo.Core.RealRAM

/-!
# Commands with real data

LLM-generated; not checked by a human.

A machine with two memories: the index memory `m : ℕ → ℕ` of the word-RAM commands `Cmd`, and a
data memory `d : ℕ → ℝ` of reals, addressed through index cells. `DCmd` has every `Cmd` (acting
on the index memory exactly as `Exec` says, data unchanged), data instructions, and its own
control flow. `DExec` gives the meaning with costs: an embedded `Cmd` costs what `Exec` says, a
data instruction `1`, and control flow as for `Cmd`. Compiled to the real RAM, each unit of cost is
at most a constant number of real RAM steps (`RealMachine/Compile.lean`).

A core for the harness (`RealMachine/Harness.lean`) starts from `DState.input` of the input code
and ends in a state satisfying `DState.Out` for the output code (`CoreSpec`).
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked

open Function

/-- A state: the index memory of naturals, and the data memory of reals. -/
@[ext] structure DState where
  /-- The index memory. -/
  m : Mem
  /-- The data memory. -/
  d : ℕ → ℝ

/-- Commands with real data. Data cells are addressed through index cells: `d[m p]`. -/
inductive DCmd
  /-- A command on the index memory. -/
  | idx (c : Cmd)
  /-- Do nothing (no cost). -/
  | skip
  /-- `d[m p] := v`. -/
  | dconst (p : ℕ) (v : ℝ)
  /-- `d[m p] := d[m q]`. -/
  | dcopy (p q : ℕ)
  /-- `d[m p] := d[m q] + d[m r]`. -/
  | dadd (p q r : ℕ)
  /-- `d[m p] := d[m q] - d[m r]`. -/
  | dsub (p q r : ℕ)
  /-- `m[x] := if d[m q] < d[m r] then 1 else 0`. -/
  | dless (x q r : ℕ)
  /-- `m[x] := d[m p]`, for a data value that is a natural number. -/
  | toIdx (x p : ℕ)
  /-- `d[m p] := m[x]`. -/
  | ofIdx (p x : ℕ)
  | seq (a b : DCmd)
  /-- If `m[l] = m[r]`. -/
  | ite (l r : ℕ) (t e : DCmd)
  /-- While `m[l] = m[r]`. -/
  | loop (l r : ℕ) (body : DCmd)

instance : Coe Cmd DCmd := ⟨DCmd.idx⟩

/-- Big-step semantics of `DCmd`, with costs. An embedded `Cmd` may use any word bound `B`. -/
inductive DExec : DCmd → DState → ℕ → DState → Prop
  | idx {B c m k m' d} : Exec B c m k m' → DExec (.idx c) ⟨m, d⟩ k ⟨m', d⟩
  | skip {s} : DExec .skip s 0 s
  | dconst {p v s} : DExec (.dconst p v) s 1 ⟨s.m, update s.d (s.m p) v⟩
  | dcopy {p q s} : DExec (.dcopy p q) s 1 ⟨s.m, update s.d (s.m p) (s.d (s.m q))⟩
  | dadd {p q r s} :
      DExec (.dadd p q r) s 1 ⟨s.m, update s.d (s.m p) (s.d (s.m q) + s.d (s.m r))⟩
  | dsub {p q r s} :
      DExec (.dsub p q r) s 1 ⟨s.m, update s.d (s.m p) (s.d (s.m q) - s.d (s.m r))⟩
  | dless {x q r s} :
      DExec (.dless x q r) s 1 ⟨update s.m x (if s.d (s.m q) < s.d (s.m r) then 1 else 0), s.d⟩
  | toIdx {x p s} (v : ℕ) : s.d (s.m p) = (v : ℝ) → DExec (.toIdx x p) s 1 ⟨update s.m x v, s.d⟩
  | ofIdx {p x s} : DExec (.ofIdx p x) s 1 ⟨s.m, update s.d (s.m p) (s.m x)⟩
  | seq {a b s k₁ s₁ k₂ s₂} : DExec a s k₁ s₁ → DExec b s₁ k₂ s₂ →
      DExec (.seq a b) s (k₁ + k₂) s₂
  | iteTrue {l r t e s k s'} : s.m l = s.m r → DExec t s k s' → DExec (.ite l r t e) s (k + 2) s'
  | iteFalse {l r t e s k s'} : s.m l ≠ s.m r → DExec e s k s' →
      DExec (.ite l r t e) s (k + 1) s'
  | loopTrue {l r body s k₁ s₁ k₂ s₂} : s.m l = s.m r → DExec body s k₁ s₁ →
      DExec (.loop l r body) s₁ k₂ s₂ → DExec (.loop l r body) s (k₁ + k₂ + 2) s₂
  | loopFalse {l r body s} : s.m l ≠ s.m r → DExec (.loop l r body) s 1 s

/-- `c` runs from `s` to a state and cost satisfying `Q`. -/
def DRuns (c : DCmd) (s : DState) (Q : DState → ℕ → Prop) : Prop :=
  ∃ s' k, DExec c s k s' ∧ Q s' k

/-- Run commands in order. -/
def DCmd.seqs : List DCmd → DCmd
  | [] => .skip
  | c :: cs => .seq c (seqs cs)

/-! ### The harness's view of a core -/

/-- The state a core starts in: the input code `L` in data cells `[0, ℓ)`, `ℓ = L.length` in index
cell `0`, and every other cell `0`. -/
noncomputable def DState.input (L : List ℝ) : DState :=
  ⟨fun a => if a = 0 then L.length else 0, fun a => L.getD a 0⟩

/-- A final state of a core: the input code `L` still in data cells `[0, ℓ)` and `ℓ` in index
cell `0`, and the output code `Z` in data cells `[m 1, m 1 + m 2)`, with `ℓ ≤ m 1` and
`m 2 = Z.length`. -/
def DState.Out (s : DState) (L Z : List ℝ) : Prop :=
  s.m 0 = L.length ∧ L.length ≤ s.m 1 ∧ s.m 2 = Z.length ∧
    (∀ i (h : i < L.length), s.d i = L[i]) ∧ ∀ j (h : j < Z.length), s.d (s.m 1 + j) = Z[j]

/-- `core` solves `spec` within `t`: from the input state of each input `x`, it ends with the code
of an output valid for `x`, within `t x` steps, and that code has length at most `t x`. -/
def CoreSpec {I O : Type*} [Code I ℝ] [Code O ℝ] (core : DCmd) (spec : IOSpec I O)
    (t : I → ℕ) : Prop :=
  ∀ x : I, DRuns core (.input (Code.encode (Value := ℝ) x)) fun s k => ∃ y : O, spec.valid x y ∧
    s.Out (Code.encode x) (Code.encode y) ∧ k ≤ t x ∧ (Code.encode (Value := ℝ) y).length ≤ t x

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked
