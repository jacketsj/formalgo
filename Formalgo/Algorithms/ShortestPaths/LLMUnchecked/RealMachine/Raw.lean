-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.Defs

/-!
# Raw commands on the real RAM

LLM-generated; not checked by a human.

Structured commands over the real RAM's memory `ℕ → ℝ` itself, compiled to real RAM programs with
`<`, `+` and `−`. `RExec` gives their meaning with exact costs (real RAM steps), and `RExec.run`
shows that compiled programs follow it.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked

open Function

/-- The real RAM operations used. -/
abbrev rops : List RealRAM.Operation := [.less, .add, .sub]

/-- A real RAM operation used. -/
abbrev ROp := {operation // operation ∈ rops}

/-- Real RAM instructions. -/
abbrev RInstr := RAM.Instruction ℕ ℝ (RAM.Arithmetic ℕ ROp)

/-- The real RAM semantics. -/
noncomputable abbrev semR := RealRAM.withAddSub.semantics

/-- A memory of reals: the real RAM's tape. -/
abbrev RMem := ℕ → ℝ

/-- A line of code: an instruction, and the next line for each outcome. -/
structure RLine where
  /-- The instruction. -/
  instr : RInstr
  /-- The next line if the outcome is `true`. -/
  onTrue : ℕ
  /-- The next line if the outcome is `false`. -/
  onFalse : ℕ

/-- Structured commands on the real RAM's memory. -/
inductive RCmd
  | const (d : ℕ) (v : ℝ)
  | copy (d s : ℕ)
  /-- `M[d] := M[M[p]]`, for `M[p]` a natural. -/
  | load (d p : ℕ)
  /-- `M[M[p]] := M[s]`, for `M[p]` a natural. -/
  | store (p s : ℕ)
  | add (d l r : ℕ)
  | sub (d l r : ℕ)
  | less (d l r : ℕ)
  | skip
  | seq (a b : RCmd)
  /-- If `M[l] = M[r]`. -/
  | ite (l r : ℕ) (t e : RCmd)
  /-- While `M[l] = M[r]`. -/
  | loop (l r : ℕ) (body : RCmd)
  /-- While `M[l] ≠ M[r]`. -/
  | loopNe (l r : ℕ) (body : RCmd)

namespace RCmd

/-- Addition. -/
def addOp : ROp := ⟨.add, by simp [rops]⟩
/-- Subtraction. -/
def subOp : ROp := ⟨.sub, by simp [rops]⟩
/-- Comparison. -/
def lessOp : ROp := ⟨.less, by simp [rops]⟩

/-- A line that jumps to `target`. -/
def jump (target : ℕ) : RLine := ⟨.extension (.equal 0 0), target, target⟩

/-- The number of lines of a command. -/
def size : RCmd → ℕ
  | skip => 0
  | seq a b => a.size + b.size
  | ite _ _ t e => t.size + e.size + 2
  | loop _ _ body => body.size + 2
  | loopNe _ _ body => body.size + 2
  | _ => 1

/-- The lines of a command starting at line `s`. -/
def compile : RCmd → ℕ → List RLine
  | const d v, s => [⟨.const d v, s + 1, s + 1⟩]
  | copy d x, s => [⟨.copy d x, s + 1, s + 1⟩]
  | load d p, s => [⟨.load d p, s + 1, s + 1⟩]
  | store p x, s => [⟨.store p x, s + 1, s + 1⟩]
  | add d l r, s => [⟨.extension (.apply addOp d l r), s + 1, s + 1⟩]
  | sub d l r, s => [⟨.extension (.apply subOp d l r), s + 1, s + 1⟩]
  | less d l r, s => [⟨.extension (.apply lessOp d l r), s + 1, s + 1⟩]
  | skip, _ => []
  | seq a b, s => a.compile s ++ b.compile (s + a.size)
  | ite l r t e, s => ⟨.extension (.equal l r), s + 1, s + t.size + 2⟩ ::
      (t.compile (s + 1) ++ jump (s + t.size + e.size + 2) :: e.compile (s + t.size + 2))
  | loop l r body, s => ⟨.extension (.equal l r), s + 1, s + body.size + 2⟩ ::
      (body.compile (s + 1) ++ [jump s])
  | loopNe l r body, s => ⟨.extension (.equal l r), s + body.size + 2, s + 1⟩ ::
      (body.compile (s + 1) ++ [jump s])

theorem length_compile (c : RCmd) (s : ℕ) : (c.compile s).length = c.size := by
  induction c generalizing s <;> simp_all [compile, size]; omega

/-- The lines of a closed program: the command, then `halt`. -/
def lines (c : RCmd) : List RLine := c.compile 0 ++ [⟨.halt, 0, 0⟩]

theorem length_lines (c : RCmd) : c.lines.length = c.size + 1 := by
  simp [lines, length_compile]

/-- Run commands in order. -/
def seqs : List RCmd → RCmd
  | [] => skip
  | c :: cs => seq c (seqs cs)

end RCmd

/-- Big-step semantics of raw commands, with exact costs in real RAM steps. -/
inductive RExec : RCmd → RMem → ℕ → RMem → Prop
  | const {M d v} : RExec (.const d v) M 1 (update M d v)
  | copy {M d s} : RExec (.copy d s) M 1 (update M d (M s))
  | load {M d p} (a : ℕ) : M p = (a : ℝ) → RExec (.load d p) M 1 (update M d (M a))
  | store {M p s} (a : ℕ) : M p = (a : ℝ) → RExec (.store p s) M 1 (update M a (M s))
  | add {M d l r} : RExec (.add d l r) M 1 (update M d (M l + M r))
  | sub {M d l r} : RExec (.sub d l r) M 1 (update M d (M l - M r))
  | less {M d l r} : RExec (.less d l r) M 1 (update M d (if M l < M r then 1 else 0))
  | skip {M} : RExec .skip M 0 M
  | seq {a b M k₁ M₁ k₂ M₂} : RExec a M k₁ M₁ → RExec b M₁ k₂ M₂ →
      RExec (.seq a b) M (k₁ + k₂) M₂
  | iteTrue {l r t e M k M'} : M l = M r → RExec t M k M' → RExec (.ite l r t e) M (k + 2) M'
  | iteFalse {l r t e M k M'} : M l ≠ M r → RExec e M k M' → RExec (.ite l r t e) M (k + 1) M'
  | loopTrue {l r body M k₁ M₁ k₂ M₂} : M l = M r → RExec body M k₁ M₁ →
      RExec (.loop l r body) M₁ k₂ M₂ → RExec (.loop l r body) M (k₁ + k₂ + 2) M₂
  | loopFalse {l r body M} : M l ≠ M r → RExec (.loop l r body) M 1 M
  | loopNeTrue {l r body M k₁ M₁ k₂ M₂} : M l ≠ M r → RExec body M k₁ M₁ →
      RExec (.loopNe l r body) M₁ k₂ M₂ → RExec (.loopNe l r body) M (k₁ + k₂ + 2) M₂
  | loopNeFalse {l r body M} : M l = M r → RExec (.loopNe l r body) M 1 M

/-! ### Programs -/

/-- The program running `lines` on the real RAM. -/
def rProgram (lines : List RLine) (h : 0 < lines.length) : Program (Fin lines.length) RInstr Bool
    where
  init := ⟨0, h⟩
  next pc outcome :=
    ⟨(if outcome then lines[pc].onTrue else lines[pc].onFalse) % lines.length, Nat.mod_lt _ h⟩
  instruction pc := lines[pc].instr

/-- `ls` sits in `lines` from line `s`. -/
def RAt (lines : List RLine) (s : ℕ) (ls : List RLine) : Prop :=
  ∀ i < ls.length, lines[s + i]? = ls[i]?

theorem RAt.append {lines : List RLine} {s : ℕ} {a b : List RLine} (h : RAt lines s (a ++ b)) :
    RAt lines s a ∧ RAt lines (s + a.length) b := by
  constructor
  · intro i hi
    have := h i (by simp; omega)
    rw [this, List.getElem?_append_left hi]
  · intro i hi
    have := h (a.length + i) (by simp; omega)
    rw [← Nat.add_assoc] at this
    rw [this, List.getElem?_append_right (by omega)]
    simp

theorem RAt.cons {lines : List RLine} {s : ℕ} {x : RLine} {b : List RLine}
    (h : RAt lines s (x :: b)) : lines[s]? = some x ∧ RAt lines (s + 1) b := by
  constructor
  · simpa using h 0 (by simp)
  · intro i hi
    have := h (i + 1) (by simp; omega)
    rw [show s + (i + 1) = s + 1 + i by omega] at this
    simpa using this

theorem tape_write_mk (M : RMem) (d : ℕ) (v : ℝ) :
    (⟨M⟩ : Tape ℕ ℝ).write d v = ⟨update M d v⟩ := by
  simp only [Tape.write, Tape.mk.injEq]
  funext i; simp [update_apply]

theorem toAddress_nat (a : ℕ) : RealRAM.withAddSub.toAddress? (a : ℝ) = some a := by
  simp [RealRAM.withAddSub, realRAM]

section Run

variable {lines : List RLine} {hlines : 0 < lines.length}

/-- One step on a line holding a non-halting instruction. -/
theorem run_rline {M M' : RMem} {pc : Fin lines.length} {line : RLine} {s : ℕ}
    (hpc : pc.val = s) (hline : lines[s]? = some line) {outcome : Bool}
    (hexec : semR.exec line.instr ⟨M⟩ = (some outcome, ⟨M'⟩)) {target : ℕ}
    (htarget : (if outcome then line.onTrue else line.onFalse) = target)
    (ht : target < lines.length) :
    (rProgram lines hlines).run semR 1 ⟨pc, ⟨M⟩⟩ = .running ⟨⟨target, ht⟩, ⟨M'⟩⟩ := by
  subst hpc
  have hl : lines[pc.val] = line := by
    rw [List.getElem?_eq_getElem pc.isLt] at hline; exact Option.some.inj hline
  simp only [Program.run, Program.step, rProgram, Fin.getElem_fin, hl, hexec]
  simp only [htarget, Nat.mod_eq_of_lt ht]

theorem run_rprim {M M' : RMem} {pc : Fin lines.length} {s : ℕ} {i : RInstr}
    (hpc : pc.val = s) (hline : lines[s]? = some ⟨i, s + 1, s + 1⟩)
    (hexec : semR.exec i ⟨M⟩ = (some true, ⟨M'⟩)) (ht : s + 1 < lines.length) :
    (rProgram lines hlines).run semR 1 ⟨pc, ⟨M⟩⟩ = .running ⟨⟨s + 1, ht⟩, ⟨M'⟩⟩ :=
  run_rline hpc hline hexec (by simp) ht

theorem exec_requal (M : RMem) (l r : ℕ) :
    semR.exec (.extension (.equal l r)) ⟨M⟩ = (some (decide (M l = M r)), ⟨M⟩) := by
  simp [RAM.semantics, RealRAM.withAddSub, realRAM, RAM.arithmetic]

/-- A compiled command follows `RExec`. -/
theorem RExec.run {c : RCmd} {M : RMem} {k : ℕ} {M' : RMem} (hE : RExec c M k M') :
    ∀ {s : ℕ} (_hat : RAt lines s (c.compile s)) (hlen : s + c.size < lines.length)
      {pc : Fin lines.length} (_hpc : pc.val = s),
      (rProgram lines hlines).run semR k ⟨pc, ⟨M⟩⟩ = .running ⟨⟨s + c.size, hlen⟩, ⟨M'⟩⟩ := by
  induction hE with
  | @const M d v =>
    intro s hat hlen pc hpc
    exact run_rprim hpc (hat.cons).1 (by simp [RAM.semantics, tape_write_mk]) hlen
  | @copy M d x =>
    intro s hat hlen pc hpc
    exact run_rprim hpc (hat.cons).1 (by simp [RAM.semantics, tape_write_mk]) hlen
  | @load M d p a ha =>
    intro s hat hlen pc hpc
    refine run_rprim hpc (hat.cons).1 ?_ hlen
    simp only [RAM.semantics]
    rw [ha, toAddress_nat]
    simp [tape_write_mk]
  | @store M p x a ha =>
    intro s hat hlen pc hpc
    refine run_rprim hpc (hat.cons).1 ?_ hlen
    simp only [RAM.semantics]
    rw [ha, toAddress_nat]
    simp [tape_write_mk]
  | @add M d l r =>
    intro s hat hlen pc hpc
    exact run_rprim hpc (hat.cons).1 (by
      simp [RAM.semantics, RealRAM.withAddSub, realRAM, RAM.arithmetic, RCmd.addOp,
        tape_write_mk]) hlen
  | @sub M d l r =>
    intro s hat hlen pc hpc
    exact run_rprim hpc (hat.cons).1 (by
      simp [RAM.semantics, RealRAM.withAddSub, realRAM, RAM.arithmetic, RCmd.subOp,
        tape_write_mk]) hlen
  | @less M d l r =>
    intro s hat hlen pc hpc
    exact run_rprim hpc (hat.cons).1 (by
      simp [RAM.semantics, RealRAM.withAddSub, realRAM, RAM.arithmetic, RCmd.lessOp,
        tape_write_mk]) hlen
  | @skip M =>
    intro s hat hlen pc hpc
    subst hpc
    simp [Program.run, RCmd.size]
  | @seq a b M k₁ M₁ k₂ M₂ _ _ iha ihb =>
    intro s hat hlen pc hpc
    obtain ⟨hata, hatb⟩ := RAt.append hat
    rw [RCmd.length_compile] at hatb
    simp only [RCmd.size] at hlen
    have h₁ := iha hata (by omega) hpc
    have h₂ := ihb hatb (by omega) (pc := ⟨s + a.size, by omega⟩) rfl
    rw [run_add_of_running h₁, h₂]
    simp [RCmd.size, Nat.add_assoc]
  | @iteTrue l r t e M k M' heq _ iht =>
    intro s hat hlen pc hpc
    obtain ⟨htest, hrest⟩ := RAt.cons hat
    obtain ⟨hatt, hrest⟩ := RAt.append hrest
    obtain ⟨hjump, _⟩ := RAt.cons hrest
    rw [RCmd.length_compile] at hjump
    simp only [RCmd.size] at hlen
    have h0 := run_rline (hlines := hlines) hpc htest (exec_requal M l r) (target := s + 1)
      (by simp [heq]) (by omega)
    have h₁ := iht hatt (by omega) (pc := ⟨s + 1, by omega⟩) rfl
    have h₂ := run_rline (hlines := hlines) (pc := ⟨s + 1 + t.size, by omega⟩) rfl hjump
      (exec_requal M' 0 0) (target := s + (t.size + e.size + 2)) (by simp [RCmd.jump]; omega)
      (by omega)
    rw [show k + 2 = 1 + (k + 1) by omega, run_add_of_running h0, run_add_of_running h₁, h₂]
    rfl
  | @iteFalse l r t e M k M' hne _ ihe =>
    intro s hat hlen pc hpc
    obtain ⟨htest, hrest⟩ := RAt.cons hat
    obtain ⟨_, hrest⟩ := RAt.append hrest
    obtain ⟨_, hate⟩ := RAt.cons hrest
    rw [RCmd.length_compile, show s + 1 + t.size + 1 = s + t.size + 2 by omega] at hate
    simp only [RCmd.size] at hlen
    have h0 := run_rline (hlines := hlines) hpc htest (exec_requal M l r)
      (target := s + t.size + 2) (by simp [hne]) (by omega)
    have h₁ := ihe hate (by omega) (pc := ⟨s + t.size + 2, by omega⟩) rfl
    rw [show k + 1 = 1 + k by omega, run_add_of_running h0, h₁]
    simp [RCmd.size]; omega
  | @loopTrue l r body M k₁ M₁ k₂ M₂ heq _ _ ihb ihl =>
    intro s hat hlen pc hpc
    have hat' := hat
    obtain ⟨htest, hrest⟩ := RAt.cons hat
    obtain ⟨hatb, hrest⟩ := RAt.append hrest
    obtain ⟨hjump, _⟩ := RAt.cons hrest
    rw [RCmd.length_compile] at hjump
    simp only [RCmd.size] at hlen
    have h0 := run_rline (hlines := hlines) hpc htest (exec_requal M l r) (target := s + 1)
      (by simp [heq]) (by omega)
    have h₁ := ihb hatb (by omega) (pc := ⟨s + 1, by omega⟩) rfl
    have h₂ := run_rline (hlines := hlines) (pc := ⟨s + 1 + body.size, by omega⟩) rfl hjump
      (exec_requal M₁ 0 0) (target := s) (by simp [RCmd.jump]) (by omega)
    have h₃ := ihl hat' (by simpa [RCmd.size] using hlen) (pc := ⟨s, by omega⟩) rfl
    rw [show k₁ + k₂ + 2 = 1 + (k₁ + (1 + k₂)) by omega, run_add_of_running h0,
      run_add_of_running h₁, run_add_of_running h₂, h₃]
  | @loopFalse l r body M hne =>
    intro s hat hlen pc hpc
    obtain ⟨htest, _⟩ := RAt.cons hat
    exact run_rline (hlines := hlines) hpc htest (exec_requal M l r)
      (by simp [hne, RCmd.size]; omega) hlen
  | @loopNeTrue l r body M k₁ M₁ k₂ M₂ hne _ _ ihb ihl =>
    intro s hat hlen pc hpc
    have hat' := hat
    obtain ⟨htest, hrest⟩ := RAt.cons hat
    obtain ⟨hatb, hrest⟩ := RAt.append hrest
    obtain ⟨hjump, _⟩ := RAt.cons hrest
    rw [RCmd.length_compile] at hjump
    simp only [RCmd.size] at hlen
    have h0 := run_rline (hlines := hlines) hpc htest (exec_requal M l r) (target := s + 1)
      (by simp [hne]) (by omega)
    have h₁ := ihb hatb (by omega) (pc := ⟨s + 1, by omega⟩) rfl
    have h₂ := run_rline (hlines := hlines) (pc := ⟨s + 1 + body.size, by omega⟩) rfl hjump
      (exec_requal M₁ 0 0) (target := s) (by simp [RCmd.jump]) (by omega)
    have h₃ := ihl hat' (by simpa [RCmd.size] using hlen) (pc := ⟨s, by omega⟩) rfl
    rw [show k₁ + k₂ + 2 = 1 + (k₁ + (1 + k₂)) by omega, run_add_of_running h0,
      run_add_of_running h₁, run_add_of_running h₂, h₃]
  | @loopNeFalse l r body M heq =>
    intro s hat hlen pc hpc
    obtain ⟨htest, _⟩ := RAt.cons hat
    exact run_rline (hlines := hlines) hpc htest (exec_requal M l r)
      (by simp [heq, RCmd.size]; omega) hlen

end Run

/-- The program of a closed command. -/
noncomputable def RCmd.program (c : RCmd) : Program (Fin c.lines.length) RInstr Bool :=
  rProgram c.lines (by simp [RCmd.length_lines])

/-- A closed command run from `M` halts after its cost and one more step, with memory `M'`. -/
theorem RExec.run_halts {c : RCmd} {M M' : RMem} {k : ℕ} (hE : RExec c M k M') :
    ∃ pc, c.program.run semR (k + 1) ⟨c.program.init, ⟨M⟩⟩ = .halted ⟨pc, ⟨M'⟩⟩ := by
  have hlpos : 0 < c.lines.length := by simp [RCmd.length_lines]
  have hrun := RExec.run (lines := c.lines) (hlines := hlpos) hE (s := 0)
    (fun i hi => by
      simp [RCmd.lines, List.getElem?_append_left (by rwa [RCmd.length_compile] at hi)])
    (by simp [RCmd.length_lines]) (pc := ⟨0, hlpos⟩) rfl
  refine ⟨⟨0 + c.size, by simp [RCmd.length_lines]⟩, ?_⟩
  change (rProgram c.lines hlpos).run semR (k + 1) ⟨⟨0, hlpos⟩, ⟨M⟩⟩ = _
  rw [run_add_of_running hrun]
  have hl : c.lines[c.size]'(by simp [RCmd.length_lines]) = ⟨.halt, 0, 0⟩ := by
    simp [RCmd.lines, RCmd.length_compile]
  simp [Program.run, Program.step, rProgram, hl, RAM.semantics]

/-! ### Running raw commands, by continuations -/

/-- `c` runs from `M` to a memory and cost satisfying `Q`. -/
def RRuns (c : RCmd) (M : RMem) (Q : RMem → ℕ → Prop) : Prop :=
  ∃ M' k, RExec c M k M' ∧ Q M' k

namespace RRuns

variable {M : RMem} {Q : RMem → ℕ → Prop}

theorem mono {c : RCmd} {Q' : RMem → ℕ → Prop} (h : RRuns c M Q) (hQ : ∀ M k, Q M k → Q' M k) :
    RRuns c M Q' := by
  obtain ⟨M', k, e, hq⟩ := h; exact ⟨M', k, e, hQ _ _ hq⟩

theorem seq {a b : RCmd} (h : RRuns a M fun M₁ k₁ => RRuns b M₁ fun M₂ k₂ => Q M₂ (k₁ + k₂)) :
    RRuns (.seq a b) M Q := by
  obtain ⟨M₁, k₁, e₁, M₂, k₂, e₂, hQ⟩ := h
  exact ⟨M₂, k₁ + k₂, .seq e₁ e₂, hQ⟩

theorem skip (h : Q M 0) : RRuns .skip M Q := ⟨M, 0, .skip, h⟩

theorem seqs_nil (h : Q M 0) : RRuns (RCmd.seqs []) M Q := skip h

theorem seqs_cons {c : RCmd} {cs : List RCmd}
    (h : RRuns c M fun M₁ k₁ => RRuns (RCmd.seqs cs) M₁ fun M₂ k₂ => Q M₂ (k₁ + k₂)) :
    RRuns (RCmd.seqs (c :: cs)) M Q := seq h

theorem const {d : ℕ} {v : ℝ} (h : Q (update M d v) 1) : RRuns (.const d v) M Q :=
  ⟨_, _, .const, h⟩

theorem copy {d s : ℕ} (h : Q (update M d (M s)) 1) : RRuns (.copy d s) M Q :=
  ⟨_, _, .copy, h⟩

theorem load {d p : ℕ} (a : ℕ) (ha : M p = (a : ℝ)) (h : Q (update M d (M a)) 1) :
    RRuns (.load d p) M Q := ⟨_, _, .load a ha, h⟩

theorem store {p s : ℕ} (a : ℕ) (ha : M p = (a : ℝ)) (h : Q (update M a (M s)) 1) :
    RRuns (.store p s) M Q := ⟨_, _, .store a ha, h⟩

theorem add {d l r : ℕ} (h : Q (update M d (M l + M r)) 1) : RRuns (.add d l r) M Q :=
  ⟨_, _, .add, h⟩

theorem sub {d l r : ℕ} (h : Q (update M d (M l - M r)) 1) : RRuns (.sub d l r) M Q :=
  ⟨_, _, .sub, h⟩

theorem less {d l r : ℕ} (h : Q (update M d (if M l < M r then 1 else 0)) 1) :
    RRuns (.less d l r) M Q := ⟨_, _, .less, h⟩

theorem ite {l r : ℕ} {t e : RCmd} (ht : M l = M r → RRuns t M fun M' k => Q M' (k + 2))
    (he : M l ≠ M r → RRuns e M fun M' k => Q M' (k + 1)) : RRuns (.ite l r t e) M Q := by
  by_cases h : M l = M r
  · obtain ⟨M', k, e', hQ⟩ := ht h; exact ⟨M', k + 2, .iteTrue h e', hQ⟩
  · obtain ⟨M', k, e', hQ⟩ := he h; exact ⟨M', k + 1, .iteFalse h e', hQ⟩

/-- A loop, from an invariant `P` on memories and costs so far, and a decreasing measure. -/
theorem loop {l r : ℕ} {body : RCmd} (P : RMem → ℕ → Prop) (μ : RMem → ℕ)
    (hstep : ∀ M n, P M n → M l = M r → RRuns body M fun M' k => P M' (n + k + 2) ∧ μ M' < μ M)
    (hexit : ∀ M n, P M n → M l ≠ M r → Q M (n + 1)) (h0 : P M 0) :
    RRuns (.loop l r body) M Q := by
  suffices ∀ N M n, μ M = N → P M n → RRuns (.loop l r body) M fun M' k => Q M' (n + k) by
    simpa using this _ M 0 rfl h0
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro M n hμ hP
    by_cases heq : M l = M r
    · obtain ⟨M₁, k₁, e₁, hP₁, hμ₁⟩ := hstep M n hP heq
      obtain ⟨M₂, k₂, e₂, hQ⟩ := ih (μ M₁) (hμ ▸ hμ₁) M₁ _ rfl hP₁
      exact ⟨M₂, k₁ + k₂ + 2, .loopTrue heq e₁ e₂, by
        change Q M₂ (n + (k₁ + k₂ + 2))
        rw [show n + (k₁ + k₂ + 2) = n + k₁ + 2 + k₂ by omega]; exact hQ⟩
    · exact ⟨M, 1, .loopFalse heq, hexit M n hP heq⟩

/-- A loop while `M[l] ≠ M[r]`, from an invariant and a decreasing measure. -/
theorem loopNe {l r : ℕ} {body : RCmd} (P : RMem → ℕ → Prop) (μ : RMem → ℕ)
    (hstep : ∀ M n, P M n → M l ≠ M r → RRuns body M fun M' k => P M' (n + k + 2) ∧ μ M' < μ M)
    (hexit : ∀ M n, P M n → M l = M r → Q M (n + 1)) (h0 : P M 0) :
    RRuns (.loopNe l r body) M Q := by
  suffices ∀ N M n, μ M = N → P M n → RRuns (.loopNe l r body) M fun M' k => Q M' (n + k) by
    simpa using this _ M 0 rfl h0
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
    intro M n hμ hP
    by_cases heq : M l = M r
    · exact ⟨M, 1, .loopNeFalse heq, hexit M n hP heq⟩
    · obtain ⟨M₁, k₁, e₁, hP₁, hμ₁⟩ := hstep M n hP heq
      obtain ⟨M₂, k₂, e₂, hQ⟩ := ih (μ M₁) (hμ ▸ hμ₁) M₁ _ rfl hP₁
      exact ⟨M₂, k₁ + k₂ + 2, .loopNeTrue heq e₁ e₂, by
        change Q M₂ (n + (k₁ + k₂ + 2))
        rw [show n + (k₁ + k₂ + 2) = n + k₁ + 2 + k₂ by omega]; exact hQ⟩

/-! Raw instructions with the new memory kept abstract. -/

theorem constR {d : ℕ} {v : ℝ} (h : ∀ M', M' d = v → (∀ a, a ≠ d → M' a = M a) → Q M' 1) :
    RRuns (.const d v) M Q :=
  const (h _ (by simp) fun a ha => by simp [ha])

theorem copyR {d s : ℕ} (h : ∀ M', M' d = M s → (∀ a, a ≠ d → M' a = M a) → Q M' 1) :
    RRuns (.copy d s) M Q :=
  copy (h _ (by simp) fun a ha => by simp [ha])

theorem loadR {d p : ℕ} (a : ℕ) (ha : M p = (a : ℝ))
    (h : ∀ M', M' d = M a → (∀ b, b ≠ d → M' b = M b) → Q M' 1) : RRuns (.load d p) M Q :=
  load a ha (h _ (by simp) fun b hb => by simp [hb])

theorem storeR {p s : ℕ} (a : ℕ) (ha : M p = (a : ℝ))
    (h : ∀ M', M' a = M s → (∀ b, b ≠ a → M' b = M b) → Q M' 1) : RRuns (.store p s) M Q :=
  store a ha (h _ (by simp) fun b hb => by simp [hb])

theorem addR {d l r : ℕ} (h : ∀ M', M' d = M l + M r → (∀ a, a ≠ d → M' a = M a) → Q M' 1) :
    RRuns (.add d l r) M Q :=
  add (h _ (by simp) fun a ha => by simp [ha])

theorem subR {d l r : ℕ} (h : ∀ M', M' d = M l - M r → (∀ a, a ≠ d → M' a = M a) → Q M' 1) :
    RRuns (.sub d l r) M Q :=
  sub (h _ (by simp) fun a ha => by simp [ha])

theorem lessR {d l r : ℕ}
    (h : ∀ M', M' d = (if M l < M r then 1 else 0) → (∀ a, a ≠ d → M' a = M a) → Q M' 1) :
    RRuns (.less d l r) M Q :=
  less (h _ (by simp) fun a ha => by simp [ha])

end RRuns

/-- Run the next raw command other than `load` and `store`, keeping the new memory abstract. -/
macro "rr" : tactic => `(tactic| first
  | refine RRuns.seqs_cons ?_
  | refine RRuns.seq ?_
  | refine RRuns.seqs_nil ?_
  | (refine RRuns.constR ?_; intro _ _ _)
  | (refine RRuns.copyR ?_; intro _ _ _)
  | (refine RRuns.addR ?_; intro _ _ _)
  | (refine RRuns.subR ?_; intro _ _ _)
  | (refine RRuns.lessR ?_; intro _ _ _))

/-- Solve a goal about values in memory, from the facts in context. -/
macro "rv" : tactic => `(tactic| first
  | omega
  | (simp (disch := omega) only [*] <;> first | omega | (push_cast; ring) | norm_num))

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked
