      (∀ i, 3 ≤ i → M' i = G i) ∧ k ≤ 8 * p₁ + 1)
    (fun M' k => ∃ p, 3 ≤ p ∧ p ≤ p₁ ∧ M' 1 = p ∧ M' 0 = n ∧
