      (∀ i, 3 ≤ i → M' i = if q < i ∧ i < 3 + d₀ then L.getD i 0 - n else L.getD i 0) ∧
      k ≤ 8 * (2 + d₀ - q)) (fun M' => ⌊M' 2⌋₊) ?_ ?_
    ⟨2 + d₀, by omega, le_rfl, by rv, by rv, by rv, fun i hi => by
      rw [if_neg (by omega)]; rv, by omega⟩) ?_
