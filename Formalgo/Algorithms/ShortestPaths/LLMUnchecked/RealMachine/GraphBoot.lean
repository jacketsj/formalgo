    have hq3 : 3 ≤ q := by
      by_contra hc
      exact hne (by rw [e2, e1, show q = 2 by omega]; norm_num)
    rr; refine RRuns.loadR q e2 ?_; intro M₃ g₃ f₃
    rr; rr; rename_i M₄ g₄ f₄
    rr; refine RRuns.storeR q (by rv) ?_; intro M₅ g₅ f₅
    rr; rr; rename_i M₆ g₆ f₆
    rr; rr; rename_i M₇ g₇ f₇
    rr; rr; rename_i M₈ g₈ f₈
    rr
    have v2 : M₈ 2 = ((q - 1 : ℕ) : ℝ) := by rw [Nat.cast_sub (by omega)]; rv
    refine ⟨⟨q - 1, by omega, by omega, v2, by rv, by rv, fun i hi => ?_, by omega⟩, ?_⟩
    · rw [f₈ i (by omega), f₇ i (by omega), f₆ i (by omega)]
      by_cases hiq : i = q
      · subst hiq
        rw [g₅, g₄, g₃, f₃ 0 (by omega), e0, hm' i hi, if_neg (by omega), if_pos (by omega)]
      · rw [f₅ i hiq, f₄ i (by omega), f₃ i (by omega), hm' i hi]
