/-! ### Copying away -/

/-- With `P = pₑ` in cell `1`: `D := pₑ + E + c + 10`, `M[D] := pₑ`, copy cells `[3, S)` to
`[D + 3, D + S)` from the top, then `M[0] := S`, `M[1] := D`. -/
noncomputable def bootTail (c : ℕ) : RCmd :=
  .seqs [.copy 0 1, .load 2 1, .add 1 1 2, .const 2 ((c + 10 : ℕ) : ℝ), .add 1 1 2, .store 1 0,
    .const 2 10, .sub 0 1 2, .add 1 1 0, .const 2 2,
    .loopNe 0 2 (.seqs [.load 2 0, .store 1 2, .const 2 1, .sub 0 0 2, .sub 1 1 2, .const 2 2]),
    .sub 1 1 2, .const 2 9, .sub 0 1 2]

theorem bootTail_runs {M G : RMem} {pe E c : ℕ} (hpe : 2 ≤ pe) (h1 : M 1 = pe)
    (hE : M pe = E) (hm : ∀ i, 3 ≤ i → M i = G i)
    (hblank : ∀ i, pe + 1 + E + c ≤ i → G i = 0) :
    RRuns (bootTail c) M fun M' k => M' 0 = (pe + 1 + E + c : ℕ) ∧
      M' 1 = (pe + E + c + 10 : ℕ) ∧ M' (pe + E + c + 10) = pe ∧
      M' (pe + E + c + 10 + 1) = 0 ∧ M' (pe + E + c + 10 + 2) = 0 ∧
      (∀ i, 3 ≤ i → i < pe + 1 + E + c → M' (pe + E + c + 10 + i) = G i) ∧
      (∀ a, pe + E + c + 10 + (pe + 1 + E + c) ≤ a → M' a = 0) ∧
      k ≤ 8 * (pe + 1 + E + c) + 14 := by
