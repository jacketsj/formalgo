  rr; refine RRuns.loadR pe (by rv) ?_; intro M₂ g₂ f₂
  rr; rr; rename_i M₃ g₃ f₃
  rr; rr; rename_i M₄ g₄ f₄
  rr; rr; rename_i M₅ g₅ f₅
  have v51 : M₅ 1 = (D : ℝ) := by
    rw [g₅, f₄ 1 (by omega), g₃, g₄, f₂ 1 (by omega), g₂, f₁ 1 (by omega), f₁ pe (by omega), h1,
      hE, hD]; push_cast; ring
  rr; refine RRuns.storeR D v51 ?_; intro M₆ g₆ f₆
  rr; rr; rename_i M₇ g₇ f₇
  rr; rr; rename_i M₈ g₈ f₈
  rr; rr; rename_i M₉ g₉ f₉
  rr; rr; rename_i M₁₀ g₁₀ f₁₀
  have v80 : M₈ 0 = ((S - 1 : ℕ) : ℝ) := by
    rw [g₈, f₇ 1 (by omega), f₆ 1 (by omega), v51, g₇, show S - 1 = pe + E + c by omega, hD]
    push_cast; ring
  rr
  refine RRuns.mono (RRuns.loopNe (M := M₁₀) (Q := fun M' k => M' 0 = 2 ∧ M' 1 = (D + 2 : ℕ) ∧
      M' 2 = 2 ∧ M' D = pe ∧ (∀ j, 3 ≤ j → j ≠ D → M' j =
        if D + 2 < j ∧ j < D + S then G (j - D) else G j) ∧ k ≤ 8 * S + 1)
    (fun M' k => ∃ i, 2 ≤ i ∧ i ≤ S - 1 ∧ M' 0 = i ∧ M' 1 = (D + i : ℕ) ∧ M' 2 = 2 ∧
      M' D = pe ∧ (∀ j, 3 ≤ j → j ≠ D → M' j =
        if D + i < j ∧ j < D + S then G (j - D) else G j) ∧ k ≤ 8 * (S - 1 - i))
    (fun M' => ⌊M' 0⌋₊) ?_ ?_ ⟨S - 1, by omega, le_rfl,
      by rw [f₁₀ 0 (by omega), f₉ 0 (by omega), v80], ?_, by rv, ?_, fun j hj hjD => ?_,
      by omega⟩) ?_
  · rintro M' k ⟨i, hi2, hiS, e0, e1, e2, eD, hm', hk⟩ hne
    have hi3 : 3 ≤ i := by
      by_contra hc; exact hne (by rw [e0, e2, show i = 2 by omega]; norm_num)
    rr; refine RRuns.loadR i e0 ?_; intro N₁ a₁ b₁
    rr; refine RRuns.storeR (D + i) (by rv) ?_; intro N₂ a₂ b₂
    rr; rr; rename_i N₃ a₃ b₃
    rr; rr; rename_i N₄ a₄ b₄
    rr; rr; rename_i N₅ a₅ b₅
    rr; rr; rename_i N₆ a₆ b₆
    rr
    have v0 : N₆ 0 = ((i - 1 : ℕ) : ℝ) := by rw [Nat.cast_sub (by omega)]; rv
    refine ⟨⟨i - 1, by omega, by omega, v0, ?_, by rv, ?_, fun j hj hjD => ?_, by omega⟩, ?_⟩
    · rw [b₆ 1 (by omega), a₅, b₄ 1 (by omega), b₄ 2 (by omega), a₃, b₃ 1 (by omega),
        b₂ 1 (by omega), b₁ 1 (by omega), e1, show D + (i - 1) = D + i - 1 by omega,
        Nat.cast_sub (by omega)]; push_cast; ring
    · rw [b₆ D (by omega), b₅ D (by omega), b₄ D (by omega), b₃ D (by omega),
        b₂ D (by omega), b₁ D (by omega), eD]
    · rw [b₆ j (by omega), b₅ j (by omega), b₄ j (by omega), b₃ j (by omega)]
      by_cases hji : j = D + i
      · subst hji
        rw [a₂, a₁, hm' i hi3 (by omega), if_neg (by omega), if_pos (by omega),
          show D + i - D = i by omega]
      · rw [b₂ j hji, b₁ j (by omega), hm' j hj hjD]
        congr 1; apply propext; omega
    · rw [v0, e0, Nat.floor_natCast, Nat.floor_natCast]; omega
  · rintro M' k ⟨i, hi2, hiS, e0, e1, e2, eD, hm', hk⟩ heq
    have hi : i = 2 := by rw [e0, e2] at heq; exact_mod_cast heq
    subst hi
    exact ⟨e0, e1, e2, eD, hm', by omega⟩
  · rw [f₁₀ 1 (by omega), g₉, v80, f₈ 1 (by omega), f₇ 1 (by omega), f₆ 1 (by omega), v51,
      show D + (S - 1) = D + S - 1 by omega, Nat.cast_sub (by omega), Nat.cast_sub (by omega)]
    push_cast; ring
  · rw [f₁₀ D (by omega), f₉ D (by omega), f₈ D (by omega), f₇ D (by omega), g₆,
      f₅ 0 (by omega), f₄ 0 (by omega), f₃ 0 (by omega), f₂ 0 (by omega), g₁, h1]
  · rw [if_neg (by omega), f₁₀ j (by omega), f₉ j (by omega), f₈ j (by omega), f₇ j (by omega),
      f₆ j hjD, f₅ j (by omega), f₄ j (by omega), f₃ j (by omega), f₂ j (by omega),
      f₁ j (by omega), hm j hj]
  · rintro M' k ⟨e0, e1, e2, eD, hm', hk⟩
    rr; rr; rename_i N₁ a₁ b₁
    rr; rr; rename_i N₂ a₂ b₂
    rr; rr; rename_i N₃ a₃ b₃
    rr
    have v1 : N₃ 1 = (D : ℕ) := by
      rw [b₃ 1 (by omega), b₂ 1 (by omega), a₁, e1, e2]; push_cast; ring
    have hfin : ∀ j, 3 ≤ j → j ≠ D → N₃ j = if D + 2 < j ∧ j < D + S then G (j - D) else G j :=
      fun j hj hjD => by rw [b₃ j (by omega), b₂ j (by omega), b₁ j (by omega), hm' j hj hjD]
    refine ⟨?_, v1, ?_, ?_, ?_, fun i hi hiS => ?_, fun a ha => ?_, by omega⟩
    · rw [a₃, b₂ 1 (by omega), a₂, a₁, e1, e2, hD, hS]; push_cast; ring
    · rw [b₃ D (by omega), b₂ D (by omega), b₁ D (by omega), eD]
    · rw [hfin _ (by omega) (by omega), if_neg (by omega), hblank _ (by omega)]
    · rw [hfin _ (by omega) (by omega), if_neg (by omega), hblank _ (by omega)]
    · rw [hfin _ (by omega) (by omega), if_pos (by omega), show D + i - D = i by omega]
    · rw [hfin _ (by omega) (by omega), if_neg (by omega), hblank _ (by omega)]

/-! ### The boot -/

/-- The boot: if `n = 0`, `pₑ = 2`; otherwise tag, scan and parse. Then copy away. -/
noncomputable def bootRaw (c : ℕ) : RCmd :=
  .seqs [.const 1 0, .ite 0 1 (.const 1 2) (.seqs [bootTag, bootScan, bootParse]), bootTail c]

/-- The cells from `3` that the boot copies. -/
noncomputable def bootG (L : List ℝ) (n : ℕ) (blocks : List (List ℕ)) : RMem :=
  if n = 0 then fun i => L.getD i 0 else fwMem blocks (tagMem L n (bdeg blocks 0)) 1 n

/-- The list the boot leaves at `D`: `pₑ`, `0`, `0`, then the cells `[3, ℓ)`. -/
noncomputable def preList (L : List ℝ) (n : ℕ) (blocks : List (List ℕ)) : List ℝ :=
  List.ofFn (n := L.length) fun i =>
    if (i : ℕ) = 0 then (bpos blocks n : ℝ) else if (i : ℕ) < 3 then 0 else bootG L n blocks i

theorem length_preList (L : List ℝ) (n : ℕ) (blocks : List (List ℕ)) :
    (preList L n blocks).length = L.length := by simp [preList]

theorem getElem_preList {L : List ℝ} {n : ℕ} {blocks : List (List ℕ)} {i : ℕ}
    (h : i < (preList L n blocks).length) : (preList L n blocks)[i] =
      if i = 0 then (bpos blocks n : ℝ) else if i < 3 then 0 else bootG L n blocks i := by
  simp [preList]

section Shape

variable {L : List ℝ} {n : ℕ} {blocks : List (List ℕ)} {E c : ℕ} {rest : List ℝ}

theorem bpos_one (hn : 1 ≤ n) (hlen : blocks.length = n) :
    bpos blocks 1 = 3 + bdeg blocks 0 := by
  rw [bpos_succ (by omega), bpos_zero]; omega

theorem tag_entry (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++ (E : ℝ) :: rest))
    (hn : 1 ≤ n) (hlen : blocks.length = n) (hlt : ∀ b ∈ blocks, ∀ a ∈ b, a < n) {i : ℕ}
    (hi : 3 ≤ i) (hid : i < 3 + bdeg blocks 0) : ∃ a : ℕ, a < n ∧ L.getD i 0 = a := by
  obtain ⟨a, ha, he⟩ := shape_getD_entry hL (k := 0) (j := i - 3) (by omega) (by omega)
  rw [bpos_zero, show 2 + 1 + (i - 3) = i by omega] at he
  refine ⟨a, hlt _ ?_ a ha, he⟩
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem (by omega), Option.getD_some]
  exact List.getElem_mem _

theorem getD_bpos_nat (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++
    (E : ℝ) :: rest)) (hlen : blocks.length = n) {k : ℕ} (hk : k ≤ n) :
    ∃ v : ℕ, L.getD (bpos blocks k) 0 = v := by
  rcases Nat.lt_or_ge k n with h | h
  · exact ⟨_, shape_getD_bpos hL (by omega)⟩
  · refine ⟨E, ?_⟩
    have := shape_getD_after hL 0
    rw [Nat.add_zero, hlen] at this
    rw [show k = n by omega, this]; rfl

end Shape

/-- The boot on a graph-shaped input leaves `preList` at `D`, with `ℓ` in cell `0` and `D` in
cell `1`. -/
theorem bootRaw_runs {L : List ℝ} {n : ℕ} {blocks : List (List ℕ)} {E c : ℕ} {rest : List ℝ}
    (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++ (E : ℝ) :: rest))
    (hlen : blocks.length = n) (hlt : ∀ b ∈ blocks, ∀ a ∈ b, a < n)
    (hrest : rest.length = E + c) :
    RRuns (bootRaw c) (fun i => L.getD i 0) fun M k => ∃ D : ℕ,
      M 0 = (preList L n blocks).length ∧ M 1 = D ∧ (preList L n blocks).length + 9 ≤ D ∧
      D ≤ 50 * (preList L n blocks).length + 50 ∧
      (∀ i (h : i < (preList L n blocks).length), M (D + i) = (preList L n blocks)[i]) ∧
      (∀ a, D + (preList L n blocks).length ≤ a → M a = 0) ∧
      k ≤ 50 * (preList L n blocks).length + 50 := by
  have hS := shape_length hL
  rw [hrest, hlen] at hS
  set pe := bpos blocks n with hpe
  have hpe2 : 2 ≤ pe := by simp [hpe, bpos]
  -- The tail, from any memory with `pₑ` in cell `1` and the cells from `3` given by `G`.
  have tail : ∀ (M : RMem) (k₀ : ℕ), k₀ ≤ 17 * pe + 10 → M 1 = pe → M pe = E →
      (∀ i, 3 ≤ i → M i = bootG L n blocks i) →
      RRuns (RCmd.seqs [bootTail c]) M fun M' k => ∃ D : ℕ,
        M' 0 = (preList L n blocks).length ∧ M' 1 = D ∧ (preList L n blocks).length + 9 ≤ D ∧
        D ≤ 50 * (preList L n blocks).length + 50 ∧
        (∀ i (h : i < (preList L n blocks).length), M' (D + i) = (preList L n blocks)[i]) ∧
        (∀ a, D + (preList L n blocks).length ≤ a → M' a = 0) ∧
        k₀ + k ≤ 50 * (preList L n blocks).length + 50 := by
    intro M k₀ hk₀ h1 hE hm
    have hblank : ∀ i, pe + 1 + E + c ≤ i → bootG L n blocks i = 0 := fun i hi => by
      have hiL : L.getD i 0 = 0 := List.getD_eq_default _ _ (by omega)
      unfold bootG
      split_ifs with hn
      · exact hiL
      · have hne : ∀ k, 1 ≤ k → k < n → i ≠ bpos blocks k := fun k _ hkn e => by
          have := bpos_lt (blocks := blocks) hkn (by omega); omega
        have h0 := bpos_lt (blocks := blocks) (j := 0) (k := n) (by omega) (by omega)
        rw [bpos_zero] at h0
        rw [fwMem_of_ne hne, tagMem, if_neg (by omega), hiL]
    rr
    refine RRuns.mono (bootTail_runs hpe2 h1 hE hm hblank) ?_
    rintro M' k ⟨e0, e1, eD, eD1, eD2, hcp, hbl, hk⟩
    rr
    have hP := length_preList L n blocks
    refine ⟨pe + E + c + 10, by rw [e0, hP, hS]; push_cast; ring, e1, by omega, by omega,
      fun i hi => ?_, fun a ha => hbl a (by omega), by omega⟩
    rw [getElem_preList]
    by_cases h0 : i = 0
    · subst h0; rw [if_pos rfl, Nat.add_zero, eD]
    · rw [if_neg h0]
      by_cases h3 : i < 3
      · rw [if_pos h3]
        rcases (show i = 1 ∨ i = 2 by omega) with h | h <;> subst h
        · exact eD1
        · exact eD2
      · rw [if_neg h3]; exact hcp i (by omega) (by omega)
  rr; rr; rename_i M₁ g₁ f₁
  rr
  refine RRuns.ite (fun heq => ?_) (fun hne => ?_)
  · -- No vertices.
    have hn : n = 0 := by
      rw [f₁ 0 (by omega), g₁, shape_getD_zero hL] at heq; exact_mod_cast heq
    subst hn
    have hb : blocks = [] := List.eq_nil_of_length_eq_zero hlen
    subst hb
    rr; rename_i M₂ g₂ f₂
    refine RRuns.mono (tail M₂ 4 (by omega) (by rw [g₂]; rfl) ?_ fun i hi => ?_) ?_
    · rw [f₂ _ (by simp [hpe, bpos, boff]), f₁ _ (by simp [hpe, bpos, boff])]
      have := shape_getD_after hL 0
      simp only [Nat.add_zero, List.length_nil] at this
      rw [this]; rfl
    · rw [f₂ i (by omega), f₁ i (by omega)]; simp [bootG]
    · rintro M' k ⟨D, a₁, a₂, a₃, a₄, a₅, a₆, a₇⟩
      exact ⟨D, a₁, a₂, a₃, a₄, a₅, a₆, by omega⟩
  · -- Tag, scan and parse.
    have hn : 1 ≤ n := by
      by_contra hc
      apply hne; rw [f₁ 0 (by omega), g₁, shape_getD_zero hL]
      exact_mod_cast (show n = 0 by omega)
    have h₀0 : M₁ 0 = n := by rw [f₁ 0 (by omega), ← shape_getD_zero hL]
    have h₀2 : M₁ 2 = bdeg blocks 0 := by
      rw [f₁ 2 (by omega), ← bpos_zero blocks, shape_getD_bpos hL (by omega)]
    have hp1 := bpos_one hn hlen
    rr
    refine RRuns.mono (bootTag_runs (L := L) h₀0 h₀2 fun i hi => f₁ i (by omega)) ?_
    rintro M₂ k₂ ⟨e0₂, hm₂, hk₂⟩
    rr
    refine RRuns.mono (bootScan_runs (p₁ := bpos blocks 1) e0₂ hm₂ (by omega)
      (fun i hi hip => ?_) ?_) ?_
    · obtain ⟨a, han, ha⟩ := tag_entry hL hn hlen hlt hi (by omega)
      rw [tagMem, if_pos ⟨hi, by omega⟩, ha]; simp only [sub_add_cancel, Nat.cast_lt]; exact han
    · obtain ⟨v, hv⟩ := getD_bpos_nat hL hlen (k := 1) hn
      rw [tagMem, if_neg (by omega), hv]; simp
    rintro M₃ k₃ ⟨e0₃, e1₃, hm₃, hk₃⟩
    rr
    refine RRuns.mono (bootParse_runs hn hlen e0₃ e1₃ hm₃ (by omega) fun k hk1 hkn => ?_) ?_
    · have := bpos_lt (blocks := blocks) (j := 0) (k := k) (by omega) (by omega)
      rw [tagMem, if_neg (by rw [bpos_zero] at this; omega), shape_getD_bpos hL (by omega)]
    rintro M₄ k₄ ⟨e1₄, hm₄, hk₄⟩
    rr
    have hpe3 : 3 + bdeg blocks 0 ≤ pe := by
      rcases Nat.eq_or_lt_of_le hn with h | h
      · rw [hpe, ← h, ← hp1]
      · have := bpos_lt (blocks := blocks) (j := 1) (k := n) h (by omega); omega
    have hG : ∀ i, 3 ≤ i → M₄ i = bootG L n blocks i := fun i hi => by
      rw [hm₄ i hi, bootG, if_neg (by omega)]
    have hpeE : M₄ pe = E := by
      rw [hG pe (by omega), bootG, if_neg (by omega), fwMem_of_ne fun k hk1 hkn e => by
        have := bpos_inj (blocks := blocks) (by omega) (by omega) e; omega,
        tagMem, if_neg (by omega)]
      have := shape_getD_after hL 0
      rw [Nat.add_zero, hlen] at this
      rw [this]; rfl
    refine RRuns.mono (tail M₄ (k₂ + k₃ + k₄ + 4) ?_ e1₄ hpeE hG) ?_
    · have := bpos_ge (blocks := blocks) (j := 1) (k := n) hn (by omega)
      omega
    · rintro M' k ⟨D, a₁, a₂, a₃, a₄, a₅, a₆, a₇⟩
      exact ⟨D, a₁, a₂, a₃, a₄, a₅, a₆, by omega⟩

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked
