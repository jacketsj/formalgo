import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.Raw
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.GraphLayout

/-!
# Booting on a graph-shaped input

LLM-generated; not checked by a human.

The input code `L` (graph-shaped: `n`, `n`, blocks, `E`, `E + c` values) fills the tape from cell
`0`, so no cell is free. With cells `0, 1, 2` as the only registers (cell `1` repeats cell `0`):
1. `bootTag`: subtract `n` from the entries of block `0` (they are below `n`, so they become
   negative), freeing cell `2` (block `0`'s length is now the length of the negative run);
2. `bootScan`: find the start `p₁` of block `1`, the first cell from `3` that is not negative;
3. `bootParse`: walk the blocks `1, …, n-1`, turning each length `d` at `p` into the forward
   pointer `p + d`, with `C - P = n - k` in cells `0, 1` as the counter, until `P` reaches `pₑ`,
   the cell holding `E`;
4. `bootTail`: with `S = pₑ + 1 + E + c` the length of `L` and `D = S + 9`, store `pₑ` at `D` and
   copy cells `[3, S)` to `[D + 3, D + S)`.
The fix-up (`GraphFix.lean`) undoes the changes on the copy.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked

open Function

/-! ### The memories along the way -/

/-- The input with block `0`'s entries (cells `[3, 3 + d₀)`) decreased by `n`. -/
noncomputable def tagMem (L : List ℝ) (n d₀ : ℕ) : RMem :=
  fun i => if 3 ≤ i ∧ i < 3 + d₀ then L.getD i 0 - n else L.getD i 0

/-- `base` with the lengths of blocks `[a, b)` turned into forward pointers. -/
noncomputable def fwMem (blocks : List (List ℕ)) (base : RMem) (a : ℕ) : ℕ → RMem
  | 0 => base
  | b + 1 => if a ≤ b then update (fwMem blocks base a b) (bpos blocks b)
      ((bpos blocks b + bdeg blocks b : ℕ) : ℝ) else fwMem blocks base a b

theorem fwMem_of_ne {blocks : List (List ℕ)} {base : RMem} {a : ℕ} :
    ∀ {b i : ℕ}, (∀ k, a ≤ k → k < b → i ≠ bpos blocks k) → fwMem blocks base a b i = base i
  | 0, i, _ => rfl
  | b + 1, i, h => by
    simp only [fwMem]
    split_ifs with hab
    · rw [update_of_ne (h b hab (by omega)), fwMem_of_ne fun k h1 h2 => h k h1 (by omega)]
    · exact fwMem_of_ne fun k h1 h2 => h k h1 (by omega)

theorem fwMem_at {blocks : List (List ℕ)} {base : RMem} {a k : ℕ} (hak : a ≤ k) :
    ∀ {b : ℕ}, k < b → b ≤ blocks.length →
      fwMem blocks base a b (bpos blocks k) = ((bpos blocks k + bdeg blocks k : ℕ) : ℝ)
  | 0, h, _ => by omega
  | b + 1, h, hb => by
    simp only [fwMem, if_pos (show a ≤ b by omega)]
    by_cases hkb : k = b
    · subst hkb; simp
    · rw [update_of_ne (fun e => hkb (bpos_inj (by omega) (by omega) e)),
        fwMem_at hak (by omega) (by omega)]

/-! ### Tagging block `0` -/

/-- `Q := d₀ + 2`; while `Q ≠ 2`: `M[Q] := M[Q] - n`, `Q := Q - 1`. -/
noncomputable def bootTag : RCmd :=
  .seqs [.const 1 2, .add 2 2 1,
    .loopNe 2 1 (.seqs [.load 1 2, .sub 1 1 0, .store 2 1, .const 1 1, .sub 2 2 1, .const 1 2])]

