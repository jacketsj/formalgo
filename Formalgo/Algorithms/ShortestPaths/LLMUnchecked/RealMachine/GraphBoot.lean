/-! ### Finding block `1` -/

/-- `P := 3`; while `M[P] + n < n`: `P := P + 1`. -/
noncomputable def bootScan : RCmd :=
  .seqs [.const 1 3, .load 2 1, .add 2 2 0, .less 2 2 0, .add 2 2 1,
    .loopNe 2 1 (.seqs [.const 2 1, .add 1 1 2, .load 2 1, .add 2 2 0, .less 2 2 0, .add 2 2 1])]

theorem scan_flag {G : RMem} {n p₁ p : ℕ} (hneg : ∀ i, 3 ≤ i → i < p₁ → G i + n < n)
    (hpos : ¬ G p₁ + n < n) (hp : 3 ≤ p) (hpp : p ≤ p₁) :
    (if G p + n < n then (1 : ℝ) else 0) + p = ((p + if p < p₁ then 1 else 0 : ℕ) : ℝ) := by
  by_cases h : p < p₁
  · rw [if_pos (hneg p hp h), if_pos h]; push_cast; ring
  · rw [show p = p₁ by omega, if_neg hpos, if_neg (lt_irrefl _)]; simp

