/-! ### Forward pointers -/

/-- `C := n + P - 1`; while `C ≠ P`: `T := M[P] + P`, `M[P] := T`, `C := C + T - P`,
`P := T + 1`. -/
noncomputable def bootParse : RCmd :=
  .seqs [.add 0 0 1, .const 2 1, .sub 0 0 2,
    .loopNe 0 1 (.seqs [.load 2 1, .add 2 2 1, .store 1 2, .add 0 0 2, .sub 0 0 1, .copy 1 2,
      .const 2 1, .add 1 1 2])]

theorem bootParse_runs {M base : RMem} {blocks : List (List ℕ)} {n : ℕ} (hn : 1 ≤ n)
    (hlen : blocks.length = n) (h0 : M 0 = n) (h1 : M 1 = bpos blocks 1)
    (hm : ∀ i, 3 ≤ i → M i = base i) (h3 : 3 ≤ bpos blocks 1)
    (hbase : ∀ k, 1 ≤ k → k < n → base (bpos blocks k) = bdeg blocks k) :
    RRuns bootParse M fun M' k => M' 1 = bpos blocks n ∧
      (∀ i, 3 ≤ i → M' i = fwMem blocks base 1 n i) ∧ k ≤ 10 * n + 4 := by
  have hpos3 : ∀ k, 1 ≤ k → k ≤ n → 3 ≤ bpos blocks k := fun k hk hkn => by
    rcases Nat.eq_or_lt_of_le hk with h | h
    · subst h; exact h3
    · have := bpos_lt (blocks := blocks) h (by omega); omega
  rr; rr; rename_i M₁ g₁ f₁
  rr; rr; rename_i M₂ g₂ f₂
  rr; rr; rename_i M₃ g₃ f₃
  rr
  refine RRuns.mono (RRuns.loopNe (M := M₃) (Q := fun M' k => M' 1 = bpos blocks n ∧
      (∀ i, 3 ≤ i → M' i = fwMem blocks base 1 n i) ∧ k ≤ 10 * n + 1)
    (fun M' k => ∃ j, 1 ≤ j ∧ j ≤ n ∧ M' 1 = bpos blocks j ∧
      M' 0 = ((bpos blocks j + (n - j) : ℕ) : ℝ) ∧
      (∀ i, 3 ≤ i → M' i = fwMem blocks base 1 j i) ∧ k ≤ 10 * (j - 1))
    (fun M' => ⌊M' 0⌋₊ - ⌊M' 1⌋₊) ?_ ?_
    ⟨1, le_rfl, hn, by rv, ?_, (fun i hi => by
      rw [f₃ i (by omega), f₂ i (by omega), f₁ i (by omega), hm i hi]; simp [fwMem]),
      by omega⟩) ?_
  · rintro M' k ⟨j, hj1, hjn, e1, e0, hm', hk⟩ hne
    have hjn' : j < n := by
      by_contra hc
      exact hne (by rw [e0, e1, show n - j = 0 by omega, Nat.add_zero])
    have hp3 := hpos3 j hj1 hjn
    rr; refine RRuns.loadR (bpos blocks j) e1 ?_; intro M₄ g₄ f₄
    rr; rr; rename_i M₅ g₅ f₅
    have v5 : M₅ 2 = ((bpos blocks j + bdeg blocks j : ℕ) : ℝ) := by
      rw [g₅, g₄, f₄ 1 (by omega), e1, hm' _ hp3,
        fwMem_of_ne fun k hk1 hkj e => by have := bpos_inj (by omega) (by omega) e; omega,
        hbase j hj1 hjn']; push_cast; ring
    rr; refine RRuns.storeR (bpos blocks j) (by rv) ?_; intro M₆ g₆ f₆
    rr; rr; rename_i M₇ g₇ f₇
    rr; rr; rename_i M₈ g₈ f₈
    rr; rr; rename_i M₉ g₉ f₉
    rr; rr; rename_i M₁₀ g₁₀ f₁₀
    rr; rr; rename_i M₁₁ g₁₁ f₁₁
    rr
    have hsucc := bpos_succ (blocks := blocks) (k := j) (by omega)
    have v1 : M₁₁ 1 = ((bpos blocks (j + 1) : ℕ) : ℝ) := by
      rw [g₁₁, f₁₀ 1 (by omega), g₁₀, g₉, f₈ 2 (by omega), f₇ 2 (by omega), f₆ 2 (by omega),
        v5, hsucc]; push_cast; ring
    have v0 : M₁₁ 0 = ((bpos blocks (j + 1) + (n - (j + 1)) : ℕ) : ℝ) := by
      rw [f₁₁ 0 (by omega), f₁₀ 0 (by omega), f₉ 0 (by omega), g₈, g₇, f₆ 0 (by omega),
        f₅ 0 (by omega), f₄ 0 (by omega), e0, f₇ 1 (by omega), f₆ 1 (by omega),
        f₅ 1 (by omega), f₄ 1 (by omega), e1, f₆ 2 (by omega), v5, hsucc]
      push_cast [show j ≤ n by omega, show j + 1 ≤ n by omega]; ring
    refine ⟨⟨j + 1, by omega, by omega, v1, v0, fun i hi => ?_, by omega⟩, ?_⟩
    · rw [f₁₁ i (by omega), f₁₀ i (by omega), f₉ i (by omega), f₈ i (by omega),
        f₇ i (by omega)]
      simp only [fwMem, if_pos hj1]
