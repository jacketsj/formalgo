-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.CodeDefs
import Mathlib.Data.List.GetD

/-!
# Positions in a graph-shaped code

LLM-generated; not checked by a human.

For blocks `b₀, …, b_{n-1}`, block `k` starts at `bpos k = 2 + Σ_{u < k} (|b_u| + 1)` in a
graph-shaped code, with its length there and its entries after it.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked

/-- The start of block `k`, counting from the start of the blocks. -/
def boff (blocks : List (List ℕ)) (k : ℕ) : ℕ := ((blocks.take k).map fun b => b.length + 1).sum

/-- The start of block `k` in a graph-shaped code. -/
def bpos (blocks : List (List ℕ)) (k : ℕ) : ℕ := 2 + boff blocks k

/-- The length of block `k`. -/
def bdeg (blocks : List (List ℕ)) (k : ℕ) : ℕ := (blocks.getD k []).length

theorem boff_zero (blocks : List (List ℕ)) : boff blocks 0 = 0 := by simp [boff]

theorem boff_succ {blocks : List (List ℕ)} {k : ℕ} (hk : k < blocks.length) :
    boff blocks (k + 1) = boff blocks k + bdeg blocks k + 1 := by
  simp only [boff, bdeg, List.take_add_one, List.getElem?_eq_getElem hk, Option.toList_some,
    List.map_append, List.sum_append, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
    List.getD_eq_getElem?_getD, Option.getD_some]
  omega

theorem bpos_zero (blocks : List (List ℕ)) : bpos blocks 0 = 2 := by simp [bpos, boff_zero]

theorem bpos_succ {blocks : List (List ℕ)} {k : ℕ} (hk : k < blocks.length) :
    bpos blocks (k + 1) = bpos blocks k + bdeg blocks k + 1 := by
  simp only [bpos, boff_succ hk]; omega

theorem bpos_lt {blocks : List (List ℕ)} {j k : ℕ} (hjk : j < k) (hk : k ≤ blocks.length) :
    bpos blocks j + bdeg blocks j + 1 ≤ bpos blocks k := by
  induction k with
  | zero => omega
  | succ k ih =>
    rw [bpos_succ (by omega)]
    rcases Nat.lt_succ_iff_lt_or_eq.1 hjk with h | h
    · have := ih h (by omega); omega
    · subst h; omega

theorem bpos_ge {blocks : List (List ℕ)} {j k : ℕ} (hjk : j ≤ k) (hk : k ≤ blocks.length) :
    bpos blocks j + (k - j) ≤ bpos blocks k := by
  rcases Nat.eq_or_lt_of_le hjk with h | h
  · subst h; omega
  · have := bpos_lt h hk
    induction k with
    | zero => omega
    | succ k ih =>
      rw [bpos_succ (by omega)]
      rcases Nat.lt_succ_iff_lt_or_eq.1 h with h' | h'
      · have := ih (by omega) (by omega) h' (bpos_lt h' (by omega)); omega
      · subst h'; omega

theorem bpos_inj {blocks : List (List ℕ)} {j k : ℕ} (hj : j ≤ blocks.length)
    (hk : k ≤ blocks.length) (h : bpos blocks j = bpos blocks k) : j = k := by
  rcases Nat.lt_trichotomy j k with hjk | hjk | hjk
  · have := bpos_lt hjk hk; omega
  · exact hjk
  · have := bpos_lt hjk hj; omega

theorem length_flatMap_blockCode (blocks : List (List ℕ)) :
    (blocks.flatMap blockCode).length = boff blocks blocks.length := by
  induction blocks with
  | nil => simp [boff]
  | cons b bs ih =>
    simp only [List.flatMap_cons, List.length_append, ih, boff, List.length_cons,
      List.take_succ_cons, List.map_cons, List.sum_cons, blockCode, List.length_map]

/-- The entries of the blocks, then the rest. -/
theorem getD_flatMap_blockCode (tl : List ℝ) : ∀ (blocks : List (List ℕ)) (k j : ℕ),
    k < blocks.length → j ≤ bdeg blocks k →
    (blocks.flatMap blockCode ++ tl).getD (boff blocks k + j) 0 =
      (blockCode (blocks.getD k [])).getD j 0
  | [], k, j, hk, _ => by simp at hk
  | b :: bs, 0, j, _, hj => by
    simp only [boff_zero, Nat.zero_add, List.flatMap_cons,
      List.append_assoc, List.getD_eq_getElem?_getD]
    simp only [bdeg, List.getD_cons_zero] at hj
    rw [List.getElem?_append_left (by simp [blockCode]; omega)]
    rfl
  | b :: bs, k + 1, j, hk, hj => by
    have ih := getD_flatMap_blockCode tl bs k j (by simpa using hk) (by simpa [bdeg] using hj)
    have hoff : boff (b :: bs) (k + 1) = (b.length + 1) + boff bs k := by
      simp [boff, List.take_succ_cons]
    rw [hoff, List.flatMap_cons, List.append_assoc, List.getD_eq_getElem?_getD,
      List.getElem?_append_right (by simp [blockCode]; omega)]
    simp only [blockCode, List.length_cons, List.length_map]
    rw [show b.length + 1 + boff bs k + j - (b.length + 1) = boff bs k + j by omega,
      ← List.getD_eq_getElem?_getD, ih]
    rfl

theorem getD_after_blocks (tl : List ℝ) (blocks : List (List ℕ)) (j : ℕ) :
    (blocks.flatMap blockCode ++ tl).getD (boff blocks blocks.length + j) 0 = tl.getD j 0 := by
  rw [List.getD_eq_getElem?_getD, List.getElem?_append_right (by
    rw [length_flatMap_blockCode]; omega), length_flatMap_blockCode,
    show boff blocks blocks.length + j - boff blocks blocks.length = j by omega,
    ← List.getD_eq_getElem?_getD]

section Shape

variable {n : ℕ} {blocks : List (List ℕ)} {E : ℕ} {rest : List ℝ} {L : List ℝ}

theorem shape_getD_zero (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++
    (E : ℝ) :: rest)) : L.getD 0 0 = n := by subst hL; rfl

theorem shape_getD_one (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++
    (E : ℝ) :: rest)) : L.getD 1 0 = n := by subst hL; rfl

theorem shape_getD_add_two (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++
    (E : ℝ) :: rest)) (i : ℕ) :
    L.getD (i + 2) 0 = (blocks.flatMap blockCode ++ (E : ℝ) :: rest).getD i 0 := by
  subst hL; rfl

/-- Block `k` starts with its length. -/
theorem shape_getD_bpos (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++
    (E : ℝ) :: rest)) {k : ℕ} (hk : k < blocks.length) :
    L.getD (bpos blocks k) 0 = bdeg blocks k := by
  rw [bpos, Nat.add_comm, shape_getD_add_two hL, ← Nat.add_zero (boff blocks k),
    getD_flatMap_blockCode _ _ _ _ hk (Nat.zero_le _)]
  simp [blockCode, bdeg]

/-- The entries of block `k` follow its length. -/
theorem shape_getD_entry (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++
    (E : ℝ) :: rest)) {k j : ℕ} (hk : k < blocks.length) (hj : j < bdeg blocks k) :
    ∃ a : ℕ, a ∈ blocks.getD k [] ∧ L.getD (bpos blocks k + 1 + j) 0 = (a : ℝ) := by
  rw [bpos, show 2 + boff blocks k + 1 + j = boff blocks k + (j + 1) + 2 by omega,
    shape_getD_add_two hL, getD_flatMap_blockCode _ _ _ _ hk (by omega)]
  obtain ⟨b, hb⟩ : ∃ b, blocks.getD k [] = b := ⟨_, rfl⟩
  have hj' : j < b.length := by rw [← hb]; simpa [bdeg] using hj
  refine ⟨b[j], by rw [hb]; exact List.getElem_mem _, ?_⟩
  rw [hb]
  simp only [blockCode, List.getD_eq_getElem?_getD, List.getElem?_cons_succ, List.getElem?_map,
    List.getElem?_eq_getElem hj', Option.map_some, Option.getD_some]

/-- After the blocks: the number of edges, then the rest. -/
theorem shape_getD_after (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++
    (E : ℝ) :: rest)) (j : ℕ) :
    L.getD (bpos blocks blocks.length + j) 0 = ((E : ℝ) :: rest).getD j 0 := by
  rw [bpos, show 2 + boff blocks blocks.length + j = boff blocks blocks.length + j + 2 by omega,
    shape_getD_add_two hL, getD_after_blocks]

theorem shape_length (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++
    (E : ℝ) :: rest)) : L.length = bpos blocks blocks.length + 1 + rest.length := by
  subst hL
  simp only [List.length_cons, List.length_append, length_flatMap_blockCode, bpos]
  omega

end Shape

