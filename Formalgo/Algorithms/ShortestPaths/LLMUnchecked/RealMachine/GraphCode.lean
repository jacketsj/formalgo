    ∀ b ∈ (List.finRange n).map (adjList G), ∀ a ∈ b, a < n := by
  intro b hb a ha
  obtain ⟨v, -, rfl⟩ := List.mem_map.1 hb
  exact lt_of_mem_adjList ha

/-- A shortest-paths input is written like a graph, with the source after the weights. -/
theorem graphShape_sssp (x : Σ n, Σ G : SimpleGraph (Fin n), (G.edgeSet → NNReal) × ℕ) :
    GraphShape 1 (Code.encode (Value := ℝ) x) := by
  obtain ⟨n, G, w, s⟩ := x
  refine ⟨n, (List.finRange n).map (adjList G), (edgeList G).length,
    (edgeList G).map (fun e => (w e : ℝ)) ++ [(s : ℝ)], by simp, forall_mem_adjLists G,
    by simp, ?_⟩
  rw [encode_sssp_input, List.flatMap_map]

/-- An all-pairs shortest-paths input is written like a graph. -/
theorem graphShape_apsp (x : Σ n, Σ G : SimpleGraph (Fin n), G.edgeSet → NNReal) :
    GraphShape 0 (Code.encode (Value := ℝ) x) := by
  obtain ⟨n, G, w⟩ := x
  refine ⟨n, (List.finRange n).map (adjList G), (edgeList G).length,
    (edgeList G).map (fun e => (w e : ℝ)), by simp, forall_mem_adjLists G, by simp, ?_⟩
  rw [encode_apsp_input, List.flatMap_map]

/-- The blocks of a graph have `n + 2 E` values in all (the handshake lemma). -/
theorem length_blocks_real {n : ℕ} (G : SimpleGraph (Fin n)) :
    ((List.finRange n).flatMap fun v => blockCode (adjList G v)).length =
      n + 2 * G.edgeSet.ncard := by
  classical
  have h : ((List.finRange n).flatMap fun v => blockCode (adjList G v)).length =
      ∑ v, (G.degree v + 1) := by
    rw [Fin.sum_univ_def, List.length_flatMap]
    congr 1
    exact List.map_congr_left fun v _ => by simp [blockCode, length_adjList]
  rw [h, Finset.sum_add_distrib, SimpleGraph.sum_degrees_eq_twice_card_edges,
    ← Set.ncard_coe_finset, SimpleGraph.coe_edgeFinset]
  simp; ring

/-- The length of the code of a shortest-paths input. -/
theorem length_encode_sssp_input {n : ℕ} (G : SimpleGraph (Fin n)) (w : G.edgeSet → NNReal)
    (s : ℕ) : (Code.encode (Value := ℝ)
        (⟨n, G, w, s⟩ : Σ n, Σ G : SimpleGraph (Fin n), (G.edgeSet → NNReal) × ℕ)).length =
      n + 3 * G.edgeSet.ncard + 4 := by
  rw [encode_sssp_input]
  simp only [List.length_cons, List.length_append, List.length_map, List.length_nil,
    length_blocks_real, length_edgeList]
  ring

/-- The length of the code of an all-pairs shortest-paths input. -/
