    Code.encode (Value := ℝ) (⟨n, f⟩ : Σ n, Fin n → Fin n → NNReal) =
      (n : ℝ) :: (n : ℝ) :: (List.finRange n).flatMap fun u =>
        (n : ℝ) :: (List.finRange n).map fun v => (f u v : ℝ) := by
  change [(n : ℝ)] ++ (Code.encode f : List ℝ) = _
  rw [encode_labels_fin]
  change [(n : ℝ)] ++ ([(((List.finRange n).map f).length : ℝ)] ++
