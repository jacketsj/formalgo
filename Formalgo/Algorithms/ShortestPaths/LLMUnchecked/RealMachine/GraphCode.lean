    (Code.encode (Value := ℝ)
        (⟨n, G, w⟩ : Σ n, Σ G : SimpleGraph (Fin n), G.edgeSet → NNReal)).length =
      n + 3 * G.edgeSet.ncard + 3 := by
  rw [encode_apsp_input]
  simp only [List.length_cons, List.length_append, List.length_map, length_blocks_real,
    length_edgeList]
