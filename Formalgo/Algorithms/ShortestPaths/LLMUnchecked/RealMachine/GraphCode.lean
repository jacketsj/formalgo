  rw [Set.Finite.toFinset_univ]; exact Fin.sort_univ n

theorem position_fin_eq_val {n : ℕ} (a : Fin n) : Code.position a = a.val := by
  unfold Code.position
  rw [sortUniv_fin]; exact List.idxOf_finRange a

open Classical in
/-- The elements of a set in `Fin n` in increasing order. -/
theorem sortSet_fin {n : ℕ} (s : Set (Fin n)) :
    s.toFinite.toFinset.sort = (List.finRange n).filter (· ∈ s) := by
  refine List.SortedLT.eq_of_mem_iff (Finset.sortedLT_sort _)
    (List.sortedLT_iff_pairwise.2 ((List.sortedLT_iff_pairwise.1 (List.sortedLT_finRange n)).filter
      _)) fun a => ?_
  simp

theorem sortUniv_eq_of_pairwise {α : Type*} [Finite α] [LinearOrder α] {l : List α}
    (hl : l.Pairwise (· < ·)) (hmem : ∀ a, a ∈ l) :
    (Set.finite_univ.toFinset : Finset α).sort = l :=
  List.SortedLT.eq_of_mem_iff (Finset.sortedLT_sort _) (List.sortedLT_iff_pairwise.2 hl)
    fun a => by simp [hmem a]

/-! ### Codes of lists and functions over `ℝ` -/

theorem flatMap_singleton_eq_map {α β : Type*} (g : α → β) (l : List α) :
    (l.flatMap fun a => [g a]) = l.map g := by
  induction l with
  | nil => rfl
  | cons a l ih => simp [ih]

/-- `blockCode b` is the length of `b`, then its entries as reals. -/
theorem blockCode_eq (b : List ℕ) :
    blockCode b = (b.length : ℝ) :: b.map fun a : ℕ => (a : ℝ) := by
  simp [blockCode]

/-- A list of natural numbers is written over `ℝ` as its block. -/
theorem encode_natList_real (l : List ℕ) : (Code.encode l : List ℝ) = blockCode l := by
  change [(l.length : ℝ)] ++ l.flatMap (fun a : ℕ => [(a : ℝ)]) = _
  rw [flatMap_singleton_eq_map, List.singleton_append, blockCode_eq]

/-- A list of nonnegative reals is written over `ℝ` as its length, then its elements. -/
theorem encode_nnrealList_real (l : List NNReal) :
    (Code.encode l : List ℝ) = (l.length : ℝ) :: l.map fun r : NNReal => (r : ℝ) := by
  change [(l.length : ℝ)] ++ l.flatMap (fun r : NNReal => [(r : ℝ)]) = _
  rw [flatMap_singleton_eq_map, List.singleton_append]

/-- A function on `Fin n` is written as the list of its values, in order. -/
theorem encode_labels_fin {V β : Type*} [Inhabited β] [Code (List β) V] {n : ℕ}
    (f : Fin n → β) : (Code.encode f : List V) = Code.encode ((List.finRange n).map f) := by
  change (Code.encode (((Set.finite_univ.toFinset : Finset (Fin n)).sort).map f) : List V) = _
  rw [sortUniv_fin]

/-! ### The code of a graph -/

open Classical in
/-- The neighbours of `v`, in increasing order, as numbers. -/
noncomputable def adjList {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) : List ℕ :=
  ((List.finRange n).filter fun u => G.Adj v u).map Fin.val

theorem mem_adjList {n : ℕ} {G : SimpleGraph (Fin n)} {v : Fin n} {a : ℕ} :
    a ∈ adjList G v ↔ ∃ u : Fin n, G.Adj v u ∧ u.val = a := by
  simp [adjList]

theorem lt_of_mem_adjList {n : ℕ} {G : SimpleGraph (Fin n)} {v : Fin n} {a : ℕ}
    (h : a ∈ adjList G v) : a < n := by
  obtain ⟨u, -, rfl⟩ := mem_adjList.1 h
  exact u.isLt

theorem pairwise_adjList {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) :
    (adjList G v).Pairwise (· < ·) := by
  unfold adjList
  rw [List.pairwise_map]
  exact (List.sortedLT_iff_pairwise.1 (List.sortedLT_finRange n)).filter _

theorem length_adjList {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] (v : Fin n) :
    (adjList G v).length = G.degree v := by
  rw [← SimpleGraph.card_neighborFinset_eq_degree, SimpleGraph.neighborFinset_eq_filter, adjList,
    List.length_map, ← List.toFinset_card_of_nodup ((List.nodup_finRange n).filter _)]
  congr 1
  ext u
  simp

