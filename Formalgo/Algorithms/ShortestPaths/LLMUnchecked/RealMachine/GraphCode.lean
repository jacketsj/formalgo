  congr 1
  exact List.map_congr_left fun a _ => position_fin_eq_val a

/-- A graph on `Fin n` is written over `ℝ` as `n`, then a block for each vertex: its degree and
its neighbours in increasing order. -/
theorem encode_graph_real {n : ℕ} (G : SimpleGraph (Fin n)) :
    (Code.encode G : List ℝ) =
      (n : ℝ) :: (List.finRange n).flatMap fun v => blockCode (adjList G v) := by
