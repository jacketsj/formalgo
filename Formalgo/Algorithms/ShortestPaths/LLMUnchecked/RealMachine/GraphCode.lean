theorem length_encode_sssp_output {n : ℕ} (f : Fin n → NNReal) :
    (Code.encode (Value := ℝ) (⟨n, f⟩ : Σ n, Fin n → NNReal)).length = n + 2 := by
  rw [encode_sssp_output]; simp

theorem length_encode_apsp_output {n : ℕ} (f : Fin n → Fin n → NNReal) :
    (Code.encode (Value := ℝ) (⟨n, f⟩ : Σ n, Fin n → Fin n → NNReal)).length =
