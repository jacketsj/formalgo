/-! ### The edges in lexicographic order -/

theorem sortEquiv_of_mem_lexEdges {n : ℕ} {G : SimpleGraph (Fin n)} {e : Fin n × Fin n}
    (he : e ∈ lexEdges G) : (Sym2.sortEquiv s(e.1, e.2) : Fin n × Fin n) = e := by
  have h := (mem_edges.1 he).1
  simp [inf_of_le_left h.le, sup_of_le_right h.le]

theorem pairwise_lexEdges_toLex {n : ℕ} (G : SimpleGraph (Fin n)) :
    ((lexEdges G).map toLex).Pairwise (· < ·) := by
  have hfr := List.sortedLT_iff_pairwise.1 (List.sortedLT_finRange n)
  unfold lexEdges
  rw [List.map_flatMap, List.pairwise_flatMap]
  refine ⟨fun u _ => ?_, hfr.imp fun {u u'} huu' => ?_⟩
  · rw [List.map_map, List.pairwise_map]
    refine (hfr.filter _).imp ?_
    intro v v' h
    exact Prod.Lex.toLex_lt_toLex.2 (.inr ⟨rfl, h⟩)
  · intro a ha b hb
    simp only [List.map_map, List.mem_map, Function.comp_apply] at ha hb
    obtain ⟨v, -, rfl⟩ := ha
    obtain ⟨v', -, rfl⟩ := hb
    exact Prod.Lex.toLex_lt_toLex.2 (.inl huu')

theorem pairwise_edgeList_sortEquiv {n : ℕ} (G : SimpleGraph (Fin n)) :
    (edgeList G).Pairwise fun a b =>
      toLex (Sym2.sortEquiv a.1 : Fin n × Fin n) < toLex (Sym2.sortEquiv b.1 : Fin n × Fin n) := by
  have h : (lexEdges G).Pairwise fun a b => a ∈ lexEdges G ∧ b ∈ lexEdges G ∧ toLex a < toLex b :=
    (List.pairwise_map.1 (pairwise_lexEdges_toLex G)).imp_of_mem fun ha hb h => ⟨ha, hb, h⟩
  unfold edgeList
  refine h.filterMap _ fun a b ⟨ha, hb, hab⟩ a' ha' b' hb' => ?_
  have hma : s(a.1, a.2) ∈ G.edgeSet := (mem_edges.1 ha).2
  have hmb : s(b.1, b.2) ∈ G.edgeSet := (mem_edges.1 hb).2
  simp only [hma, hmb, ↓reduceDIte, Option.some.injEq] at ha' hb'
  subst ha' hb'
  change toLex (Sym2.sortEquiv s(a.1, a.2) : Fin n × Fin n) <
    toLex (Sym2.sortEquiv s(b.1, b.2) : Fin n × Fin n)
  rw [sortEquiv_of_mem_lexEdges ha, sortEquiv_of_mem_lexEdges hb]
  exact hab

theorem length_edgeList {n : ℕ} (G : SimpleGraph (Fin n)) :
    (edgeList G).length = G.edgeSet.ncard := by
  letI := Code.sym2LinearOrder (Fin n)
  rw [← sortUniv_eq_of_pairwise (α := G.edgeSet) (pairwise_edgeList_sortEquiv G)
    (mem_edgeList (G := G)), Finset.length_sort,
    ← Set.ncard_eq_toFinset_card _ Set.finite_univ, Set.ncard_univ, Nat.card_coe_set_eq]

/-- The edge weights are written over `ℝ` as the number of edges, then the weights in the order
of `edgeList G`. -/
theorem encode_weights_real {n : ℕ} (G : SimpleGraph (Fin n)) (w : G.edgeSet → NNReal) :
    (Code.encode w : List ℝ) =
      ((edgeList G).length : ℝ) :: (edgeList G).map fun e => (w e : ℝ) := by
  letI := Code.sym2LinearOrder (Fin n)
  refine (congrArg (fun l : List G.edgeSet => (Code.encode (l.map w) : List ℝ))
    (sortUniv_eq_of_pairwise (α := G.edgeSet) (pairwise_edgeList_sortEquiv G)
      (mem_edgeList (G := G)))).trans ?_
  rw [encode_nnrealList_real, List.length_map, List.map_map]
  rfl

