theorem fwMem_succ_left {blocks : List (List ℕ)} {base : RMem} {k n i : ℕ}
    (hn : n ≤ blocks.length) (hi : i ≠ bpos blocks k) :
    fwMem blocks base k n i = fwMem blocks base (k + 1) n i := by
  by_cases h : ∃ j, k + 1 ≤ j ∧ j < n ∧ i = bpos blocks j
  · obtain ⟨j, hj1, hj2, rfl⟩ := h
    rw [fwMem_at (by omega) hj2 hn, fwMem_at hj1 hj2 hn]
  · push Not at h
    rw [fwMem_of_ne fun j hj1 hj2 e => ?_, fwMem_of_ne fun j hj1 hj2 e => h j hj1 hj2 e]
    rcases Nat.eq_or_lt_of_le hj1 with h' | h'
    · subst h'; exact hi e
    · exact h j h' hj2 e

