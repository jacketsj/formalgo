      (∀ i, s'.d i = if 3 ≤ i ∧ i < p₁ then s.d i + s.d 1 else s.d i) ∧
      (∀ a, a ≠ 4 → a ≠ 6 → s'.m a = s.m a) ∧ k ≤ 5 * p₁ + 2 := by
  dstep; dstep; rename_i m₁ g₁ f₁
  dstep
  refine DRuns.mono (DRuns.loop (s := ⟨m₁, s.d⟩) (Q := fun s' k =>
      (∀ i, s'.d i = if 3 ≤ i ∧ i < p₁ then s.d i + s.d 1 else s.d i) ∧
      (∀ a, a ≠ 4 → a ≠ 6 → s'.m a = s.m a) ∧ k ≤ 5 * p₁ + 1)
    (fun s' k => ∃ j, 3 ≤ j ∧ j ≤ p₁ ∧ s'.m 4 = j ∧ s'.m 6 = (if j < p₁ then 1 else 0) ∧
      (∀ i, s'.d i = if 3 ≤ i ∧ i < j then s.d i + s.d 1 else s.d i) ∧
      (∀ a, a ≠ 4 → a ≠ 6 → s'.m a = s.m a) ∧ k ≤ 5 * (j - 3))
