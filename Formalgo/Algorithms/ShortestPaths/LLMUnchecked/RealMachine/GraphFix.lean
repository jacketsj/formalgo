      fun i => by rw [if_neg (by omega)], fun a h1 h2 => by rs, by omega⟩) ?_
  · rintro s' k ⟨j, hj3, hjp, e4, e6, hd, hfr, hk⟩ heq
    have hlt : j < p₁ := by
      by_contra hc
      rw [e6, if_neg hc, hfr 11 (by omega) (by omega), h11] at heq; exact absurd heq (by decide)
    dstep; dstep; rename_i d₂ g₂ f₂
    dstep; dstep; rename_i m₃ g₃ f₃
    dstep; dstep; rename_i m₄ g₄ f₄
    dstep
    simp only at g₂ f₂ g₃ f₃ g₄ f₄ ⊢
    have v4 : m₄ 4 = j + 1 := by
      rw [f₄ 4 (by omega), g₃, e4, hfr 5 (by omega) (by omega), h5]
