/-! ### The fix-up -/

theorem getD_preList (L : List ℝ) (n : ℕ) (blocks : List (List ℕ)) (i : ℕ) :
    (preList L n blocks).getD i 0 = if i < L.length then
      (if i = 0 then (bpos blocks n : ℝ) else if i < 3 then 0 else bootG L n blocks i)
    else 0 := by
  split_ifs with h
  · rw [List.getD_eq_getElem _ _ (by rw [length_preList]; exact h), getElem_preList, if_pos ‹_›]
  · rw [List.getD_eq_getElem _ _ (by rw [length_preList]; exact h), getElem_preList,
      if_neg ‹_›, if_pos ‹_›]
  · rw [List.getD_eq_getElem _ _ (by rw [length_preList]; exact h), getElem_preList,
      if_neg ‹_›, if_neg ‹_›]
  · exact List.getD_eq_default _ _ (by rw [length_preList]; omega)

/-- With `n ≥ 1`: find block `1`, restore the lengths, count `n`, add `n` back to block `0`, and
rewrite cells `0, 1, 2`. -/
def fixPos : DCmd :=
  .seqs [Cmd.const 4 3, fixScan, Cmd.copy 10 4, Cmd.const 7 1, fixWalk, Cmd.const 3 1, .ofIdx 3 7,
    Cmd.const 4 3, fixUntag, Cmd.const 3 0, .ofIdx 3 7, Cmd.const 3 2, Cmd.const 11 3,
    Cmd.sub 8 10 11, .ofIdx 3 8]

theorem fixPos_runs {L : List ℝ} {n : ℕ} {blocks : List (List ℕ)} {E c : ℕ} {rest : List ℝ}
    (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++ (E : ℝ) :: rest))
    (hlen : blocks.length = n) (hlt : ∀ b ∈ blocks, ∀ a ∈ b, a < n)
    (hrest : rest.length = E + c) (hn : 1 ≤ n) {s : DState} (h1 : s.m 1 = bpos blocks n)
    (h5 : s.m 5 = 1) (h9 : s.m 9 = 1) (hd : ∀ i, s.d i = (preList L n blocks).getD i 0) :
    DRuns fixPos s fun s' k => (∀ i, s'.d i = L.getD i 0) ∧
      (∀ a, 12 ≤ a ∨ a = 0 → s'.m a = s.m a) ∧ k ≤ 20 * L.length + 40 := by
  have hS := shape_length hL
  rw [hrest, hlen] at hS
  set S := L.length
  set d₀ := bdeg blocks 0
  set p₁ := bpos blocks 1
  set pe := bpos blocks n
  have hp1 : p₁ = 3 + d₀ := bpos_one hn hlen
  have hp1e : p₁ ≤ pe := by
    have := bpos_ge (blocks := blocks) (j := 1) (k := n) hn (by omega); omega
  have hpeS : pe < S := by omega
  have hG : ∀ i, bootG L n blocks i = fwMem blocks (tagMem L n d₀) 1 n i := fun i => by
    simp only [bootG, if_neg (show n ≠ 0 by omega)]; rfl
  -- The data cells from `3`.
  have hd3 : ∀ i, 3 ≤ i → i < S → s.d i = fwMem blocks (tagMem L n d₀) 1 n i := fun i h3 hS' => by
    rw [hd, getD_preList, if_pos hS', if_neg (by omega), if_neg (by omega), hG]
  -- Block `0`'s entries, tagged.
  have hneg : ∀ i, 3 ≤ i → i < p₁ → s.d i < 0 := fun i h3 hi => by
    obtain ⟨a, han, ha⟩ := tag_entry hL hn hlen hlt h3 (by omega)
    rw [hd3 i h3 (by omega), fwMem_of_ne fun k hk1 hkn e => by
      have := bpos_ge (blocks := blocks) (j := 1) (k := k) hk1 (by omega); omega,
      tagMem, if_pos ⟨h3, by omega⟩, ha, sub_neg]
    exact_mod_cast han
  have hpos : ¬ s.d p₁ < 0 := by
    rw [hd3 p₁ (by omega) (by omega)]
    rcases Nat.lt_or_ge 1 n with h | h
    · rw [fwMem_at le_rfl h (by omega)]; exact not_lt.2 (by positivity)
    · rw [fwMem_of_ne fun k hk1 hkn => by omega, tagMem, if_neg (by omega)]
      obtain ⟨v, hv⟩ := getD_bpos_nat hL hlen (k := 1) hn
      rw [hv]; exact not_lt.2 (by positivity)
  have hd1 : s.d 1 = 0 := by rw [hd, getD_preList, if_pos (by omega)]; simp
  dstep; dstep; rename_i m₁ g₁ f₁
  dstep
  try dsimp only at *
  refine DRuns.mono (fixScan_runs (s := ⟨m₁, s.d⟩) (p₁ := p₁) g₁
    (by dsimp only; rw [f₁ 5 (by omega), h5]) (by dsimp only; rw [f₁ 9 (by omega), h9]) hd1
    (by omega) hneg hpos) ?_
  rintro s₂ k₂ ⟨ed₂, e4₂, e11₂, fr₂, hk₂⟩
  try dsimp only at *
  dstep; dstep; rename_i m₃ g₃ f₃
  dstep; dstep; rename_i m₄ g₄ f₄
  dstep
  try dsimp only at *
  have hs₄d : (⟨m₄, s₂.d⟩ : DState).d = s.d := ed₂
  refine DRuns.mono (fixWalk_runs (s := ⟨m₄, s₂.d⟩) (base := tagMem L n d₀) (S := S) hn hlen
    (by omega) hpeS (by simp only; rw [f₄ 4 (by omega), f₃ 4 (by omega), e4₂])
    (by simp only; rw [g₄]) (by simp only; rw [f₄ 1 (by omega), f₃ 1 (by omega),
      fr₂ 1 (by omega) (by omega) (by omega), f₁ 1 (by omega), h1])
    (by simp only; rw [f₄ 5 (by omega), f₃ 5 (by omega), fr₂ 5 (by omega) (by omega)
      (by omega), f₁ 5 (by omega), h5])
    (by simp only; rw [f₄ 11 (by omega), f₃ 11 (by omega), e11₂])
    (fun i h3 hS' => by rw [hs₄d]; exact hd3 i h3 hS')
    (fun k hk1 hkn => by
      have := bpos_ge (blocks := blocks) (j := 1) (k := k) hk1 (by omega)
      rw [tagMem, if_neg (by omega), shape_getD_bpos hL (by omega)])) ?_
  rintro s₅ k₅ ⟨e7₅, hw₅, ho₅, fr₅, hk₅⟩
  try dsimp only at *
  dstep; dstep; rename_i m₆ g₆ f₆
  dstep; dstep; rename_i d₇ g₇ f₇
  dstep; dstep; rename_i m₈ g₈ f₈
  dstep
  try dsimp only at *
  have a10 : m₈ 10 = p₁ := by
    rw [f₈ 10 (by omega), f₆ 10 (by omega), fr₅ 10 (by omega) (by omega) (by omega) (by omega),
      f₄ 10 (by omega), g₃, e4₂]
  have a9 : m₈ 9 = 1 := by
    rw [f₈ 9 (by omega), f₆ 9 (by omega), fr₅ 9 (by omega) (by omega) (by omega) (by omega),
      f₄ 9 (by omega), f₃ 9 (by omega), fr₂ 9 (by omega) (by omega) (by omega),
      f₁ 9 (by omega), h9]
  have a5 : m₈ 5 = 1 := by
    rw [f₈ 5 (by omega), f₆ 5 (by omega), fr₅ 5 (by omega) (by omega) (by omega) (by omega),
      f₄ 5 (by omega), f₃ 5 (by omega), fr₂ 5 (by omega) (by omega) (by omega),
      f₁ 5 (by omega), h5]
  have a11 : m₈ 11 = 1 := by
    rw [f₈ 11 (by omega), f₆ 11 (by omega), fr₅ 11 (by omega) (by omega) (by omega) (by omega),
      f₄ 11 (by omega), f₃ 11 (by omega), e11₂]
  refine DRuns.mono (fixUntag_runs (s := ⟨m₈, d₇⟩) (p₁ := p₁) (by omega) g₈ a10 a9 a5 a11) ?_
  rintro s₉ k₉ ⟨hd₉, fr₉, hk₉⟩
  try dsimp only at *
  dstep; dstep; rename_i m₁₀ g₁₀ f₁₀
  dstep; dstep; rename_i d₁₁ g₁₁ f₁₁
  dstep; dstep; rename_i m₁₂ g₁₂ f₁₂
  dstep; dstep; rename_i m₁₃ g₁₃ f₁₃
  dstep
  try dsimp only at *
  refine DRuns.isub (by simp only; rw [g₁₃, f₁₃ 10 (by omega), f₁₂ 10 (by omega),
    f₁₀ 10 (by omega), fr₉ 10 (by omega) (by omega), a10]; omega) ?_
  intro m₁₄ g₁₄ f₁₄
  dstep; dstep; rename_i d₁₅ g₁₅ f₁₅
  dstep
  try dsimp only at *
  -- The index cells used.
  have b63 : m₆ 3 = 1 := g₆
  have b67 : m₆ 7 = n := by rw [f₆ 7 (by omega), e7₅]
  have b103 : m₁₀ 3 = 0 := g₁₀
  have b107 : m₁₀ 7 = n := by
    rw [f₁₀ 7 (by omega), fr₉ 7 (by omega) (by omega), f₈ 7 (by omega), f₆ 7 (by omega), e7₅]
  have b143 : m₁₄ 3 = 2 := by rw [f₁₄ 3 (by omega), f₁₃ 3 (by omega), g₁₂]
  have b148 : m₁₄ 8 = d₀ := by
    rw [g₁₄, f₁₃ 10 (by omega), f₁₂ 10 (by omega), f₁₀ 10 (by omega), fr₉ 10 (by omega)
      (by omega), a10, g₁₃]; omega
  rw [b63] at g₇ f₇
  rw [b103, b107] at g₁₁
  rw [b103] at f₁₁
  rw [b143, b148] at g₁₅
  rw [b143] at f₁₅
  have hd7 : ∀ i, i ≠ 1 → d₇ i = s₅.d i := f₇
  have hs₅ : ∀ i, s₅.d i = if 3 ≤ i ∧ i < S then tagMem L n d₀ i else s.d i := fun i => by
    split_ifs with h
    · exact hw₅ i h.1 h.2
    · rw [ho₅ i (by omega), ed₂]
  refine ⟨fun i => ?_, fun a ha => ?_, ?_⟩
  · rcases (show i = 0 ∨ i = 1 ∨ i = 2 ∨ 3 ≤ i by omega) with h | h | h | h
    · subst h
      rw [f₁₅ 0 (by omega), g₁₁, shape_getD_zero hL]
    · subst h
      rw [f₁₅ 1 (by omega), f₁₁ 1 (by omega), hd₉, if_neg (by omega), g₇, b67,
        shape_getD_one hL]
    · subst h
      rw [g₁₅, ← bpos_zero blocks, shape_getD_bpos hL (by omega)]
    · rw [f₁₅ i (by omega), f₁₁ i (by omega), hd₉, hd7 i (by omega), hs₅, g₇, b67]
      by_cases hip : i < p₁
      · rw [if_pos ⟨h, hip⟩, if_pos ⟨h, by omega⟩, tagMem, if_pos ⟨h, by omega⟩]; ring
      · rw [if_neg (fun h' => hip h'.2)]
        by_cases hiS : i < S
        · rw [if_pos ⟨h, hiS⟩, tagMem, if_neg (by omega)]
        · rw [if_neg (fun h' => hiS h'.2), hd, getD_preList, if_neg hiS,
            List.getD_eq_default _ _ (by omega)]
  · have e : m₁₄ a = s₉.m a := by
      rw [f₁₄ a (by omega), f₁₃ a (by omega), f₁₂ a (by omega), f₁₀ a (by omega)]
    rw [e, fr₉ a (by omega) (by omega), f₈ a (by omega), f₆ a (by omega),
      fr₅ a (by omega) (by omega) (by omega) (by omega), f₄ a (by omega), f₃ a (by omega),
      fr₂ a (by omega) (by omega) (by omega), f₁ a (by omega)]
  · have := bpos_ge (blocks := blocks) (j := 0) (k := n) (by omega) (by omega)
    rw [bpos_zero] at this
    omega

/-- With `n = 0`: `d[2] := ℓ - 3 - c` and `d[0] := 0`. -/
noncomputable def fixZero (c : ℕ) : DCmd :=
  .seqs [Cmd.const 11 (3 + c), Cmd.sub 8 0 11, Cmd.const 3 2, .ofIdx 3 8, Cmd.const 3 0,
    .dconst 3 0]

theorem fixZero_runs {L : List ℝ} {blocks : List (List ℕ)} {E c : ℕ} {rest : List ℝ}
    (hL : L = ((0 : ℕ) : ℝ) :: ((0 : ℕ) : ℝ) :: (blocks.flatMap blockCode ++ (E : ℝ) :: rest))
    (hlen : blocks.length = 0) (hrest : rest.length = E + c) {s : DState}
    (h0 : s.m 0 = L.length) (hd : ∀ i, s.d i = (preList L 0 blocks).getD i 0) :
    DRuns (fixZero c) s fun s' k => (∀ i, s'.d i = L.getD i 0) ∧
      (∀ a, 12 ≤ a ∨ a = 0 → s'.m a = s.m a) ∧ k ≤ 6 := by
  have hb : blocks = [] := List.eq_nil_of_length_eq_zero hlen
  subst hb
  have hS := shape_length hL
  simp only [hrest, List.length_nil, bpos, boff, List.take_nil, List.map_nil,
    List.sum_nil] at hS
  dstep; dstep; rename_i m₁ g₁ f₁
  dstep
  refine DRuns.isub (by dsimp only; rw [g₁, f₁ 0 (by omega), h0]; omega) ?_
  intro m₂ g₂ f₂
  dstep; dstep; rename_i m₃ g₃ f₃
  dstep; dstep; rename_i d₄ g₄ f₄
  dstep; dstep; rename_i m₅ g₅ f₅
  dstep; dstep; rename_i d₆ g₆ f₆
  dstep
  try dsimp only at *
  have b2 : m₂ 8 = E := by rw [g₂, f₁ 0 (by omega), h0, g₁]; omega
  rw [g₃, f₃ 8 (by omega), b2] at g₄
  rw [g₃] at f₄
  rw [g₅] at g₆ f₆
  refine ⟨fun i => ?_, fun a ha => ?_, by omega⟩
  · rcases (show i = 0 ∨ i = 2 ∨ (i ≠ 0 ∧ i ≠ 2) by omega) with h | h | h
    · subst h; rw [g₆, shape_getD_zero hL]; simp
    · subst h; rw [f₆ 2 (by omega), g₄]
      have := shape_getD_after hL 0
      simp only [List.length_nil, bpos, boff, List.take_nil, List.map_nil, List.sum_nil,
        Nat.add_zero] at this
      rw [this]; rfl
    · rw [f₆ i h.1, f₄ i h.2, hd, getD_preList]
      split_ifs with h1 h2 h3
      · omega
      · rcases (show i = 1 by omega) with rfl
        rw [shape_getD_one hL]; simp
      · simp [bootG]
      · exact (List.getD_eq_default _ _ (by omega)).symm
  · rw [f₅ a (by omega), f₃ a (by omega), f₂ a (by omega), f₁ a (by omega)]

/-- Zero the index cells `1, …, 11`. -/
def fixClean : DCmd := .seqs ((List.range' 1 11).map fun r => (Cmd.const r 0 : DCmd))

theorem clean_runs : ∀ (rs : List ℕ) (s : DState),
    DRuns (.seqs (rs.map fun r => (Cmd.const r 0 : DCmd))) s fun s' k => s'.d = s.d ∧
      (∀ a ∈ rs, s'.m a = 0) ∧ (∀ a, a ∉ rs → s'.m a = s.m a) ∧ k = rs.length
  | [], s => DRuns.seqs_nil ⟨rfl, by simp, fun _ _ => rfl, rfl⟩
  | r :: rs, s => by
    refine DRuns.seqs_cons (DRuns.iconst fun m₁ g₁ f₁ => ?_)
    refine DRuns.mono (clean_runs rs ⟨m₁, s.d⟩) fun s' k ⟨hd, hz, hfr, hk⟩ => ?_
    refine ⟨hd, fun a ha => ?_, fun a ha => ?_, by simp [hk]; omega⟩
    · rcases List.mem_cons.1 ha with rfl | ha
      · by_cases h : a ∈ rs
        · exact hz a h
        · rw [hfr a h]; exact g₁
      · exact hz a ha
    · rw [hfr a (fun h => ha (List.mem_cons_of_mem _ h))]
      exact f₁ a (fun h => ha (h ▸ List.mem_cons_self))

/-- The fix-up for a graph-shaped input with `c` values after the edge labels. -/
noncomputable def fixCmd (c : ℕ) : DCmd :=
  .seqs [Cmd.const 5 1, Cmd.const 2 2, Cmd.const 9 1, .toIdx 1 3, .ite 1 2 (fixZero c) fixPos,
    fixClean]

/-- The fix-up turns the boot's list back into the input code. -/
theorem fixCmd_runs {L : List ℝ} {n : ℕ} {blocks : List (List ℕ)} {E c : ℕ} {rest : List ℝ}
    (hL : L = (n : ℝ) :: (n : ℝ) :: (blocks.flatMap blockCode ++ (E : ℝ) :: rest))
    (hlen : blocks.length = n) (hlt : ∀ b ∈ blocks, ∀ a ∈ b, a < n)
    (hrest : rest.length = E + c) :
    DRuns (fixCmd c) (.input (preList L n blocks)) fun s k =>
      s = .input L ∧ k ≤ 20 * L.length + 60 := by
  have hP := length_preList L n blocks
  have hS := shape_length hL
  rw [hrest, hlen] at hS
  have hpe : 2 + n ≤ bpos blocks n := by
    have := bpos_ge (blocks := blocks) (j := 0) (k := n) (by omega) (by omega)
    rw [bpos_zero] at this; omega
  dstep; dstep; rename_i m₁ g₁ f₁
  dstep; dstep; rename_i m₂ g₂ f₂
  dstep; dstep; rename_i m₃ g₃ f₃
  dstep
  try dsimp only at *
  have hi0 : ∀ a, (DState.input (preList L n blocks)).m a = if a = 0 then L.length else 0 :=
    fun a => by simp [DState.input, hP]
  have hm3 : m₃ 3 = 0 := by rw [f₃ 3 (by omega), f₂ 3 (by omega), f₁ 3 (by omega), hi0]; rfl
  refine DRuns.toIdxR (bpos blocks n) ?_ fun m₄ g₄ f₄ => ?_
  · dsimp only; rw [hm3]
    change (preList L n blocks).getD 0 0 = _
    rw [getD_preList, if_pos (by omega), if_pos rfl]
  dstep
  try dsimp only at *
  have hd : ∀ i, (⟨m₄, (DState.input (preList L n blocks)).d⟩ : DState).d i =
      (preList L n blocks).getD i 0 := fun i => rfl
  have e0 : m₄ 0 = L.length := by
    rw [f₄ 0 (by omega), f₃ 0 (by omega), f₂ 0 (by omega), f₁ 0 (by omega), hi0]; rfl
  refine DRuns.ite (fun heq => ?_) (fun hne => ?_)
  · -- No vertices.
    have hn : n = 0 := by
      dsimp only at heq; rw [g₄, f₄ 2 (by omega), f₃ 2 (by omega), g₂] at heq; omega
    subst hn
    refine DRuns.mono (fixZero_runs hL hlen hrest e0 hd) fun s₅ k₅ ⟨hd₅, fr₅, hk₅⟩ => ?_
    dstep
    refine DRuns.mono (clean_runs (List.range' 1 11) s₅) fun s₆ k₆ ⟨hd₆, hz, hfr, hk⟩ => ?_
    dstep
    refine ⟨DState.ext (funext fun a => ?_) (funext fun a => ?_), ?_⟩
    · simp only [DState.input, List.mem_range'_1] at hz hfr ⊢
      by_cases ha : 1 ≤ a ∧ a < 12
      · rw [hz a (by omega), if_neg (by omega)]
      · rw [hfr a (by omega), fr₅ a (by omega)]
        by_cases ha0 : a = 0
        · subst ha0; simp [e0]
        · rw [if_neg ha0]; dsimp only
          rw [f₄ a (by omega), f₃ a (by omega), f₂ a (by omega), f₁ a (by omega), hi0, if_neg ha0]
    · rw [hd₆, hd₅]; rfl
    · simp at hk; omega
  · -- Some vertex.
    have hn : 1 ≤ n := by
      by_contra hc
      apply hne; dsimp only; rw [g₄, f₄ 2 (by omega), f₃ 2 (by omega), g₂]
      have : bpos blocks n = 2 := by
        rw [show n = 0 by omega, bpos_zero]
      rw [this]
    refine DRuns.mono (fixPos_runs hL hlen hlt hrest hn (s := ⟨m₄, _⟩) g₄
      (by dsimp only; rw [f₄ 5 (by omega), f₃ 5 (by omega), f₂ 5 (by omega), g₁])
      (by dsimp only; rw [f₄ 9 (by omega), g₃]) hd) fun s₅ k₅ ⟨hd₅, fr₅, hk₅⟩ => ?_
    dstep
    refine DRuns.mono (clean_runs (List.range' 1 11) s₅) fun s₆ k₆ ⟨hd₆, hz, hfr, hk⟩ => ?_
    dstep
    refine ⟨DState.ext (funext fun a => ?_) (funext fun a => ?_), ?_⟩
    · simp only [DState.input, List.mem_range'_1] at hz hfr ⊢
      by_cases ha : 1 ≤ a ∧ a < 12
      · rw [hz a (by omega), if_neg (by omega)]
      · rw [hfr a (by omega), fr₅ a (by omega)]
        by_cases ha0 : a = 0
        · subst ha0; simp [e0]
        · rw [if_neg ha0]; dsimp only
          rw [f₄ a (by omega), f₃ a (by omega), f₂ a (by omega), f₁ a (by omega), hi0, if_neg ha0]
    · rw [hd₆, hd₅]; rfl
    · simp at hk; omega

