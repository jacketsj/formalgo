import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.Defs

/-!
# Reasoning about commands with real data

LLM-generated; not checked by a human.

The lift of `Exec`/`Runs` proofs to `DExec`/`DRuns` (data unchanged), and continuation rules for
`DRuns`, as `Runs` has for `Cmd`.
-/

namespace Formalgo.Algorithms.ShortestPaths.LLMUnchecked

open Function

/-- A command on the index memory runs as `Exec` says, with the data memory unchanged. -/
theorem DExec.ofExec {B : ℕ} {c : Cmd} {m m' : Mem} {k : ℕ} (d : ℕ → ℝ) (h : Exec B c m k m') :
    DExec c ⟨m, d⟩ k ⟨m', d⟩ :=
  .idx h

/-- A loop, from an invariant `P` on states and costs so far, and a decreasing measure. -/
theorem DExec.loop_of {l r : ℕ} {body : DCmd} (P : DState → ℕ → Prop) (μ : DState → ℕ)
    (Q : DState → ℕ → Prop)
    (hstep : ∀ s n, P s n → s.m l = s.m r →
      ∃ s' k, DExec body s k s' ∧ P s' (n + k + 2) ∧ μ s' < μ s)
    (hexit : ∀ s n, P s n → s.m l ≠ s.m r → Q s (n + 1)) :
    ∀ s n, P s n → ∃ s' k, DExec (.loop l r body) s k s' ∧ Q s' (n + k) := by
  intro s
  induction hμ : μ s using Nat.strong_induction_on generalizing s with
  | _ N ih =>
    intro n hP
    by_cases heq : s.m l = s.m r
    · obtain ⟨s₁, k₁, hb, hP₁, hμ₁⟩ := hstep s n hP heq
      obtain ⟨s₂, k₂, hl₂, hQ⟩ := ih (μ s₁) (hμ ▸ hμ₁) s₁ rfl _ hP₁
      exact ⟨s₂, k₁ + k₂ + 2, .loopTrue heq hb hl₂, by
        rw [show n + (k₁ + k₂ + 2) = n + k₁ + 2 + k₂ by omega]; exact hQ⟩
    · exact ⟨s, 1, .loopFalse heq, hexit s n hP heq⟩

namespace DRuns

variable {s : DState} {Q : DState → ℕ → Prop}

/-- A `Runs` proof for an index command gives a `DRuns` proof, with the data unchanged. -/
theorem idx {B : ℕ} {c : Cmd} (h : Runs B c s.m fun m' k => Q ⟨m', s.d⟩ k) : DRuns c s Q := by
  obtain ⟨m', k, e, hQ⟩ := h
  exact ⟨⟨m', s.d⟩, k, .idx e, hQ⟩

/-- `Runs` lifts to `DRuns`: the index memory follows `Runs`, and the data is unchanged. -/
theorem ofRuns {B : ℕ} {c : Cmd} {m : Mem} {d : ℕ → ℝ} {Q' : Mem → ℕ → Prop}
    (h : Runs B c m Q') : DRuns c ⟨m, d⟩ fun s' k => s'.d = d ∧ Q' s'.m k := by
  obtain ⟨m', k, e, hQ⟩ := h
  exact ⟨⟨m', d⟩, k, .idx e, rfl, hQ⟩

theorem mono {c : DCmd} {Q' : DState → ℕ → Prop} (h : DRuns c s Q)
    (hQ : ∀ s k, Q s k → Q' s k) : DRuns c s Q' := by
  obtain ⟨s', k, e, hq⟩ := h; exact ⟨s', k, e, hQ _ _ hq⟩

theorem skip (h : Q s 0) : DRuns .skip s Q := ⟨s, 0, .skip, h⟩

theorem seq {a b : DCmd} (h : DRuns a s fun s₁ k₁ => DRuns b s₁ fun s₂ k₂ => Q s₂ (k₁ + k₂)) :
    DRuns (.seq a b) s Q := by
  obtain ⟨s₁, k₁, e₁, s₂, k₂, e₂, hQ⟩ := h
  exact ⟨s₂, k₁ + k₂, .seq e₁ e₂, hQ⟩

theorem seqs_nil (h : Q s 0) : DRuns (DCmd.seqs []) s Q := skip h

theorem seqs_cons {c : DCmd} {cs : List DCmd}
    (h : DRuns c s fun s₁ k₁ => DRuns (DCmd.seqs cs) s₁ fun s₂ k₂ => Q s₂ (k₁ + k₂)) :
    DRuns (DCmd.seqs (c :: cs)) s Q := seq h

theorem dconst {p : ℕ} {v : ℝ} (h : Q ⟨s.m, update s.d (s.m p) v⟩ 1) :
    DRuns (.dconst p v) s Q := ⟨_, _, .dconst, h⟩

theorem dcopy {p q : ℕ} (h : Q ⟨s.m, update s.d (s.m p) (s.d (s.m q))⟩ 1) :
    DRuns (.dcopy p q) s Q := ⟨_, _, .dcopy, h⟩

theorem dadd {p q r : ℕ} (h : Q ⟨s.m, update s.d (s.m p) (s.d (s.m q) + s.d (s.m r))⟩ 1) :
    DRuns (.dadd p q r) s Q := ⟨_, _, .dadd, h⟩

theorem dsub {p q r : ℕ} (h : Q ⟨s.m, update s.d (s.m p) (s.d (s.m q) - s.d (s.m r))⟩ 1) :
    DRuns (.dsub p q r) s Q := ⟨_, _, .dsub, h⟩

theorem dless {x q r : ℕ}
    (h : Q ⟨update s.m x (if s.d (s.m q) < s.d (s.m r) then 1 else 0), s.d⟩ 1) :
    DRuns (.dless x q r) s Q := ⟨_, _, .dless, h⟩

theorem toIdx {x p : ℕ} (v : ℕ) (hv : s.d (s.m p) = (v : ℝ)) (h : Q ⟨update s.m x v, s.d⟩ 1) :
    DRuns (.toIdx x p) s Q := ⟨_, _, .toIdx v hv, h⟩

theorem ofIdx {p x : ℕ} (h : Q ⟨s.m, update s.d (s.m p) (s.m x)⟩ 1) :
    DRuns (.ofIdx p x) s Q := ⟨_, _, .ofIdx, h⟩

theorem ite {l r : ℕ} {t e : DCmd} (ht : s.m l = s.m r → DRuns t s fun s' k => Q s' (k + 2))
    (he : s.m l ≠ s.m r → DRuns e s fun s' k => Q s' (k + 1)) : DRuns (.ite l r t e) s Q := by
  by_cases h : s.m l = s.m r
  · obtain ⟨s', k, e', hQ⟩ := ht h; exact ⟨s', k + 2, .iteTrue h e', hQ⟩
  · obtain ⟨s', k, e', hQ⟩ := he h; exact ⟨s', k + 1, .iteFalse h e', hQ⟩

/-- A loop, from an invariant `P` on states and costs so far, and a decreasing measure `μ`. -/
theorem loop {l r : ℕ} {body : DCmd} (P : DState → ℕ → Prop) (μ : DState → ℕ)
    (hstep : ∀ s n, P s n → s.m l = s.m r →
      DRuns body s fun s' k => P s' (n + k + 2) ∧ μ s' < μ s)
    (hexit : ∀ s n, P s n → s.m l ≠ s.m r → Q s (n + 1)) (h0 : P s 0) :
    DRuns (.loop l r body) s Q := by
  obtain ⟨s', k, e, hQ⟩ := DExec.loop_of P μ Q
    (fun s n hP heq => by
      obtain ⟨s', k, e, hP', hμ⟩ := hstep s n hP heq
      exact ⟨s', k, e, hP', hμ⟩) hexit s 0 h0
  exact ⟨s', k, e, by simpa using hQ⟩

/-! Data instructions with the new data memory kept abstract. -/

theorem dconstR {p : ℕ} {v : ℝ}
    (h : ∀ d', d' (s.m p) = v → (∀ a, a ≠ s.m p → d' a = s.d a) → Q ⟨s.m, d'⟩ 1) :
    DRuns (.dconst p v) s Q :=
  dconst (h _ (by simp) fun a ha => by simp [ha])

theorem dcopyR {p q : ℕ}
    (h : ∀ d', d' (s.m p) = s.d (s.m q) → (∀ a, a ≠ s.m p → d' a = s.d a) → Q ⟨s.m, d'⟩ 1) :
    DRuns (.dcopy p q) s Q :=
  dcopy (h _ (by simp) fun a ha => by simp [ha])

theorem daddR {p q r : ℕ}
    (h : ∀ d', d' (s.m p) = s.d (s.m q) + s.d (s.m r) → (∀ a, a ≠ s.m p → d' a = s.d a) →
      Q ⟨s.m, d'⟩ 1) :
    DRuns (.dadd p q r) s Q :=
  dadd (h _ (by simp) fun a ha => by simp [ha])

theorem dsubR {p q r : ℕ}
    (h : ∀ d', d' (s.m p) = s.d (s.m q) - s.d (s.m r) → (∀ a, a ≠ s.m p → d' a = s.d a) →
      Q ⟨s.m, d'⟩ 1) :
    DRuns (.dsub p q r) s Q :=
  dsub (h _ (by simp) fun a ha => by simp [ha])

theorem dlessR {x q r : ℕ}
    (h : ∀ m', m' x = (if s.d (s.m q) < s.d (s.m r) then 1 else 0) → (∀ a, a ≠ x → m' a = s.m a) →
      Q ⟨m', s.d⟩ 1) :
    DRuns (.dless x q r) s Q :=
  dless (h _ (by simp) fun a ha => by simp [ha])

theorem toIdxR {x p : ℕ} (v : ℕ) (hv : s.d (s.m p) = (v : ℝ))
    (h : ∀ m', m' x = v → (∀ a, a ≠ x → m' a = s.m a) → Q ⟨m', s.d⟩ 1) :
    DRuns (.toIdx x p) s Q :=
  toIdx v hv (h _ (by simp) fun a ha => by simp [ha])

theorem ofIdxR {p x : ℕ}
    (h : ∀ d', d' (s.m p) = (s.m x : ℝ) → (∀ a, a ≠ s.m p → d' a = s.d a) → Q ⟨s.m, d'⟩ 1) :
    DRuns (.ofIdx p x) s Q :=
  ofIdx (h _ (by simp) fun a ha => by simp [ha])

/-! Single index instructions, with no word bound to track (the bound is chosen for you). -/

theorem iconst {d v : ℕ}
    (h : ∀ m', m' d = v → (∀ a, a ≠ d → m' a = s.m a) → Q ⟨m', s.d⟩ 1) :
    DRuns (Cmd.const d v) s Q :=
  idx (B := d + v + 1) (Runs.constR (by omega) (by omega) h)

theorem icopy {d x : ℕ}
    (h : ∀ m', m' d = s.m x → (∀ a, a ≠ d → m' a = s.m a) → Q ⟨m', s.d⟩ 1) :
    DRuns (Cmd.copy d x) s Q :=
  idx (B := d + x + 1) (Runs.copyR (by omega) (by omega) h)

theorem iload {d p : ℕ}
    (h : ∀ m', m' d = s.m (s.m p) → (∀ a, a ≠ d → m' a = s.m a) → Q ⟨m', s.d⟩ 1) :
    DRuns (Cmd.load d p) s Q :=
  idx (B := d + p + 1) (Runs.loadR (by omega) (by omega) h)

theorem istore {p x : ℕ}
    (h : ∀ m', m' (s.m p) = s.m x → (∀ a, a ≠ s.m p → m' a = s.m a) → Q ⟨m', s.d⟩ 1) :
    DRuns (Cmd.store p x) s Q :=
  idx (B := p + x + 1) (Runs.storeR (by omega) (by omega) h)

theorem iadd {d l r : ℕ}
    (h : ∀ m', m' d = s.m l + s.m r → (∀ a, a ≠ d → m' a = s.m a) → Q ⟨m', s.d⟩ 1) :
    DRuns (Cmd.add d l r) s Q :=
  idx (B := d + l + r + s.m l + s.m r + 1) (Runs.addR (by omega) (by omega) (by omega)
    (by omega) h)

theorem isub {d l r : ℕ} (hlr : s.m r ≤ s.m l)
    (h : ∀ m', m' d = s.m l - s.m r → (∀ a, a ≠ d → m' a = s.m a) → Q ⟨m', s.d⟩ 1) :
    DRuns (Cmd.sub d l r) s Q :=
  idx (B := d + l + r + 1) (Runs.subR (by omega) (by omega) (by omega) hlr h)

theorem iless {d l r : ℕ}
    (h : ∀ m', m' d = (if s.m l < s.m r then 1 else 0) → (∀ a, a ≠ d → m' a = s.m a) →
      Q ⟨m', s.d⟩ 1) :
    DRuns (Cmd.less d l r) s Q :=
  idx (B := d + l + r + 1) (Runs.lessR (by omega) (by omega) (by omega) h)

end DRuns

/-- Run the next `DCmd` step that needs no extra argument, keeping the new memory abstract and
introducing the facts about it. -/
macro "dstep" : tactic => `(tactic| first
  | refine DRuns.seqs_cons ?_
  | refine DRuns.seq ?_
  | refine DRuns.seqs_nil ?_
  | (refine DRuns.iconst ?_; intro _ _ _)
  | (refine DRuns.icopy ?_; intro _ _ _)
  | (refine DRuns.iload ?_; intro _ _ _)
  | (refine DRuns.istore ?_; intro _ _ _)
  | (refine DRuns.iadd ?_; intro _ _ _)
  | (refine DRuns.iless ?_; intro _ _ _)
  | (refine DRuns.dconstR ?_; intro _ _ _)
  | (refine DRuns.dcopyR ?_; intro _ _ _)
  | (refine DRuns.daddR ?_; intro _ _ _)
  | (refine DRuns.dsubR ?_; intro _ _ _)
  | (refine DRuns.dlessR ?_; intro _ _ _)
  | (refine DRuns.ofIdxR ?_; intro _ _ _))

end Formalgo.Algorithms.ShortestPaths.LLMUnchecked
