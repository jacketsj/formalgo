-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.Heap.HeapInsert

/-!
# The state without its keys

LLM-generated; not checked by a human.

On the real RAM the keys live in the data memory; the index memory holds the rest of the state,
with zeros for the keys. `keyless s` is that part, as a state with natural keys, so the word-RAM
proofs of the steps that do not read keys apply to it unchanged. With every key `0`, the heap
order holds trivially, so the heap invariants pass to `keyless s`; the loops that do not read keys
commute with `keyless`.
-/

namespace Formalgo.Algorithms.ShortestPaths

open St

variable {R : Type*}

/-- The state with every key `0`. -/
def keyless (s : StW R) : St :=
  ⟨0, s.stat, s.par, s.deg, s.mark, s.pos, s.tbl, s.ch, s.hmin, s.lt, s.ht, s.clock, s.time⟩

variable (s : StW R) (v p c d x k : ℕ)

@[simp] theorem keyless_key : (keyless s).key = 0 := rfl
@[simp] theorem keyless_stat : (keyless s).stat = s.stat := rfl
@[simp] theorem keyless_par : (keyless s).par = s.par := rfl
@[simp] theorem keyless_deg : (keyless s).deg = s.deg := rfl
@[simp] theorem keyless_mark : (keyless s).mark = s.mark := rfl
@[simp] theorem keyless_pos : (keyless s).pos = s.pos := rfl
@[simp] theorem keyless_tbl : (keyless s).tbl = s.tbl := rfl
@[simp] theorem keyless_ch : (keyless s).ch = s.ch := rfl
@[simp] theorem keyless_hmin : (keyless s).hmin = s.hmin := rfl
@[simp] theorem keyless_time : (keyless s).time = s.time := rfl

theorem keyless_tick : keyless (tick c s) = tick c (keyless s) := rfl
theorem keyless_detach : keyless (detach v p s) = detach v p (keyless s) := rfl
theorem keyless_attach : keyless (attach v p s) = attach v p (keyless s) := rfl
theorem keyless_cut : keyless (cut v p s) = cut v p (keyless s) := rfl
theorem keyless_link : keyless (link v p s) = link v p (keyless s) := rfl
theorem keyless_setStat : keyless (setStat v k s) = setStat v k (keyless s) := rfl
theorem keyless_setTbl : keyless (setTbl d x s) = setTbl d x (keyless s) := rfl
theorem keyless_setMark : keyless (setMark v k s) = setMark v k (keyless s) := rfl
theorem keyless_setKey (r : R) : keyless (setKey v r s) = keyless s := rfl
theorem keyless_hmin_set : keyless { s with hmin := x } = { keyless s with hmin := x } := rfl

/-! ### The heap invariants without keys -/

section Inv

variable [LinearOrder R] {s s' : StW R} {M L : Finset ℕ} {e z Q : ℕ}

omit [LinearOrder R] in
theorem older_keyless (w : ℕ) (N : Finset ℕ) : older (keyless s) N w = older s N w := rfl

omit [LinearOrder R] in
theorem pot_keyless (N : Finset ℕ) : pot (keyless s) N = pot s N := rfl

theorem Forest.keyless (h : Forest s M e) : Forest (keyless s) M e :=
  ⟨h.zero, h.up, h.down, fun _ _ _ => le_rfl, h.height, h.fib, h.ltinj, h.ltclock, h.mark⟩

omit [LinearOrder R] in
theorem RootList.keyless (h : RootList s M L) : RootList (keyless s) M L :=
  ⟨h.loose, h.list, h.root⟩

theorem HeapInv.keyless {n : ℕ} (h : HeapInv n s M) : HeapInv n (keyless s) M :=
  ⟨h.range, h.forest.keyless, h.roots.keyless,
    fun hne => ⟨(h.min hne).1, (h.min hne).2.1, fun _ _ => le_rfl⟩, h.tbl⟩

omit [LinearOrder R] in
theorem Keep.keyless (h : Keep M s s') : Keep M (keyless s) (keyless s') :=
  ⟨rfl, h.stat, h.out⟩

omit [LinearOrder R] in
theorem DecFrame.keyless (h : DecFrame M s s') : DecFrame M (keyless s) (keyless s') :=
  ⟨rfl, h.stat, h.tbl, h.hmin, h.roots, h.out⟩

theorem MoveInv.keyless {a : StW R × ℕ} (h : MoveInv M z Q s a) :
    MoveInv M z Q (keyless s) (keyless a.1, a.2) :=
  ⟨h.z_eq, h.zM, h.forest.keyless, h.roots.keyless, h.zpar, h.cost, h.keep.keyless, h.tbl⟩

theorem CascInv.keyless {a : StW R × ℕ} (h : CascInv M Q a) : CascInv M Q (keyless a.1, a.2) :=
  ⟨h.forest.keyless, h.roots.keyless, h.pM, h.slack, h.cost⟩

end Inv

/-! ### Loops that do not read keys -/

open LLMUnchecked in
/-- A loop whose step and condition do not read keys commutes with `keyless`. -/
theorem whileF_keyless {α : Type*} {c : StW R × α → Prop} {c' : St × α → Prop} [DecidablePred c]
    [DecidablePred c'] {f : StW R × α → StW R × α} {g : St × α → St × α}
    (hc : ∀ a, c' (keyless a.1, a.2) ↔ c a)
    (hf : ∀ a, (keyless (f a).1, (f a).2) = g (keyless a.1, a.2)) :
    ∀ N a, (keyless (whileF c f N a).1, (whileF c f N a).2) = whileF c' g N (keyless a.1, a.2)
  | 0, _ => rfl
  | N + 1, a => by
    by_cases h : c a
    · rw [whileF_succ h, whileF_succ ((hc a).2 h), ← hf]; exact whileF_keyless hc hf N _
    · rw [whileF_stop h, whileF_stop (fun h' => h ((hc a).1 h'))]

open LLMUnchecked in
theorem whileF_move_keyless (F : ℕ) (a : StW R × ℕ) :
    (keyless (whileF moveCond moveStep F a).1, (whileF moveCond moveStep F a).2) =
      whileF moveCond moveStep F (keyless a.1, a.2) :=
  whileF_keyless (c := moveCond (R := R)) (c' := moveCond) (f := moveStep) (g := moveStep)
    (fun _ => Iff.rfl) (fun _ => rfl) F a

open LLMUnchecked in
theorem whileF_casc_keyless (F : ℕ) (a : StW R × ℕ) :
    (keyless (whileF cascCond cascStep F a).1, (whileF cascCond cascStep F a).2) =
      whileF cascCond cascStep F (keyless a.1, a.2) :=
  whileF_keyless (c := cascCond (R := R)) (c' := cascCond) (f := cascStep) (g := cascStep)
    (fun _ => Iff.rfl) (fun _ => rfl) F a

end Formalgo.Algorithms.ShortestPaths
