-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealRun.RSource

/-!
# Running `output` on reals

LLM-generated; not checked by a human.

The output code `n, n, d₁, …, dₙ` goes to data cells `[O - 1, O + n]`, `O = H + 9 R`.
-/

namespace Formalgo.Algorithms.ShortestPaths

open LLMUnchecked Cmd Prog Function NNReal

variable {L : Lay} {t : StW ℝ≥0} {st : DState} {B : ℕ}

theorem outBodyR_spec (hR : RRep L t st) {v : ℕ} (h11 : st.m 11 = v) (h1 : 1 ≤ v)
    (hv : v ≤ L.n) (hB : L.top < B) :
    DRuns RProg.outBody st fun st' k => RRep L t st' ∧ st'.m 11 = v + 1 ∧
      st'.m 12 = (if L.n < v + 1 then 1 else 0) ∧
      st'.d (L.H + 9 * L.R + v) = outVal t v ∧
      (∀ a, a ≠ L.H + 9 * L.R + v → st'.d a = st.d a) ∧
      (∀ a, 32 ≤ a → st'.m a = st.m a) ∧ k ≤ 14 := by
  have hH := hR.rep.H32
  have ht := top_ge (L := L)
  have hRn : L.n + L.D + 3 = L.R := rfl
  have b1 : st.m 11 ≤ L.bnd 1 := by rw [h11]; simp [Lay.bnd]; omega
  have one := hR.rep.one
  have b₀ : st.m 10 = L.H + 9 * L.R := hR.rep.base 9 (by omega)
  unfold RProg.outBody
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.mono (rd_spec hR.rep (k := 1) (d := 13)
    (i := 11) (by omega) b1 (by omega) (by omega) (by omega) hB) fun m₁ c₁ ⟨g₁, f₁, hc₁⟩ => ?_))
  rw [h11] at g₁
  replace g₁ : m₁ 13 = t.stat v := g₁
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.addR (by omega) (by omega) (by omega)
    (by rw [f₁ 3 (by omega) (by omega), one]; omega) fun m₂ g₂ f₂ => ?_))
  rw [f₁ 3 (by omega) (by omega), one] at g₂
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.addR (by omega) (by omega) (by omega)
    (by rw [f₂ 10 (by omega), f₁ 10 (by omega) (by omega), f₂ 11 (by omega),
      f₁ 11 (by omega) (by omega), b₀, h11]; omega) fun m₃ g₃ f₃ => ?_))
  rw [f₂ 10 (by omega), f₁ 10 (by omega) (by omega), f₂ 11 (by omega),
      f₁ 11 (by omega) (by omega), b₀, h11] at g₃
  have E₃ : ∀ a, a ≠ 2 → a ≠ 6 → a ≠ 13 → m₃ a = st.m a := fun a a2 a6 a13 => by
    rw [f₃ a a2, f₂ a a6, f₁ a a2 a13]
  have R₃ : Rep L (keyless t) m₃ := hR.rep.congr
    (fun a ha _ => E₃ a (fun e => ha (by simp [Tmp, e])) (fun e => ha (by simp [Tmp, e]))
      (fun e => ha (by simp [Tmp, e])))
    (fun a ha => E₃ a (by omega) (by omega) (by omega))
  have e13 : m₃ 13 = t.stat v := by rw [f₃ 13 (by omega), f₂ 13 (by omega), g₁]
  have e6 : m₃ 6 = 2 := by rw [f₃ 6 (by omega), g₂]
  have e11 : m₃ 11 = v := by rw [E₃ 11 (by omega) (by omega) (by omega), h11]
  have hO : ∀ w ≤ L.n, L.H + 9 * L.R + v ≠ L.H + w := fun w hw => by omega
  -- The value: the key for a settled vertex, or `0`.
  have hval : DRuns (.ite 13 6 (DCmd.seqs [RProg.kp 14 11, .dcopy 2 14]) (.dconst 2 0))
      ⟨m₃, st.d⟩ fun st₄ c => st₄.d (L.H + 9 * L.R + v) = outVal t v ∧
        (∀ a, a ≠ L.H + 9 * L.R + v → st₄.d a = st.d a) ∧
        (∀ a, a ≠ 14 → st₄.m a = m₃ a) ∧ c ≤ 5 := by
    refine DRuns.ite (fun hs => ?_) (fun hs => ?_)
    · change m₃ 13 = m₃ 6 at hs
      rw [e13, e6] at hs
      refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.mono (kp_spec R₃ (d := 14) (i := 11)
        (by omega) (by omega) (by omega) hB) fun m₄ c₄ ⟨g₄, f₄, hc₄⟩ => ?_))
      rw [e11] at g₄
      refine DRuns.seqs_cons (DRuns.dcopyR fun d₅ g₅ f₅ => DRuns.seqs_nil ?_)
      simp only at g₅ f₅
      rw [f₄ 2 (by omega), g₃, g₄, hR.key v hv] at g₅
      refine ⟨by dsimp only; rw [g₅]; simp [outVal, hs],
        fun a ha => f₅ a (by rw [f₄ 2 (by omega), g₃]; exact ha), f₄, by omega⟩
    · change m₃ 13 ≠ m₃ 6 at hs
      rw [e13, e6] at hs
      refine DRuns.dconstR fun d₄ g₄ f₄ => ?_
      simp only at g₄ f₄
      rw [g₃] at g₄ f₄
      exact ⟨by dsimp only; rw [g₄]; simp [outVal, hs], f₄, fun _ _ => rfl, by omega⟩
  refine DRuns.seqs_cons (DRuns.mono hval fun st₄ c₄ ⟨g₄, f₄, k₄, hc₄⟩ => ?_)
  have R₄ : Rep L (keyless t) st₄.m := R₃.regs1 (r := 14) (by simp [Tmp]) (by omega) k₄
  have e11' : st₄.m 11 = v := by rw [k₄ 11 (by omega), e11]
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.addR (by omega) (by omega) (by omega)
    (by rw [e11', R₄.one]; omega) fun m₅ g₅ f₅ => ?_))
  rw [e11', R₄.one] at g₅
  have R₅ := R₄.regs1 (r := 11) (by simp [Tmp]) (by omega) f₅
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.lessR (by omega) (by omega) (by omega)
    fun m₆ g₆ f₆ => ?_))
  have n₅ : m₅ 27 = L.n := R₅.n
  rw [n₅, g₅] at g₆
  refine DRuns.seqs_nil ?_
  refine ⟨⟨R₅.regs1 (r := 12) (by simp [Tmp]) (by omega) f₆, fun w hw => ?_⟩,
    by dsimp only; rw [f₆ 11 (by omega), g₅], g₆, g₄, f₄, fun a ha => ?_, by omega⟩
  · change st₄.d _ = _
    rw [f₄ _ (hO w hw).symm]; exact hR.key w hw
  · dsimp only
    rw [f₆ a (by omega), f₅ a (by omega), k₄ a (by omega), E₃ a (by omega) (by omega) (by omega)]

/-- The output: `n` twice, then each vertex's value; `M[1]` is its address, `M[2]` its length. -/
theorem outputR_run (hR : RRep L t st) (hB : L.top < B) :
    DRuns RProg.output st fun st' k => st'.m 1 = L.H + 9 * L.R - 1 ∧ st'.m 2 = L.n + 2 ∧
      st'.d (L.H + 9 * L.R - 1) = L.n ∧ st'.d (L.H + 9 * L.R) = L.n ∧
      (∀ v, 1 ≤ v → v ≤ L.n → st'.d (L.H + 9 * L.R + v) = outVal t v) ∧
      (∀ a, a < L.H + 9 * L.R - 1 → st'.d a = st.d a) ∧
      (∀ a, 32 ≤ a → st'.m a = st.m a) ∧ k ≤ 17 * L.n + 20 := by
  have hH := hR.rep.H32
  have ht := top_ge (L := L)
  have hRn : L.n + L.D + 3 = L.R := rfl
  have b₀ : st.m 10 = L.H + 9 * L.R := hR.rep.base 9 (by omega)
  have n₀ : st.m 27 = L.n := hR.rep.n
  have one := hR.rep.one
  unfold RProg.output
  -- `n` at `O - 1` and at `O`.
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.subR (by omega) (by omega) (by omega)
    (by rw [b₀, one]; omega) fun m₁ g₁ f₁ => ?_))
  rw [b₀, one] at g₁
  refine DRuns.seqs_cons (DRuns.ofIdxR fun d₂ g₂ f₂ => ?_)
  simp only at g₂ f₂
  rw [g₁, f₁ 27 (by omega), n₀] at g₂
  rw [g₁] at f₂
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.copyR (by omega) (by omega)
    fun m₃ g₃ f₃ => ?_))
  dsimp only at g₃ f₃
  rw [f₁ 10 (by omega), b₀] at g₃
  refine DRuns.seqs_cons (DRuns.ofIdxR fun d₄ g₄ f₄ => ?_)
  simp only at g₄ f₄
  rw [g₃, f₃ 27 (by omega), f₁ 27 (by omega), n₀] at g₄
  rw [g₃] at f₄
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.constR (by omega) (by omega)
    fun m₅ g₅ f₅ => ?_))
  dsimp only at f₅
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.lessR (by omega) (by omega) (by omega)
    fun m₆ g₆ f₆ => ?_))
  have E₆ : ∀ a, a ≠ 2 → a ≠ 11 → a ≠ 12 → m₆ a = st.m a := fun a a2 a11 a12 => by
    rw [f₆ a a12, f₅ a a11, f₃ a a2, f₁ a a2]
  have R₆ : Rep L (keyless t) m₆ := hR.rep.congr
    (fun a ha _ => E₆ a (fun e => ha (by simp [Tmp, e])) (fun e => ha (by simp [Tmp, e]))
      (fun e => ha (by simp [Tmp, e])))
    (fun a ha => E₆ a (by omega) (by omega) (by omega))
  rw [f₅ 27 (by omega), f₃ 27 (by omega), f₁ 27 (by omega), n₀, g₅] at g₆
  have hd₄ : ∀ a, a < L.H + 9 * L.R - 1 → d₄ a = st.d a := fun a ha => by
    rw [f₄ a (by omega), f₂ a (by omega)]
  have k₄ : ∀ w ≤ L.n, d₄ (L.H + w) = st.d (L.H + w) := fun w hw => hd₄ _ (by omega)
  have RR₆ : RRep L t ⟨m₆, d₄⟩ := ⟨R₆, fun w hw => by
    change d₄ _ = _; rw [k₄ w hw]; exact hR.key w hw⟩
  -- The loop: vertices below `v` are written.
  let P : DState → ℕ → Prop := fun s' c => ∃ v, 1 ≤ v ∧ v ≤ L.n + 1 ∧ RRep L t s' ∧
    s'.m 11 = v ∧ s'.m 12 = (if L.n < v then 1 else 0) ∧
    s'.d (L.H + 9 * L.R - 1) = L.n ∧ s'.d (L.H + 9 * L.R) = L.n ∧
    (∀ j, 1 ≤ j → j < v → s'.d (L.H + 9 * L.R + j) = outVal t j) ∧
    (∀ a, a < L.H + 9 * L.R - 1 → s'.d a = st.d a) ∧
    (∀ a, 32 ≤ a → s'.m a = st.m a) ∧ c ≤ 16 * (v - 1)
  refine DRuns.seqs_cons (DRuns.loop P (fun s' => L.n + 1 - s'.m 11) ?_ ?_
    ⟨1, le_refl _, by omega, RR₆, by dsimp only; rw [f₆ 11 (by omega), g₅],
      by dsimp only; rw [g₆], by dsimp only; rw [f₄ _ (by omega), g₂], g₄,
      fun j h1 h2 => by omega, hd₄, fun a ha => E₆ a (by omega) (by omega) (by omega),
      by omega⟩)
  · rintro s' c ⟨v, h1, hv, Rv, e11, e12, eO1, eO, hdone, hlo, hhi, hc⟩ heq
    have hvn : v ≤ L.n := by
      rw [e12, Rv.rep.zero] at heq
      by_contra hn; simp [show L.n < v by omega] at heq
    refine DRuns.mono (outBodyR_spec Rv e11 h1 hvn hB)
      fun s₇ k ⟨R₇, a11, a12, a0, ad, am, hk'⟩ => ⟨⟨v + 1, by omega, by omega, R₇, a11, a12,
        ?_, ?_, fun j h1' h2 => ?_, fun a ha => ?_, fun a ha => ?_, ?_⟩, ?_⟩
    · rw [ad _ (by omega), eO1]
    · rw [ad _ (by omega), eO]
    · rcases Nat.lt_or_ge j v with hj | hj
      · rw [ad _ (by omega), hdone j h1' hj]
      · have : j = v := by omega
        subst this; exact a0
    · rw [ad _ (by omega), hlo a ha]
    · rw [am a ha, hhi a ha]
    · simp only [Nat.add_sub_cancel]
      have : 16 * v = 16 * (v - 1) + 16 := by omega
      omega
    · rw [a11, e11]; omega
  · rintro s' c ⟨v, h1, hv, Rv, e11, e12, eO1, eO, hdone, hlo, hhi, hc⟩ heq
    have hvn : v = L.n + 1 := by
      rw [e12, Rv.rep.zero] at heq
      by_contra hn
      exact heq (by rw [if_neg (by omega)])
    subst hvn
    have n' : s'.m 27 = L.n := Rv.rep.n
    have o' : s'.m 3 = 1 := Rv.rep.one
    have b' : s'.m 10 = L.H + 9 * L.R := Rv.rep.base 9 (by omega)
    refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.subR (by omega) (by omega) (by omega)
      (by rw [b', o']; omega) fun m₈ g₈ f₈ => ?_))
    refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.addR (by omega) (by omega) (by omega)
      (by rw [f₈ 27 (by omega), f₈ 3 (by omega), n', o']; omega) fun m₉ g₉ f₉ => ?_))
    refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.addR (by omega) (by omega) (by omega)
      (by rw [g₉, f₉ 3 (by omega), f₈ 27 (by omega), f₈ 3 (by omega), n', o']; omega)
      fun m₁₀ g₁₀ f₁₀ => ?_))
    refine DRuns.seqs_nil ?_
    refine ⟨?_, ?_, eO1, eO, fun j h1' h2 => hdone j h1' (by omega), hlo, fun a ha => ?_, ?_⟩
    · dsimp only; rw [f₁₀ 1 (by omega), f₉ 1 (by omega), g₈, b', o']
    · dsimp only; rw [g₁₀, g₉, f₉ 3 (by omega), f₈ 27 (by omega), f₈ 3 (by omega), n', o']
    · dsimp only; rw [f₁₀ a (by omega), f₉ a (by omega), f₈ a (by omega), hhi a ha]
    · simp only [Nat.add_sub_cancel] at hc
      have : 16 * L.n ≤ 17 * L.n := by omega
      omega

