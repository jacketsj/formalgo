  unfold RProg.wpLoop
  refine Runs.seqs_cons (Runs.subR (by omega) (by omega) (by omega)
    (by rw [hR.r3, hR.r4]; omega) fun m₁ g₁ f₁ => ?_)
  rw [hR.r3, hR.r4] at g₁
  refine Runs.seqs_cons (Runs.lessR (by omega) (by omega) (by omega) fun m₂ g₂ f₂ => ?_)
  rw [f₁ 25 (by omega), h25, g₁] at g₂
  let P : Mem → ℕ → Prop := fun m' c => ∃ j, wbase x ≤ j ∧ j ≤ (rcode x).length - 1 ∧
    m' 25 = j ∧ m' 28 = (rcode x).length - 1 ∧
    m' 26 = (if j < (rcode x).length - 1 then 1 else 0) ∧
    (∀ i, wbase x ≤ i → i < j → m' (64 + i) = i) ∧
    (∀ a, ¬CvT a → (a < 64 + wbase x ∨ 64 + j ≤ a) → m' a = m a) ∧ c ≤ 7 * (j - wbase x)
  refine Runs.seqs_cons (Runs.loop P (fun m' => (rcode x).length - 1 - m' 25) (by omega)
    (by omega) ?_ ?_ ⟨wbase x, le_refl _, by omega, by rw [f₂ 25 (by omega), f₁ 25 (by omega), h25],
      by rw [f₂ 28 (by omega), g₁], g₂, fun i h1 h2 => by omega, fun a ha _ => by
        obtain ⟨a2, ha'⟩ := nT a ha
        rw [f₂ a (by omega), f₁ a (by omega)], by omega⟩)
