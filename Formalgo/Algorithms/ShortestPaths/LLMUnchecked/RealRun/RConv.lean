    rw [h9, e25] at k₁
    refine Runs.seqs_cons (Runs.storeR (by omega) (by omega) fun n₂ k₂ l₂ => ?_)
    rw [k₁, l₁ 25 (by omega), e25] at k₂
    rw [k₁] at l₂
