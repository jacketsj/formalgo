    rw [l₂ 25 (by omega), l₁ 25 (by omega), l₂ 3 (by omega), l₁ 3 (by omega), e25, h3] at k₃
    refine Runs.seqs_cons (Runs.lessR (by omega) (by omega) (by omega) fun n₄ k₄ l₄ => ?_)
    rw [k₃, l₃ 28 (by omega), l₂ 28 (by omega), l₁ 28 (by omega), e28] at k₄
    refine Runs.seqs_nilR (by omega) fun n₅ k₅ l₅ => ?_
    have F : ∀ a, a ≠ 2 → a ≠ 25 → a ≠ 26 → a ≠ 64 + j → n₅ a = m' a := fun a a2 a25 a26 aj => by
      rw [l₅ a a2, l₄ a a26, l₃ a a25, l₂ a aj, l₁ a a2]
    refine ⟨⟨j + 1, by omega, by omega, by rw [l₅ 25 (by omega), l₄ 25 (by omega), k₃],
      by rw [F 28 (by omega) (by omega) (by omega) (by omega), e28],
