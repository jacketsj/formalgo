  simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]

theorem cvt_run (x : InputW ℝ≥0) :
    DRuns RProg.cvt (DState.input (rcode x)) fun st k =>
      CodeRegs 32 (rcode x).length 64 st.m ∧ MemAt st.m 64 (pcode x) ∧
      (∀ a, 64 + (rcode x).length ≤ a → st.m a = 0) ∧ st.m 63 = (rcode x).length ∧
      st.d = (DState.input (rcode x)).d ∧ k ≤ 20 * (rcode x).length + 40 := by
  have hl := length_rcode (x := x)
  have hp := length_pcode' (x := x)
  have hw : wbase x = 3 + x.1 + 2 * nE x := rfl
  have nT : ∀ a, ¬CvT a → a ≠ 2 ∧ (a < 20 ∨ 28 < a) := fun a ha => by unfold CvT at ha; omega
  have hB : 4 * (rcode x).length + 200 < 4 * (rcode x).length + 300 := by omega
  unfold RProg.cvt
  change DRuns _ ⟨fun a => if a = 0 then (rcode x).length else 0, fun a => (rcode x).getD a 0⟩ _
  -- The registers.
  refine DRuns.seqs_cons (DRuns.idxm (B := 4 * (rcode x).length + 300)
    (Runs.mono (setRegs_run (ℓ := (rcode x).length) (by omega) (if_pos rfl))
      fun m₁ k₁ ⟨R₁, f₁, hk₁⟩ => ?_))
  -- `n`.
  refine DRuns.seqs_cons (DRuns.toIdxR x.1 (by
    change (rcode x).getD (m₁ 8) 0 = _
    rw [R₁.r8, rcode_getD_nat (.inl (by omega))]; rfl) fun m₂ g₂ f₂ => ?_)
  dsimp only at g₂ f₂
  have R₂ : CvR (rcode x).length m₂ := R₁.of fun a ha _ => f₂ a (by unfold CvT at ha; omega)
  -- `E`, and the position of the first weight.
  refine DRuns.seqs_cons (DRuns.idxm (B := 4 * (rcode x).length + 300)
    (Runs.mono (countE_run hB R₂ g₂) fun m₃ k₃ ⟨e24, e25, e26, f₃, hk₃⟩ => ?_))
  have R₃ : CvR (rcode x).length m₃ := R₂.of fun a ha _ => f₃ a ha
  have z₃ : ∀ a, 64 ≤ a → m₃ a = 0 := fun a ha => by
    rw [f₃ a (by unfold CvT; omega), f₂ a (by omega), f₁ a (by omega) (by omega) (by omega)
      (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)]
    rw [if_neg (by omega)]
  -- The natural cells before the weights.
  let P : DState → ℕ → Prop := fun st c => ∃ j ≤ wbase x, st.m 25 = j ∧
    st.m 26 = (if j < wbase x then 1 else 0) ∧ st.m 24 = wbase x ∧ CvR (rcode x).length st.m ∧
    (∀ i < j, st.m (64 + i) = (pcode x).getD i 0) ∧ (∀ a, 64 + j ≤ a → st.m a = 0) ∧
    st.d = (fun a => (rcode x).getD a 0) ∧ c ≤ 8 * j
  refine DRuns.seqs_cons (DRuns.loop P (fun st => wbase x - st.m 25) ?_ ?_
    ⟨0, by omega, e25, by dsimp only; rw [e26, if_pos (by omega)], e24, R₃, fun i hi => by omega,
      fun a ha => z₃ a (by omega), rfl, le_refl _⟩)
  · rintro st c ⟨j, hj, e25, e26, e24, Rj, hdone, hz, hd, hc⟩ heq
    rw [e26, Rj.r3] at heq
    have hlt : j < wbase x := by by_contra hc'; simp [hc'] at heq
    unfold RProg.cpBody
    refine DRuns.seq (DRuns.toIdxR ((pcode x).getD j 0) (by
      rw [hd, e25]; exact rcode_getD_nat (.inl hlt)) fun m₄ g₄ f₄ => ?_)
    unfold RProg.cpTail
    refine DRuns.idxm (B := 4 * (rcode x).length + 300) ?_
    refine Runs.seqs_cons (Runs.addR (by omega) (by omega) (by omega)
      (by rw [f₄ 9 (by omega), f₄ 25 (by omega), Rj.r9, e25]; omega) fun n₁ k₁ l₁ => ?_)
    rw [f₄ 9 (by omega), f₄ 25 (by omega), Rj.r9, e25] at k₁
    refine Runs.seqs_cons (Runs.storeR (by omega) (by omega) fun n₂ k₂ l₂ => ?_)
    rw [k₁, l₁ 27 (by omega), g₄] at k₂
    rw [k₁] at l₂
    refine Runs.seqs_cons (Runs.addR (by omega) (by omega) (by omega)
      (by rw [l₂ 25 (by omega), l₁ 25 (by omega), f₄ 25 (by omega), e25, l₂ 3 (by omega),
        l₁ 3 (by omega), f₄ 3 (by omega), Rj.r3]; omega) fun n₃ k₃ l₃ => ?_)
    rw [l₂ 25 (by omega), l₁ 25 (by omega), f₄ 25 (by omega), e25, l₂ 3 (by omega),
        l₁ 3 (by omega), f₄ 3 (by omega), Rj.r3] at k₃
    refine Runs.seqs_cons (Runs.lessR (by omega) (by omega) (by omega) fun n₄ k₄ l₄ => ?_)
    rw [k₃, l₃ 24 (by omega), l₂ 24 (by omega), l₁ 24 (by omega), f₄ 24 (by omega), e24] at k₄
    refine Runs.seqs_nilR (by omega) fun n₅ k₅ l₅ => ?_
    have F : ∀ a, a ≠ 2 → a ≠ 25 → a ≠ 26 → a ≠ 27 → a ≠ 64 + j → n₅ a = st.m a :=
      fun a a2 a25 a26 a27 aj => by rw [l₅ a a2, l₄ a a26, l₃ a a25, l₂ a aj, l₁ a a2, f₄ a a27]
    refine ⟨⟨j + 1, by omega, by dsimp only; rw [l₅ 25 (by omega), l₄ 25 (by omega), k₃],
      by dsimp only; rw [l₅ 26 (by omega), k₄],
      by dsimp only; rw [F 24 (by omega) (by omega) (by omega) (by omega)
        (by omega), e24], Rj.of fun a ha h64 => F a (nT a ha).1 (by have := nT a ha; omega)
          (by have := nT a ha; omega) (by have := nT a ha; omega) (by omega),
      fun i hi => ?_, fun a ha => ?_, hd, by omega⟩, ?_⟩
    · dsimp only
      rcases Nat.lt_or_ge i j with hij | hij
      · rw [F _ (by omega) (by omega) (by omega) (by omega) (by omega), hdone i hij]
      · have : i = j := by omega
        subst this
        rw [l₅ _ (by omega), l₄ _ (by omega), l₃ _ (by omega), k₂]
    · dsimp only
      rw [F a (by omega) (by omega) (by omega) (by omega) (by omega), hz a (by omega)]
    · dsimp only
      rw [l₅ 25 (by omega), l₄ 25 (by omega), k₃, e25]; omega
  · rintro st c ⟨j, hj, e25, e26, e24, Rj, hdone, hz, hd, hc⟩ heq
    rw [e26, Rj.r3] at heq
    have hge : ¬j < wbase x := by intro hc'; simp [hc'] at heq
    have hjw : j = wbase x := by omega
    subst hjw
    -- The weights' positions.
    refine DRuns.seqs_cons (DRuns.idxm (B := 4 * (rcode x).length + 300)
      (Runs.mono (wpLoop_run hB Rj e25) fun m₅ k₅ ⟨g₅, hw₅, f₅, hk₅⟩ => ?_))
    have R₅ : CvR (rcode x).length m₅ := Rj.of fun a ha h64 => f₅ a ha (.inl (by omega))
    -- The source.
    unfold RProg.lastCp
    refine DRuns.seqs_cons (DRuns.seq (DRuns.toIdxR ((pcode x).getD ((rcode x).length - 1) 0)
      (by
        change st.d (m₅ 25) = _
        rw [hd, g₅]; exact rcode_getD_nat (.inr (by omega))) fun m₆ g₆ f₆ => ?_))
    dsimp only at g₆ f₆
    refine DRuns.idxm (B := 4 * (rcode x).length + 300) ?_
    refine Runs.seqs_cons (Runs.addR (by omega) (by omega) (by omega)
      (by rw [f₆ 9 (by omega), f₆ 25 (by omega), R₅.r9, g₅]; omega) fun n₁ k₁ l₁ => ?_)
    rw [f₆ 9 (by omega), f₆ 25 (by omega), R₅.r9, g₅] at k₁
    refine Runs.seqs_cons (Runs.storeR (by omega) (by omega) fun n₂ k₂ l₂ => ?_)
    rw [k₁, l₁ 27 (by omega), g₆] at k₂
    rw [k₁] at l₂
    refine Runs.seqs_nilR (by omega) fun n₃ k₃ l₃ => ?_
    refine DRuns.seqs_nil ?_
    have F : ∀ a, a ≠ 2 → a ≠ 27 → a ≠ 64 + ((rcode x).length - 1) → n₃ a = m₅ a :=
      fun a a2 a27 aj => by rw [l₃ a a2, l₂ a aj, l₁ a a2, f₆ a a27]
    have R₆ : CvR (rcode x).length n₃ := R₅.of fun a ha h64 =>
      F a (nT a ha).1 (by have := nT a ha; omega) (by omega)
    refine ⟨⟨⟨R₆.r1, R₆.r3, R₆.r5⟩, R₆.r4, R₆.r8, R₆.r9, R₆.r16⟩, fun j hj => ?_, fun a ha => ?_,
      R₆.r63, hd, ?_⟩
    · dsimp only
      rw [← getD_eq_getElem' hj]
      rcases Nat.lt_or_ge j (wbase x) with h1 | h1
      · rw [F _ (by omega) (by omega) (by omega), f₅ _ (by unfold CvT; omega) (.inl (by omega)),
          hdone j h1]
      · rcases Nat.lt_or_ge j ((rcode x).length - 1) with h2 | h2
        · rw [F _ (by omega) (by omega) (by omega), hw₅ j h1 h2,
            pcode_getD_w h1 (by omega)]
        · have : j = (rcode x).length - 1 := by omega
          subst this
          rw [l₃ _ (by omega), k₂]
    · dsimp only
      rw [F a (by omega) (by omega) (by omega), f₅ a (by unfold CvT; omega) (.inr (by omega)),
        hz a (by omega)]
    · omega

end Formalgo.Algorithms.ShortestPaths
