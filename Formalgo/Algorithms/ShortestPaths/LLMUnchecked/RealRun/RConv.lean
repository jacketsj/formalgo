/-!
# Copying the real input into the index memory

LLM-generated; not checked by a human.

The core starts with the code `L` of the input in data cells `[0, ℓ)` and `ℓ` in index cell `0`.
`cvt` sets the fixed registers of the word-RAM conversion (`S = 32`, `A = 64`), saves `ℓ` in
index cell `63`, finds `E` from `ℓ = n + 3 E + 4`, and copies the code into index cells
`[64, 64 + ℓ)`: every natural cell as it is (`toIdx`), and in place of the weight at position `j`
the number `j` (`pcode`).
-/

namespace Formalgo.Algorithms.ShortestPaths.RProg

open LLMUnchecked Cmd Prog

/-- The fixed registers of the conversion, and `ℓ` saved in cell `63`. -/
def setRegs : Cmd := seqs [const 3 1, const 5 32, const 8 0, const 16 3, const 1 32, const 9 64,
  copy 4 0, const 2 63, store 2 0]

/-- One more edge: `t := t + 3`, `e := e + 1`. -/
def eBody : Cmd := seqs [add 22 22 16, add 21 21 3, less 23 22 4]

/-- `M[21] := E`, from `ℓ = n + 3 E + 4`; then `M[24] :=` the position of the first weight. -/
def countE : Cmd := seqs [const 21 0, add 22 20 16, add 22 22 3, less 23 22 4, loop 23 3 eBody,
  Cmd.sub 24 4 3, Cmd.sub 24 24 21, const 25 0, less 26 25 24]

/-- Store the copied cell at `64 + j`, and move on. -/
def cpTail : Cmd := seqs [add 2 9 25, store 2 27, add 25 25 3, less 26 25 24]

/-- Copy the natural cell `j` (`25`). -/
def cpBody : DCmd := .seq (.toIdx 27 25) cpTail

/-- Put the position `j` of a weight at `64 + j`. -/
def wpBody : Cmd := seqs [add 2 9 25, store 2 25, add 25 25 3, less 26 25 28]

/-- The weights' positions. -/
def wpLoop : Cmd := seqs [Cmd.sub 28 4 3, less 26 25 28, loop 26 3 wpBody]

/-- Copy the last cell, the source. -/
def lastCp : DCmd := .seq (.toIdx 27 25) (seqs [add 2 9 25, store 2 27])

/-- Copy the input code into index cells `[64, 64 + ℓ)`, weights replaced by their positions. -/
def cvt : DCmd := DCmd.seqs [setRegs, .toIdx 20 8, countE, .loop 26 3 cpBody, wpLoop, lastCp]

end Formalgo.Algorithms.ShortestPaths.RProg

