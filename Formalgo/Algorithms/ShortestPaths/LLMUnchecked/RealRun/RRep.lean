import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.Proof
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.Dijkstra.DijkstraInput
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealRun.Keyless
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealRun.RProgram

/-!
# Memory and the model, on reals

LLM-generated; not checked by a human.

`RRep L s st`: the index memory holds `keyless s` as `Rep` says (its key array is all `0`), and
data cell `H + v` holds the key of `v`. `WRel x C wf d`: the adjacency lists of the real context
`C` are those of the edge list `x` in memory, whose weight fields are data addresses: field `p`
stands for the weight `wf p`, held in data cell `p`, below `H`.
-/

namespace Formalgo.Algorithms.ShortestPaths

open LLMUnchecked Cmd Prog Function NNReal

variable {L : Lay} {s : StW ℝ≥0} {st : DState} {m m' : Mem} {B : ℕ}

/-- The state in the two memories. -/
structure RRep (L : Lay) (s : StW ℝ≥0) (st : DState) : Prop where
  rep : Rep L (keyless s) st.m
  key : ∀ v ≤ L.n, st.d (L.H + v) = s.key v

/-- The real adjacency lists of `C` follow the edge list `x`, whose weight fields are the data
addresses of the weights. -/
structure WRel (L : Lay) (x : EInput) (C : CtxW ℝ≥0) (wf : ℕ → ℝ≥0) (d : ℕ → ℝ) : Prop where
  adj : ∀ a, C.adj a = (adjX x a).map fun p => (p.1, wf p.2)
  wt : ∀ a, ∀ p ∈ adjX x a, d p.2 = wf p.2
  low : ∀ a, ∀ p ∈ adjX x a, p.2 < L.H

/-- The data cell where a new key is formed. -/
def Lay.NK (L : Lay) : ℕ := L.H + 9 * L.R

theorem WRel.frame {x : EInput} {C : CtxW ℝ≥0} {wf : ℕ → ℝ≥0} {d d' : ℕ → ℝ}
    (h : WRel L x C wf d) (hd : ∀ a, a < L.H → d' a = d a) : WRel L x C wf d' :=
  ⟨h.adj, fun a p hp => by rw [hd _ (h.low a p hp)]; exact h.wt a p hp, h.low⟩

/-- Changes to the index memory that keep `Rep` keep `RRep`, with the data unchanged. -/
theorem RRep.ofRep {s' : StW ℝ≥0} {m' : Mem} (h : RRep L s st) (hR : Rep L (keyless s') m')
    (hk : s'.key = s.key) : RRep L s' ⟨m', st.d⟩ :=
  ⟨hR, fun v hv => by rw [hk]; exact h.key v hv⟩

theorem RRep.idx (h : RRep L s st) (hR : Rep L (keyless s) m') : RRep L s ⟨m', st.d⟩ :=
  h.ofRep hR rfl

/-- Writing data cells other than the keys keeps `RRep`. -/
theorem RRep.dframe {d' : ℕ → ℝ} (h : RRep L s st)
    (hd : ∀ v ≤ L.n, d' (L.H + v) = st.d (L.H + v)) : RRep L s ⟨st.m, d'⟩ :=
  ⟨h.rep, fun v hv => by change d' _ = _; rw [hd v hv]; exact h.key v hv⟩

/-- Writing the key of `v` in data cell `H + v`. -/
theorem RRep.setKey (h : RRep L s st) {v : ℕ} (k : ℝ≥0) {d' : ℕ → ℝ} (hv : v ≤ L.n)
    (hd : d' (L.H + v) = k) (hf : ∀ a, a ≠ L.H + v → d' a = st.d a) :
    RRep L (St.setKey v k s) ⟨st.m, d'⟩ := by
  refine ⟨h.rep, fun w hw => ?_⟩
  rcases eq_or_ne w v with rfl | hwv
  · change d' _ = _; rw [hd]; simp [St.setKey]
  · change d' _ = ((update s.key v k w : ℝ≥0) : ℝ); rw [hf _ (by omega)]
    rw [update_of_ne hwv]; exact h.key w hw

theorem Lay.NK_ne_key {v : ℕ} (hv : v ≤ L.n) : L.NK ≠ L.H + v := by
  unfold Lay.NK Lay.R; omega

theorem Lay.NK_ge : L.H + 9 * L.R ≤ L.NK := le_refl _

/-- `kp` puts the data address of the key of `M[i]` in `M[d]`. -/
theorem kp_spec (hR : Rep L (keyless s) m) {d i : ℕ} (hd : d < 32) (hi : i < 32)
    (hmi : m i ≤ L.n) (hB : L.top < B) :
    Runs B (RProg.kp d i) m fun m' c => m' d = L.H + m i ∧ (∀ a, a ≠ d → m' a = m a) ∧ c = 1 := by
  have ht := top_ge (L := L)
  have hH := hR.H32
  have hRn : L.n + L.D + 3 = L.R := rfl
  have hb : m 18 = L.H := by simpa [breg] using hR.base 0 (by decide)
  refine Runs.addR (by omega) (by omega) (by omega) (by rw [hb]; omega) fun m₁ h₁ f₁ => ?_
  exact ⟨by rw [h₁, hb], f₁, rfl⟩

/-- Comparing two keys. -/
theorem RRep.dless_key (h : RRep L s st) {m : Mem} {q r : ℕ} {a b : ℕ} (ha : a ≤ L.n)
    (hb : b ≤ L.n) (hq : m q = L.H + a) (hr : m r = L.H + b) :
    (if st.d (m q) < st.d (m r) then (1 : ℕ) else 0) = if s.key a < s.key b then 1 else 0 :=
  by rw [hq, hr, h.key a ha, h.key b hb]; simp only [NNReal.coe_lt_coe]

end Formalgo.Algorithms.ShortestPaths
