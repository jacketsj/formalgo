/-- A command loop follows a model loop, as `Runs.loop_refine` for `Cmd`. -/
theorem DRuns.loop_refine {l r : ℕ} {body : DCmd} {α : Type*} (R : α → DState → Prop)
    (c : α → Prop) [DecidablePred c] (f : α → α) (T : α → ℕ)
    (hcond : ∀ a st, R a st → (st.m l = st.m r ↔ c a))
    (hbody : ∀ a st, R a st → c a →
      DRuns body st fun st' k => R (f a) st' ∧ T a + k + 2 ≤ T (f a)) :
    ∀ (N : ℕ) (a : α) (st : DState), R a st → ¬c (whileF c f N a) →
      DRuns (.loop l r body) st fun st' k =>
        R (whileF c f N a) st' ∧ T a + k ≤ T (whileF c f N a) + 1
  | 0, a, st, hR, hN => by
    have hne : st.m l ≠ st.m r := fun h => hN ((hcond a st hR).1 h)
    exact ⟨st, 1, .loopFalse hne, hR, le_refl _⟩
  | N + 1, a, st, hR, hN => by
    by_cases hc : c a
    · rw [whileF_succ hc] at hN ⊢
      obtain ⟨st₁, k₁, e₁, hR₁, hT₁⟩ := hbody a st hR hc
      obtain ⟨st₂, k₂, e₂, hR₂, hT₂⟩ := DRuns.loop_refine R c f T hcond hbody N (f a) st₁ hR₁ hN
      exact ⟨st₂, k₁ + k₂ + 2, .loopTrue ((hcond a st hR).2 hc) e₁ e₂, hR₂, by omega⟩
    · rw [whileF_stop hc] at hN ⊢
      have hne : st.m l ≠ st.m r := fun h => hc ((hcond a st hR).1 h)
      exact ⟨st, 1, .loopFalse hne, hR, le_refl _⟩

/-- A `Runs` proof for an index command, from a state given as a pair. -/
theorem DRuns.cmd {B : ℕ} {c : Cmd} {m : Mem} {d : ℕ → ℝ} {Q : DState → ℕ → Prop}
    (h : Runs B c m fun m' k => Q ⟨m', d⟩ k) : DRuns c ⟨m, d⟩ Q := DRuns.idx h

