theorem linkLoopR_spec (C : CtxW ℝ≥0) {M : Finset ℕ} {D Q d₀ : ℕ} {s₀ : StW ℝ≥0}
    {st₀ : DState} (hLn : L.n = C.n) (hLD : L.D = D) (hD : D = 2 * Nat.size C.n)
    (hM : ∀ v ∈ M, 1 ≤ v ∧ v ≤ C.n) (hB : L.top < B) (hFu : D ≤ C.F) {a : StW ℝ≥0 × ℕ × ℕ}
    (h : LinkRR L x st₀ (LinkInv D M Q d₀ s₀) a st) :
    DRuns (.loop 17 3 RProg.linkBody) st fun st' k =>
      LinkRR L x st₀ (LinkInv D M Q d₀ s₀) (whileF linkCond linkStep C.F a) st' ∧
        a.1.time + k ≤ (whileF linkCond linkStep C.F a).1.time + 1 ∧
        ¬linkCond (whileF linkCond linkStep C.F a) := by
  have hstop := (link_loop C h.inv hFu).2
  refine DRuns.mono (DRuns.loop_refine (LinkRR L x st₀ (LinkInv D M Q d₀ s₀)) linkCond linkStep
    (fun a => a.1.time) (fun a st hR => ?_)
    (fun a st hR hc => linkBodyR_spec C hLn hLD hD hM hB hR hc) C.F a st h hstop)
    fun st' k ⟨hR, hk⟩ => ⟨hR, hk, hstop⟩
  rw [hR.r17, hR.rep.rep.one]
  simp only [linkCond]
  constructor
  · intro he; split_ifs at he with hp; omega
  · intro hne; rw [if_pos (by omega)]

