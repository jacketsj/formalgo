    have e₄13 : m₄ 13 = v := by rw [f₄ 13 (by omega), f₃ 13 (by omega), e₂13]
    have e₄14 : m₄ 14 = L.NK := by rw [f₄ 14 (by omega), f₃ 14 (by omega), e₂14]
    have e₄15 : m₄ 15 = s.par v := by rw [f₄ 15 (by omega), f₃ 15 (by omega), h₂15]
    refine DRuns.seqs_cons (DRuns.ite (fun hlt => ?_) (fun hlt => ?_))
    · simp only at hlt
      rw [h₄17, R₄.one] at hlt
      have hlt' : nk < s.key (s.par v) := by by_contra hc; simp [hc] at hlt
      have e : ShortestPaths.decKey C v nk s = ShortestPaths.updMinKey v nk (cascFin
          (whileF cascCond cascStep C.F (St.cut v (s.par v) s₁, s.par v))) := by
        unfold ShortestPaths.decKey
        rw [if_neg (show ¬s₁.par v = 0 from h0),
          if_pos (show nk < s₁.key (s₁.par v) by rw [hpar, hkey]; exact hlt')]
        rfl
      rw [e]
      refine DRuns.mono (decCutR_spec C (RR₁.idx R₄) X₄ e₄13 e₄14 hnk₁ e₄15 hf₁
        (cascInv_start hH hv hnkv h0) hMr hdg hd0 hm hFM hB) fun st₅ c₅ ⟨R₅, X₅, F₅, d₅, hc₅⟩ => ?_
      refine DRuns.seqs_nil ?_
      refine DRuns.seqs_nil ?_
      refine ⟨R₅, X₅, F₄.trans F₅, fun a ha => by rw [d₅]; exact k₁ a ha, ?_⟩
      rw [updMinKeyR_time]
      have : s₁.time = s.time + 80 := rfl
      omega
    · simp only at hlt
      rw [h₄17, R₄.one] at hlt
      have hlt' : ¬nk < s.key (s.par v) := by intro hc; simp [hc] at hlt
      have e : ShortestPaths.decKey C v nk s = s₁ := by
        unfold ShortestPaths.decKey
        rw [if_neg (show ¬s₁.par v = 0 from h0),
          if_neg (show ¬nk < s₁.key (s₁.par v) by rw [hpar, hkey]; exact hlt')]
      rw [e]
      refine DRuns.idx (B := B) (Runs.constR (m := m₄) (by omega) (by omega) fun m₅ h₅ f₅ => ?_)
      refine DRuns.seqs_nil ?_
      refine DRuns.seqs_nil ?_
      have F₅ : Frm L TD m₄ m₅ := Frm.reg1 (.inr (by simp [TU])) (by omega) f₅
      refine ⟨RR₁.idx (R₄.regs1 (r := 2) (by simp [Tmp]) (by omega) f₅), X₄.frame hH32 F₅.2,
        F₄.trans F₅, k₁, ?_⟩
      have : s₁.time = s.time + 80 := rfl
      omega

end Formalgo.Algorithms.ShortestPaths
