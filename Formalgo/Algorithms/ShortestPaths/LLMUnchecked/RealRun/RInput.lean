-- Unchecked LLM code: generated by an LLM and not checked by a human.
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealRun.RRep
import Formalgo.Algorithms.ShortestPaths.LLMUnchecked.RealMachine.GraphCode

/-!
# The real input in the index memory

LLM-generated; not checked by a human.

The code of an input `x` with real weights is `n, n`, the neighbour blocks, `E`, the `E` weights
(from position `wbase x = n + 2 E + 3`, in the order of `edgeList`), and the source. Everything
but the weights is a natural number. The program copies the code into the index memory, putting
in place of the weight at position `j` the number `j` itself: that is `pcode x`. The word-RAM
conversion turns it into the edge-list code of `xi x`, the input whose weight on each edge is the
position of its weight in the code; so the half-edges carry the data addresses of their weights,
and `wf x p` is the weight at address `p`.
-/

namespace Formalgo.Algorithms.ShortestPaths

open LLMUnchecked Function NNReal

variable (x : InputW ℝ≥0)

/-- The code of the input, over the reals. -/
noncomputable def rcode : List ℝ := Code.encode (Value := ℝ) x

/-- The number of edges. -/
noncomputable def nE : ℕ := (edgeList x.2.1).length

/-- The position of the first weight in the code. -/
noncomputable def wbase : ℕ := 3 + x.1 + 2 * nE x

open Classical in
/-- The index of an edge in `edgeList`. -/
noncomputable def eidx (e : x.2.1.edgeSet) : ℕ := (edgeList x.2.1).idxOf e

/-- The input whose weight on each edge is the position of its weight in the code. -/
noncomputable def xi : EInput := ⟨x.1, x.2.1, fun e => wbase x + eidx x e, x.2.2.2⟩

/-- The code in the index memory: the weights replaced by their positions. -/
noncomputable def pcode : List ℕ :=
  x.1 :: x.1 :: ((nbrLists x.2.1).flatMap blk ++
    nE x :: ((List.range (nE x)).map (wbase x + ·) ++ [x.2.2.2]))

/-- The weight at data address `p`. -/
noncomputable def wf (p : ℕ) : ℝ≥0 := ((rcode x).getD p 0).toNNReal

variable {x}

theorem adjList_eq_nbrs {n : ℕ} (G : SimpleGraph (Fin n)) (v : Fin n) :
    adjList G v = nbrs G v := by
  classical
  unfold adjList nbrs
  congr 1

theorem blocks_real {n : ℕ} (G : SimpleGraph (Fin n)) :
    (List.finRange n).flatMap (fun v => blockCode (adjList G v)) =
      ((nbrLists G).flatMap blk).map fun a : ℕ => (a : ℝ) := by
  rw [nbrLists, List.flatMap_map, List.map_flatMap]
  refine List.flatMap_congr fun v _ => ?_
  rw [blockCode_eq, adjList_eq_nbrs]
  simp [blk]

/-- The real code, part by part. -/
theorem rcode_eq : rcode x = (x.1 : ℝ) :: (x.1 : ℝ) ::
    (((nbrLists x.2.1).flatMap blk).map (fun a : ℕ => (a : ℝ)) ++
      (nE x : ℝ) :: ((edgeList x.2.1).map (fun e => (x.2.2.1 e : ℝ)) ++ [(x.2.2.2 : ℝ)])) := by
  obtain ⟨n, G, w, s⟩ := x
  rw [rcode, encode_sssp_input, blocks_real]; rfl

theorem length_blocks_nat (x : InputW ℝ≥0) :
    ((nbrLists x.2.1).flatMap blk).length = x.1 + 2 * nE x := by
  have h := length_blocks_real x.2.1
  rw [blocks_real, List.length_map] at h
  rw [h, nE, LLMUnchecked.length_edgeList]

theorem length_rcode : (rcode x).length = x.1 + 3 * nE x + 4 := by
  rw [rcode_eq]
  simp only [List.length_cons, List.length_append, List.length_map, length_blocks_nat,
    List.length_nil]
  rw [nE]; ring

theorem length_pcode : (pcode x).length = x.1 + 3 * nE x + 4 := by
  simp only [pcode, List.length_cons, List.length_append, List.length_map, length_blocks_nat,
    List.length_range, List.length_nil]
  ring

/-! ### The code, cell by cell -/

theorem getD_app_left {α : Type*} {l₁ l₂ : List α} {j : ℕ} (d : α) (h : j < l₁.length) :
    (l₁ ++ l₂).getD j d = l₁.getD j d := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_append_left h]

theorem getD_app_right {α : Type*} {l₁ l₂ : List α} {j : ℕ} (d : α) (h : l₁.length ≤ j) :
    (l₁ ++ l₂).getD j d = l₂.getD (j - l₁.length) d := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_append_right h]

/-- The part of the code before the weights. -/
noncomputable def preC (x : InputW ℝ≥0) : List ℕ :=
  x.1 :: x.1 :: ((nbrLists x.2.1).flatMap blk ++ [nE x])

theorem length_preC : (preC x).length = wbase x := by
  simp only [preC, List.length_cons, List.length_append, length_blocks_nat, List.length_nil,
    wbase]
  ring

theorem rcode_split : rcode x = (preC x).map (fun a : ℕ => (a : ℝ)) ++
    ((edgeList x.2.1).map (fun e => (x.2.2.1 e : ℝ)) ++ [(x.2.2.2 : ℝ)]) := by
  rw [rcode_eq]; simp [preC]

theorem pcode_split : pcode x = preC x ++
    ((List.range (nE x)).map (wbase x + ·) ++ [x.2.2.2]) := by
  simp [pcode, preC]

/-- Before the weights, and at the source, the real code holds the index code. -/
theorem rcode_getD_nat {j : ℕ} (hj : j < wbase x ∨ j = x.1 + 3 * nE x + 3) :
    (rcode x).getD j 0 = ((pcode x).getD j 0 : ℝ) := by
  have hl := length_preC (x := x)
  rw [rcode_split, pcode_split]
  rcases hj with hj | hj
  · rw [getD_app_left _ (by simp; omega), getD_app_left _ (by omega)]
    simp only [List.getD_eq_getElem?_getD, List.getElem?_map]
    rcases (preC x)[j]? with _ | a <;> simp
  · have hw : wbase x = 3 + x.1 + 2 * nE x := rfl
    have hE : (edgeList x.2.1).length = nE x := rfl
    rw [← List.append_assoc, ← List.append_assoc]
    rw [getD_app_right _ (by simp only [List.length_append, List.length_map]; omega),
      getD_app_right _
        (by simp only [List.length_append, List.length_map, List.length_range]; omega)]
    simp only [List.length_append, List.length_map, List.length_range]
    rw [show j - ((preC x).length + (edgeList x.2.1).length) = 0 by omega,
      show j - ((preC x).length + nE x) = 0 by omega]; rfl

/-- At the weights, the index code holds the position. -/
theorem pcode_getD_w {j : ℕ} (h1 : wbase x ≤ j) (h2 : j < wbase x + nE x) :
    (pcode x).getD j 0 = j := by
  have hl := length_preC (x := x)
  rw [pcode_split, getD_app_right _ (by omega), getD_app_left _ (by simp; omega)]
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range (by omega)]
  simp; omega

/-- At the weights, the real code holds the weights, in the order of `edgeList`. -/
theorem rcode_getD_w {i : ℕ} (hi : i < nE x) :
    (rcode x).getD (wbase x + i) 0 = x.2.2.1 ((edgeList x.2.1)[i]'hi) := by
  have hl := length_preC (x := x)
  rw [rcode_split, getD_app_right _ (by simp; omega),
    getD_app_left _ (by simp [List.length_map]; unfold nE at hi; omega)]
  simp only [List.length_map, hl, Nat.add_sub_cancel_left]
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hi]
  rfl

theorem length_pcode' : (pcode x).length = (rcode x).length := by
  rw [length_pcode, length_rcode]

/-! ### The edge-list input -/

theorem nodup_edgeList {n : ℕ} (G : SimpleGraph (Fin n)) : (edgeList G).Nodup :=
  (edgeList_pairwise G).imp fun h hab => by subst hab; exact lt_irrefl _ h

theorem length_lexEdges_eq : (lexEdges x.2.1).length = nE x := by
  have := congrArg List.length (values_eq (xi x))
  simp only [List.length_map] at this
  exact this.symm

theorem xi_weight (e : x.2.1.edgeSet) : (xi x).weight e = wbase x + eidx x e := rfl

theorem eidx_lt (e : x.2.1.edgeSet) : eidx x e < nE x := by
  classical
  exact List.idxOf_lt_length_of_mem (mem_edgeList e)

theorem getElem_eidx (e : x.2.1.edgeSet) : (edgeList x.2.1)[eidx x e]'(eidx_lt e) = e := by
  classical
  exact List.getElem_idxOf _

theorem eidx_getElem {i : ℕ} (hi : i < nE x) : eidx x ((edgeList x.2.1)[i]'hi) = i := by
  classical
  exact (nodup_edgeList x.2.1).idxOf_getElem i hi

theorem weights_xi : (lexEdges (xi x).wg.graph).map (fun e => (xi x).wg.weight s(e.1, e.2)) =
    (List.range (nE x)).map (wbase x + ·) := by
  rw [← values_eq]
  change (edgeList x.2.1).map (xi x).weight = _
  refine List.ext_getElem (by simp only [List.length_map, List.length_range]; rfl)
    fun i h1 h2 => ?_
  simp only [List.getElem_map, List.getElem_range, xi_weight]
  exact congrArg (wbase x + ·) (eidx_getElem (by simpa using h2))

/-- The edge-list code the conversion writes is the code of `xi x`. -/
theorem ncode_xi : ncode (xi x) = x.1 :: nE x :: (emitAll (nbrLists x.2.1) 0 ++
    nE x :: ((List.range (nE x)).map (wbase x + ·) ++ [x.2.2.2])) := by
  rw [ncode_input_eq, weights_xi, emitAll_nbr]
  have : numEdges (xi x) = nE x := length_lexEdges_eq
  rw [this]
  simp only [List.cons_append, List.append_assoc, List.nil_append]
  rfl

open Classical in
/-- The weight of an edge is the weight at the address its weight field holds. -/
theorem wf_weight {a b : Fin x.1} (h : (a, b) ∈ lexEdges x.2.1) :
    x.wg.weight s(a, b) = wf x ((xi x).wg.weight s(a, b)) := by
  have hm : s(a, b) ∈ x.2.1.edgeSet := (mem_edges.1 h).2
  change (if h : s(a, b) ∈ x.2.1.edgeSet then x.2.2.1 ⟨_, h⟩ else 0) =
    wf x (if h : s(a, b) ∈ x.2.1.edgeSet then (xi x).weight ⟨_, h⟩ else 0)
  rw [dif_pos hm, dif_pos hm, xi_weight, wf, rcode_getD_w (eidx_lt _), getElem_eidx,
    Real.toNNReal_coe]
  rfl

theorem halvesW_eq : halvesW x.wg = (halves (xi x)).map fun h => (h.1, h.2.1, wf x h.2.2) := by
  unfold halvesW halves
  rw [List.map_flatMap]
  refine List.flatMap_congr fun e he => ?_
  simp only [List.map_cons, List.map_nil]
  rw [wf_weight he]

theorem adjW_eq (a : ℕ) : adjW x.wg a = (adjX (xi x) a).map fun p => (p.1, wf x p.2) := by
  unfold adjW adjX
  rw [halvesW_eq]
  simp [List.map_reverse, List.filter_map, List.map_map, Function.comp_def]

/-- A weight field holds the address of a weight. -/
theorem adjX_weight {a : ℕ} {p : ℕ × ℕ} (hp : p ∈ adjX (xi x) a) :
    wbase x ≤ p.2 ∧ p.2 < wbase x + nE x ∧ (rcode x).getD p.2 0 = (wf x p.2 : ℝ) := by
  have keyE : ∀ e : x.2.1.edgeSet, wbase x ≤ wbase x + eidx x e ∧
      wbase x + eidx x e < wbase x + nE x ∧
        (rcode x).getD (wbase x + eidx x e) 0 = (wf x (wbase x + eidx x e) : ℝ) := by
    intro e
    have hi := eidx_lt (x := x) e
    refine ⟨by omega, by omega, ?_⟩
    rw [wf, rcode_getD_w hi, Real.coe_toNNReal _ (NNReal.coe_nonneg _)]
  have key : ∀ u v : Fin (xi x).wg.n, (u, v) ∈ lexEdges (xi x).wg.graph →
      wbase x ≤ (xi x).wg.weight s(u, v) ∧ (xi x).wg.weight s(u, v) < wbase x + nE x ∧
        (rcode x).getD ((xi x).wg.weight s(u, v)) 0 = (wf x ((xi x).wg.weight s(u, v)) : ℝ) := by
    intro u v huv
    have he : s(u, v) ∈ (xi x).graph.edgeSet := (mem_edges.1 huv).2
    rw [wg_weight (xi x) he]
    exact keyE ⟨_, he⟩
  obtain ⟨h, hm, -, rfl⟩ := mem_adjX.1 hp
  obtain ⟨u, v, huv, rfl | rfl⟩ := mem_halves.1 hm
  · exact key u v huv
  · exact key u v huv

/-- The real context follows the edge list in memory, for data that holds the code below `H`. -/
theorem wrel_input {L : Lay} {d : ℕ → ℝ} (hH : (rcode x).length ≤ L.H)
    (hd : ∀ a, a < L.H → d a = (rcode x).getD a 0) : WRel L (xi x) (ctxW x.wg) (wf x) d := by
  refine ⟨adjW_eq, fun a p hp => ?_, fun a p hp => ?_⟩
  · have := adjX_weight hp
    have h4 := length_rcode (x := x)
    have h3 : wbase x = 3 + x.1 + 2 * nE x := rfl
    rw [hd _ (by omega)]
    exact this.2.2
  · have := adjX_weight hp
    have := length_rcode (x := x)
    have h3 : wbase x = 3 + x.1 + 2 * nE x := rfl
    omega

end Formalgo.Algorithms.ShortestPaths
