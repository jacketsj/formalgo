/-!
# The core on reals

LLM-generated; not checked by a human.

From the edge-list code of `xi x` at `A` (weight fields holding the data addresses of the
weights) and the input code in the data memory, the core runs Dijkstra's algorithm on the model
with real weights, `ctxW x.wg`, and writes the output code in data cells from `O - 1`,
`O = H + 9 R`.
-/

namespace Formalgo.Algorithms.ShortestPaths

open LLMUnchecked Cmd Prog Function NNReal

variable {x : InputW ℝ≥0}

theorem layOf_n (A : ℕ) : (layOf (xi x) A).n = x.1 := rfl

theorem ctxW_n : (ctxW x.wg).n = x.1 := rfl

theorem ctxW_D : (ctxW x.wg).D = Dn x.1 := rfl

set_option maxHeartbeats 1000000 in
-- The proof follows every phase of the core in one context.
theorem coreR_run {S A : ℕ} {st : DState} (hR : CodeRegs S (ncode (xi x)).length A st.m)
    (hA : 32 ≤ A) (hM : MemAt st.m A (ncode (xi x)))
    (hz : ∀ a, A + (ncode (xi x)).length ≤ a → st.m a = 0)
    (hd : ∀ a, st.d a = (rcode x).getD a 0) (hℓ : (rcode x).length ≤ A) :
    DRuns RProg.core st fun st' k =>
      st'.m 1 = (layOf (xi x) A).H + 9 * (layOf (xi x) A).R - 1 ∧ st'.m 2 = x.1 + 2 ∧
      st'.d ((layOf (xi x) A).H + 9 * (layOf (xi x) A).R - 1) = x.1 ∧
      st'.d ((layOf (xi x) A).H + 9 * (layOf (xi x) A).R) = x.1 ∧
      (∀ v, 1 ≤ v → v ≤ x.1 → st'.d ((layOf (xi x) A).H + 9 * (layOf (xi x) A).R + v) =
        outVal (finish (ctxW x.wg) x.2.2.2) v) ∧
      (∀ a, a < (rcode x).length → st'.d a = st.d a) ∧
      (∀ a, 32 ≤ a → a < (layOf (xi x) A).H → st'.m a = st.m a) ∧
      k ≤ 6 * Nat.size x.1 + 33 * numEdges (xi x) + 25 * x.1 +
        (finish (ctxW x.wg) x.2.2.2).time + 17 * x.1 + 140 := by
  obtain ⟨⟨r1, r3, r5⟩, r4, r8, r9, r16⟩ := id hR
  obtain ⟨c0, c1, cE, cs⟩ := memAt_input hM
  have hlen := length_ncode_input (xi x)
  have hLH : (layOf (xi x) A).H = A + (ncode (xi x)).length := rfl
  have hHZ : A + 3 * numEdges (xi x) + 3 < (layOf (xi x) A).H := by omega
  generalize hL : layOf (xi x) A = L at *
  have hLn : L.n = (xi x).wg.n := by rw [← hL]; rfl
  have hLD : L.D = Dn (xi x).wg.n := by rw [← hL]; rfl
  have hLE : L.E = numEdges (xi x) := by rw [← hL]; rfl
  have hLD' : L.D = 2 * Nat.size (xi x).wg.n := hLD
  have H32 : 32 ≤ L.H := by omega
  have hRn : L.n + L.D + 3 = L.R := rfl
  have ht := top_ge (L := L)
  have H7ge : ∀ v, L.H ≤ H7 L + v := fun v => by unfold H7; omega
  have hH8 : ∀ {a}, a < L.H → a < H8 L := fun h => by unfold H8; omega
  have hRpos : 0 < L.R := by omega
  set B := L.top + 1 with hB'
  have hB : L.top < B := by omega
  clear hRn
  unfold RProg.core
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.mono (setup_run (n := (xi x).wg.n)
    (E := numEdges (xi x)) hLn hLD' hLH hA r4 r8 r9 r16 r3 c0 c1 hz hB)
    fun m₁ c₁ ⟨P₁, e11, e13, hi₁, lo₁, hc₁⟩ => ?_))
  have h9₁ : m₁ 9 = A := by
    rw [lo₁ 9 (by decide) (Fx.keep (r := 9) (by simp [Fx])).2.2.2.2.1, r9]
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.mono (build_run (tri := triX (xi x))
    (length_triX (xi x)) hLE hA (by omega)
    (fun t ht => by rw [hLn]; exact triX_bound (xi x) t ht) P₁ h9₁ e11 e13
    (EdgesAt.frame hi₁ _ _ _ (by omega) (by omega) cE)
    (fun v _ => by
      have h1 := H7ge v
      rw [hi₁ _ (by omega), hz _ (by omega)]) hB)
    fun m₂ c₂ ⟨P₂, f13, f17, hL₂, lo₂, hi₂, hc₂⟩ => ?_))
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.mono (cbInit_run P₂ f13 hL₂ hB)
    fun m₃ c₃ ⟨P₃, cb₃, hL₃, lo₃, hi₃, hc₃⟩ => ?_))
  have X₃ : Fixed L (xi x) m₃ := ⟨fun v hv => by
    have := hL₃ v hv; rw [adjL_halves] at this; exact this, cb₃⟩
  have e17 : m₃ 17 = A + 3 * numEdges (xi x) + 3 := by
    rw [lo₃ 17 (by decide) (by simp [TB]), f17]
  have eZ : m₃ (A + 3 * numEdges (xi x) + 3) = x.2.2.2 := by
    rw [hi₃ _ (by omega) (.inl (hH8 hHZ)), hi₂ _ (by omega) hHZ, hi₁ _ (by omega), cs]; rfl
  have hd0 : ∀ v ≤ L.n, st.d (L.H + v) = 0 := fun v _ => by
    rw [hd, List.getD_eq_getElem?_getD, List.getElem?_eq_none (by omega)]; rfl
  refine DRuns.seqs_cons (DRuns.mono (sourceR_run (C := ctxW x.wg) (st := ⟨m₃, st.d⟩) P₃ X₃ e17
    eZ (by rw [hLn]; rfl) hd0 hB) fun st₄ c₄ ⟨R₄, X₄, F₄, d₄, hc₄⟩ => ?_)
  -- The test of the main loop.
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.loadR (by omega) (by omega)
    fun m₅ g₅ f₅ => ?_))
  have a21 : st₄.m 21 = L.H + 3 * L.R := R₄.rep.base 3 (by decide)
  have d₅ : m₅ 11 = (start (ctxW x.wg) x.2.2.2).deg 0 := by
    rw [g₅, a21]; exact R₄.rep.arr 3 (by decide) 0 (Nat.zero_le _)
  have R₅ := R₄.rep.regs1 (r := 11) (by simp [Tmp]) (by decide) f₅
  refine DRuns.seqs_cons (DRuns.idxm (B := B) (Runs.lessR (by omega) (by omega) (by omega)
    fun m₆ g₆ f₆ => ?_))
  have R₆ := R₅.regs1 (r := 12) (by simp [Tmp]) (by decide) f₆
  have h12 : m₆ 12 = if 0 < (start (ctxW x.wg) x.2.2.2).deg 0 then 1 else 0 := by
    rw [g₆, R₅.zero, d₅]
  have X₆ : Fixed L (xi x) m₆ := X₄.frame H32 fun a ha _ => by
    rw [f₆ a (by omega), f₅ a (by omega)]
  have RR₆ : RRep L (start (ctxW x.wg) x.2.2.2) ⟨m₆, st₄.d⟩ := R₄.idx R₆
  have hdl : ∀ a, a < L.H → st₄.d a = (rcode x).getD a 0 := fun a _ => by rw [d₄, hd]
  have hW : WRel L (xi x) (ctxW x.wg) (wf x) st₄.d :=
    wrel_input (by omega) hdl
  -- The main loop and the output.
  refine DRuns.seqs_cons (DRuns.mono (finishR_run (st := ⟨m₆, st₄.d⟩) ctxW_ok adjW_ok_wsum
    (by rw [hLn]; rfl) (by rw [hLD]; rfl) hW hB RR₆ X₆ h12)
    fun st₇ c₇ ⟨R₇, X₇, F₇, d₇, hc₇⟩ => ?_)
  refine DRuns.seqs_cons (DRuns.mono (outputR_run R₇ hB)
    fun st₈ c₈ ⟨a1, a2, aO1, aO, aOv, ad, am, hc₈⟩ => DRuns.seqs_nil ?_)
  have hn : L.n = x.1 := hLn
  refine ⟨a1, by rw [a2, hn], by rw [aO1, hn], by rw [aO, hn], fun v h1 h2 => aOv v h1 (by omega),
    fun a ha => ?_, fun a h1 h2 => ?_, ?_⟩
  · have hO : a < L.H + 9 * L.R - 1 := by omega
    rw [ad a hO]; change st₇.d a = _
    rw [d₇ a (by omega)]; change st₄.d a = _; rw [d₄]
  · have ne : ¬L.Dyn a := not_dyn h2
    rw [am a h1]
    change st₇.m a = _
    rw [F₇.2 a h1 ne]
    change m₆ a = _
    rw [f₆ a (by omega), f₅ a (by omega), F₄.2 a h1 ne]
    change m₃ a = _
    rw [hi₃ a h1 (.inl (hH8 h2)), hi₂ a h1 h2, hi₁ a h1]
  · have hxn : (xi x).wg.n = x.1 := rfl
    rw [hxn] at hc₁
    rw [hn] at hc₃ hc₈
    omega

end Formalgo.Algorithms.ShortestPaths
