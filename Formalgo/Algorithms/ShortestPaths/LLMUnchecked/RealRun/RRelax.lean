/-- The three cases of a relaxation. -/
theorem relaxIteR_spec (C : CtxW ℝ≥0) {M : Finset ℕ} {u v : ℕ} {w : ℝ≥0} (hR : RRep L s st)
    (hF : Fixed L x st.m) (h13 : st.m 13 = v) (h14 : st.m 14 = L.NK)
    (hnk : st.d L.NK = ((s.key u + w : ℝ≥0) : ℝ)) (h15 : st.m 15 = s.stat v) (hv : v ≤ L.n)
    (hH : HeapInv C.n s M) (hd0 : s.deg 0 ≤ L.n) (hm : s.hmin ≤ L.n)
    (hv1 : s.stat v = 1 → v ∈ M) (hMr : ∀ a ∈ M, 1 ≤ a ∧ a ≤ L.n)
    (hdg : ∀ a ∈ M, s.deg a ≤ L.D) (hFM : M.card ≤ C.F) (hB : L.top < B) :
    DRuns (.ite 15 8 (DCmd.seqs [RProg.wkey 13 14, (wr 1 13 3 : DCmd), (attach 13 8 : DCmd),
        RProg.updMin 13])
        (.ite 15 3 (DCmd.seqs [(RProg.kp 15 13 : DCmd), .dless 15 14 15,
          .ite 15 3 RProg.decKey nop]) nop)) st
      fun st' k => RRep L (relax C u v w s) st' ∧ Fixed L x st'.m ∧ Frm L TD st.m st'.m ∧
        (∀ a, a ≠ L.H + v → st'.d a = st.d a) ∧ s.time + k ≤ (relax C u v w s).time + 32 := by
  have hH32 := hR.rep.H32
  have ht := top_ge (L := L)
  refine DRuns.ite (fun h0 => ?_) (fun h0 => ?_)
  · rw [h15, hR.rep.zero] at h0
    have e : relax C u v w s =
        St.updMin v (St.attach v 0 (St.setStat v 1 (St.setKey v (s.key u + w) s))) := by
      unfold relax; dsimp only; rw [if_pos h0]
    rw [e]
    refine DRuns.mono (relaxNewR_spec hR hF h13 h14 hnk hv hd0 hm hB)
      fun st' c ⟨R', X', F', d', hc⟩ => ⟨R', X', F'.mono fun _ => T29_TD, d', ?_⟩
    rw [updMinR_time]
    change s.time + _ ≤ s.time + 32
    omega
  · rw [h15, hR.rep.zero] at h0
    refine DRuns.ite (fun h1 => ?_) (fun h1 => ?_)
    · rw [h15, hR.rep.one] at h1
      have e : relax C u v w s =
          if s.key u + w < s.key v then ShortestPaths.decKey C v (s.key u + w) s else s := by
        unfold relax; dsimp only; rw [if_neg h0, if_pos h1]
      rw [e]
      exact DRuns.mono (relaxDecR_spec C hR hF h13 h14 hnk hv hH (hv1 h1) hMr hdg hFM hB)
        fun st' c ⟨R', X', F', d', hc⟩ => ⟨R', X', F', d', by omega⟩
    · rw [h15, hR.rep.one] at h1
      have e : relax C u v w s = s := by
        unfold relax; dsimp only; rw [if_neg h0, if_neg h1]
      rw [e]
      refine DRuns.idx (B := B) (Runs.constR (by omega) (by omega) fun m' h' f' => ?_)
      have F' : Frm L TD st.m m' := Frm.reg1 (.inl (by simp [TC, T267])) (by omega) f'
      exact ⟨hR.idx (hR.rep.regs1 (r := 2) (by simp [Tmp]) (by omega) f'), hF.frame hH32 F'.2,
        F', fun _ _ => rfl, by omega⟩

