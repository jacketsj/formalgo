/-- The half-edges from `h` list `l`, with weights in the data memory. -/
def LstR (L : Lay) (st : DState) : ℕ → List (ℕ × ℝ≥0) → Prop
  | h, [] => h = 0
  | h, (v, w) :: l => L.HE ≤ h ∧ h + 3 ≤ L.CH ∧ st.m (h + 1) = v ∧ st.m (h + 2) < L.H ∧
      st.d (st.m (h + 2)) = w ∧ LstR L st (st.m h) l

theorem LstR.frame (H32 : 32 ≤ L.H) (hm : ∀ a, 32 ≤ a → ¬L.Dyn a → st'.m a = st.m a)
    (hd : ∀ a, a < L.H → st'.d a = st.d a) :
    ∀ (l : List (ℕ × ℝ≥0)) (h : ℕ), LstR L st h l → LstR L st' h l
  | [], h, hl => hl
  | (v, w) :: l, h, ⟨h1, h2, h3, h4, h5, h6⟩ => by
    have hHE : L.H + 7 * L.R ≤ L.HE := by unfold Lay.HE; omega
    have nd : ∀ a, L.HE ≤ a → a < L.CH → ¬L.Dyn a := fun a ha ha' hd => by
      unfold Lay.Dyn Lay.top at hd; omega
    have e : ∀ a, L.HE ≤ a → a < L.CH → st'.m a = st.m a := fun a ha ha' =>
      hm a (by omega) (nd a ha ha')
    have e2 := e (h + 2) (by omega) (by omega)
    refine ⟨h1, h2, by rw [e _ (by omega) (by omega)]; exact h3, by rw [e2]; exact h4,
      by rw [e2, hd _ h4]; exact h5, ?_⟩
    rw [e h h1 (by omega)]
    exact LstR.frame H32 hm hd l _ h6

/-- A nonzero head means a nonempty list. -/
theorem LstR.pos (H32 : 32 ≤ L.H) : ∀ {l : List (ℕ × ℝ≥0)} {h : ℕ}, LstR L st h l →
    (0 < h ↔ l ≠ [])
  | [], h, hl => by have : h = 0 := hl; simp [this]
  | (v, w) :: l, h, hl => by
    have h1 : L.HE ≤ h := hl.1
    have h2 : 32 ≤ L.HE := by unfold Lay.HE; omega
    simp only [ne_eq, reduceCtorEq, not_false_eq_true, iff_true]; omega

theorem LstR.of_lst {wf : ℕ → ℝ≥0} :
    ∀ (l : List (ℕ × ℕ)) (h : ℕ), Lst L st.m h l →
      (∀ p ∈ l, st.d p.2 = wf p.2 ∧ p.2 < L.H) →
      LstR L st h (l.map fun p => (p.1, wf p.2))
  | [], _, hl, _ => hl
  | (v, w) :: l, h, ⟨h1, h2, h3, h4, h5⟩, hw => by
    have hw0 := hw (v, w) List.mem_cons_self
    refine ⟨h1, h2, h3, by rw [h4]; exact hw0.2, by rw [h4]; exact hw0.1, ?_⟩
    exact LstR.of_lst l _ h5 fun p hp => hw p (List.mem_cons_of_mem _ hp)

/-- The adjacency list of `v`, in memory. -/
theorem LstR.of_fixed {C : CtxW ℝ≥0} {wf : ℕ → ℝ≥0} (hF : Fixed L x st.m)
    (hW : WRel L x C wf st.d) {v : ℕ} (hv : v ≤ L.n) :
    LstR L st (st.m (L.H + 7 * L.R + v)) (C.adj v) := by
  rw [hW.adj]
  exact LstR.of_lst _ _ (hF.head v hv) fun p hp => ⟨hW.wt v p hp, hW.low v p hp⟩

