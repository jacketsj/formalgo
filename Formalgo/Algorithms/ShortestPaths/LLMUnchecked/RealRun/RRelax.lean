      (by omega) f₂
  have F₂ : Frm L TD st.m m₂ := (Frm.reg1 t15 (by omega) f₁).trans (Frm.reg1 t15 (by omega) f₂)
  have X₂ : Fixed L x m₂ := hF.frame hH32 F₂.2
