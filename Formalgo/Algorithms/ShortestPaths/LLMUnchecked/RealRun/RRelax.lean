    (r := 14) (by simp [Tmp]) (by omega) f₆
  have RR₇ : RRep L s ⟨m₆, d₇⟩ := (hR.idx R₆).dframe fun v hv => k₇ _ (Lay.NK_ne_key hv).symm
  have F₆ : Frm L TR m₄ m₆ := (Frm.reg1 t15 (by omega) f₅).trans (Frm.reg1 t14 (by omega) f₆)
  have v₆ : m₆ 13 = v := by rw [f₆ 13 (by omega), f₅ 13 (by omega), v₄]
  -- The status of `v`.
  refine DRuns.seqs_cons (DRuns.idx (B := B) (Runs.mono (rd_spec (m := m₆) RR₇.rep (k := 1)
    (d := 15) (i := 13) (by omega) (by rw [v₆]; simp [Lay.bnd]; omega) (by omega) (by omega)
    (by omega) hB) fun m₈ c₈ ⟨g₈, f₈, hc₈⟩ => ?_))
  rw [v₆] at g₈
  replace g₈ : m₈ 15 = s.stat v := g₈
  have R₈ := RR₇.rep.regs2 (r₁ := 2) (r₂ := 15) (by simp [Tmp]) (by simp [Tmp]) (by omega)
    (by omega) f₈
  have F₈ : Frm L TR st.m m₈ := F₄.trans (F₆.trans (Frm.reg t15 (by omega) f₈ t2))
  have X₈ : Fixed L x m₈ := hF.frame hH32 F₈.2
  have v₈ : m₈ 13 = v := by rw [f₈ 13 (by omega) (by omega), v₆]
  have n₈ : m₈ 14 = L.NK := by rw [f₈ 14 (by omega) (by omega), n₆]
  have u₈ : m₈ 30 = u := by rw [F₈.1 30 (by omega) n30, h30]
  have k₈ : m₈ 31 = h := by
    rw [f₈ 31 (by omega) (by omega), f₆ 31 (by omega), f₅ 31 (by omega), k₄]
  have dk : d₇ L.NK = ((s.key u + w : ℝ≥0) : ℝ) := g₇
  refine DRuns.seqs_cons (DRuns.mono (relaxIteR_spec C (RR₇.idx R₈) X₈ v₈ n₈ dk g₈ hv hH hd0 hm
    hv1 hMr hdg hFM hB) fun st₉ c₉ ⟨R₉, X₉, F₉, d₉, hc₉⟩ => ?_)
  have Fa : Frm L TR st.m st₉.m := F₈.trans (F₉.mono fun _ => TD_TR)
  have nd : ¬L.Dyn h := fun hd => by unfold Lay.Dyn Lay.top at hd; unfold Lay.HE at l1; omega
  have k₉ : st₉.m 31 = h := by rw [F₉.1 31 (by omega) d31]; exact k₈
  have dlow : ∀ a, a < L.H → st₉.d a = st.d a := fun a ha => by
    rw [d₉ a (by omega)]; exact k₇ a (by unfold Lay.NK; omega)
  -- The next half-edge.
  refine DRuns.seqs_cons (DRuns.idx (B := B) (Runs.loadR (by omega) (by omega)
    fun m₁₀ g₁₀ f₁₀ => ?_))
  have n₁₀ : m₁₀ 31 = st.m h := by rw [g₁₀, k₉, Fa.2 h (by omega) nd]
  refine DRuns.seqs_cons (DRuns.idx (B := B) (Runs.lessR (m := m₁₀) (by omega) (by omega)
    (by omega) fun m₁₁ g₁₁ f₁₁ => ?_))
  refine DRuns.seqs_nil ?_
  have z₁₀ : m₁₀ 8 = 0 := by rw [f₁₀ 8 (by omega)]; exact R₉.rep.zero
  have Fe : Frm L TR st₉.m m₁₁ := (Frm.reg1 t31 (by omega) f₁₀).trans
    (Frm.reg1 t11 (by omega) f₁₁)
  have Ft : Frm L TR st.m m₁₁ := Fa.trans Fe
  have e31 : m₁₁ 31 = st.m h := by rw [f₁₁ 31 (by omega), n₁₀]
  have e11 : m₁₁ 11 = if m₁₀ 8 < m₁₀ 31 then 1 else 0 := g₁₁
  refine ⟨?_, X₉.frame hH32 Fe.2, Ft, dlow, ?_, ?_, ?_, ?_⟩
  · have R₁₁ : Rep L (keyless (relax C u v w s)) m₁₁ :=
      (R₉.rep.regs1 (r := 31) (by simp [Tmp]) (by omega) f₁₀).regs1 (r := 11) (by simp [Tmp])
        (by omega) f₁₁
    exact ⟨R₁₁.keyless_tick 50, R₉.key⟩
  · change m₁₁ 30 = u
    rw [Ft.1 30 (by omega) n30, h30]
  · change LstR L ⟨m₁₁, st₉.d⟩ (m₁₁ 31) l
    rw [e31]
    exact LstR.frame (st := st) (st' := ⟨m₁₁, st₉.d⟩) hH32 Ft.2 dlow l _ l6
  · change m₁₁ 11 = if 0 < m₁₁ 31 then 1 else 0
    rw [e11, z₁₀, n₁₀, e31]
  · change s.time + _ + 2 ≤ (relax C u v w s).time + 50
    omega

end Formalgo.Algorithms.ShortestPaths
